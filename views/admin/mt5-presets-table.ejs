<%- include('../partials/head', { pageTitle: pageTitle || 'ตาราง MT5', pageCss: 'admin-mt5-presets.css' }) %>
<%- include('../partials/admin-shell') %>

<%
  rows = rows || [];
  const show = (v) => (v === null || v === undefined) ? '' : v;
%>

<div class="mt5-page">
  <section class="mt5-hero">
    <div>
      <div class="mt5-kicker">MT5 BOT SETTING TABLE</div>
      <h1>📊 <%= preset.name %></h1>
      <p>ภาพรวมตารางทุน / LOT / ระดับความเสี่ยง · ค่า <b>Pip Step</b> / <b>TP Average</b> ส่งไปไฟล์ .set ของ EA (ไม่แก้ .mq5)</p>
      <% if (slug === 'ak-sniper') { %>
      <p class="mt5-hint" style="margin-top:8px;font-size:13px;color:#94a3b8">
        เลขบัญชีที่ EA อนุญาตฝังใน .ex5 — ดูรายการใน <code>data/mt5-presets/ak-sniper-ea-meta.json</code>
      </p>
      <% } %>
    </div>

    <div class="mt5-hero-actions">
      <button type="button" class="mt5-btn primary" onclick="openViewModal()">👁 ดูวิว</button>
      <button type="button" class="mt5-btn success" onclick="openAddModal()">➕ เพิ่มข้อมูล</button>
      <button type="button" class="mt5-btn warning" onclick="openEditModal()">✏️ แก้ไข</button>

      <form method="POST" action="/admin/mt5-presets/<%= slug %>/delete-table" onsubmit="return confirm('ยืนยันลบข้อมูลทั้งตาราง?')" style="display:inline;">
        <button type="submit" class="mt5-btn danger">🗑 ลบตาราง</button>
      </form>

      <form method="POST" action="/admin/mt5-presets/<%= slug %>/reset" onsubmit="return confirm('รีเซ็ตข้อมูลกลับค่าเริ่มต้น?')" style="display:inline;">
        <button type="submit" class="mt5-btn gray">🔄 รีเซ็ต</button>
      </form>
    </div>
  </section>

  <section class="mt5-card">
    <div class="mt5-card-head">
      <h2>ภาพรวมตารางทุน</h2>
      <p>จำนวน <b><%= rows.length %></b> แถว</p>
    </div>

    <div class="mt5-table-wrap">
      <table class="mt5-excel-table">
        <thead>
          <tr class="group-head">
            <th rowspan="2">ทุนแนะนำ</th>
            <th rowspan="2">ทุนเซฟ</th>
            <th rowspan="2">ทุนเซฟสูงสุด</th>
            <th rowspan="2">LOT SIZE</th>
            <th rowspan="2">LOT PLUS</th>
            <th colspan="2">🔴 เสี่ยงสูง</th>
            <th colspan="2">🟡 เสี่ยงกลาง</th>
            <th colspan="2">🟢 เสี่ยงต่ำ</th>
            <th rowspan="2">Pip Step</th>
            <th rowspan="2">TP Avg</th>
          </tr>
          <tr class="sub-head">
            <th>T START</th>
            <th>T STOP</th>
            <th>กลาง T START</th>
            <th>กลาง T STOP</th>
            <th>รวบไว T START</th>
            <th>รวบไว T STOP</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(row){ %>
            <tr>
              <td><%= show(row.capital_recommend) %></td>
              <td><%= show(row.capital_safe) %></td>
              <td><%= show(row.capital_max_safe) %></td>
              <td><%= show(row.lot_size) %></td>
              <td><%= show(row.lot_plus) %></td>
              <td><%= show(row.t_start) %></td>
              <td><%= show(row.t_stop) %></td>
              <td><%= show(row.medium_t_start) %></td>
              <td><%= show(row.medium_t_stop) %></td>
              <td><%= show(row.fast_t_start) %></td>
              <td><%= show(row.fast_t_stop) %></td>
              <td><%= show(row.pip_step) %></td>
              <td><%= show(row.take_profit_average) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<div id="mt5ViewModal" class="mt5-modal">
  <div class="mt5-modal-panel wide">
    <div class="mt5-modal-head">
      <h2>👁 ดูวิวตาราง <%= preset.name %></h2>
      <button type="button" class="mt5-close-modal" onclick="closeViewModal()">ปิด ✕</button>
    </div>
    <div class="mt5-table-wrap modal-table">
      <table class="mt5-excel-table">
        <thead>
          <tr class="group-head">
            <th rowspan="2">ทุนแนะนำ</th><th rowspan="2">ทุนเซฟ</th><th rowspan="2">ทุนเซฟสูงสุด</th>
            <th rowspan="2">LOT SIZE</th><th rowspan="2">LOT PLUS</th>
            <th colspan="2">🔴 เสี่ยงสูง</th><th colspan="2">🟡 เสี่ยงกลาง</th><th colspan="2">🟢 เสี่ยงต่ำ</th>
          </tr>
          <tr class="sub-head">
            <th>T START</th><th>T STOP</th><th>กลาง T START</th><th>กลาง T STOP</th><th>รวบไว T START</th><th>รวบไว T STOP</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(row){ %>
            <tr>
              <td><%= show(row.capital_recommend) %></td><td><%= show(row.capital_safe) %></td><td><%= show(row.capital_max_safe) %></td>
              <td><%= show(row.lot_size) %></td><td><%= show(row.lot_plus) %></td>
              <td><%= show(row.t_start) %></td><td><%= show(row.t_stop) %></td>
              <td><%= show(row.medium_t_start) %></td><td><%= show(row.medium_t_stop) %></td>
              <td><%= show(row.fast_t_start) %></td><td><%= show(row.fast_t_stop) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="mt5AddModal" class="mt5-modal">
  <div class="mt5-modal-panel">
    <div class="mt5-modal-head">
      <h2>➕ เพิ่มข้อมูลใหม่</h2>
      <button type="button" class="mt5-close-modal" onclick="closeAddModal()">ปิด ✕</button>
    </div>

    <form method="POST" action="/admin/mt5-presets/<%= slug %>/create" class="mt5-form-grid">
      <label>ทุนแนะนำ<input required type="number" step="0.01" name="capital_recommend"></label>
      <label>ทุนเซฟ<input type="number" step="0.01" name="capital_safe"></label>
      <label>ทุนเซฟสูงสุด<input type="number" step="0.01" name="capital_max_safe"></label>
      <label>LOT SIZE<input required type="number" step="0.01" name="lot_size"></label>
      <label>LOT PLUS<input required type="number" step="0.01" name="lot_plus"></label>
      <label>T START<input type="number" step="0.01" name="t_start"></label>
      <label>T STOP<input type="number" step="0.01" name="t_stop"></label>
      <label>กลาง T START<input type="number" step="0.01" name="medium_t_start"></label>
      <label>กลาง T STOP<input type="number" step="0.01" name="medium_t_stop"></label>
      <label>รวบไว T START<input type="number" step="0.01" name="fast_t_start"></label>
      <label>รวบไว T STOP<input type="number" step="0.01" name="fast_t_stop"></label>
      <label>Pip Step<input type="number" step="1" name="pip_step" placeholder="345"></label>
      <label>TP Average<input type="number" step="1" name="take_profit_average" placeholder="100"></label>

      <div class="mt5-form-actions">
        <button type="submit" class="mt5-btn success">บันทึกเพิ่มข้อมูล</button>
      </div>
    </form>
  </div>
</div>

<div id="mt5EditModal" class="mt5-modal">
  <div class="mt5-modal-panel wide">
    <div class="mt5-modal-head">
      <h2>✏️ แก้ไขข้อมูล <%= preset.name %></h2>
      <button type="button" class="mt5-close-modal" onclick="closeEditModal()">ปิด ✕</button>
    </div>

    <div class="mt5-table-wrap modal-table">
      <table class="mt5-edit-table">
        <thead>
          <tr>
            <th>ทุนแนะนำ</th><th>ทุนเซฟ</th><th>ทุนเซฟสูงสุด</th><th>LOT SIZE</th><th>LOT PLUS</th>
            <th>T START</th><th>T STOP</th><th>กลาง START</th><th>กลาง STOP</th><th>รวบไว START</th><th>รวบไว STOP</th><th>Pip</th><th>TP</th><th>จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(row){ const fid = 'form-row-' + row.id; %>
            <tr>
              <td>
                <form id="<%= fid %>" method="POST" action="/admin/mt5-presets/<%= slug %>/<%= row.id %>/update"></form>
                <input form="<%= fid %>" type="number" step="0.01" name="capital_recommend" value="<%= show(row.capital_recommend) %>">
              </td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="capital_safe" value="<%= show(row.capital_safe) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="capital_max_safe" value="<%= show(row.capital_max_safe) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="lot_size" value="<%= show(row.lot_size) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="lot_plus" value="<%= show(row.lot_plus) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="t_start" value="<%= show(row.t_start) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="t_stop" value="<%= show(row.t_stop) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="medium_t_start" value="<%= show(row.medium_t_start) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="medium_t_stop" value="<%= show(row.medium_t_stop) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="fast_t_start" value="<%= show(row.fast_t_start) %>"></td>
              <td><input form="<%= fid %>" type="number" step="0.01" name="fast_t_stop" value="<%= show(row.fast_t_stop) %>"></td>
              <td><input form="<%= fid %>" type="number" step="1" name="pip_step" value="<%= show(row.pip_step) %>"></td>
              <td><input form="<%= fid %>" type="number" step="1" name="take_profit_average" value="<%= show(row.take_profit_average) %>"></td>
              <td class="action-cell">
                <button form="<%= fid %>" type="submit" class="small-save">บันทึก</button>
                <form method="POST" action="/admin/mt5-presets/<%= slug %>/<%= row.id %>/delete" onsubmit="return confirm('ยืนยันลบแถวนี้?')">
                  <button type="submit" class="small-delete">ลบ</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
function openViewModal(){ document.getElementById('mt5ViewModal').classList.add('show'); document.body.style.overflow='hidden'; }
function closeViewModal(){ document.getElementById('mt5ViewModal').classList.remove('show'); document.body.style.overflow=''; }

function openAddModal(){ document.getElementById('mt5AddModal').classList.add('show'); document.body.style.overflow='hidden'; }
function closeAddModal(){ document.getElementById('mt5AddModal').classList.remove('show'); document.body.style.overflow=''; }

function openEditModal(){ document.getElementById('mt5EditModal').classList.add('show'); document.body.style.overflow='hidden'; }
function closeEditModal(){ document.getElementById('mt5EditModal').classList.remove('show'); document.body.style.overflow=''; }

document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){
    closeViewModal();
    closeAddModal();
    closeEditModal();
  }
});
</script>

<%- include('../partials/admin-shell-end') %>
