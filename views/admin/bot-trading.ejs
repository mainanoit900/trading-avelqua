<%- include('../partials/head', { pageTitle: 'Admin Bot Trading', pageCss: 'admin-bot-trading.css' }) %>
<%- include('../partials/admin-shell') %>
<%
  const n = (v,d=2)=>Number(v||0).toLocaleString('th-TH',{minimumFractionDigits:d,maximumFractionDigits:d});
  const i = (v)=>Number(v||0).toLocaleString('th-TH');
  const date = (v)=>v ? new Date(v).toLocaleString('th-TH',{timeZone:'Asia/Bangkok'}) : '-';
  const pct = (used,total)=>Number(total||0)>0 ? Math.min(100,Math.round(Number(used||0)/Number(total||0)*100)) : 0;
%>
<div class="abt-page">
  <section class="abt-hero">
    <div class="abt-kicker">ADMIN ONLY · VPS · MT5 · EA · AGENT</div>
    <h2>ศูนย์ควบคุม Bot Trading ฝั่ง Admin</h2>
    <p>หน้านี้ใช้ตั้งค่าระบบบอท, VPS, Port, MT5, Agent Commands, สถานะ Session, Metric และกำไรย้อนหลัง ก่อนเปิดให้ลูกค้าใช้งานจริงในฝั่ง User</p>
    <div class="abt-stats">
      <div><span>VPS Online</span><strong><%= summary.onlineNodes %>/<%= summary.totalNodes %></strong></div>
      <div><span>Port ใช้งาน</span><strong><%= summary.usedPorts %>/<%= summary.totalPorts %></strong><em style="width:<%= pct(summary.usedPorts, summary.totalPorts) %>%"></em></div>
      <div><span>Lot ใช้งาน</span><strong><%= n(summary.usedLot) %>/<%= n(summary.totalLot) %></strong><em style="width:<%= pct(summary.usedLot, summary.totalLot) %>%"></em></div>
      <div><span>Bot Running</span><strong><%= summary.runningBots %></strong><small>Stopped <%= summary.stoppedBots %> · Error <%= summary.errorBots %></small></div>
    </div>
  </section>

  <nav class="abt-tabs">
    <a href="#settings">ตั้งค่าบอท</a><a href="#vps">VPS / Port</a><a href="#sessions">PLAY / STOP</a><a href="#metrics">กราฟ / Metric</a><a href="#credit">เครดิตแพ็กเกจ</a><a href="#profit-calendar">ปฏิทินกำไร</a><a href="#agent-commands">Agent Commands</a><a href="#logs">Logs</a>
  </nav>

  <section class="abt-card" id="settings">
    <div class="abt-head"><div><h3>ส่วนที่ 1 · ตั้งค่าบอท</h3><p>กำหนดค่าเริ่มต้นให้ระบบ ก่อน User ใช้งานจริง</p></div><span class="abt-pill <%= settings.is_enabled ? 'ok' : 'bad' %>"><%= settings.is_enabled ? 'เปิดระบบ' : 'ปิดระบบ' %></span></div>
    <form method="POST" action="/admin/bot-trading/settings" class="abt-form">
      <label>คู่เงินหลัก<input name="default_symbol" value="<%= settings.default_symbol || 'XAUUSD' %>"></label>
      <label>Lot เริ่มต้น<input type="number" step="0.01" name="default_lot" value="<%= settings.default_lot || 0.01 %>"></label>
      <label>Lot สูงสุด/User<input type="number" step="0.01" name="max_lot_per_user" value="<%= settings.max_lot_per_user || 0.10 %>"></label>
      <label>Port สูงสุด/User<input type="number" name="max_ports_per_user" value="<%= settings.max_ports_per_user || 1 %>"></label>
      <label>Risk Mode<select name="risk_mode"><% ['safe','standard','aggressive'].forEach(r=>{ %><option value="<%= r %>" <%= settings.risk_mode===r?'selected':'' %>><%= r %></option><% }) %></select></label>
      <label>TP/SL มาตรฐาน<input value="ใช้ตาม Preset/EA ที่ Admin อนุญาต" readonly></label>
      <label class="abt-check"><input type="checkbox" name="allow_user_custom_lot" <%= settings.allow_user_custom_lot?'checked':'' %>> อนุญาตให้ User แก้ Lot</label>
      <label class="abt-check"><input type="checkbox" name="allow_user_custom_symbol" <%= settings.allow_user_custom_symbol?'checked':'' %>> อนุญาตให้ User แก้คู่เงิน</label>
      <label class="abt-check"><input type="checkbox" name="is_enabled" <%= settings.is_enabled!==false?'checked':'' %>> เปิดระบบ Bot Trading</label>
      <label class="full">ข้อความเตือนความเสี่ยง<textarea name="admin_note"><%= settings.admin_note || 'การเทรดมีความเสี่ยง ต้องตรวจสอบเงินทุน Lot และแพ็กเกจก่อนกด PLAY ทุกครั้ง' %></textarea></label>
      <div class="full"><button class="abt-btn primary">บันทึกการตั้งค่า</button></div>
    </form>
  </section>

  <section class="abt-card" id="vps">
    <div class="abt-head"><div><h3>ส่วนที่ 2 · VPS / Port / Windows Agent</h3><p>กดส่งคำสั่งไปยัง Agent ของแต่ละ VPS ได้จากหน้านี้</p></div><a class="abt-btn soft" href="/admin/vps">ไปหน้า VPS เดิม</a></div>
    <div class="abt-grid-3">
      <% if (!(nodes||[]).length) { %><div class="abt-empty">ยังไม่มี VPS Node</div><% } %>
      <% (nodes||[]).forEach(node=>{ %>
        <div class="abt-node">
          <div class="abt-row"><strong><%= node.node_name %></strong><span class="abt-pill <%= node.status==='available'?'ok':(node.status==='offline'?'bad':'warn') %>"><%= node.status %></span></div>
          <p><%= node.ip_address || '-' %></p>
          <div class="abt-mini">Port <%= node.used_ports||0 %>/<%= node.max_ports||0 %><em><b style="width:<%= pct(node.used_ports,node.max_ports) %>%"></b></em></div>
          <div class="abt-mini">Lot <%= n(node.used_lot) %>/<%= n(node.max_lot) %><em><b style="width:<%= pct(node.used_lot,node.max_lot) %>%"></b></em></div>
          <div class="abt-actions">
            <% ['health_check','start_mt5','restart_mt5','run_bot','stop_bot','sync_mt5'].forEach(cmd=>{ %>
              <form method="POST" action="/admin/bot-trading/nodes/<%= node.id %>/command"><input type="hidden" name="command" value="<%= cmd %>"><button class="abt-btn soft" type="submit"><%= cmd %></button></form>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="abt-card" id="sessions">
    <div class="abt-head"><div><h3>ส่วนที่ 3 · PLAY / STOP Sessions</h3><p>Admin อนุญาต/สั่งรัน/หยุด Session ก่อนเปิดให้ User กดเอง</p></div></div>
    <div class="abt-table-wrap"><table class="abt-table"><thead><tr><th>Session</th><th>User</th><th>MT5</th><th>VPS</th><th>Symbol/Lot</th><th>Status</th><th>Action</th></tr></thead><tbody>
      <% if (!(sessions||[]).length) { %><tr><td colspan="7"><div class="abt-empty">ยังไม่มี Bot Session</div></td></tr><% } %>
      <% (sessions||[]).forEach(s=>{ %><tr><td><strong><%= s.session_code %></strong></td><td><%= s.full_name || s.email || '-' %></td><td><%= s.broker_name || '-' %><br><small><%= s.account_login || '' %> <%= s.server_name || '' %></small></td><td><%= s.node_name || '-' %></td><td><%= s.symbol || '-' %><br><small>Lot <%= s.lot_in_use || 0 %> · Port <%= s.ports_in_use || 0 %></small></td><td><span class="abt-pill <%= s.status==='running'?'ok':(s.status==='error'?'bad':'warn') %>"><%= s.status %></span></td><td><div class="abt-actions"><% [['play','PLAY'],['stop','STOP'],['restart','RESTART'],['sync','SYNC']].forEach(a=>{ %><form method="POST" action="/admin/bot-trading/sessions/<%= s.id %>/action"><input type="hidden" name="action" value="<%= a[0] %>"><button class="abt-btn <%= a[0]==='stop'?'danger':(a[0]==='play'?'success':'soft') %>"><%= a[1] %></button></form><% }) %></div></td></tr><% }) %>
    </tbody></table></div>
  </section>

  <div class="abt-two">
    <section class="abt-card" id="metrics"><div class="abt-head"><div><h3>ส่วนที่ 4 · Graph / MT5 Metrics</h3><p>รอ EA ส่ง Balance / Equity / Profit / Drawdown กลับ DB</p></div></div><div class="abt-log"><% if (!(metrics||[]).length) { %><div class="abt-empty">ยังไม่มี Metrics จาก EA</div><% } %><% (metrics||[]).forEach(m=>{ %><div class="abt-log-row"><strong><%= m.session_code || '-' %> · <%= m.symbol %></strong><p>Balance <%= n(m.balance) %> · Equity <%= n(m.equity) %> · Profit <%= n(m.profit) %> · DD <%= n(m.drawdown_percent) %>%</p><small><%= date(m.created_at) %></small></div><% }) %></div></section>
    <section class="abt-card" id="credit"><div class="abt-head"><div><h3>ส่วนที่ 5 · เครดิตแพ็กเกจ</h3><p>ใช้ดูข้อจำกัด Port / Lot ตามแพ็กเกจ ก่อนเชื่อม User</p></div></div><div class="abt-log"><% if (!(packages||[]).length) { %><div class="abt-empty">ยังไม่มี Package</div><% } %><% (packages||[]).forEach(p=>{ %><div class="abt-log-row"><strong><%= p.name || p.package_name || ('Package #' + p.id) %></strong><p>ราคา <%= n(p.price || p.price_thb || 0) %> บาท · สถานะ <%= p.is_enabled===false?'ปิด':'เปิด' %></p></div><% }) %></div></section>
  </div>

  <section class="abt-card" id="profit-calendar"><div class="abt-head"><div><h3>ส่วนที่ 6 · ปฏิทินกำไร</h3><p>สรุปกำไรรายวัน/รายเดือน/ย้อนหลัง และใช้ต่อยอดคาดการณ์ % ในอนาคต</p></div><span class="abt-pill ok">เดือนนี้ <%= n(summary.profitMonth) %></span></div><div class="abt-calendar"><% if (!(trades||[]).length) { %><div class="abt-empty">ยังไม่มี Trade Results</div><% } %><% (trades||[]).forEach(t=>{ %><div><strong><%= String(t.result_date).slice(0,10) %></strong><span class="<%= Number(t.profit||0)>=0?'plus':'minus' %>"><%= n(t.profit) %></span><small><%= i(t.trades) %> trades</small></div><% }) %></div></section>

  <div class="abt-two">
    <section class="abt-card" id="agent-commands"><div class="abt-head"><div><h3>Agent Commands</h3><p>คำสั่งที่ส่งไป Windows Agent</p></div></div><div class="abt-log"><% if (!(commands||[]).length) { %><div class="abt-empty">ยังไม่มีคำสั่ง</div><% } %><% (commands||[]).forEach(c=>{ %><div class="abt-log-row"><strong><%= c.command_type %> <span class="abt-pill <%= c.status==='success'?'ok':(c.status==='failed'?'bad':'warn') %>"><%= c.status %></span></strong><p><%= c.node_name || '-' %> · <%= c.session_code || '-' %></p><small><%= date(c.created_at) %></small></div><% }) %></div></section>
    <section class="abt-card" id="logs"><div class="abt-head"><div><h3>Bot Logs</h3><p>Log ล่าสุดจากระบบบอท</p></div></div><div class="abt-log"><% if (!(logs||[]).length) { %><div class="abt-empty">ยังไม่มี Log</div><% } %><% (logs||[]).forEach(l=>{ %><div class="abt-log-row"><strong><%= l.session_code || '-' %> · <%= l.level_name %></strong><p><%= l.message %></p><small><%= date(l.created_at) %></small></div><% }) %></div></section>
  </div>
</div>
<%- include('../partials/admin-shell-end') %>
