<%- include('../partials/admin-shell') %>

<div class="grid-2">
  <section class="card form-card">
    <div class="card-head">
      <div>
        <h3 data-i18n="admin.ai.title"><%= t('admin.ai.title', 'AI Chat Settings') %></h3>
        <p>ตั้งค่าโมเดล บุคลิก และการเก็บประวัติแชทเพื่อพัฒนาการตอบลูกค้า</p>
      </div>

      <div class="inline-actions">
        <a class="btn secondary" href="/admin/ai-history">ดูประวัติแชท AI</a>
      </div>
    </div>

    <form method="POST" action="/admin/ai-settings" class="form-grid two">
      <label>
        OPENAI_API_KEY
        <input type="text" name="openai_api_key" value="<%= settings.openai_api_key || '' %>" />
      </label>

      <label>
        Model
        <input type="text" name="model_name" value="<%= settings.model_name || 'gpt-5.4-mini' %>" />
      </label>

      <label>
        ชื่อแชท
        <input type="text" name="bot_name" value="<%= settings.bot_name || 'สายฝน' %>" />
      </label>

      <label class="full">
        บุคลิกหลัก
        <textarea name="persona_th"><%= settings.persona_th || 'สุภาพ ลงท้ายด้วยคำว่าค่ะ' %></textarea>
      </label>

      <label class="full">
        ข้อห้ามเพิ่มเติม
        <textarea name="forbidden_topics_th" placeholder="ตัวอย่าง: ห้ามสัญญาผลกำไร, ห้ามเปิดเผยโค้ด, ห้ามตอบข้อมูลแอดมินภายใน"><%= settings.forbidden_topics_th || '' %></textarea>
      </label>

      <label class="full">
        รายละเอียดการคุยเพิ่มเติม
        <textarea name="conversation_instructions_th" placeholder="เช่น ให้ตอบสุภาพ กระชับ ขายแบบไม่กดดัน"><%= settings.conversation_instructions_th || '' %></textarea>
      </label>

      <label class="full">
        บุคลิก AI ฝั่ง /admin
        <textarea name="admin_persona_th" placeholder="เช่น ผู้ช่วยแอดมิน ตอบตรง สรุปไว"><%= settings.admin_persona_th || '' %></textarea>
      </label>

      <label class="full">
        บุคลิก AI ฝั่ง /app
        <textarea name="app_persona_th" placeholder="เช่น ที่ปรึกษาลูกค้า สุภาพ เข้าใจง่าย"><%= settings.app_persona_th || '' %></textarea>
      </label>

      <div class="checkbox-grid full">
        <label class="checkbox-row">
          <input type="checkbox" name="is_enabled" <%= settings.is_enabled ? 'checked' : '' %> />
          เปิด AI
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="save_chat_history" <%= settings.save_chat_history ? 'checked' : '' %> />
          บันทึกประวัติแชท
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="hide_system_structure" <%= settings.hide_system_structure ? 'checked' : '' %> />
          ห้ามเปิดเผยโครงสร้างระบบ/โค้ด
        </label>
      </div>

      <div class="form-actions full">
        <button class="btn primary" data-i18n="common.save"><%= t('common.save', 'Save') %></button>
        <a class="btn secondary" href="/admin/ai-history">เปิดหน้าประวัติแชท</a>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="card-head">
      <div>
        <h3>แนวทางการตอบ</h3>
        <p>สรุปสถานะเพื่อใช้ปรับคำตอบลูกค้า</p>
      </div>
    </div>

    <div class="list-stack">
      <div class="list-item">ชื่อบอทปัจจุบัน: <strong><%= settings.bot_name || 'สายฝน' %></strong></div>
      <div class="list-item">บุคลิก: <%= settings.persona_th || '-' %></div>
      <div class="list-item">ข้อห้าม: <%= settings.forbidden_topics_th || 'ยังไม่ได้ระบุ' %></div>
      <div class="list-item">บันทึกประวัติแชท: <strong><%= settings.save_chat_history ? 'เปิดใช้งาน' : 'ปิดอยู่' %></strong></div>
      <div class="list-item">ดูประวัติทั้งหมด: <a href="/admin/ai-history">/admin/ai-history</a></div>
    </div>
  </section>
</div>

<%- include('../partials/admin-shell-end') %>