<%- include('../partials/admin-shell') %>

<section class="card">
  <div class="card-head">
    <div>
      <h3>AI Chat History</h3>
      <p>ดูประวัติการคุยทั้งหมดเพื่อวิเคราะห์และพัฒนาการตอบลูกค้า</p>
    </div>
    <div class="inline-actions">
      <a class="btn secondary" href="/admin/ai-settings">กลับหน้า AI Settings</a>
    </div>
  </div>

  <form method="GET" action="/admin/ai-history" class="form-grid two" style="margin-bottom:16px;">
    <label class="full">
      ค้นหา session / ชื่อลูกค้า / อีเมล
      <input
        type="text"
        name="q"
        value="<%= q || '' %>"
        placeholder="เช่น session key, ชื่อลูกค้า, อีเมล"
      />
    </label>
    <div class="form-actions full">
      <button class="btn primary" type="submit">ค้นหา</button>
      <a class="btn secondary" href="/admin/ai-history">ล้างค้นหา</a>
    </div>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Session</th>
          <th>ลูกค้า</th>
          <th>อีเมล</th>
          <th>ข้อความ</th>
          <th>อัปเดตล่าสุด</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% if (!sessions || !sessions.length) { %>
          <tr>
            <td colspan="6" class="muted">ยังไม่มีประวัติแชท</td>
          </tr>
        <% } %>

        <% (sessions || []).forEach(function(s){ %>
          <tr>
            <td>
              <strong><%= s.session_key %></strong>
            </td>
            <td><%= s.full_name || s.name || '-' %></td>
            <td><%= s.email || '-' %></td>
            <td><%= Number(s.message_count || 0) %></td>
            <td><%= s.updated_at ? new Date(s.updated_at).toLocaleString('th-TH') : '-' %></td>
            <td>
              <a class="btn secondary" href="/admin/ai-history/<%= encodeURIComponent(s.session_key) %>">
                ดูแชท
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/admin-shell-end') %>