<%- include('../partials/head', { pageTitle, pageCss: 'admin-vps-control.css' }) %>
<%- include('../partials/admin-shell') %>

<div class="vps-page">
  <section class="vps-hero premium">
    <div><div class="vps-kicker">VPS PORT / MT5</div><h1><%= mode === 'edit' ? 'แก้ไข Port' : 'เพิ่ม Port' %></h1><p>Port ใช้แยกโฟลเดอร์ MT5/Bot เช่น PORT01 - PORT020 เพื่อไม่ให้ชนกัน</p></div>
    <a class="btn soft" href="/admin/vps">← กลับ VPS</a>
  </section>

  <section class="vps-card">
    <form method="POST" action="<%= mode === 'edit' ? '/admin/vps/ports/' + port.id + '/update' : '/admin/vps/ports/create' %>" class="vps-form">
      <label>เลือก Windows VPS
        <select name="node_id" required>
          <% (nodes || []).forEach(function(n){ const pct = n.max_ports ? Math.round((Number(n.used_ports||0)/Number(n.max_ports||1))*100) : 0; %>
            <option value="<%= n.id %>" <%= String(port.node_id || '') === String(n.id) ? 'selected' : '' %>><%= n.node_name %> | <%= n.ip_address || '-' %> | Port <%= n.used_ports || 0 %>/<%= n.max_ports || 0 %> | ใช้ <%= pct %>%</option>
          <% }) %>
        </select>
      </label>
      <label>ชื่อ Port <input name="port_name" value="<%= port.port_name || '' %>" placeholder="PORT01" required></label>
      <label>หมายเลข/รหัส Port <input name="port_number" value="<%= port.port_number || '' %>" placeholder="PORT01 หรือ 30001"></label>
      <label>โฟลเดอร์ของ Port <input name="folder_path" value="<%= port.folder_path || '' %>" placeholder="C:\AvelquaBots\PORT01"></label>
      <label>รองรับ Lot <input type="number" step="0.01" name="max_lot" value="<%= port.max_lot || 0.01 %>" min="0"></label>
      <label>สถานะ
        <select name="status">
          <% ['available','running','stopped','maintenance','error'].forEach(function(s){ %><option value="<%= s %>" <%= (port.status||'available')===s?'selected':'' %>><%= s %></option><% }) %>
        </select>
      </label>
      <div><button class="btn primary" type="submit"><%= mode === 'edit' ? 'บันทึก Port' : '+ เพิ่ม Port' %></button></div>
    </form>
  </section>
</div>

<%- include('../partials/admin-shell-end') %>
