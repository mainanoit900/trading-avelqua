<%
const settings = (typeof scoinSettings !== 'undefined' && scoinSettings) ? scoinSettings : {};
const econ = (typeof economySettings !== 'undefined' && economySettings) ? economySettings : {};
const safeOrders = Array.isArray(orders) ? orders : [];
const safeTransactions = Array.isArray(transactions) ? transactions : [];
const safeWallets = Array.isArray(wallets) ? wallets : [];
const safePriceHistory = Array.isArray(priceHistory) ? priceHistory : [];
const safeTreasuryWallets = Array.isArray(treasuryWallets) ? treasuryWallets : [];
const safeEconomyLogs = Array.isArray(economyLogs) ? economyLogs : [];
const fundFromLogs = {
  company_profit_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.company_profit_thb || 0), 0),
  network_bonus_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.network_bonus_thb || 0), 0),
  buyback_reserve_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.buyback_reserve_thb || 0), 0),
  burn_liquidity_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.burn_liquidity_thb || 0), 0),
  promotion_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.promotion_thb || 0), 0),
  system_marketing_thb: safeEconomyLogs.reduce((sum, l) => sum + Number(l.system_marketing_thb || 0), 0),
  user_receive_scoin: safeEconomyLogs.reduce((sum, l) => sum + Number(l.user_receive_scoin || 0), 0)
};
const fund = (typeof fundSummary !== 'undefined' && fundSummary) ? fundSummary : fundFromLogs;
const statsFromOrders = {
  pending: safeOrders.filter((o) => String(o.status || '').toLowerCase() === 'pending').length,
  approved: safeOrders.filter((o) => String(o.status || '').toLowerCase() === 'approved').length,
  rejected: safeOrders.filter((o) => String(o.status || '').toLowerCase() === 'rejected').length,
  approved_buy_volume: safeOrders.filter((o) => String(o.order_type || '').toLowerCase() === 'buy' && String(o.status || '').toLowerCase() === 'approved').reduce((sum, o) => sum + Number(o.scoin_amount || 0), 0),
  approved_sell_volume: safeOrders.filter((o) => String(o.order_type || '').toLowerCase() === 'sell' && String(o.status || '').toLowerCase() === 'approved').reduce((sum, o) => sum + Number(o.scoin_amount || 0), 0)
};
const stats = (typeof orderStats !== 'undefined' && orderStats) ? orderStats : statsFromOrders;
const pg = (typeof pagers !== 'undefined' && pagers) ? pagers : {};
const currentNowThai = (typeof nowThai !== 'undefined' && nowThai) ? nowThai : new Date().toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', hour12: false });
function fmtNum(value, min = 2, max = 4) { return Number(value || 0).toLocaleString('th-TH', { minimumFractionDigits: min, maximumFractionDigits: max }); }
function fmtMoney(value) { return Number(value || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function fmtDate(value) { if (!value) return '-'; try { return new Date(value).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', hour12: false }); } catch (e) { return '-'; } }
function pagerUrl(key, page) {
  const qs = new URLSearchParams();
  qs.set(key, page);
  return '/admin/scoin-market?' + qs.toString();
}
function renderPager(pager, key) {
  if (!pager || Number(pager.pages || 1) <= 1) return '';
  const page = Number(pager.page || 1);
  const pages = Number(pager.pages || 1);
  const prev = Math.max(1, page - 1);
  const next = Math.min(pages, page + 1);
  return `<div class="scoin-pagination"><a class="${page <= 1 ? 'disabled' : ''}" href="${pagerUrl(key, prev)}">ก่อนหน้า</a><span>หน้า ${page} / ${pages}</span><a class="${page >= pages ? 'disabled' : ''}" href="${pagerUrl(key, next)}">ถัดไป</a></div>`;
}
%>

<%- include('../partials/admin-shell') %>
<link rel="stylesheet" href="/public/css/admin-scoin-market.css">

<style>
