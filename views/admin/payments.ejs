<script>
(function(){
  document.querySelectorAll('.payment-row-actions').forEach(function(box){
    box.style.display = 'flex';
    box.classList.add('payment-inline-actions');
  });
})();
</script>


<section class="card scoin-sell-card" style="margin-top:24px;">
  <div class="card-head payment-head-wrap">
    <div>
      <h3>รายการลูกค้าขาย Scoin คืนโฮส</h3>
      <p>ดูรายละเอียด / ปริ้น / Excel / ยืนยัน / ยกเลิก / ลบ</p>
    </div>
    <div class="inline-actions wrap">
      <button type="button" class="btn secondary" id="scoinSelectAllBtn">เลือกทั้งหมด</button>
      <button type="button" class="btn secondary" id="scoinClearBtn">ล้างที่เลือก</button>
      <button type="button" class="btn primary" id="scoinPrintBtn">ปริ้นที่เลือก</button>
      <button type="button" class="btn primary" id="scoinExcelBtn">Excel ที่เลือก</button>
      <form method="POST" action="/admin/scoin-market/bulk-delete" id="scoinBulkDeleteForm" onsubmit="return confirm('ยืนยันลบรายการที่เลือก?');">
        <input type="hidden" name="ids" id="scoinBulkDeleteIds" />
        <button class="btn danger" type="submit">ลบที่เลือก</button>
      </form>
    </div>
  </div>

  <div class="table-wrap scoin-table-wrap">
    <table class="payment-table scoin-sell-table">
      <thead>
        <tr>
          <th><input type="checkbox" id="scoinSelectAll" class="scoin-check"></th>
          <th>ID</th>
          <th>ผู้ใช้</th>
          <th>Scoin</th>
          <th>ยอดสุทธิ</th>
          <th>บัญชีรับเงิน</th>
          <th>สถานะ</th>
          <th>วันที่</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% (scoinSellOrders || []).forEach(function(o){ %>
          <tr>
            <td><input type="checkbox" class="scoin-row-check scoin-check" value="<%= o.id %>"></td>
            <td><strong>#<%= o.display_id || ('SCSELL' + String(o.id).padStart(6,'0')) %></strong></td>
            <td><strong><%= o.full_name || '-' %></strong><div class="cell-sub"><%= o.email || '-' %></div></td>
            <td><%= Number(o.scoin_amount || 0).toLocaleString('th-TH') %></td>
            <td>
              <strong>฿<%= Number(o.net_amount_thb || 0).toLocaleString('th-TH') %></strong>
              <div class="cell-sub">ก่อนหัก ฿<%= Number(o.gross_amount_thb || 0).toLocaleString('th-TH') %> / fee ฿<%= Number(o.fee_amount_thb || 0).toLocaleString('th-TH') %></div>
            </td>
            <td><%= o.bank_name || '-' %><div class="cell-sub"><%= o.account_name || '-' %> <%= o.account_number_masked || '' %></div></td>
            <td><span class="badge <%= String(o.status) === 'approved' ? 'green' : (String(o.status) === 'rejected' ? 'red' : 'yellow') %>"><%= o.status || '-' %></span><div class="cell-sub">จ่าย: <%= o.payout_status || '-' %></div></td>
            <td><%= formatDateTime(o.created_at) %></td>
            <td>
              <div class="scoin-actions">
                <button type="button" class="btn secondary scoin-detail-btn"
                  data-id="<%= o.display_id || ('SCSELL' + String(o.id).padStart(6,'0')) %>"
                  data-name="<%= o.full_name || '-' %>"
                  data-email="<%= o.email || '-' %>"
                  data-scoin="<%= Number(o.scoin_amount || 0) %>"
                  data-price="<%= Number(o.price_thb || 0) %>"
                  data-gross="<%= Number(o.gross_amount_thb || 0) %>"
                  data-fee="<%= Number(o.fee_amount_thb || 0) %>"
                  data-net="<%= Number(o.net_amount_thb || 0) %>"
                  data-bank="<%= o.bank_name || '-' %>"
                  data-account="<%= o.account_name || '-' %> <%= o.account_number_masked || '' %>"
                  data-status="<%= o.status || '-' %>"
                  data-payout="<%= o.payout_status || '-' %>"
                  data-date="<%= formatDateTime(o.created_at) %>">ดู</button>

                <% if (String(o.status) === 'pending') { %>
                  <form method="POST" action="/admin/scoin-market/<%= o.id %>/approve"><button class="btn success" type="submit">ยืนยัน</button></form>
                  <form method="POST" action="/admin/scoin-market/<%= o.id %>/reject"><button class="btn warning" type="submit">ยกเลิก</button></form>
                <% } %>

                <% if (String(o.status) === 'approved' && String(o.payout_status || 'pending') === 'pending') { %>
                  <form method="POST" action="/admin/scoin-market/<%= o.id %>/confirm-transfer">
                    <input type="hidden" name="transfer_note" value="ยืนยันจ่ายจากหน้า payments" />
                    <button class="btn success" type="submit">จ่ายแล้ว</button>
                  </form>
                <% } %>

                <form method="POST" action="/admin/scoin-market/<%= o.id %>/delete" onsubmit="return confirm('ยืนยันลบรายการนี้?');">
                  <button class="btn danger" type="submit">ลบ</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>

        <% if (!(scoinSellOrders || []).length) { %>
          <tr><td colspan="9" class="empty-cell">ยังไม่มีรายการขาย Scoin คืนโฮส</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section id="scoinDetailModal" class="scoin-modal" style="display:none;">
  <div class="scoin-modal-box">
    <div class="scoin-modal-head">
      <h3>รายละเอียดการขาย Scoin</h3>
      <button type="button" id="scoinModalClose" class="btn secondary">ปิด</button>
    </div>
    <div id="scoinModalBody" class="scoin-modal-body"></div>
    <div class="inline-actions">
      <button type="button" id="scoinModalPrint" class="btn primary">ปริ้นรายละเอียด</button>
    </div>
  </div>
</section>

<section id="scoinPrintArea" class="payment-print-area" aria-hidden="true"></section>

<style>
.scoin-sell-table{min-width:980px!important}
.scoin-sell-table th,.scoin-sell-table td{white-space:normal!important}
.scoin-actions{display:flex;flex-wrap:wrap;gap:5px;max-width:160px}
.scoin-actions .btn{min-height:28px!important;padding:4px 8px!important;font-size:11px!important;border-radius:8px!important}
.scoin-actions form{margin:0}
.scoin-check{width:18px;height:18px;accent-color:#7c3aed}
.scoin-modal{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:999999;display:grid;place-items:center;padding:20px}
.scoin-modal-box{width:min(720px,96vw);background:#0f172a;border:1px solid rgba(148,163,184,.25);border-radius:22px;padding:18px;box-shadow:0 24px 80px rgba(0,0,0,.55)}
.scoin-modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}
.scoin-modal-body{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.scoin-detail-line{padding:10px 12px;background:rgba(255,255,255,.04);border-radius:12px}
.scoin-detail-line span{display:block;color:#94a3b8;font-size:12px;margin-bottom:4px}
@media(max-width:760px){.scoin-modal-body{grid-template-columns:1fr}}
</style>

<script>
(function(){
  const all = document.getElementById('scoinSelectAll');
  const allBtn = document.getElementById('scoinSelectAllBtn');
  const clearBtn = document.getElementById('scoinClearBtn');
  const form = document.getElementById('scoinBulkDeleteForm');
  const idsInput = document.getElementById('scoinBulkDeleteIds');

  const checks = () => Array.from(document.querySelectorAll('.scoin-row-check'));
  const selected = () => checks().filter(cb => cb.checked);

  if (all) all.addEventListener('change', () => checks().forEach(cb => cb.checked = all.checked));
  if (allBtn) allBtn.addEventListener('click', () => checks().forEach(cb => cb.checked = true));
  if (clearBtn) clearBtn.addEventListener('click', () => checks().forEach(cb => cb.checked = false));

  if (form) form.addEventListener('submit', function(e){
    const ids = selected().map(cb => cb.value);
    if (!ids.length) { e.preventDefault(); alert('กรุณาเลือกรายการก่อนลบ'); return false; }
    idsInput.value = ids.join(',');
  });

  function orderDataFromRow(cb){
    const tr = cb.closest('tr');
    const btn = tr ? tr.querySelector('.scoin-detail-btn') : null;
    if (!btn) return null;
    return {
      ID: btn.dataset.id, ผู้ใช้: btn.dataset.name, Email: btn.dataset.email,
      Scoin: Number(btn.dataset.scoin||0), ราคาเหรียญ: Number(btn.dataset.price||0),
      ยอดก่อนหัก: Number(btn.dataset.gross||0), ค่าธรรมเนียม: Number(btn.dataset.fee||0),
      จ่ายสุทธิ: Number(btn.dataset.net||0), ธนาคาร: btn.dataset.bank,
      บัญชี: btn.dataset.account, สถานะ: btn.dataset.status,
      สถานะจ่าย: btn.dataset.payout, วันที่: btn.dataset.date
    };
  }

  function requireSelected(){
    const rows = selected().map(orderDataFromRow).filter(Boolean);
    if (!rows.length) alert('กรุณาเลือกรายการก่อน');
    return rows;
  }

  document.getElementById('scoinExcelBtn')?.addEventListener('click', function(){
    const rows = requireSelected(); if (!rows.length) return;
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'Scoin Sell');
    XLSX.writeFile(wb, 'scoin-sell-selected-' + Date.now() + '.xlsx');
  });

  document.getElementById('scoinPrintBtn')?.addEventListener('click', function(){
    const rows = requireSelected(); if (!rows.length) return;
    const html = rows.map(r => `<tr><td>${r.ID}</td><td>${r.ผู้ใช้}<br>${r.Email}</td><td>${r.Scoin}</td><td>${r.ธนาคาร}<br>${r.บัญชี}</td><td>฿${r.จ่ายสุทธิ.toLocaleString('th-TH')}</td><td>${r.สถานะ}</td><td>${r.วันที่}</td></tr>`).join('');
    document.getElementById('scoinPrintArea').innerHTML = `<div class="print-sheet"><div class="print-head"><div><div class="print-brand">TRADING AVELQUA</div><div class="print-sub">รายการลูกค้าขาย Scoin คืนโฮส</div></div><div class="print-sub">พิมพ์เมื่อ: ${new Date().toLocaleString('th-TH')}</div></div><table class="print-table"><thead><tr><th>ID</th><th>ผู้ใช้</th><th>Scoin</th><th>บัญชีรับเงิน</th><th>จ่ายสุทธิ</th><th>สถานะ</th><th>วันที่</th></tr></thead><tbody>${html}</tbody></table></div>`;
    window.print();
  });

  const modal = document.getElementById('scoinDetailModal');
  const modalBody = document.getElementById('scoinModalBody');

  document.querySelectorAll('.scoin-detail-btn').forEach(btn => {
    btn.addEventListener('click', function(){
      const d = btn.dataset;
      modalBody.innerHTML = [
        ['ID',d.id],['ผู้ขาย',d.name],['Email',d.email],['Scoin',Number(d.scoin||0).toLocaleString('th-TH')],
        ['ราคา/เหรียญ','฿'+Number(d.price||0).toLocaleString('th-TH')],['ยอดก่อนหัก','฿'+Number(d.gross||0).toLocaleString('th-TH')],
        ['ค่าธรรมเนียม','฿'+Number(d.fee||0).toLocaleString('th-TH')],['จ่ายสุทธิ','฿'+Number(d.net||0).toLocaleString('th-TH')],
        ['ธนาคาร',d.bank],['บัญชีรับเงิน',d.account],['สถานะ',d.status],['สถานะจ่าย',d.payout],['วันที่',d.date]
      ].map(x => `<div class="scoin-detail-line"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join('');
      modal.style.display = 'grid';
    });
  });

  document.getElementById('scoinModalClose')?.addEventListener('click', () => modal.style.display = 'none');
  document.getElementById('scoinModalPrint')?.addEventListener('click', () => window.print());
})();
</script>


<%- include('../partials/admin-shell-end') %>
