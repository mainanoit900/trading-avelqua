<%- include('../partials/head', { pageTitle: 'Windows VPS Agent', pageCss: 'admin-panel.css' }) %>
<%- include('../partials/admin-shell') %>

<section class="admin-page">
  <div class="admin-page-header">
    <div>
      <h1>Windows VPS Agent API</h1>
      <p>คัดลอกโค้ดนี้ไปวางใน Windows VPS เพื่อเชื่อมต่อกับระบบ</p>
    </div>
    <a class="btn btn-secondary" href="/admin/vps">กลับหน้า VPS</a>
  </div>

  <div class="admin-card">
    <h3>PowerShell Agent</h3>

    <textarea id="agentCode" style="width:100%;min-height:520px;font-family:Consolas,monospace;border-radius:14px;padding:16px;background:#07111f;color:#d8f3ff;border:1px solid rgba(255,255,255,.15);"><%= script || '' %></textarea>

    <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
      <button class="btn btn-primary" onclick="copyAgent()">Copy Code</button>
      <button class="btn btn-secondary" onclick="location.reload()">Refresh</button>
    </div>
  </div>
</section>

<script>
function copyAgent() {
  const el = document.getElementById('agentCode');
  el.select();
  document.execCommand('copy');
  alert('Copy Agent Code แล้ว');
}
</script>

<%- include('../partials/admin-shell-end') %>
