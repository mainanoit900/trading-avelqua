<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>VPS PORT DASHBOARD</title>

<style>
body {
    background: #0f172a;
    color: #e5e7eb;
    font-family: Arial;
}

.container {
    padding: 20px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.card {
    background: #1e293b;
    border-radius: 12px;
    padding: 15px;
    box-shadow: 0 0 10px #000;
}

.status-running { color: #22c55e; }
.status-stopped { color: #ef4444; }
.status-busy { color: #facc15; }

.btn {
    padding: 6px 10px;
    border-radius: 6px;
    border: none;
    margin: 2px;
    cursor: pointer;
}

.btn-run { background: #22c55e; }
.btn-stop { background: #ef4444; }
.btn-restart { background: #3b82f6; }

.dropzone {
    border: 2px dashed #475569;
    padding: 10px;
    text-align: center;
    margin-top: 10px;
}
</style>

</head>
<body>

<div class="container">
<h2>🚀 VPS PORT DASHBOARD</h2>

<div id="grid" class="grid"></div>

</div>

<script>
const VPS_ID = <%- JSON.stringify(String((typeof vps !== 'undefined' && vps.id) ? vps.id : node.id)) %>;

async function loadDashboard() {
    const res = await fetch(`/admin/vps/${VPS_ID}/ports/api/dashboard`);
    const data = await res.json();

    const grid = document.getElementById('grid');
    grid.innerHTML = '';

    data.ports.forEach(p => {
        const div = document.createElement('div');
        div.className = 'card';

        let statusClass = 'status-stopped';
        if (p.status === 'running') statusClass = 'status-running';
        if (p.busy) statusClass = 'status-busy';

        div.innerHTML = `
            <h3>PORT${p.port}</h3>
            <div class="${statusClass}">${p.status}</div>
            <div>PID: ${p.pid || '-'}</div>
            <div>EA: ${p.mq5_count}</div>
            <div>Busy: ${p.busy}</div>

            <button class="btn btn-run" onclick="action('${p.port}','start')">Start</button>
            <button class="btn btn-stop" onclick="action('${p.port}','stop')">Stop</button>
            <button class="btn btn-restart" onclick="action('${p.port}','restart')">Restart</button>

            <button class="btn" onclick="compile('${p.port}')">Compile</button>
            <button class="btn" onclick="logs('${p.port}')">Logs</button>

            <div class="dropzone"
                ondrop="drop(event,'${p.port}')"
                ondragover="event.preventDefault()">
                📂 Drag .mq5 here
            </div>
        `;

        grid.appendChild(div);
    });
}

async function action(port, act) {
    await fetch(`/admin/vps/${VPS_ID}/ports/api/action`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ port, action: act })
    });
}

async function compile(port) {
    const filename = prompt("ไฟล์ .mq5:");
    if (!filename) return;

    await fetch(`/admin/vps/${VPS_ID}/ports/api/action`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            port,
            action: 'compile',
            filename
        })
    });
}

async function logs(port) {
    const res = await fetch(`/admin/vps/${VPS_ID}/ports/api/action`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            port,
            action: 'logs'
        })
    });

    const data = await res.json();
    alert(JSON.stringify(data, null, 2));
}

function drop(e, port) {
    e.preventDefault();

    const file = e.dataTransfer.files[0];
    const reader = new FileReader();

    reader.onload = async function() {
        const base64 = reader.result.split(',')[1];

        await fetch(`/admin/vps/${VPS_ID}/ports/api/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                port,
                action: 'upload_compile_restart',
                filename: file.name,
                base64
            })
        });

        alert("Upload + Compile + Restart เรียบร้อย");
    };

    reader.readAsDataURL(file);
}

setInterval(loadDashboard, 3000);
loadDashboard();
</script>

</body>
</html>
