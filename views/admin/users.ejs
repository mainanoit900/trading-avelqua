<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const safeUsers = Array.isArray(users) ? users : [];
const safeCounts = counts || { total: 0, active: 0, banned: 0, identity_verified: 0 };
const safeFilters = filters || { q: '', status: '', role: '', identity: '' };
const userPg = typeof pagination !== 'undefined' ? pagination : { currentPage: 1, totalPages: 1, totalRows: 0, pageSize: 15 };
const localeTag = (typeof lang !== 'undefined' && lang === 'en') ? 'en-GB' : 'th-TH';

function userDisplayName(u) {
  return u.identity_full_name || u.full_name || [u.first_name || '', u.last_name || ''].join(' ').trim() || '-';
}

function formatUserDate(value) {
  if (!value) return '-';
  try { return new Date(value).toLocaleDateString(localeTag); }
  catch (e) { return String(value); }
}

function formatUserDateTime(value) {
  if (!value) return '-';
  try { return new Date(value).toLocaleString(localeTag); }
  catch (e) { return String(value); }
}

function usersKeepParams(overrides) {
  const params = new URLSearchParams();
  params.set('q', safeFilters.q || '');
  params.set('status', safeFilters.status || '');
  params.set('role', safeFilters.role || '');
  params.set('identity', safeFilters.identity || '');
  params.set('page', String(userPg.currentPage || 1));
  Object.keys(overrides || {}).forEach(function (key) {
    if (overrides[key] === null || overrides[key] === undefined || overrides[key] === '') {
      params.delete(key);
    } else {
      params.set(key, String(overrides[key]));
    }
  });
  return '/admin/users?' + params.toString();
}

function formatThaiId(value) {
  const digits = String(value || '').replace(/\D/g, '');
  if (digits.length !== 13) return value || '-';
  return `${digits[0]} ${digits.slice(1, 5)} ${digits.slice(5, 10)} ${digits.slice(10, 12)} ${digits[12]}`;
}

function documentTypeLabel(value) {
  if (value === 'passport') return 'พาสปอร์ต';
  if (value === 'thai_id') return 'บัตรประชาชน';
  return value || '-';
}

function userDetailPayload(u) {
  return {
    id: u.display_id || u.id,
    name: userDisplayName(u),
    email: u.email || '-',
    phone: u.identity_phone || u.phone || '-',
    address_line: u.address_line || '-',
    subdistrict: u.subdistrict || '-',
    district: u.district || '-',
    province: u.province || '-',
    postal_code: u.postal_code || '-',
    verify_email: u.verify_email || '-',
    document_type: documentTypeLabel(u.document_type),
    national_id: formatThaiId(u.national_id),
    passport_number: u.passport_number || '-',
    date_of_birth: u.date_of_birth ? formatUserDate(u.date_of_birth) : '-',
    document_expiry_date: u.document_expiry_date ? formatUserDate(u.document_expiry_date) : '-',
    document_image_path: u.document_image_path || '',
    identity_verified: !!u.identity_verified,
    identity_verified_at: u.identity_verified_at ? formatUserDateTime(u.identity_verified_at) : '-',
    package_name: u.active_package_name || '-',
    source_channel: u.source_channel || '-',
    package_end_at: u.package_end_at ? formatUserDateTime(u.package_end_at) : '-',
    role: u.role || 'user',
    provider: u.provider || '-',
    status: u.status || 'active',
    created_at: u.created_at ? formatUserDateTime(u.created_at) : '-',
    last_login_at: u.last_login_at ? formatUserDateTime(u.last_login_at) : '-',
    bank_name: u.bank_name || '-',
    bank_account_name: u.bank_account_name || '-',
    bank_account_number_masked: u.account_number_masked || '-',
    bank_verify_email: u.bank_verify_email || '-',
    bank_status: u.bank_status || 'ยังไม่มีข้อมูล',
    bank_is_verified: !!u.bank_is_verified,
    bank_verified_at: u.bank_verified_at ? formatUserDateTime(u.bank_verified_at) : '-',
    bank_updated_at: u.bank_updated_at ? formatUserDateTime(u.bank_updated_at) : '-',
    edit_url: '/admin/users/' + (u.id || '') + '/edit'
  };
}
%>

<%- include('../partials/admin-shell') %>

<section class="admin-page-section admin-users-page">
  <div class="admin-page-hero">
    <div>
      <div class="admin-page-chip"><%= safeT('admin.users.badge', 'USER MANAGEMENT') %></div>
      <h1><%= safeT('admin.users.title', 'จัดการผู้ใช้งาน') %></h1>
      <p><%= safeT('admin.users.desc', 'ดูข้อมูลผู้ใช้ ค้นหา แก้ไข แบน ลบ และส่งออก Excel ได้จากหน้าเดียว') %></p>
    </div>
  </div>

  <div class="admin-users-kpis">
    <div class="admin-kpi-card">
      <span><%= safeT('admin.users.total', 'ผู้ใช้ทั้งหมด') %></span>
      <strong><%= Number(safeCounts.total || 0).toLocaleString('th-TH') %></strong>
    </div>
    <div class="admin-kpi-card">
      <span><%= safeT('admin.users.active', 'ใช้งานอยู่') %></span>
      <strong><%= Number(safeCounts.active || 0).toLocaleString('th-TH') %></strong>
    </div>
    <div class="admin-kpi-card">
      <span><%= safeT('admin.users.banned', 'ถูกแบน') %></span>
      <strong><%= Number(safeCounts.banned || 0).toLocaleString('th-TH') %></strong>
    </div>
    <div class="admin-kpi-card accent">
      <span><%= safeT('admin.users.identity_verified', 'ยืนยันตัวตนแล้ว') %></span>
      <strong><%= Number(safeCounts.identity_verified || 0).toLocaleString('th-TH') %></strong>
    </div>
  </div>

  <section class="admin-users-card">
    <div class="admin-users-toolbar">
      <form method="GET" action="/admin/users" class="admin-users-filter" id="usersFilterForm">
        <input type="hidden" name="page" value="1">
        <label class="admin-users-filter-field admin-users-filter-search">
          <span><%= safeT('common.search', 'ค้นหา') %></span>
          <input
            type="search"
            name="q"
            value="<%= safeFilters.q || '' %>"
            placeholder="<%= safeT('admin.users.search_placeholder', 'ค้นหา ID / ชื่อ / อีเมล / เบอร์โทร') %>"
          >
        </label>

        <label class="admin-users-filter-field">
          <span><%= safeT('admin.users.status', 'สถานะ') %></span>
          <select name="status">
            <option value=""><%= safeT('admin.users.all_status', 'ทุกสถานะ') %></option>
            <option value="active" <%= safeFilters.status === 'active' ? 'selected' : '' %>>active</option>
            <option value="banned" <%= safeFilters.status === 'banned' ? 'selected' : '' %>>banned</option>
            <option value="disabled" <%= safeFilters.status === 'disabled' ? 'selected' : '' %>>disabled</option>
            <option value="pending_verification" <%= safeFilters.status === 'pending_verification' ? 'selected' : '' %>>pending_verification</option>
          </select>
        </label>

        <label class="admin-users-filter-field">
          <span>Role</span>
          <select name="role">
            <option value=""><%= safeT('admin.users.all_roles', 'ทุกสิทธิ์') %></option>
            <option value="user" <%= safeFilters.role === 'user' ? 'selected' : '' %>>user</option>
            <option value="admin" <%= safeFilters.role === 'admin' ? 'selected' : '' %>>admin</option>
          </select>
        </label>

        <label class="admin-users-filter-field">
          <span><%= safeT('admin.users.identity', 'ยืนยันตัวตน') %></span>
          <select name="identity">
            <option value=""><%= safeT('admin.users.all_identity', 'ยืนยันตัวตนทั้งหมด') %></option>
            <option value="verified" <%= safeFilters.identity === 'verified' ? 'selected' : '' %>><%= safeT('admin.users.identity_done', 'ยืนยันแล้ว') %></option>
            <option value="pending" <%= safeFilters.identity === 'pending' ? 'selected' : '' %>><%= safeT('admin.users.identity_pending', 'ยังไม่ยืนยัน') %></option>
          </select>
        </label>

        <div class="admin-users-filter-actions">
          <button type="submit" class="btn btn-primary"><%= safeT('common.search', 'ค้นหา') %></button>
          <a href="/admin/users" class="btn btn-secondary"><%= safeT('common.reset', 'ล้างค่า') %></a>
        </div>
      </form>

      <div class="admin-users-actions">
        <a
          href="/admin/users/export.xlsx?<%= new URLSearchParams({
            q: safeFilters.q || '',
            status: safeFilters.status || '',
            role: safeFilters.role || '',
            identity: safeFilters.identity || ''
          }).toString() %>"
          class="btn btn-excel"
        >
          <span>📗</span>
          <span><%= safeT('admin.users.export_excel', 'Export Excel') %></span>
        </a>
      </div>
    </div>

    <div class="admin-users-result-meta">
      แสดง <%= safeUsers.length %> รายการ · หน้า <%= userPg.currentPage || 1 %>/<%= userPg.totalPages || 1 %> · ทั้งหมด <%= Number(userPg.totalRows || 0).toLocaleString('th-TH') %> คน
    </div>

    <% if (!safeUsers.length) { %>
      <div class="admin-users-empty"><%= safeT('admin.users.empty', 'ยังไม่พบข้อมูลผู้ใช้') %></div>
    <% } else { %>
      <div class="admin-users-table-wrap">
        <table class="admin-users-table admin-users-table-compact">
          <thead>
            <tr>
              <th><%= safeT('admin.users.member', 'สมาชิก') %></th>
              <th><%= safeT('admin.users.package', 'แพ็กเกจ') %></th>
              <th><%= safeT('admin.users.status', 'สถานะ') %></th>
              <th><%= safeT('admin.users.created_at', 'สมัคร') %></th>
              <th><%= safeT('common.actions', 'จัดการ') %></th>
            </tr>
          </thead>
          <tbody>
            <% safeUsers.forEach(function (u) {
              const displayName = userDisplayName(u);
              const detailJson = JSON.stringify(userDetailPayload(u)).replace(/</g, '\\u003c');
            %>
              <tr>
                <td>
                  <div class="user-cell-main">
                    <strong class="user-cell-name" title="<%= displayName %>"><%= displayName %></strong>
                    <div class="user-cell-sub">#<%= u.display_id || u.id %></div>
                    <div class="user-cell-email" title="<%= u.email || '-' %>"><%= u.email || '-' %></div>
                    <div class="user-cell-phone"><%= u.identity_phone || u.phone || '-' %></div>
                  </div>
                </td>
                <td>
                  <div class="user-cell-package" title="<%= u.active_package_name || '-' %>"><%= u.active_package_name || '-' %></div>
                  <div class="user-cell-sub"><%= u.source_channel || u.provider || '-' %></div>
                </td>
                <td>
                  <div class="user-pill-stack">
                    <span class="pill role <%= u.role === 'admin' ? 'admin' : 'user' %>"><%= u.role || 'user' %></span>
                    <span class="pill status <%= u.status === 'banned' ? 'banned' : (u.status === 'active' ? 'active' : 'other') %>"><%= u.status || 'active' %></span>
                    <% if (u.identity_verified) { %>
                      <span class="pill verify yes"><%= safeT('admin.users.identity_done', 'ยืนยันแล้ว') %></span>
                    <% } else { %>
                      <span class="pill verify no"><%= safeT('admin.users.identity_pending', 'ยังไม่ยืนยัน') %></span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div><%= formatUserDate(u.created_at) %></div>
                  <div class="user-cell-sub"><%= u.last_login_at ? ('ล่าสุด ' + formatUserDate(u.last_login_at)) : 'ยังไม่ login' %></div>
                </td>
                <td>
                  <%- include('./partials/user-actions-dropdown', { user: u, detailJson: detailJson }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="admin-users-mobile-list">
        <% safeUsers.forEach(function (u) {
          const displayName = userDisplayName(u);
          const detailJson = JSON.stringify(userDetailPayload(u)).replace(/</g, '\\u003c');
        %>
          <article class="admin-users-mobile-card">
            <div class="admin-users-mobile-head">
              <div>
                <strong><%= displayName %></strong>
                <div class="user-cell-sub">#<%= u.display_id || u.id %> · <%= u.email || '-' %></div>
              </div>
              <span class="pill status <%= u.status === 'banned' ? 'banned' : (u.status === 'active' ? 'active' : 'other') %>"><%= u.status || 'active' %></span>
            </div>
            <div class="admin-users-mobile-meta">
              <span><%= u.active_package_name || '-' %></span>
              <span><%= u.identity_phone || u.phone || '-' %></span>
              <span><%= formatUserDate(u.created_at) %></span>
            </div>
            <div class="user-pill-stack">
              <span class="pill role <%= u.role === 'admin' ? 'admin' : 'user' %>"><%= u.role || 'user' %></span>
              <% if (u.identity_verified) { %>
                <span class="pill verify yes"><%= safeT('admin.users.identity_done', 'ยืนยันแล้ว') %></span>
              <% } else { %>
                <span class="pill verify no"><%= safeT('admin.users.identity_pending', 'ยังไม่ยืนยัน') %></span>
              <% } %>
            </div>
            <div class="admin-users-mobile-actions">
              <%- include('./partials/user-actions-dropdown', { user: u, detailJson: detailJson, toggleLabel: 'จัดการ ▾' }) %>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="users-pagination">
        <div class="users-pagination-info">หน้า <%= userPg.currentPage || 1 %> / <%= userPg.totalPages || 1 %></div>
        <div class="users-pagination-actions">
          <% if ((userPg.currentPage || 1) > 1) { %>
            <a class="users-page-btn" href="<%= usersKeepParams({ page: (userPg.currentPage || 1) - 1 }) %>">ก่อนหน้า</a>
          <% } else { %>
            <span class="users-page-btn is-disabled">ก่อนหน้า</span>
          <% } %>
          <% if ((userPg.currentPage || 1) < (userPg.totalPages || 1)) { %>
            <a class="users-page-btn" href="<%= usersKeepParams({ page: (userPg.currentPage || 1) + 1 }) %>">ถัดไป</a>
          <% } else { %>
            <span class="users-page-btn is-disabled">ถัดไป</span>
          <% } %>
        </div>
      </div>
    <% } %>
  </section>
</section>

