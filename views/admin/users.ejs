                <path d="M5 10V19M9 10V19M15 10V19M19 10V19"/>
                <path d="M4 19h16"/>
                <path d="M12 3 3 7h18l-9-4z"/>
              </svg>
            </span>
            <div>
              <h3>บัญชีธนาคาร</h3>
              <p id="detail-bank-status">-</p>
            </div>
          </div>
          <div class="user-detail-fields">
            <div class="user-detail-field"><span>ธนาคาร</span><strong id="detail-bank-name">-</strong></div>
            <div class="user-detail-field"><span>ชื่อบัญชี</span><strong id="detail-bank-account-name">-</strong></div>
            <div class="user-detail-field"><span>เลขบัญชี</span><strong id="detail-bank-account-number">-</strong></div>
            <div class="user-detail-field"><span>อีเมลยืนยัน</span><strong id="detail-bank-verify-email">-</strong></div>
            <div class="user-detail-field"><span>ยืนยันเมื่อ</span><strong id="detail-bank-verified-at">-</strong></div>
            <div class="user-detail-field"><span>อัปเดตล่าสุด</span><strong id="detail-bank-updated-at">-</strong></div>
          </div>
        </section>
      </div>
    </div>

    <div class="user-detail-footer">
      <a href="#" class="user-detail-btn secondary" id="detail-edit-link">อัปเดตข้อมูล</a>
      <button type="button" class="user-detail-btn primary" onclick="closeUserDetail()">ปิด</button>
    </div>
  </div>
</div>

<script>
  function setDetailText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value || '-';
  }

  function userInitials(name) {
    const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return 'U';
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function openUserDetail(user) {
    setDetailText('detail-name', user.name);
    setDetailText('detail-email', user.email);
    setDetailText('detail-id-label', '#' + (user.id || '-'));
    setDetailText('detail-phone', user.phone);
    setDetailText('detail-address-line', user.address_line);
    setDetailText('detail-subdistrict', user.subdistrict);
    setDetailText('detail-district', user.district);
    setDetailText('detail-province', user.province);
    setDetailText('detail-postal-code', user.postal_code);
    setDetailText('detail-verify-email', user.verify_email);
    setDetailText('detail-document-type', user.document_type);
    setDetailText('detail-national-id', user.national_id);
    setDetailText('detail-passport-number', user.passport_number);
    setDetailText('detail-date-of-birth', user.date_of_birth);
    setDetailText('detail-document-expiry', user.document_expiry_date);
    setDetailText('detail-identity-verified-at', user.identity_verified_at);
    setDetailText('detail-package-name', user.package_name);
    setDetailText('detail-source-channel', user.source_channel);
    setDetailText('detail-package-end-at', user.package_end_at);
    setDetailText('detail-provider', user.provider);
    setDetailText('detail-created-at', user.created_at);
    setDetailText('detail-last-login-at', user.last_login_at);
    setDetailText('detail-bank-name', user.bank_name);
    setDetailText('detail-bank-account-name', user.bank_account_name);
    setDetailText('detail-bank-account-number', user.bank_account_number_masked);
    setDetailText('detail-bank-verify-email', user.bank_verify_email);
    setDetailText('detail-bank-verified-at', user.bank_verified_at);
    setDetailText('detail-bank-updated-at', user.bank_updated_at);

    const avatar = document.getElementById('detail-avatar');
    if (avatar) avatar.textContent = userInitials(user.name);

    const roleBadge = document.getElementById('detail-role-badge');
    if (roleBadge) {
      roleBadge.textContent = user.role || 'user';
      roleBadge.className = 'user-detail-badge role ' + (user.role === 'admin' ? 'is-admin' : 'is-user');
    }

    const statusBadge = document.getElementById('detail-status-badge');
    if (statusBadge) {
      statusBadge.textContent = user.status || 'active';
      statusBadge.className = 'user-detail-badge status ' + (user.status === 'banned' ? 'is-banned' : (user.status === 'active' ? 'is-active' : 'is-other'));
    }

    const identityBadge = document.getElementById('detail-identity-badge');
    if (identityBadge) {
      identityBadge.textContent = user.identity_verified ? 'ยืนยันแล้ว' : 'ยังไม่ยืนยัน';
      identityBadge.className = 'user-detail-badge identity ' + (user.identity_verified ? 'is-verified' : 'is-pending');
    }

    const bankStatus = document.getElementById('detail-bank-status');
    if (bankStatus) {
      bankStatus.textContent = user.bank_is_verified ? 'ยืนยันบัญชีแล้ว' : (user.bank_status || 'ยังไม่ยืนยัน');
    }

    const docImg = document.getElementById('detail-document-image');
    const docEmpty = document.getElementById('detail-document-empty');
    const imagePath = String(user.document_image_path || '').replace(/^\/+/, '');
    if (docImg && docEmpty) {
      if (imagePath) {
        docImg.src = '/' + imagePath;
        docImg.hidden = false;
        docEmpty.hidden = true;
      } else {
        docImg.removeAttribute('src');
        docImg.hidden = true;
        docEmpty.hidden = false;
      }
    }

    const editLink = document.getElementById('detail-edit-link');
    if (editLink) editLink.href = user.edit_url || '#';

    document.getElementById('userDetailModal').classList.add('show');
    document.body.classList.add('modal-open');
  }

  function closeUserDetail() {
    document.getElementById('userDetailModal').classList.remove('show');
    document.body.classList.remove('modal-open');
  }

  document.addEventListener('click', function (e) {
    const toggle = e.target.closest('.user-action-toggle');

    function resetUserActionDropdown(menu) {
      menu.classList.remove('open');
      const dropdown = menu.querySelector('.user-action-dropdown');
      if (!dropdown) return;
      dropdown.classList.remove('is-fixed');
      dropdown.style.display = '';
      dropdown.style.position = '';
      dropdown.style.top = '';
      dropdown.style.left = '';
      dropdown.style.right = '';
      dropdown.style.bottom = '';
      dropdown.style.minWidth = '';
    }

    function positionUserActionDropdown(menu, button) {
      const dropdown = menu.querySelector('.user-action-dropdown');
      if (!dropdown) return;
      dropdown.classList.add('is-fixed');
      dropdown.style.display = 'grid';
      dropdown.style.position = 'fixed';
      dropdown.style.right = 'auto';
      dropdown.style.bottom = 'auto';
      dropdown.style.minWidth = '196px';

      const rect = button.getBoundingClientRect();
      const width = dropdown.offsetWidth || 196;
      const height = dropdown.offsetHeight || 220;
      let left = rect.right - width;
      let top = rect.bottom + 6;

      left = Math.max(8, Math.min(left, window.innerWidth - width - 8));
      if (top + height > window.innerHeight - 8) {
        top = Math.max(8, rect.top - height - 6);
      }

      dropdown.style.left = left + 'px';
      dropdown.style.top = top + 'px';
    }

    document.querySelectorAll('.user-action-menu.open').forEach(function (menu) {
      if (!menu.contains(e.target)) resetUserActionDropdown(menu);
    });

    if (toggle) {
      e.preventDefault();
      e.stopPropagation();
      const menu = toggle.closest('.user-action-menu');
      const willOpen = !menu.classList.contains('open');
      document.querySelectorAll('.user-action-menu.open').forEach(function (other) {
        if (other !== menu) resetUserActionDropdown(other);
      });
      if (willOpen) {
        menu.classList.add('open');
        positionUserActionDropdown(menu, toggle);
      } else {
        resetUserActionDropdown(menu);
      }
    }
  });

  window.addEventListener('resize', function () {
    document.querySelectorAll('.user-action-menu.open').forEach(function (menu) {
      const toggle = menu.querySelector('.user-action-toggle');
      if (toggle) {
        const dropdown = menu.querySelector('.user-action-dropdown');
        if (dropdown && dropdown.classList.contains('is-fixed')) {
          const rect = toggle.getBoundingClientRect();
          const width = dropdown.offsetWidth || 196;
          const height = dropdown.offsetHeight || 220;
          let left = rect.right - width;
          let top = rect.bottom + 6;
          left = Math.max(8, Math.min(left, window.innerWidth - width - 8));
          if (top + height > window.innerHeight - 8) {
            top = Math.max(8, rect.top - height - 6);
          }
          dropdown.style.left = left + 'px';
          dropdown.style.top = top + 'px';
        }
      }
    });
  });
</script>

<%- include('../partials/admin-shell-end') %>
