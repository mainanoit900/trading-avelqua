<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const safeSite = typeof site !== 'undefined' && site ? site : {};
const brandName = safeSite.brandName || 'TRADING AVELQUA';
const langNow = (typeof lang !== 'undefined' && lang) ? lang : 'th';
const resetToken = (typeof token !== 'undefined' && token) ? token : '';
%>

<!DOCTYPE html>
<html lang="<%= langNow %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="icon" type="image/x-icon" href="/public/favicon.ico?v=2">
<link rel="shortcut icon" href="/public/favicon.ico?v=2">
<link rel="apple-touch-icon" href="/public/favicon.ico?v=2">

<link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title><%= safeT('reset.title', 'ตั้งรหัสผ่านใหม่') %> | <%= brandName %></title>
  <link rel="stylesheet" href="/public/css/auth.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-logo-wrap">
        <img src="/public/images/logo.png" alt="<%= brandName %>" class="auth-logo">
      </div>

      <h1 class="auth-title"><%= safeT('reset.title', 'ตั้งรหัสผ่านใหม่') %></h1>
      <p class="auth-sub"><%= safeT('reset.desc', 'กรอกรหัสผ่านใหม่ด้านล่าง') %></p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="auth-alert auth-alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="auth-alert auth-alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/reset-password" class="auth-form">
        <input type="hidden" name="token" value="<%= resetToken %>">

        <div class="auth-group auth-password">
          <label class="auth-label"><%= safeT('register.password', 'รหัสผ่าน') %></label>
          <input
            type="password"
            id="resetPassword"
            name="password"
            class="auth-input"
            placeholder="<%= safeT('reset.title', 'ตั้งรหัสผ่านใหม่') %>"
            required
          >
          <button
            type="button"
            class="toggle-pass"
            onclick="toggleResetPass()"
            aria-label="<%= safeT('register.toggle_password', 'แสดงหรือซ่อนรหัสผ่าน') %>"
          >👁</button>
        </div>

        <button type="submit" class="auth-btn">
          <%= safeT('reset.submit', 'บันทึกรหัสผ่านใหม่') %>
        </button>
      </form>

      <div class="auth-register-text">
        <a href="/login"><%= safeT('nav.login', 'เข้าสู่ระบบ') %></a>
      </div>

      <div class="auth-back-home">
              </div>
    </div>
  </div>

  <script>
    function toggleResetPass() {
      const input = document.getElementById('resetPassword');
      if (!input) return;
      input.type = input.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>