<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const safeSite = typeof site !== 'undefined' && site ? site : {};
const brandName = safeSite.brandName || 'TRADING AVELQUA';
const langNow = (typeof lang !== 'undefined' && lang) ? lang : 'th';
const safeError = typeof error !== 'undefined' ? error : '';
const safeSuccess = typeof success !== 'undefined' ? success : '';
const localeList = (typeof supportedLocales !== 'undefined' && supportedLocales) ? supportedLocales : ['th', 'en', 'lo', 'vi', 'my'];
const labelsMap = (typeof localeLabels !== 'undefined' && localeLabels) ? localeLabels : { th: 'ไทย', en: 'EN', lo: 'LO', vi: 'VI', my: 'MY' };
const langShort = { th: 'TH', en: 'EN', lo: 'LO', vi: 'VI', my: 'MY' };
const cssVer = '7';
%>

<!DOCTYPE html>
<html lang="<%= langNow %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050a14">
  <link rel="icon" type="image/x-icon" href="/public/favicon.ico?v=2">
  <link rel="shortcut icon" href="/public/favicon.ico?v=2">
  <link rel="apple-touch-icon" href="/public/favicon.ico?v=2">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <title><%= safeT('login.title', 'เข้าสู่ระบบ') %> | <%= brandName %></title>
  <link rel="stylesheet" href="/public/css/login.css?v=<%= cssVer %>">
</head>
<body>
  <div class="login-page">
    <div class="login-bg-glow login-bg-glow-a"></div>
    <div class="login-bg-glow login-bg-glow-b"></div>

    <div class="login-frame">
      <header class="login-toolbar">
        <a href="/?lang=<%= langNow %>" class="login-toolbar-brand">
          <img src="/public/images/logo.png" alt="<%= brandName %>" width="36" height="36">
          <span><%= brandName %></span>
        </a>
        <div class="login-lang-dropdown" id="loginLangDropdown">
          <button type="button" class="login-lang-trigger" aria-expanded="false" aria-haspopup="listbox" aria-label="Language">
            <span class="login-lang-trigger-label"><%= labelsMap[langNow] || langNow.toUpperCase() %></span>
            <span class="login-lang-caret" aria-hidden="true">▾</span>
          </button>
          <div class="login-lang-menu" role="listbox">
            <% localeList.forEach(function(code) { %>
              <a
                href="/set-language/<%= code %>?redirect=/login"
                class="login-lang-option <%= langNow === code ? 'active' : '' %>"
                role="option"
              >
                <span><%= labelsMap[code] || code.toUpperCase() %></span>
                <small><%= langShort[code] || String(code).toUpperCase() %></small>
              </a>
            <% }) %>
          </div>
        </div>
      </header>

      <div class="login-layout">
        <section class="login-visual" aria-hidden="false">
          <div class="login-visual-art">
            <div class="login-visual-ring"></div>
            <img src="/public/images/logo.png" alt="" class="login-visual-logo">
          </div>

          <div class="login-visual-copy">
            <p class="login-eyebrow"><%= safeT('login.badge', 'SECURE LOGIN') %></p>
            <h1><%= safeT('login.hero_title', 'เข้าสู่ระบบเพื่อจัดการทุกอย่างในที่เดียว') %></h1>
            <p class="login-lead"><%= safeT('login.desc', 'เข้าสู่ระบบเพื่อจัดการพอร์ต ดูแพ็กเกจ และติดตามผลการใช้งานทั้งหมดในระบบเดียว') %></p>
          </div>

          <ul class="login-features">
            <li>
              <span class="login-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 4-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <strong><%= safeT('login.feature_1_title', 'จัดการพอร์ต MT5') %></strong>
                <span><%= safeT('login.feature_1_desc', 'เชื่อมต่อ รันบอท และติดตามผลแบบเรียลไทม์') %></span>
              </div>
            </li>
            <li>
              <span class="login-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4zM4 11h16M8 15h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <strong><%= safeT('login.feature_2_title', 'กระเป๋า Scoin') %></strong>
                <span><%= safeT('login.feature_2_desc', 'ซื้อ ขาย โอน และดูประวัติธุรกรรมได้ครบ') %></span>
              </div>
            </li>
            <li>
              <span class="login-feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <strong><%= safeT('login.feature_3_title', 'ปลอดภัยและทันสมัย') %></strong>
                <span><%= safeT('login.feature_3_desc', 'รองรับอีเมล Google และ LINE ใช้งานได้ทุกอุปกรณ์') %></span>
              </div>
            </li>
          </ul>

          <p class="login-visual-foot">© <%= new Date().getFullYear() %> <%= brandName %></p>
        </section>

        <section class="login-panel">
          <div class="login-panel-inner">
            <header class="login-panel-head">
              <p class="login-panel-eyebrow"><%= safeT('login.customer_portal', 'Customer Portal') %></p>
              <h2><%= safeT('login.title', 'เข้าสู่ระบบ') %></h2>
              <p><%= safeT('login.form_desc', 'กรอกอีเมลและรหัสผ่าน หรือเลือกเข้าสู่ระบบด้วย Google / LINE') %></p>
            </header>

            <% if (safeError) { %>
              <div class="login-alert error"><%= safeError %></div>
            <% } %>

            <% if (safeSuccess) { %>
              <div class="login-alert success"><%= safeSuccess %></div>
            <% } %>

            <form method="POST" action="/login" class="login-form">
              <div class="login-field">
                <label for="loginEmail"><%= safeT('common.email', 'อีเมล') %></label>
                <input
                  id="loginEmail"
                  type="email"
                  name="email"
                  class="login-input"
                  placeholder="<%= safeT('login.email_placeholder', 'กรอกอีเมล') %>"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="login-field">
                <div class="login-field-top">
                  <label for="password"><%= safeT('login.password', 'รหัสผ่าน') %></label>
                  <a class="login-forgot" href="/forgot-password"><%= safeT('forgot.title', 'ลืมรหัสผ่าน') %></a>
                </div>
                <div class="login-password-wrap">
                  <input
                    type="password"
                    id="password"
                    name="password"
                    class="login-input login-input-password"
                    placeholder="<%= safeT('login.password_placeholder', 'กรอกรหัสผ่าน') %>"
                    autocomplete="current-password"
                    required
                  >
                  <button
                    type="button"
                    class="login-password-toggle"
                    onclick="togglePass()"
                    aria-label="<%= safeT('register.toggle_password', 'แสดงหรือซ่อนรหัสผ่าน') %>"
                  >
                    <span id="passwordToggleText"><%= safeT('login.show_password', 'แสดง') %></span>
                  </button>
                </div>
              </div>

              <button type="submit" class="login-submit">
                <%= safeT('nav.login', 'เข้าสู่ระบบ') %>
              </button>
            </form>

            <div class="login-divider"><span><%= safeT('login.social', 'หรือเข้าสู่ระบบด้วย') %></span></div>

            <div class="login-social-grid">
              <a href="/auth/google" class="login-social-btn">
                <span class="login-social-icon">
                  <img src="/public/images/google.png" alt="Google" width="32" height="32">
                </span>
                <span class="login-social-label">Google</span>
              </a>
              <a href="/auth/line" class="login-social-btn login-social-line">
                <span class="login-social-icon login-social-icon-line">
                  <img src="/public/images/line.png" alt="LINE" width="48" height="48">
                </span>
                <span class="login-social-label">LINE</span>
              </a>
            </div>

            <p class="login-footer">
              <%= safeT('login.no_account', 'ยังไม่มีบัญชี?') %>
              <a href="/register"><%= safeT('nav.register', 'สมัครใช้งาน') %></a>
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script>
    const PW_SHOW = "<%= safeT('login.show_password', 'แสดง') %>";
    const PW_HIDE = "<%= safeT('login.hide_password', 'ซ่อน') %>";

    function togglePass() {
      const input = document.getElementById('password');
      const text = document.getElementById('passwordToggleText');
      if (!input || !text) return;
      if (input.type === 'password') {
        input.type = 'text';
        text.textContent = PW_HIDE;
      } else {
        input.type = 'password';
        text.textContent = PW_SHOW;
      }
    }

    (function initLoginLangDropdown() {
      const root = document.getElementById('loginLangDropdown');
      if (!root) return;
      const trigger = root.querySelector('.login-lang-trigger');
      const menu = root.querySelector('.login-lang-menu');
      if (!trigger || !menu) return;

      function closeMenu() {
        root.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }

      function openMenu() {
        root.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }

      trigger.addEventListener('click', function (event) {
        event.stopPropagation();
        if (root.classList.contains('open')) closeMenu();
        else openMenu();
      });

      document.addEventListener('click', function () {
        closeMenu();
      });

      menu.addEventListener('click', function (event) {
        event.stopPropagation();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeMenu();
      });
    })();
  </script>
</body>
</html>
