    </main>
  </div>
  <script>
    (function () {
      const menuBtn = document.getElementById('portalMenuBtn');
      const sidebar = document.getElementById('portalSidebar');
      const shell = document.querySelector('.portal-shell.premium');

      if (menuBtn && sidebar) {
        menuBtn.addEventListener('click', function () {
          const open = sidebar.classList.toggle('open');
          if (shell) shell.classList.toggle('sidebar-open', open);
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        document.addEventListener('click', function (e) {
          if (!sidebar.classList.contains('open')) return;
          if (sidebar.contains(e.target) || menuBtn.contains(e.target)) return;
          sidebar.classList.remove('open');
          if (shell) shell.classList.remove('sidebar-open');
          menuBtn.setAttribute('aria-expanded', 'false');
        });
      }

      const identityVerified = !!(window.__AVELQUA_IDENTITY__ && window.__AVELQUA_IDENTITY__.verified);
      if (!identityVerified) {
        document.body.classList.add('identity-not-verified');
        document.querySelectorAll('[data-requires-identity="1"]').forEach(function (link) {
          link.addEventListener('click', function (e) {
            e.preventDefault();
            if (typeof window.openIdentityGateModal === 'function') {
              window.openIdentityGateModal();
              return;
            }
            window.location.href = '/app?showIdentityGate=1';
          });
        });
      }
    })();
  </script>
  <%- include('./session-idle-guard') %>
  <%- include('./ai-chat-widget') %>
</body>
</html>
