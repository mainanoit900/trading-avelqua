<link rel="stylesheet" href="/public/css/ai-chat.css?v=202606080">

<style>
  /* ai-chat-widget scoped styles */
  .ta-ai-chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 2147483000;
    pointer-events: none;
  }

  .ta-ai-chat-toggle,
  .ta-ai-chat-box {
    pointer-events: auto;
  }

  .ta-ai-chat-toggle {
    position: relative;
    z-index: 2;
    width: 200px;
    height: 200px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    box-shadow: none;
    border-radius: 0;
    animation: taAiBounce 2.2s ease-in-out infinite;
    touch-action: none;
  }

  .ta-ai-chat-toggle.dragging {
    animation: none;
    cursor: grabbing;
  }

  .ta-ai-chat-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .ta-ai-chat-box {
    width: 360px;
    max-width: calc(100vw - 24px);
    height: 672px;
    max-height: min(672px, calc(100vh - 220px));
    background: #fff !important;
    color: #0f172a !important;
    border-radius: 18px;
    position: absolute;
    z-index: 1;
    bottom: calc(100% + 12px);
    right: 0;
    left: auto;
    top: auto;
    display: none;
    grid-template-rows: auto minmax(0, 1fr) auto;
    box-shadow: 0 22px 60px rgba(0,0,0,0.25);
    overflow: hidden;
    border: 1px solid #dbe4f0;
  }

  .ta-ai-chat-box.is-below {
    bottom: auto;
    top: calc(100% + 12px);
  }

  .ta-ai-chat-box.is-align-left {
    right: auto;
    left: 0;
  }

  .ta-ai-chat-box.open {
    display: grid;
    height: 672px;
    max-height: min(672px, calc(100vh - 220px));
  }

  .ta-ai-chat-header {
    grid-row: 1;
    flex: 0 0 auto;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    padding: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ta-ai-chat-header strong {
    color: #fff;
    font-size: 18px;
  }

  .ta-ai-chat-header button {
    border: none;
    background: transparent;
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .ta-ai-chat-body {
    grid-row: 2;
    min-height: 0;
    overflow: hidden;
    position: relative;
    background: #f8fafc;
  }

  .ta-ai-chat-messages {
    height: 100%;
    max-height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 12px;
    background: #f8fafc !important;
    color: #0f172a !important;
  }

  .ta-ai-chat-footer {
    grid-row: 3;
    flex: 0 0 auto;
    background: #fff !important;
    border-top: 1px solid #e5e7eb;
  }

  .ta-ai-msg {
    margin-bottom: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    max-width: 80%;
    line-height: 1.45;
    word-break: break-word;
    font-size: 14px !important;
  }

  .ta-ai-msg-user {
    background: #2563eb !important;
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    margin-left: auto;
  }

  .ta-ai-msg-bot {
    background: #e5e7eb !important;
    color: #111827 !important;
    -webkit-text-fill-color: #111827 !important;
    border: 1px solid #d1d5db !important;
    max-width: 92%;
  }

  .ta-ai-msg-bot a {
    color: #1d4ed8 !important;
    -webkit-text-fill-color: #1d4ed8 !important;
    text-decoration: underline;
    word-break: break-all;
  }

  .ta-ai-msg-bot .ta-ai-msg-line {
    margin: 0 0 6px;
    line-height: 1.55;
  }

  .ta-ai-msg-bot .ta-ai-msg-line:last-child {
    margin-bottom: 0;
  }

  .ta-ai-msg-gap {
    height: 8px;
  }

  .ta-ai-msg-bullet {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .ta-ai-msg-bullet-mark {
    flex: 0 0 auto;
    min-width: 1.1em;
    font-weight: 700;
  }

  .ta-ai-msg-heading {
    font-weight: 700;
    color: #0f172a !important;
    -webkit-text-fill-color: #0f172a !important;
    margin-top: 2px;
  }

  .ta-ai-msg-image {
    display: block;
    max-width: 100%;
    max-height: 180px;
    border-radius: 10px;
    margin-top: 6px;
    object-fit: contain;
    background: #fff;
  }

  .ta-ai-chat-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px 0;
    background: #fff !important;
  }

  .ta-ai-chat-attach {
    width: 38px;
    height: 38px;
    border: 1px solid #cbd5e1 !important;
    border-radius: 10px;
    background: #f8fafc !important;
    color: #334155 !important;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    flex: 0 0 38px;
  }

  .ta-ai-chat-attach:hover {
    background: #eef2ff !important;
    border-color: #93c5fd !important;
  }

  .ta-ai-chat-pending {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 0 12px 8px;
    background: #fff !important;
    color: #475569 !important;
    font-size: 12px;
  }

  .ta-ai-chat-pending.show {
    display: flex;
  }

  .ta-ai-chat-pending img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
  }

  .ta-ai-chat-pending button {
    border: none;
    background: transparent;
    color: #64748b !important;
    cursor: pointer;
    font-size: 16px;
  }

  .ta-ai-chat-form {
    display: flex;
    align-items: stretch;
    border-top: 1px solid #ddd;
    background: #ffffff;
  }

.ta-ai-chat-form input,
.ta-ai-chat-form input[type="text"],
#taAiChatInput {
  flex: 1;
  border: none !important;
  padding: 12px !important;
  font-size: 14px;
  color: #111827 !important;
  -webkit-text-fill-color: #111827 !important;
  background: #ffffff !important;
  outline: none;
  box-shadow: none !important;
}

.ta-ai-chat-form input::placeholder,
.ta-ai-chat-form input[type="text"]::placeholder,
#taAiChatInput::placeholder {
  color: #94a3b8 !important;
  opacity: 1 !important;
}

.ta-ai-chat-form button {
  border: none;
  background: #2563eb;
  color: #fff !important;
  padding: 0 18px;
  font-weight: 700;
  cursor: pointer;
}

  .ta-ai-chat-form button {
    border: none;
    background: #2563eb;
    color: #fff;
    padding: 0 18px;
    font-weight: 700;
    cursor: pointer;
  }

  .ta-ai-typing {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ta-ai-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #64748b;
    display: inline-block;
    animation: taAiTyping 1.1s infinite ease-in-out;
  }

  .ta-ai-typing span:nth-child(2) { animation-delay: 0.15s; }
  .ta-ai-typing span:nth-child(3) { animation-delay: 0.30s; }

  @keyframes taAiBounce {
    0% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
    100% { transform: translateY(0); }
  }

  @keyframes taAiTyping {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  @media (max-width: 640px) {
    .ta-ai-chat {
      right: 12px;
      bottom: 12px;
    }

    .ta-ai-chat-toggle {
      width: 140px;
      height: 140px;
    }

    .ta-ai-chat-box,
    .ta-ai-chat-box.open {
      width: calc(100vw - 24px);
      max-width: 360px;
      height: min(588px, calc(100vh - 180px));
      max-height: min(588px, calc(100vh - 180px));
    }
  }
</style>

<%
  const chatTitle = typeof t === 'function' ? t('ai.title', 'Support Chat 24h.') : 'Support Chat 24h.';
  const chatWelcome = typeof t === 'function' ? t('ai.welcome', '👋 สวัสดีค่ะ มีอะไรให้ช่วยได้บ้างคะ') : '👋 สวัสดีค่ะ มีอะไรให้ช่วยได้บ้างคะ';
  const chatPlaceholder = typeof t === 'function' ? t('ai.placeholder', 'พิมพ์ข้อความ...') : 'พิมพ์ข้อความ...';
  const chatSend = typeof t === 'function' ? t('ai.send', 'ส่ง') : 'ส่ง';
  const chatTypingText = typeof t === 'function' ? t('ai.typing_status', 'กำลังพิมพ์...') : 'กำลังพิมพ์...';
  const chatOnline = typeof t === 'function' ? t('ai.online', 'online') : 'online';
  const chatConnectError = typeof t === 'function' ? t('ai.connect_error', 'ขออภัยค่ะ ระบบไม่สามารถเชื่อมต่อได้ในขณะนี้') : 'ขออภัยค่ะ ระบบไม่สามารถเชื่อมต่อได้ในขณะนี้';
  const chatReplyError = typeof t === 'function' ? t('ai.reply_error', 'ขออภัยค่ะ ระบบไม่สามารถตอบได้ในขณะนี้') : 'ขออภัยค่ะ ระบบไม่สามารถตอบได้ในขณะนี้';
  const chatAttachLabel = typeof t === 'function' ? t('ai.attach', 'แนบรูป') : 'แนบรูป';
  const chatUser = (typeof user !== 'undefined' && user && user.id)
    ? user
    : ((typeof currentUser !== 'undefined' && currentUser && currentUser.id) ? currentUser : null);
  const chatLoggedIn = !!chatUser;
%>

<div class="ta-ai-chat" id="taAiChat">
  <button class="ta-ai-chat-toggle" id="taAiChatToggle" type="button" aria-label="<%= chatTitle %>">
    <img src="/public/images/ai-chat-icon.png" class="ta-ai-chat-icon" alt="<%= chatTitle %>">
  </button>

  <div class="ta-ai-chat-box" id="taAiChatBox">
    <div class="ta-ai-chat-header">
      <strong><%= chatTitle %></strong>
      <button id="taAiChatClose" type="button">×</button>
    </div>

    <div class="ta-ai-chat-body">
      <div class="ta-ai-chat-messages" id="taAiChatMessages">
        <div class="ta-ai-msg ta-ai-msg-bot"><%= chatWelcome %></div>
      </div>
    </div>

    <div class="ta-ai-chat-footer">
      <div class="ta-ai-chat-pending" id="taAiChatPending">
        <img id="taAiChatPendingImg" alt="" />
        <span id="taAiChatPendingText">รูปพร้อมส่ง (ลบหลัง 12:00 น.)</span>
        <button type="button" id="taAiChatPendingClear" aria-label="ลบรูป">×</button>
      </div>

      <div class="ta-ai-chat-toolbar" id="taAiChatToolbar" style="<%= chatLoggedIn ? '' : 'display:none' %>">
        <button type="button" class="ta-ai-chat-attach" id="taAiChatAttach" title="<%= chatAttachLabel %>" aria-label="<%= chatAttachLabel %>">📷</button>
        <input type="file" id="taAiChatFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
      </div>

      <form class="ta-ai-chat-form" id="taAiChatForm">
        <input id="taAiChatInput" type="text" placeholder="<%= chatPlaceholder %>" autocomplete="off">
        <button type="submit"><%= chatSend %></button>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  const root = document.getElementById('taAiChat');
  const toggle = document.getElementById('taAiChatToggle');
  const box = document.getElementById('taAiChatBox');
  const closeBtn = document.getElementById('taAiChatClose');
  const form = document.getElementById('taAiChatForm');
  const input = document.getElementById('taAiChatInput');
  const messages = document.getElementById('taAiChatMessages');
  const attachBtn = document.getElementById('taAiChatAttach');
  const fileInput = document.getElementById('taAiChatFile');
  const pendingBox = document.getElementById('taAiChatPending');
  const pendingImg = document.getElementById('taAiChatPendingImg');
  const pendingClear = document.getElementById('taAiChatPendingClear');

  if (!root || !toggle || !box || !closeBtn || !form || !input || !messages) return;

  const LOGGED_IN = <%- JSON.stringify(!!chatLoggedIn) %>;
  let pendingImage = null;

  const TEXT = {
    typingStatus: <%- JSON.stringify(chatTypingText) %>,
    online: <%- JSON.stringify(chatOnline) %>,
    connectError: <%- JSON.stringify(chatConnectError) %>,
    replyError: <%- JSON.stringify(chatReplyError) %>,
    uploadError: 'อัปโหลดรูปไม่สำเร็จ',
    loginForImage: 'กรุณาเข้าสู่ระบบก่อนแนบรูป'
  };

  const DEFAULT_POS = { r: 20, b: 20 };
  const POS_KEY = 'chat_pos_v_lang_v1';
  const LONG_PRESS_MS = 350;

  function loadPos() {
    try {
      const p = JSON.parse(localStorage.getItem(POS_KEY));
      if (p && Number.isFinite(Number(p.r)) && Number.isFinite(Number(p.b))) {
        return { r: Number(p.r), b: Number(p.b) };
      }
    } catch (_) {}
    return DEFAULT_POS;
  }

  function savePos(r, b) {
    try { localStorage.setItem(POS_KEY, JSON.stringify({ r, b })); } catch (_) {}
  }

  function clampPos(r, b) {
    const w = toggle.offsetWidth || 200;
    const h = toggle.offsetHeight || 200;
    const maxR = Math.max(8, window.innerWidth - w - 8);
    const maxB = Math.max(8, window.innerHeight - h - 8);
    return {
      r: Math.min(Math.max(8, Number(r) || DEFAULT_POS.r), maxR),
      b: Math.min(Math.max(8, Number(b) || DEFAULT_POS.b), maxB)
    };
  }

  function setPos(r, b) {
    const p = clampPos(r, b);
    root.style.setProperty('right', p.r + 'px', 'important');
    root.style.setProperty('bottom', p.b + 'px', 'important');
    root.style.setProperty('left', 'auto', 'important');
    root.style.setProperty('top', 'auto', 'important');
    layoutChatBox();
    return p;
  }

  function layoutChatBox() {
    const gap = 12;
    const margin = 10;
    const toggleW = toggle.offsetWidth || 200;
    const toggleH = toggle.offsetHeight || 200;
    const maxBoxW = Math.min(360, window.innerWidth - margin * 2);

    box.classList.remove('is-below', 'is-align-left');
    box.style.left = '';
    box.style.right = '';
    box.style.top = '';
    box.style.bottom = '';
    box.style.width = maxBoxW + 'px';

    if (!box.classList.contains('open')) {
      box.style.bottom = 'calc(100% + 12px)';
      box.style.right = '0';
      return;
    }

    const rootRect = root.getBoundingClientRect();
    const spaceAbove = Math.max(0, rootRect.top - margin);
    const spaceBelow = Math.max(0, window.innerHeight - rootRect.bottom - margin);
    const isBelow = spaceAbove < spaceBelow && spaceBelow >= 320;
    if (isBelow) {
      box.classList.add('is-below');
    } else {
      box.style.bottom = (toggleH + gap) + 'px';
    }

    const availableH = isBelow
      ? Math.max(280, spaceBelow - gap)
      : Math.max(280, spaceAbove - toggleH - gap);
    const boxH = Math.min(672, availableH, window.innerHeight - margin * 2);
    box.style.setProperty('height', boxH + 'px', 'important');
    box.style.setProperty('max-height', boxH + 'px', 'important');

    const boxW = Math.min(maxBoxW, box.offsetWidth || maxBoxW);
    const onLeftHalf = (rootRect.left + toggleW / 2) < (window.innerWidth / 2);
    let leftRelative = onLeftHalf ? 0 : (toggleW - boxW);

    if (rootRect.left + leftRelative < margin) {
      leftRelative = margin - rootRect.left;
    }
    if (rootRect.left + leftRelative + boxW > window.innerWidth - margin) {
      leftRelative = (window.innerWidth - margin - boxW) - rootRect.left;
    }

    box.style.right = 'auto';
    box.style.left = leftRelative + 'px';
    scrollMessagesToBottom();
  }

  function scrollMessagesToBottom() {
    requestAnimationFrame(() => {
      messages.scrollTop = messages.scrollHeight;
    });
  }

  const savedPos = loadPos();
  setPos(savedPos.r, savedPos.b);

  async function loadSavedHistory() {
    if (!LOGGED_IN) return;
    try {
      const res = await fetch('/api/ai-chat/history', { credentials: 'same-origin' });
      const data = await res.json();
      if (!data.ok || !Array.isArray(data.messages) || !data.messages.length) return;
      messages.innerHTML = '';
      for (const item of data.messages) {
        const role = item.role === 'user' ? 'user' : 'bot';
        const text = String(item.content || '').trim();
        if (!text) continue;
        if (role === 'user') add(text, 'user');
        else add(text, 'bot');
      }
    } catch (_) {}
  }

  loadSavedHistory();

  window.addEventListener('resize', function () {
    const s = getComputedStyle(root);
    setPos(parseInt(s.right, 10) || DEFAULT_POS.r, parseInt(s.bottom, 10) || DEFAULT_POS.b);
  });

  let pointerActive = false;
  let dragEnabled = false;
  let suppressClick = false;
  let longPressTimer = null;
  let activePointerId = null;
  let sx = 0;
  let sy = 0;
  let lastX = 0;
  let lastY = 0;
  let sr = DEFAULT_POS.r;
  let sb = DEFAULT_POS.b;

  function clearLongPress() {
    if (longPressTimer) {
      clearTimeout(longPressTimer);
      longPressTimer = null;
    }
  }

  function finishPointer(e) {
    clearLongPress();
    pointerActive = false;
    dragEnabled = false;
    activePointerId = null;
    toggle.classList.remove('dragging');
    try { toggle.releasePointerCapture(e.pointerId); } catch (_) {}
  }

  function escapeHtml(text) {
    return String(text || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function linkifyInline(text) {
    return escapeHtml(text).replace(
      /(https?:\/\/[^\s<]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
    );
  }

  function formatBotMessage(text) {
    const lines = String(text || '').split('\n');
    const parts = [];

    for (let i = 0; i < lines.length; i++) {
      const trimmed = lines[i].trim();

      if (!trimmed) {
        parts.push('<div class="ta-ai-msg-gap"></div>');
        continue;
      }

      const bullet = trimmed.match(/^(\d+[.)]|[-•*])\s+(.+)$/u);
      if (bullet) {
        parts.push(
          '<div class="ta-ai-msg-line ta-ai-msg-bullet">' +
          '<span class="ta-ai-msg-bullet-mark">' + bullet[1] + '</span>' +
          '<span>' + linkifyInline(bullet[2]) + '</span></div>'
        );
        continue;
      }

      if (/[:：]\s*$/.test(trimmed) && trimmed.length <= 48) {
        parts.push('<div class="ta-ai-msg-line ta-ai-msg-heading">' + linkifyInline(trimmed) + '</div>');
        continue;
      }

      parts.push('<div class="ta-ai-msg-line">' + linkifyInline(trimmed) + '</div>');
    }

    return parts.join('');
  }

  function add(t, role, imageUrl) {
    const el = document.createElement('div');
    el.className = 'ta-ai-msg ' + (role === 'user' ? 'ta-ai-msg-user' : 'ta-ai-msg-bot');
    if (role === 'user') {
      if (t) {
        const textNode = document.createElement('div');
        textNode.textContent = t;
        el.appendChild(textNode);
      }
      if (imageUrl) {
        const img = document.createElement('img');
        img.src = imageUrl;
        img.className = 'ta-ai-msg-image';
        img.alt = 'attached';
        el.appendChild(img);
      }
    } else {
      el.innerHTML = formatBotMessage(t);
    }
    messages.appendChild(el);
    scrollMessagesToBottom();
    return el;
  }

  function clearPendingImage() {
    pendingImage = null;
    if (pendingBox) pendingBox.classList.remove('show');
    if (pendingImg) pendingImg.removeAttribute('src');
    if (fileInput) fileInput.value = '';
  }

  async function uploadSelectedImage(file) {
    const fd = new FormData();
    fd.append('image', file);
    const res = await fetch('/api/ai-chat/upload', { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) {
      throw new Error(data.message || TEXT.uploadError);
    }
    return data;
  }

  if (LOGGED_IN && attachBtn && fileInput) {
    attachBtn.onclick = () => fileInput.click();
    fileInput.onchange = async () => {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;
      try {
        attachBtn.disabled = true;
        const uploaded = await uploadSelectedImage(file);
        const previewUrl = URL.createObjectURL(file);
        pendingImage = { id: uploaded.id, previewUrl, url: uploaded.url };
        if (pendingImg) pendingImg.src = previewUrl;
        if (pendingBox) pendingBox.classList.add('show');
      } catch (err) {
        add(err.message || TEXT.uploadError, 'bot');
        clearPendingImage();
      } finally {
        attachBtn.disabled = false;
      }
    };
  }

  if (pendingClear) {
    pendingClear.onclick = () => clearPendingImage();
  }

  function addTyping() {
    const el = document.createElement('div');
    el.className = 'ta-ai-msg ta-ai-msg-bot';
    el.innerHTML = '<span class="ta-ai-typing"><span></span><span></span><span></span></span>';
    messages.appendChild(el);
    scrollMessagesToBottom();
    return el;
  }

  toggle.onclick = () => {
    if (suppressClick) {
      suppressClick = false;
      return;
    }
    box.classList.toggle('open');
    layoutChatBox();
  };

  closeBtn.onclick = () => {
    box.classList.remove('open');
    layoutChatBox();
  };

  toggle.onpointerdown = e => {
    if (e.pointerType === 'mouse' && e.button !== 0) return;

    pointerActive = true;
    dragEnabled = false;
    suppressClick = false;
    activePointerId = e.pointerId;
    sx = e.clientX;
    sy = e.clientY;
    lastX = sx;
    lastY = sy;

    const s = getComputedStyle(root);
    sr = parseInt(s.right, 10) || DEFAULT_POS.r;
    sb = parseInt(s.bottom, 10) || DEFAULT_POS.b;

    clearLongPress();
    longPressTimer = setTimeout(() => {
      if (!pointerActive || activePointerId !== e.pointerId) return;
      dragEnabled = true;
      suppressClick = true;
      toggle.classList.add('dragging');
      sx = lastX;
      sy = lastY;
      const cur = getComputedStyle(root);
      sr = parseInt(cur.right, 10) || DEFAULT_POS.r;
      sb = parseInt(cur.bottom, 10) || DEFAULT_POS.b;
    }, LONG_PRESS_MS);

    try { toggle.setPointerCapture(e.pointerId); } catch (_) {}
  };

  toggle.onpointermove = e => {
    if (!pointerActive || e.pointerId !== activePointerId) return;

    lastX = e.clientX;
    lastY = e.clientY;

    if (!dragEnabled) return;

    const dx = e.clientX - sx;
    const dy = e.clientY - sy;
    setPos(sr - dx, sb - dy);
  };

  toggle.onpointerup = e => {
    if (!pointerActive || e.pointerId !== activePointerId) return;

    if (dragEnabled) {
      const p = setPos(parseInt(getComputedStyle(root).right, 10), parseInt(getComputedStyle(root).bottom, 10));
      savePos(p.r, p.b);
      dragEnabled = false;
      finishPointer(e);
      return;
    }

    clearLongPress();
    finishPointer(e);
  };

  toggle.onpointercancel = e => {
    if (e.pointerId !== activePointerId) return;
    dragEnabled = false;
    finishPointer(e);
  };

  form.onsubmit = async e => {
    e.preventDefault();
    const text = input.value.trim();
    const imageSnapshot = pendingImage;
    if (!text && !imageSnapshot) return;

    add(text, 'user', imageSnapshot ? imageSnapshot.previewUrl : '');
    input.value = '';
    clearPendingImage();

    const loading = addTyping();

    try {
      const pagePath = window.location.pathname || '/';
      const pageCode = pagePath.startsWith('/admin')
        ? 'admin'
        : pagePath.startsWith('/app')
        ? 'app'
        : 'public';

      const userId =
        document.body?.dataset?.userId ||
        '<%= chatUser ? String(chatUser.id) : "" %>' ||
        'guest';

      const sessionKey = pageCode + ':' + userId;

      const payload = {
        message: text,
        sessionKey,
        pageCode,
        pagePath,
        pageTitle: document.title || pageCode
      };
      if (imageSnapshot?.id) payload.imageIds = [imageSnapshot.id];

      const res = await fetch('/api/ai-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const d = await res.json();
      loading.remove();
      add(d.reply || TEXT.replyError, 'bot');
    } catch (_) {
      loading.remove();
      add(TEXT.connectError, 'bot');
    }
  };
})();
</script>