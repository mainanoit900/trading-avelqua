<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const safeSite = typeof site !== 'undefined' && site ? site : {};
const brandName = safeSite.brandName || 'TRADING AVELQUA';
%>

<link rel="stylesheet" href="/public/css/auth.css">

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-wrap">
      <img src="/public/images/logo.png" alt="<%= brandName %>" class="auth-logo">
    </div>

    <h1 class="auth-title"><%= safeT('register.title', 'สมัครสมาชิก') %></h1>
    <p class="auth-sub"><%= safeT('register.subtitle', 'สร้างบัญชีเพื่อเริ่มใช้งานแพลตฟอร์ม') %></p>
    <div class="auth-alert auth-alert-success" style="margin-top:12px;">สมัครผ่านอีเมลต้องกดยืนยันอีเมลก่อนเข้าใช้งาน แต่ Google และ LINE เข้าใช้งานได้ทันที</div>

    <% if (error) { %>
      <div class="auth-alert auth-alert-danger"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="auth-alert auth-alert-success"><%= success %></div>
    <% } %>

    <form method="POST" action="/register">
      <div class="auth-group">
        <label class="auth-label"><%= safeT('register.name_label', 'ชื่อ') %></label>
        <input type="text" name="name" class="auth-input" placeholder="<%= safeT('register.name_placeholder', 'กรอกชื่อ') %>" required>
      </div>

      <div class="auth-group">
        <label class="auth-label"><%= safeT('register.email_label', 'อีเมล') %></label>
        <input type="email" name="email" class="auth-input" placeholder="<%= safeT('register.email_placeholder', 'กรอกอีเมล') %>" required>
      </div>

      <div class="auth-group auth-password">
        <label class="auth-label"><%= safeT('register.password_label', 'รหัสผ่าน') %></label>
        <input type="password" id="regPassword" name="password" class="auth-input" placeholder="<%= safeT('register.password_placeholder', 'กรอกรหัสผ่าน') %>" required>
        <button type="button" class="toggle-pass" onclick="toggleRegisterPass()">👁</button>
      </div>

      <button type="submit" class="auth-btn"><%= safeT('register.submit', 'สมัครสมาชิก') %></button>
    </form>

    <div class="auth-register-text">
      <span><%= safeT('register.have_account', 'มีบัญชีอยู่แล้ว?') %></span>
      <a href="/login"><%= safeT('register.login', 'เข้าสู่ระบบ') %></a>
    </div>
  </div>
</div>

<script>
function toggleRegisterPass() {
  const input = document.getElementById('regPassword');
  input.type = input.type === 'password' ? 'text' : 'password';
}
</script>