<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const safeSite = typeof site !== 'undefined' && site ? site : {};
const brandName = safeSite.brandName || 'TRADING AVELQUA';
%>

<link rel="stylesheet" href="/public/css/auth.css">

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-wrap">
      <img src="/public/images/logo.png" alt="<%= brandName %>" class="auth-logo">
    </div>

    <h1 class="auth-title"><%= safeT('forgot.title', 'ลืมรหัสผ่าน') %></h1>
    <p class="auth-sub"><%= safeT('forgot.subtitle', 'กรอกอีเมลเพื่อรับลิงก์รีเซ็ตรหัสผ่าน') %></p>

    <% if (error) { %>
      <div class="auth-alert auth-alert-danger"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="auth-alert auth-alert-success"><%= success %></div>
    <% } %>

    <form method="POST" action="/forgot-password">
      <div class="auth-group">
        <label class="auth-label"><%= safeT('forgot.email_label', 'อีเมล') %></label>
        <input type="email" name="email" class="auth-input" placeholder="<%= safeT('forgot.email_placeholder', 'กรอกอีเมล') %>" required>
      </div>

      <button type="submit" class="auth-btn"><%= safeT('forgot.submit', 'ส่งลิงก์รีเซ็ต') %></button>
    </form>
  </div>
</div>