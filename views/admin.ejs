<%
  const safeStats = (typeof stats !== 'undefined' && stats) ? stats : {};
  const safeDb = (typeof db !== 'undefined' && db) ? db : {};
  const safeUsers = Array.isArray(safeDb.users) ? safeDb.users : [];
  const safePackages = Array.isArray(safeDb.packages) ? safeDb.packages : [];
  const safeCoupons = Array.isArray(safeDb.coupons) ? safeDb.coupons : [];
  const safePayments = Array.isArray(safeDb.payments) ? safeDb.payments : [];
  const safeVpsNodes = Array.isArray(safeDb.vpsNodes) ? safeDb.vpsNodes : [];
%>

<%- include('../partials/head', { pageCss: 'admin.css' }) %>
<%- include('../partials/nav') %>
<%- include('../partials/head', { pageTitle: 'Admin Dashboard', pageCss: 'admin-panel.css' }) %>

<main class="container section admin-page admin-theme">
  <section class="admin-hero card">
    <div>
      <span class="admin-chip">ADMIN CONTROL</span>
      <h1 class="admin-title">Admin Dashboard</h1>
      <p class="muted admin-lead">จัดการสมาชิก แพ็กเกจ คูปอง ข่าว และ VPS ในมุมมองโทนเข้มสบายตา โดยไม่กระทบข้อมูลเดิม</p>
    </div>
    <div class="admin-hero-glow"></div>
  </section>

  <section class="stats admin-stat-grid">
    <div class="stat stat-lux">
      <span class="stat-label">Users</span>
      <strong><%= Number(safeStats.users || safeUsers.length || 0) %></strong>
      <div class="muted">สมาชิกในระบบ</div>
    </div>
    <div class="stat stat-lux">
      <span class="stat-label">Packages</span>
      <strong><%= Number(safeStats.packages || safePackages.length || 0) %></strong>
      <div class="muted">แพ็กเกจทั้งหมด</div>
    </div>
    <div class="stat stat-lux">
      <span class="stat-label">Payments</span>
      <strong><%= Number(safeStats.payments || safePayments.length || 0) %></strong>
      <div class="muted">รายการชำระเงิน</div>
    </div>
    <div class="stat stat-lux accent">
      <span class="stat-label">Revenue</span>
      <strong>฿<%= Number(safeStats.revenue || 0).toLocaleString('th-TH') %></strong>
      <div class="muted">ยอดรายรับรวม</div>
    </div>
  </section>

  <div class="admin-layout">
    <div class="grid admin-grid-two">
      <section class="card card-lux">
        <div class="card-head-simple">
          <div>
            <h2>จัดการสมาชิก</h2>
            <p class="muted">ดูและจัดการผู้ใช้งานทั้งหมดจากหน้าเดียว</p>
          </div>
        </div>
        <div class="table-wrap table-lux">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>ชื่อ</th>
                <th>อีเมล</th>
                <th>Role</th>
                <th>จัดการ</th>
              </tr>
            </thead>
            <tbody>
              <% if (!safeUsers.length) { %>
                <tr>
                  <td colspan="5" class="muted">ยังไม่มีสมาชิก</td>
                </tr>
              <% } %>

              <% safeUsers.forEach(function(u){ %>
                <tr>
                  <td><%= u.id %></td>
                  <td><%= u.name || [u.firstName || '', u.lastName || ''].join(' ').trim() || '-' %></td>
                  <td><%= u.email || '-' %></td>
                  <td><span class="role-pill <%= (u.role === 'admin') ? 'role-admin' : 'role-user' %>"><%= u.role || 'user' %></span></td>
                  <td>
                    <div class="inline-actions">
                      <form method="post" action="/admin/users/<%= u.id %>/role">
                        <input type="hidden" name="role" value="<%= (u.role === 'admin') ? 'user' : 'admin' %>">
                        <button class="btn" type="submit">
                          <%= (u.role === 'admin') ? 'เปลี่ยนเป็น user' : 'เปลี่ยนเป็น admin' %>
                        </button>
                      </form>

                      <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('ลบผู้ใช้งานนี้?')">
                        <button class="btn danger" type="submit">ลบ</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card card-lux">
        <div class="card-head-simple">
          <div>
            <h2>จัดการแพ็กเกจ</h2>
            <p class="muted">เพิ่มสิทธิ์ใหม่โดยไม่เปลี่ยน logic หลังบ้าน</p>
          </div>
        </div>

        <form class="form-grid two form-lux" method="post" action="/admin/packages/create">
          <input name="name" placeholder="ชื่อแพ็กเกจ" required>
          <select name="size">
            <option value="basic">BASIC</option>
            <option value="pro">PRO</option>
            <option value="advanced">ADVANCED</option>
          </select>

          <input name="days" placeholder="days" type="number" required>
          <input name="price" placeholder="price" type="number" required>
          <input name="lotMin" placeholder="lotMin" step="0.01">
          <input name="lotMax" placeholder="lotMax" step="0.01">
          <input name="portMin" placeholder="portMin" type="number">
          <input name="portMax" placeholder="portMax" type="number">
          <input name="profitMin" placeholder="profitMin" type="number">
          <input name="profitMax" placeholder="profitMax" type="number">

          <div style="grid-column:1/-1">
            <button class="btn primary" type="submit">เพิ่มแพ็กเกจ</button>
          </div>
        </form>

        <div class="table-wrap table-lux" style="margin-top:14px">
          <table class="table">
            <tbody>
              <% if (!safePackages.length) { %>
                <tr>
                  <td class="muted">ยังไม่มีแพ็กเกจ</td>
                </tr>
              <% } %>

              <% safePackages.forEach(function(p){ %>
                <tr>
                  <td><%= p.name || '-' %></td>
                  <td>฿<%= Number(p.price || 0).toLocaleString('th-TH') %></td>
                  <td>
                    <form method="post" action="/admin/packages/<%= p.id %>/delete">
                      <button class="btn danger" type="submit">ลบ</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="grid admin-grid-three">
      <section class="card card-lux">
        <div class="card-head-simple">
          <div>
            <h2>คูปอง</h2>
            <p class="muted">สร้างโค้ดส่วนลดในธีมใหม่แบบสบายตา</p>
          </div>
        </div>
        <form class="form-grid form-lux" method="post" action="/admin/coupons/create">
          <input name="code" placeholder="โค้ดคูปอง" required>
          <select name="type">
            <option value="discount">ส่วนลด</option>
            <option value="free">ฟรี</option>
          </select>
          <input name="value" placeholder="มูลค่าส่วนลด" type="number">
          <input name="usageLimit" placeholder="จำนวนครั้ง" type="number" value="1">
          <input name="expiresAt" placeholder="วันหมดอายุ ISO เช่น 2026-12-31T23:59:59.000Z">
          <button class="btn primary" type="submit">เพิ่มคูปอง</button>
        </form>

        <div class="table-wrap table-lux" style="margin-top:14px">
          <table class="table">
            <tbody>
              <% if (!safeCoupons.length) { %>
                <tr>
                  <td class="muted">ยังไม่มีคูปอง</td>
                </tr>
              <% } %>
              <% safeCoupons.forEach(function(c){ %>
                <tr>
                  <td><%= c.code || '-' %></td>
                  <td><%= c.type || '-' %></td>
                  <td><%= c.value || 0 %></td>
                  <td>
                    <form method="post" action="/admin/coupons/<%= c.id %>/delete">
                      <button class="btn danger" type="submit">ลบ</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card card-lux">
        <div class="card-head-simple">
          <div>
            <h2>ข่าว</h2>
            <p class="muted">แบบฟอร์มเดิม แต่ดูสะอาดและพรีเมียมขึ้น</p>
          </div>
        </div>
        <form class="form-grid form-lux" method="post" action="/admin/news/create">
          <input name="title" placeholder="หัวข้อข่าว" required>
          <input name="category" placeholder="หมวดข่าว เช่น gold / forex / stock">
          <textarea name="body" placeholder="เนื้อข่าว"></textarea>
          <textarea name="analysis" placeholder="วิเคราะห์"></textarea>
          <button class="btn primary" type="submit">เพิ่มข่าว</button>
        </form>
      </section>

      <section class="card card-lux">
        <div class="card-head-simple">
          <div>
            <h2>VPS / MT5</h2>
            <p class="muted">คงฟอร์มเดิม เพิ่มความอ่านง่ายในโทนเข้ม</p>
          </div>
        </div>

        <form class="form-grid form-lux" method="post" action="/admin/vps/create">
          <input name="name" placeholder="ชื่อ VPS" required>
          <input name="host" placeholder="Host / IP">
          <input name="location" placeholder="Location">
          <input name="maxLot" placeholder="Lot สูงสุด" type="number" step="0.01">
          <input name="maxPorts" placeholder="Port สูงสุด" type="number">
          <button class="btn primary" type="submit">เพิ่ม VPS</button>
        </form>

        <div class="table-wrap table-lux" style="margin-top:14px">
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Used/Max Ports</th>
                <th>Max Lot</th>
              </tr>
            </thead>
            <tbody>
              <% if (!safeVpsNodes.length) { %>
                <tr>
                  <td colspan="3" class="muted">ยังไม่มี VPS</td>
                </tr>
              <% } %>
              <% safeVpsNodes.forEach(function(v){ %>
                <tr>
                  <td><%= v.name || '-' %></td>
                  <td><%= v.usedPorts || 0 %> / <%= v.maxPorts || 0 %></td>
                  <td><%= v.maxLot || 0 %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
