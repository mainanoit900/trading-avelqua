<section class="card"><div class="card-head"><h3>Credit / Subscription</h3></div><div class="kv-grid"><div><span>แพ็กเกจล่าสุด</span><strong><%= subscription ? subscription.package_name_snapshot || '-' : '-' %></strong></div><div><span>วันหมดอายุ</span><strong><%= subscription && subscription.end_at ? new Date(subscription.end_at).toLocaleString('th-TH') : '-' %></strong></div><div><span>Lot</span><strong><%= subscription ? subscription.lot_min : 0 %> - <%= subscription ? subscription.lot_max : 0 %></strong></div><div><span>Port</span><strong><%= subscription ? subscription.ports_min : 0 %> - <%= subscription ? subscription.ports_max : 0 %></strong></div></div></section>
<%- include('../partials/app-shell-end') %>
