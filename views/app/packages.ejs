<script>
  (function () {
    const modal = document.getElementById('packageBuyConfirmModal');
    const confirmBtn = document.getElementById('confirmPackageBuyBtn');
    let activeForm = null;
    if (!modal || !confirmBtn) return;

    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value || '-';
    }

    function openModal(button) {
      activeForm = button.closest('form');
      setText('buyModalPackage', button.dataset.packageName);
      setText('buyModalGroup', button.dataset.packageGroup);
      setText('buyModalDays', button.dataset.packageDays);
      setText('buyModalLot', button.dataset.packageLot);
      setText('buyModalPort', button.dataset.packagePort);
      setText('buyModalPrice', button.dataset.packagePrice);
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'ยืนยันซื้อ';
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('scoin-modal-open');
    }

    function closeModal() {
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('scoin-modal-open');
    }

    document.querySelectorAll('.js-open-package-buy').forEach(function (button) {
      button.addEventListener('click', function () { openModal(button); });
    });
    modal.querySelectorAll('[data-buy-close]').forEach(function (el) { el.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && modal.classList.contains('show')) closeModal(); });
    confirmBtn.addEventListener('click', function () {
      if (!activeForm) return;
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'กำลังสร้างรายการ...';
      activeForm.submit();
    });
  })();
</script>

<script>
  (function () {
    const openBtn = document.getElementById('openHeroFreeCouponModal');
    const modal = document.getElementById('heroFreeCouponModal');
    if (!openBtn || !modal) return;

    function openHeroFc() {
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('scoin-modal-open');
      const input = document.getElementById('heroFreeCouponCode');
      if (input) { input.focus(); input.select(); }
    }

    function closeHeroFc() {
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('scoin-modal-open');
    }

    openBtn.addEventListener('click', openHeroFc);
    modal.querySelectorAll('[data-hero-fc-close]').forEach(function (el) {
      el.addEventListener('click', closeHeroFc);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal.classList.contains('show')) closeHeroFc();
    });
  })();
</script>

