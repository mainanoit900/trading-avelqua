  <div class="scoin-confirm-backdrop" data-hero-fc-close></div>
  <div class="scoin-confirm-card" role="dialog" aria-modal="true">
    <button type="button" class="scoin-confirm-x" data-hero-fc-close aria-label="ปิด">×</button>
