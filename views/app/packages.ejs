<% groups.forEach(function(groupKey){ const items = (groupedPackages && groupedPackages[groupKey]) || []; %>
  <section class="package-lux-section">
    <div class="package-section-head">
      <div>
        <span class="package-chip"><%= groupLabels[groupKey] || groupKey.toUpperCase() %></span>
        <h3><%= groupLabels[groupKey] || groupKey.toUpperCase() %></h3>
      </div>

      <p>
        <%= groupKey === 'basic'
          ? safeT('app.packages.basic_desc', 'เริ่มต้นใช้งาน เหมาะสำหรับทดลองระบบ')
          : groupKey === 'pro'
            ? safeT('app.packages.pro_desc', 'เหมาะสำหรับผู้ใช้งานจริง ต้องการเพิ่มพอร์ตและระยะเวลา')
            : safeT('app.packages.advanced_desc', 'สำหรับผู้ใช้งานระดับสูง ต้องการความยืดหยุ่นสูงสุด')
        %>
      </p>
    </div>

    <% if (!items.length) { %>
      <div class="package-empty">
        <i class="fa-regular fa-folder-open"></i>
        <%= safeT('app.packages.empty', 'ยังไม่มีแพ็กเกจในหมวดนี้') %>
      </div>
    <% } else { %>
      <div class="package-lux-grid">
        <% items.forEach(function(pkg){
          const days = Number(pkg.days || 1);
          const price = Number(pkg.price || 0);
          const avgPerDay = days ? price / days : 0;
          const isPopular = pkg.is_popular === true || pkg.is_popular === 't' || pkg.is_popular === 1;
        %>
          <article class="package-lux-card <%= isPopular ? 'popular' : '' %>">
            <div class="package-card-top">
              <span class="package-id"><%= isPopular ? safeT('app.packages.recommend', 'แนะนำ') : (pkg.display_id || pkg.package_code || ('PK' + String(pkg.id).padStart(6, '0'))) %></span>
              <span class="package-days"><%= groupLabels[groupKey] || groupKey.toUpperCase() %></span>
            </div>

            <h4><%= days.toLocaleString(dateLocale) %> <%= safeT('app.packages.days', 'วัน') %></h4>

            <p class="package-summary">
              <%= pkgSummary(pkg) || (groupKey === 'basic' ? 'เหมาะสำหรับผู้เริ่มต้น' : groupKey === 'pro' ? 'เหมาะสำหรับผู้ใช้งานจริง' : 'เหมาะสำหรับผู้ใช้งานระดับสูง') %>
            </p>

            <div class="package-price">
              <strong>฿<%= intMoney(price) %></strong>
              <small><%= safeT('app.packages.avg_per_day', 'เฉลี่ย') %> ฿<%= money(avgPerDay) %> / <%= safeT('app.packages.day', 'วัน') %></small>
            </div>

<div class="package-scoin-box">
  <div class="package-scoin-main">
    <span>รับ SCOIN</span>
    <strong><%= money(price * 0.30) %> SCOIN</strong>
  </div>

  <div class="package-scoin-mini">
    
    <div>
      <span>ผู้แนะนำตรง</span>
      <strong><%= money(price * 0.60) %> SCOIN</strong>
    </div>
  </div>

  <p>
    หมายเหตุ: สิทธิ์รับ SCOIN 30% และโบนัสแนะนำ ใช้เฉพาะการชำระด้วยเงินจริงเท่านั้น หากชำระแพ็กเกจด้วย Scoin จะไม่ได้รับ Scoin คืนและไม่แบ่งสายงาน
  </p>
</div>

            <div class="package-features">
              <div>
                <span><%= safeT('app.packages.buy_package', 'ซื้อแพ็กเกจ') %></span>
                <strong><%= pkgName(pkg) %></strong>
              </div>

              <div>
                <span><%= safeT('app.packages.lot', 'รองรับ lot') %></span>
                <strong><%= pkg.lot_range || '-' %></strong>
              </div>

              <div>
                <span><%= safeT('app.packages.port_count', 'จำนวนพอร์ต') %></span>
                <strong><%= pkg.port_range || '-' %></strong>
              </div>

              <div>
                <span><%= safeT('app.packages.profit', 'กำไรเฉลี่ย') %></span>
                <strong><%= profitText(pkg) %></strong>
              </div>

              <div>
                <span><%= safeT('app.packages.duration', 'ใช้งานระบบได้') %></span>
                <strong><%= days.toLocaleString(dateLocale) %> <%= safeT('app.packages.days', 'วัน') %></strong>
              </div>

              <div>
                <span><%= safeT('app.packages.support', 'การใช้งาน') %></span>
                <strong><%= supportText(pkg) %></strong>
              </div>
            </div>

            <p class="package-note">
              <%= safeT('app.packages.ready_note', 'พร้อมใช้งานทันทีและเหมาะกับระดับแพ็กเกจที่เลือก') %>
            </p>

            <form method="POST" action="/app/packages/<%= pkg.id %>/buy" class="package-buy-form">
              <button
                type="button"
                class="package-buy-btn js-open-package-buy"
                data-package-name="<%= pkgName(pkg) %>"
                data-package-group="<%= groupLabels[groupKey] || groupKey.toUpperCase() %>"
                data-package-days="<%= days.toLocaleString(dateLocale) %>"
                data-package-price="฿<%= intMoney(price) %>"
                data-package-lot="<%= pkg.lot_range || '-' %>"
                data-package-port="<%= pkg.port_range || '-' %>"
              >
                <span><%= safeT('app.packages.buy_now', 'ซื้อแพ็กเกจ') %></span>
              </button>
            </form>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
<% }) %>

<section id="package-history" class="package-lux-section package-history-section">
  <div class="package-section-head">
    <div>
      <span class="package-chip"><%= safeT('app.packages.history_chip', 'PAYMENT') %></span>
      <h3><%= safeT('app.packages.history_title', 'รายการซื้อแพ็กเกจล่าสุด') %></h3>
    </div>
    <p><%= safeT('app.packages.history_desc', 'รายการที่ซื้อด้วยเงินจริงและ Scoin จะแสดงรวมกัน หากจ่ายด้วย Scoin ระบบเปิดใช้งานทันที แต่ไม่ได้รับ Scoin คืนและไม่แบ่งโบนัสสายงาน') %></p>
  </div>

  <% if (!(recentPackagePayments || []).length) { %>
    <div class="package-empty">
      <i class="fa-regular fa-receipt"></i>
      <%= safeT('app.packages.no_history', 'ยังไม่มีรายการซื้อแพ็กเกจ') %>
    </div>
  <% } else { %>
    <div class="package-history-table">
      <table>
        <thead>
          <tr>
            <th class="col-id"><%= safeT('common.id', 'ID') %></th>
            <th class="col-package"><%= safeT('dashboard.package', 'Package') %></th>
            <th class="col-amount"><%= safeT('common.amount', 'ยอดเงิน') %></th>
            <th class="col-method">วิธีชำระ</th>
            <th class="col-status"><%= safeT('common.status', 'สถานะ') %></th>
            <th class="col-date"><%= safeT('common.created_at', 'วันที่') %></th>
          </tr>
        </thead>
        <tbody>
          <% recentPackagePayments.forEach(function(p){ %>
            <% const historyWhen = formatHistoryDateTime(p.created_at); %>
            <tr>
              <td class="col-id"><span class="history-id">#<%= p.display_id || ('PM' + String(p.id).padStart(6, '0')) %></span></td>
              <td class="col-package"><%= p.display_package_label || p.package_name_snapshot || '-' %></td>
              <td class="col-amount">
                <div>฿<%= money(p.final_amount || p.amount || 0) %></div>
              </td>
              <td class="col-method">
                <% if (isFreeCouponPackagePayment(p)) { %>
                  <span class="history-method-badge coupon">
                    <i class="fa-solid fa-ticket"></i> <%= paymentMethodText(p) %>
                  </span>
                <% } else if (isScoinPackagePayment(p)) { %>
                  <span class="history-method-badge scoin">
                    <i class="fa-solid fa-coins"></i> <%= isTH ? 'ชำระด้วย Scoin' : 'Paid with Scoin' %>
                  </span>
                  <small class="history-method-scoin-amount"><%= scoinAmountText(p) %></small>
                  <small class="history-method-scoin-note"><%= isTH ? 'เปิดใช้งานทันที · ไม่คืน Scoin' : 'Instant activation · Scoin non-refundable' %></small>
                <% } else { %>
                  <span class="history-method-badge cash"><%= paymentMethodText(p) %></span>
                <% } %>
              </td>
              <td class="col-status"><span class="package-status <%= String(p.payment_status || 'pending').toLowerCase() %>"><%= statusText(p.payment_status) %></span></td>
              <td class="col-date">
                <% if (historyWhen) { %>
                  <span class="history-date-line"><%= historyWhen.date %></span>
                  <span class="history-time-line"><%= historyWhen.time %></span>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if ((paymentTotalPages || 1) > 1) { %>
      <div class="package-history-pagination" aria-label="Package history pagination">
        <% const currentPayPage = Number(paymentPage || 1); %>
        <% if (currentPayPage > 1) { %>
          <a class="history-page-btn" href="/app/packages?page=<%= currentPayPage - 1 %>#package-history">
            <i class="fa-solid fa-chevron-left"></i> ก่อนหน้า
          </a>
        <% } else { %>
          <span class="history-page-btn disabled"><i class="fa-solid fa-chevron-left"></i> ก่อนหน้า</span>
        <% } %>

        <span class="history-page-info">
          หน้า <strong><%= currentPayPage %></strong> / <strong><%= paymentTotalPages %></strong>
        </span>

        <% if (currentPayPage < Number(paymentTotalPages || 1)) { %>
          <a class="history-page-btn" href="/app/packages?page=<%= currentPayPage + 1 %>#package-history">
            ถัดไป <i class="fa-solid fa-chevron-right"></i>
          </a>
        <% } else { %>
          <span class="history-page-btn disabled">ถัดไป <i class="fa-solid fa-chevron-right"></i></span>
        <% } %>
      </div>
    <% } %>

  <% } %>
</section>


