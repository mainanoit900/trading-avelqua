<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const currentLang = String(typeof lang !== 'undefined' ? lang : 'th').toLowerCase();
const isTH = currentLang === 'th';
const dateLocale = isTH ? 'th-TH' : 'en-US';
const couponUsedHistoryUrlValue = String(typeof couponUsedHistoryUrl !== 'undefined' ? couponUsedHistoryUrl : '').trim();

const groups = ['basic', 'pro', 'advanced'];
const groupLabels = { basic: 'BASIC', pro: 'PRO', advanced: 'ADVANCED' };

function money(value) {
  return Number(value || 0).toLocaleString(dateLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function intMoney(value) {
  return Number(value || 0).toLocaleString(dateLocale, { maximumFractionDigits: 0 });
}
function pkgName(pkg) {
  return isTH ? (pkg.name_th || pkg.name_en || '-') : (pkg.name_en || pkg.name_th || '-');
}
function pkgSummary(pkg) {
  return isTH ? (pkg.summary_th || pkg.summary_en || '') : (pkg.summary_en || pkg.summary_th || '');
}
function profitText(pkg) {
  return isTH ? (pkg.profit_range_th || '-') : (pkg.profit_range_en || pkg.profit_range_th || '-');
}
function supportText(pkg) {
  return isTH
    ? (pkg.support_th || pkg.support_en || 'เริ่มใช้งานได้หลังชำระเงินและแอดมินอนุมัติ')
    : (pkg.support_en || pkg.support_th || 'Ready after payment approval');
}
function statusText(status) {
  const s = String(status || 'pending').toLowerCase();
  if (s === 'paid') return isTH ? 'สำเร็จ' : 'Paid';
  if (s === 'cancelled') return isTH ? 'ยกเลิก' : 'Cancelled';
  if (s === 'failed') return isTH ? 'ไม่สำเร็จ' : 'Failed';
  if (s === 'refunded') return isTH ? 'คืนเงิน' : 'Refunded';
  return isTH ? 'รอตรวจสอบ' : 'Pending';
}
function rawPayloadObj(p) {
  if (!p || !p.raw_payload) return {};
  if (typeof p.raw_payload === 'object') return p.raw_payload;
  try { return JSON.parse(p.raw_payload); } catch (e) { return {}; }
}
function isScoinPackagePayment(p) {
  const raw = rawPayloadObj(p);
  return String(p.payment_method || '').toLowerCase() === 'scoin' || !!raw.scoin_payment || String(p.payment_ref || '').startsWith('SCOIN-PKG-');
}
function scoinAmountText(p) {
  const raw = rawPayloadObj(p);
  const amount = Number(p.scoin_paid_amount || (raw.scoin_payment && raw.scoin_payment.scoin_amount) || 0);
  if (!amount) return '-';
  return amount.toLocaleString(dateLocale, { minimumFractionDigits: 4, maximumFractionDigits: 4 }) + ' Scoin';
}
function isFreeCouponPackagePayment(p) {
  const m = String(p.payment_method || '').toLowerCase();
  if (m === 'free_coupon') return true;
  const raw = rawPayloadObj(p);
  return !!(raw.coupon && (raw.coupon.type === 'free' || Number(raw.coupon.free_days || 0) > 0));
}
function paymentMethodText(p) {
  if (isScoinPackagePayment(p)) return isTH ? 'Scoin' : 'Scoin';
  if (isFreeCouponPackagePayment(p)) return isTH ? 'คูปองฟรี' : 'Free Coupon';
  const m = String(p.payment_method || '').toLowerCase();
  if (m === 'stripe_card') return isTH ? 'บัตรเครดิต (Stripe)' : 'Credit Card (Stripe)';
  if (m === 'stripe_promptpay') return isTH ? 'PromptPay QR (Stripe)' : 'PromptPay QR (Stripe)';
  if (m === 'credit_card') return isTH ? 'บัตรเครดิต' : 'Credit Card';
  if (m === 'promptpay_qr') return isTH ? 'PromptPay QR' : 'PromptPay QR';
  if (m === 'bank_transfer') return isTH ? 'โอนเงิน' : 'Bank Transfer';
  return isTH ? 'เงินสด/โอน' : 'Cash/Transfer';
}
function formatHistoryDateTime(value) {
  if (!value) return null;
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return null;
  return {
    date: d.toLocaleDateString(dateLocale, { day: 'numeric', month: 'short', year: 'numeric' }),
    time: d.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false })
  };
}

const totalPackages = groups.reduce((sum, key) => sum + (((groupedPackages && groupedPackages[key]) || []).length), 0);
%>

<% var pageCss = '/css/app-packages.css'; %>
<%- include('../partials/app-shell') %>

<% if (error || success) { %>
  <div class="scoin-confirm-modal show" id="packagesFlashModal" aria-hidden="false">
    <div class="scoin-confirm-backdrop" data-packages-flash-close></div>
    <div class="scoin-confirm-card" role="dialog" aria-modal="true">
      <button type="button" class="scoin-confirm-x" data-packages-flash-close aria-label="ปิด">×</button>
      <div class="scoin-confirm-icon">
        <% if (error) { %>
          <i class="fa-solid fa-triangle-exclamation"></i>
        <% } else { %>
          <i class="fa-solid fa-circle-check"></i>
        <% } %>
      </div>
      <span class="package-chip"><%= error ? 'แจ้งเตือน' : 'สำเร็จ' %></span>
      <h3><%= error ? 'ไม่สามารถใช้งานคูปองได้' : 'ดำเนินการสำเร็จ' %></h3>
      <p><%= error || success %></p>
      <div class="scoin-confirm-actions">
        <% if (error && String(error).includes('คูปองนี้ถูกใช้งานแล้ว') && couponUsedHistoryUrlValue) { %>
          <a href="<%= couponUsedHistoryUrlValue %>" class="scoin-modal-cancel">ดูประวัติการใช้งาน</a>
        <% } %>
        <button type="button" class="scoin-modal-confirm" data-packages-flash-close>ตกลง</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const modal = document.getElementById('packagesFlashModal');
      if (!modal) return;
      document.body.classList.add('scoin-modal-open');

      function closeModal() {
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('scoin-modal-open');
      }

      modal.querySelectorAll('[data-packages-flash-close]').forEach(function (el) {
        el.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
<% } %>

