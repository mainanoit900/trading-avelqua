<%- include('../partials/app-shell') %>
<section class="card"><div class="card-head"><h3>รายการพอร์ตที่เชื่อมต่อ</h3></div><div class="table-wrap"><table><thead><tr><th>Broker</th><th>Login</th><th>Server</th><th>Action</th></tr></thead><tbody><% if (!(brokerAccounts || []).length) { %><tr><td colspan="4" class="empty-cell">ยังไม่มีบัญชีโบรกเกอร์</td></tr><% } %><% (brokerAccounts || []).forEach(function(a){ %><tr><td><%= a.broker_name %></td><td><%= a.account_login %></td><td><%= a.server_name %></td><td><form method="POST" action="/app/bots/<%= a.id %>/play" class="inline-grid"><input type="text" name="symbol" value="XAUUSD" /><input type="number" step="0.01" name="lot_in_use" value="<%= subscription ? subscription.lot_min : 0.01 %>" /><input type="number" name="ports_in_use" value="<%= subscription ? subscription.ports_min : 1 %>" /><button class="btn primary">PLAY</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="card"><div class="card-head"><h3>Bot Sessions</h3></div><div class="table-wrap"><table><thead><tr><th>Session</th><th>Symbol</th><th>Lot</th><th>Ports</th><th>Node</th><th>Status</th><th></th></tr></thead><tbody><% if (!(botSessions || []).length) { %><tr><td colspan="7" class="empty-cell">ยังไม่มี session</td></tr><% } %><% (botSessions || []).forEach(function(s){ %><tr><td><%= s.session_code %></td><td><%= s.symbol %></td><td><%= s.lot_in_use %></td><td><%= s.ports_in_use %></td><td><%= s.node_name || '-' %></td><td><span class="badge <%= s.status === 'running' ? 'green' : 'yellow' %>"><%= s.status %></span></td><td><% if (s.status === 'running') { %><form method="POST" action="/app/bots/<%= s.id %>/stop"><button class="btn danger">STOP</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/app-shell-end') %>
