<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const levels = Array.isArray(referralLevels) ? referralLevels : [];
const treeRows = Array.isArray(referralTreeRows) ? referralTreeRows : [];
const totalMembers = pagination && pagination.total ? pagination.total : treeRows.length;
const incomeSummary = referralIncomeSummary || { totalScoinIncome: 0, totalRewardCount: 0, byLevel: [] };
const incomeDetails = Array.isArray(referralIncomeDetails) ? referralIncomeDetails : [];
const incomePager = incomePagination || { page: 1, totalPages: 1, total: incomeDetails.length };
const memberPager = memberPagination || pagination || { page: 1, totalPages: 1, total: treeRows.length };

function incomeTypeLabel(item) {
  const type = String((item && item.tx_type) || '');
  if (type === 'referral_first_purchase_bonus' || type === 'qualified_referral_bonus') return 'โบนัสแนะนำตรงครั้งแรก 60%';
  if (/^referral_level_[1-5]_bonus$/.test(type)) {
    const foundLevel = type.match(/^referral_level_([1-5])_bonus$/);
    return `โบนัสสายงานชั้น ${foundLevel ? foundLevel[1] : Number((item && item.level_no) || 0) || '-'}`;
  }
  if (type === 'referral_level_bonus' || type === 'referral_reward') return `โบนัสสายงานชั้น ${Number((item && item.level_no) || 0) || '-'}`;
  return type || '-';
}

function fmtShortDate(value) {
  if (!value) return '-';
  try {
    return new Date(value).toLocaleString('th-TH', {
      timeZone: 'Asia/Bangkok',
      day: '2-digit',
      month: '2-digit',
      year: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    });
  } catch (e) {
    return '-';
  }
}
function incomeRuleText(item) {
  const type = String((item && item.tx_type) || '');
  if (type === 'referral_first_purchase_bonus' || type === 'qualified_referral_bonus') return 'แนะนำตรงครั้งแรก: 60% ครั้งเดียว ไม่แบ่งสายงาน';
  if (/^referral_level_[1-5]_bonus$/.test(type) || type === 'referral_level_bonus' || type === 'referral_reward') {
    const level = Number((item && item.level_no) || 0);
    const percent = level === 1 ? 8 : level === 2 ? 5 : level === 3 ? 3 : level === 4 ? 2 : level === 5 ? 2 : Number((item && item.reward_percent) || 0);
    return `ซื้อแพ็กเกจด้วยเงินจริง แบ่งสายงานชั้น ${level || '-'} = ${percent || '-'}%`;
  }
  return '-';
}

%>

<% pageCss = 'app-referrals.css'; %>
<%- include('../partials/app-shell') %>

