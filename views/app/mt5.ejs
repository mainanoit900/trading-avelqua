<script>
(function () {
  const PRESET_LABEL = {
    'ak-sniper': 'AK-SNIPER',
    'pa-sniper': 'PA-SNIPER',
    '5pa-sniper': '5PA-SNIPER',
    'sniper-demo': 'sniper-demo'
  };

  function updateMt5Stats(balance, equity, profit) {
    const balEl = document.getElementById('mt5StatBalance');
    const eqEl = document.getElementById('mt5StatEquity');
    const prEl = document.getElementById('mt5StatProfit');
    if (balEl) balEl.textContent = fmtMt5Money(balance);
    if (eqEl) eqEl.textContent = fmtMt5Money(equity);
    if (prEl) {
      if (profit == null || !Number.isFinite(Number(profit))) {
        prEl.textContent = '—';
        prEl.className = 'mt5-profit-neutral';
      } else {
        const p = Number(profit);
        prEl.textContent = (p >= 0 ? '+' : '') + fmtMt5Money(p);
        prEl.className = p >= 0 ? 'mt5-profit-pos' : 'mt5-profit-neg';
      }
    }
  }

  function fmtMt5Money(v) {
    if (v == null || v === '' || Number.isNaN(Number(v))) return '—';
    const n = Number(v);
    if (!Number.isFinite(n) || n < 0) return '—';
    return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  window.fmtMt5Money = fmtMt5Money;

  function getMt5AccountId() {
    const hid = document.getElementById('mt5AccountId');
    if (hid && hid.value) return hid.value;
    const sel = document.getElementById('mt5AccountSelect');
    return sel && sel.value ? sel.value : '';
  }

  function equityFromAccountOption(sel) {
    if (!sel || !sel.options.length) return null;
    const opt = sel.options[sel.selectedIndex];
    if (!opt) return null;
    const eq = opt.getAttribute('data-equity');
    const bal = opt.getAttribute('data-balance');
    if (eq != null && eq !== '' && Number(eq) > 0) return Number(eq);
    if (bal != null && bal !== '' && Number(bal) > 0) return Number(bal);
    return null;
  }

  function updatePortLockEquity(equity, balance, syncing, profit) {
    const el = document.getElementById('mt5PortLockEquity');
    if (!el) return;
    if (syncing) {
      el.textContent = ' · รอข้อมูลทุน (~20 วิ)...';
      el.className = 'mt5-port-lock-equity syncing';
      return;
    }
    const eq = equity != null && Number(equity) > 0 ? Number(equity) : null;
    const bal = balance != null && Number(balance) > 0 ? Number(balance) : null;
    const v = eq != null ? eq : bal;
    if (v == null) {
      el.textContent = ' · กรอกทุนด้านล่าง';
      el.className = 'mt5-port-lock-equity syncing';
      const hint = document.getElementById('mt5CapitalHint');
      if (hint && hint.textContent.indexOf('บันทึกทุน') < 0) {
        hint.textContent =
          'ดึงอัตโนมัติไม่ได้ — ดู Equity บน MT5 แล้วกรอกในช่องเงินทุน กด「บันทึกทุนที่เห็นบน MT5」';
      }
      return;
    }
    let txt = ' · Equity $' + fmtMt5Money(v);
    const pr = profit != null && Number.isFinite(Number(profit)) ? Number(profit) : (eq != null && bal != null ? eq - bal : null);
    if (pr != null && Number.isFinite(pr)) {
      const prTxt = Math.abs(pr).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      txt += ' (' + (pr >= 0 ? '+' : '-') + '$' + prTxt + ')';
    }
    const ts = document.getElementById('mt5PortLockEquityTs');
    if (ts) {
      try {
        ts.textContent = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      } catch (_) {
        ts.textContent = '';
      }
    }
    if (el.dataset.lastVal !== String(v)) {
      el.classList.remove('flash');
      void el.offsetWidth;
      el.classList.add('flash');
    }
    el.dataset.lastVal = String(v);
    el.textContent = txt;
    el.className = 'mt5-port-lock-equity live';
  }
  window.updatePortLockEquity = updatePortLockEquity;

  window.syncPortLockFromLiveDashboard = function (instances) {
    const accId = Number(getMt5AccountId() || 0);
    if (!accId || !Array.isArray(instances)) return;
    const inst = instances.find(function (x) {
      return Number(x.mt5_account_id) === accId;
    });
    if (!inst) return;
    const st = String(inst.status || '').toLowerCase();
    const eq = inst.mt5_equity;
    const bal = inst.mt5_balance;
    if (eq == null && bal == null) return;
    const isBotActive = ['running', 'starting', 'restarting', 'pending'].includes(st);
    if (!isBotActive && !(Number(eq) > 0) && !(Number(bal) > 0)) return;
    const profitVal =
      inst.display_profit != null && Number.isFinite(Number(inst.display_profit))
        ? Number(inst.display_profit)
        : inst.profit != null && Number.isFinite(Number(inst.profit))
          ? Number(inst.profit)
          : null;
    applyEquityUiState(eq != null ? eq : null, bal != null ? bal : null, profitVal);
  };

  function applyEquityUiState(equity, balance, profit) {
    const capitalInput = document.getElementById('capital_manual');
    const capitalHint = document.getElementById('mt5CapitalHint');
    const eq = equity != null && Number(equity) > 0 ? Number(equity) : null;
    const bal = balance != null && Number(balance) > 0 ? Number(balance) : null;
    const profitVal =
      profit != null && Number.isFinite(Number(profit))
        ? Number(profit)
        : eq != null && bal != null
          ? eq - bal
          : null;
    updatePortLockEquity(eq, bal, false, profitVal);
    updateMt5Stats(bal, eq, profitVal);
    if (capitalHint) {
      capitalHint.textContent = eq
        ? ('ทุนจาก MT5: ' + fmtMt5Money(eq) + (bal ? ' · Balance ' + fmtMt5Money(bal) : '') + ' · อัปเดตทุก ~20 วิ')
        : 'เลือก PORT — ระบบอัปเดตทุนจาก MT5 ทุก ~20 วิ (ขั้นต่ำ $100)';
    }
    if (eq && capitalInput && (!capitalInput.dataset.userCapitalEdited || capitalInput.dataset.userCapitalEdited !== '1')) {
      capitalInput.value = eq >= 100 ? eq : 100;
    }
  }

  async function refreshAccountEquityFast(accountId) {
    if (!accountId) return null;
    try {
      const res = await fetch('/app/mt5/account-equity?account_id=' + encodeURIComponent(accountId), {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      return data.ok ? data : null;
    } catch (_) {
      return null;
    }
  }

  async function refreshAccountSnapshot(accountId, doVpsRefresh) {
    if (!accountId) return null;
    try {
      const waitQ = window.__mt5EquityWaitOnce ? '&wait=1' : '';
      if (window.__mt5EquityWaitOnce) window.__mt5EquityWaitOnce = false;
      const refreshQ = doVpsRefresh ? '&refresh=1' : '';
      const res = await fetch('/app/mt5/account-snapshot?account_id=' + encodeURIComponent(accountId) + waitQ + refreshQ, {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      return data.ok ? data : null;
    } catch (_) {
      return null;
    }
  }

  async function refreshPresetCalc() {
    const accountSel = document.getElementById('mt5AccountSelect');
    const botSel = document.getElementById('mt5BotSelect');
    const levelSel = document.getElementById('mt5TradeLevel');
    const capitalInput = document.getElementById('capital_manual');
    const lotInput = document.getElementById('mt5ManualLot');
    const presetHint = document.getElementById('mt5PresetHint');
    const lotHint = document.getElementById('mt5LotHint');
    const capitalHint = document.getElementById('mt5CapitalHint');
    if (!botSel || !levelSel) return;
    const accountId = getMt5AccountId();
    const botId = botSel.value;
    if (!accountId || !botId) return;
    const params = new URLSearchParams({
      mt5_account_id: accountId,
      bot_id: botId,
      trade_level: levelSel.value || 'medium',
      capital_manual: capitalInput && capitalInput.value ? capitalInput.value : '',
      manual_lot: lotInput && lotInput.value ? lotInput.value : ''
    });
    try {
      const res = await fetch('/app/mt5/preset-calc?' + params.toString(), {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) return;
      let snapBal = data.mt5Balance;
      let snapEq = data.mt5EquityKnown ? data.mt5Equity : null;
      if (!data.mt5EquityKnown) {
        const snap = await refreshAccountSnapshot(accountId);
        if (snap) {
          snapBal = snap.balance;
          snapEq = snap.hasEquity ? snap.equity : null;
        }
      }
      const optEq = accountSel ? equityFromAccountOption(accountSel) : null;
      if (snapEq == null && optEq != null) snapEq = optEq;
      applyEquityUiState(snapEq, snapBal);
      updateMt5Stats(snapBal, snapEq, data.mt5Profit);
      if (capitalHint && snapEq) {
        capitalHint.textContent =
          'Balance ' + fmtMt5Money(snapBal) + ' · Equity ' + fmtMt5Money(snapEq) +
          ' · ใช้ทุน ' + fmtMt5Money(data.capital);
      }
      const prevLot = document.getElementById('mt5PreviewLot');
      const prevT = document.getElementById('mt5PreviewT');
      const prevRec = document.getElementById('mt5PreviewCapRec');
      const prevSafe = document.getElementById('mt5PreviewCapSafe');
      if (prevLot) prevLot.textContent = (data.lot || '—') + ' / ' + (data.lotPlus || '—');
      if (prevT) prevT.textContent = (data.tStart || 0) + ' / ' + (data.tStop || 0) + (data.riskLabel ? ' · ' + data.riskLabel : '');
      if (prevRec) prevRec.textContent = data.capitalRecommend != null ? fmtMt5Money(data.capitalRecommend) : '—';
      if (prevSafe) {
        prevSafe.textContent =
          fmtMt5Money(data.capitalSafe) + ' / ' + fmtMt5Money(data.capitalMaxSafe) +
          (data.capitalFromTable ? ' (ตาราง)' : ' (คำนวณ 200%/300%)');
      }
      if (lotInput && (!lotInput.dataset.userEdited || lotInput.dataset.userEdited !== '1')) {
        const pkgLot = data.defaultLot != null ? data.defaultLot : (data.suggestedLot || data.lot || '');
        lotInput.value = pkgLot;
        lotInput.placeholder = String(pkgLot || '');
        lotInput.min = data.lotMin != null ? data.lotMin : lotInput.min;
        lotInput.max = data.lotMax != null ? data.lotMax : lotInput.max;
      }
      if (lotHint) {
        lotHint.textContent = data.packageLotHint || ('Lot แพ็กเกจ ' + (data.packageLotRange || ''));
      }
      const eaHint = document.getElementById('mt5EaSetHint');
      if (presetHint && data.presetSlug) {
        presetHint.textContent = (PRESET_LABEL[data.presetSlug] || data.presetSlug) +
          ' · แถว LOT ' + (data.lot || '') + ' · ' + (data.riskLabel || data.tradeLevel || '');
      }
      if (eaHint && data.eaSetFileName) {
        eaHint.textContent = data.eaAttachHint || ('Preset: ' + data.eaSetFileName);
      }
      const warn = document.getElementById('mt5LicenseWarn');
      if (warn) {
        if (data.eaLicenseOk === false && data.eaLicenseMessage) {
          warn.hidden = false;
          warn.textContent =
            data.eaLicenseMessage +
            (data.suggestedBotLabel ? ' → แนะนำ: ' + data.suggestedBotLabel : '');
          if (data.suggestedBotId && botSel) {
            const cur = String(botSel.value || '');
            if (cur !== String(data.suggestedBotId)) {
              botSel.value = String(data.suggestedBotId);
              botSel.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
        } else {
          warn.hidden = true;
          warn.textContent = '';
        }
      }
    } catch (_) {}
  }

  function applyPackageDefaultLot() {
    const lotInput = document.getElementById('mt5ManualLot');
    const lotHint = document.getElementById('mt5LotHint');
    const meta = window.__mt5PageMeta || {};
    if (!lotInput || lotInput.dataset.userEdited === '1') return;
    const def = meta.packageDefaultLot != null ? meta.packageDefaultLot : meta.packageLotMax;
    if (def == null) return;
    lotInput.value = def;
    lotInput.placeholder = String(def);
    if (meta.packageLotMin != null) lotInput.min = meta.packageLotMin;
    if (meta.packageLotMax != null) lotInput.max = meta.packageLotMax;
    if (lotHint) {
      lotHint.textContent =
        meta.packageGroup === 'ADVANCED'
          ? 'แพ็กเกจ ADVANCED · Lot เริ่มต้น ' + def + ' (แก้ได้)'
          : 'แพ็กเกจ ' + (meta.packageGroup || '') + ' · Lot ' + meta.packageLotMin + ' - ' + meta.packageLotMax + ' · ตั้งค่า ' + def;
    }
  }

  function mt5BindRunForm() {
    const lotInput = document.getElementById('mt5ManualLot');
    const capitalInput = document.getElementById('capital_manual');
    const accountSel = document.getElementById('mt5AccountSelect');
    const botSel = document.getElementById('mt5BotSelect');
    const levelSel = document.getElementById('mt5TradeLevel');
    if (!getMt5AccountId() || !botSel) return;
    applyPackageDefaultLot();
    if (lotInput && !lotInput.dataset.bound) {
      lotInput.dataset.bound = '1';
      lotInput.addEventListener('input', function () {
        lotInput.dataset.userEdited = lotInput.value ? '1' : '0';
      });
    }
    const bindEls = [botSel, levelSel, capitalInput];
    if (accountSel) bindEls.unshift(accountSel);
    bindEls.forEach(function (el) {
      if (!el || el.dataset.presetBound === '1') return;
      el.dataset.presetBound = '1';
      el.addEventListener('change', function () {
        const li = document.getElementById('mt5ManualLot');
        if (li && el !== capitalInput) {
          li.dataset.userEdited = '0';
          applyPackageDefaultLot();
        }
        refreshPresetCalc();
      });
    });
    if (capitalInput && capitalInput.dataset.presetInputBound !== '1') {
      capitalInput.dataset.presetInputBound = '1';
      capitalInput.addEventListener('input', function () {
        capitalInput.dataset.userCapitalEdited = capitalInput.value ? '1' : '0';
      });
      let saveEquityTimer = null;
      capitalInput.addEventListener('input', function () {
        refreshPresetCalc();
        clearTimeout(saveEquityTimer);
        saveEquityTimer = setTimeout(function () {
          const accId = getMt5AccountId();
          const v = Number(capitalInput.value);
          if (!accId || !Number.isFinite(v) || v <= 0) return;
          fetch('/app/mt5/save-equity', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ mt5_account_id: accId, equity: v })
          }).then(function () {
            applyEquityUiState(v, v);
            const sel = document.getElementById('mt5AccountSelect');
            if (sel) updateAccountSelectEquityLabel(sel, { hasEquity: true, equity: v, hasBalance: true, balance: v });
            refreshPresetCalc();
          }).catch(function () {});
        }, 800);
      });
      capitalInput.addEventListener('blur', function () {
        const accId = getMt5AccountId();
        const v = Number(capitalInput.value);
        if (!accId || !Number.isFinite(v) || v <= 0) return;
        fetch('/app/mt5/save-equity', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ mt5_account_id: accId, equity: v })
        }).then(function () {
          applyEquityUiState(v, v);
          const sel = document.getElementById('mt5AccountSelect');
          if (sel) updateAccountSelectEquityLabel(sel, { hasEquity: true, equity: v });
          refreshPresetCalc();
        }).catch(function () {});
      });
    }
    if (accountSel) {
      applyEquityUiState(equityFromAccountOption(accountSel), null);
    } else {
      const lockEl = document.getElementById('mt5PortLockEquity');
      const initEq = lockEl && lockEl.dataset.initialEquity ? Number(lockEl.dataset.initialEquity) : null;
      const initBal = lockEl && lockEl.dataset.initialBalance ? Number(lockEl.dataset.initialBalance) : null;
      if ((initEq && initEq > 0) || (initBal && initBal > 0)) {
        applyEquityUiState(initEq, initBal);
      }
    }
    refreshPresetCalc();
    const runForm = document.getElementById('mt5RunForm');
    if (runForm && runForm.dataset.ajaxBound !== '1') {
      runForm.dataset.ajaxBound = '1';
      runForm.addEventListener('submit', mt5SubmitRunForm);
    }
    const resetBtn = document.getElementById('mt5BtnTradingReset');
    if (resetBtn && resetBtn.dataset.bound !== '1') {
      resetBtn.dataset.bound = '1';
      resetBtn.addEventListener('click', function (e) {
        e.preventDefault();
        mt5TradingReset();
      });
    }
  }
  window.mt5BindRunForm = mt5BindRunForm;
  window.mt5SubmitRunForm = mt5SubmitRunForm;
  mt5BindRunForm();
  if (typeof mt5RestoreTradeLevelSelect === 'function') mt5RestoreTradeLevelSelect();

  function updateAccountSelectEquityLabel(sel, snap) {
    if (!sel || !sel.options.length || !snap) return;
    const opt = sel.options[sel.selectedIndex];
    if (!opt) return;
    const login = opt.getAttribute('data-login') || '';
    const portMatch = opt.textContent.match(/^PORT\s+(\d+)/);
    const portSlot = portMatch ? portMatch[1] : '';
    let suffix = '';
    if (snap.hasEquity) {
      suffix = ' / Equity: ' + fmtMt5Money(snap.equity);
      opt.setAttribute('data-equity', String(snap.equity));
    }
    if (snap.hasBalance) opt.setAttribute('data-balance', String(snap.balance));
    opt.textContent = 'PORT ' + portSlot + ' / Login ' + login + suffix;
  }

  const MT5_EQUITY_POLL_MS = 30 * 60 * 1000;
  let mt5EquityVpsTick = 0;
  let mt5EquityVpsBusy = false;

  (function applyInitialPortLockEquity() {
    const el = document.getElementById('mt5PortLockEquity');
    if (!el) return;
    const eq = Number(el.getAttribute('data-initial-equity') || 0);
    const bal = Number(el.getAttribute('data-initial-balance') || 0);
    if (eq > 0 || bal > 0) applyEquityUiState(eq > 0 ? eq : null, bal > 0 ? bal : null);
  })();

  function applyEquitySnap(snap) {
    if (!snap) return;
    if (snap.hasEquity || snap.hasBalance) {
      applyEquityUiState(snap.hasEquity ? snap.equity : null, snap.hasBalance ? snap.balance : null, snap.profit);
      const sel = document.getElementById('mt5AccountSelect');
      if (snap.hasEquity && sel) updateAccountSelectEquityLabel(sel, snap);
    }
    const ts = document.getElementById('mt5PortLockEquityTs');
    if (ts) {
      try {
        ts.textContent = 'Live · ' + new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      } catch (_) {
        ts.textContent = 'Live';
      }
    }
  }

  function pollAccountEquity() {
    const accId = getMt5AccountId();
    if (!accId) return;

    refreshAccountEquityFast(accId).then(applyEquitySnap);

    mt5EquityVpsTick += 1;
    if (mt5EquityVpsBusy) return;
    mt5EquityVpsBusy = true;
    refreshAccountSnapshot(accId, true)
      .then(function (snap) {
        if (snap && snap.hasEquity) applyEquitySnap(snap);
        else if (snap && !snap.syncing) {
          const capitalHint = document.getElementById('mt5CapitalHint');
          const cap = document.getElementById('capital_manual');
          if (capitalHint) {
            capitalHint.textContent =
              'ยังอ่านทุนจาก MT5 ไม่ได้ — ตรวจว่า MT5 เปิดอยู่และ Agent service รันอยู่ หรือใส่ทุนมือ (ขั้นต่ำ $100)';
          }
          if (cap && !cap.value) cap.placeholder = 'ใส่ทุนมือ (เช่น 1000)';
        }
      })
      .finally(function () {
        mt5EquityVpsBusy = false;
      });
  }

  pollAccountEquity();
  setInterval(pollAccountEquity, MT5_EQUITY_POLL_MS);

  function drawEquityChart(canvas, series) {
    if (!canvas || !series || !series.length) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.clientWidth || 600;
    const h = canvas.height = 220;
    const vals = series.map(function (p) { return Number(p.equity || 0); });
    const min = Math.min.apply(null, vals);
    const max = Math.max.apply(null, vals);
    const pad = 12;
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = '#334155';
    ctx.beginPath();
    vals.forEach(function (v, i) {
      const x = pad + (i / Math.max(1, vals.length - 1)) * (w - pad * 2);
      const y = h - pad - ((v - min) / Math.max(0.01, max - min)) * (h - pad * 2);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.strokeStyle = '#22c55e';
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  async function loadBotAnalytics(instanceId) {
    const panel = document.getElementById('mt5BotAnalyticsPanel');
    if (!panel || !instanceId) return;
    const card = document.getElementById('mt5BotAnalyticsCard');
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    panel.innerHTML = '<div class="mt5-empty">กำลังโหลดวิเคราะห์...</div>';
    try {
      const res = await fetch('/app/mt5/bot-analytics/' + instanceId, {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) {
        panel.innerHTML = '<div class="mt5-empty">' + (data.message || 'โหลดไม่สำเร็จ') + '</div>';
        return;
      }
      const inst = data.instance || {};
      const intel = data.intel || {};
      const profitCls = (data.profit || 0) >= 0 ? 'pos' : 'neg';
      let alertsHtml = '';
      (data.alerts || []).forEach(function (a) {
        alertsHtml += '<div class="mt5-alert-item ' + a.level + '">' + a.message + '</div>';
      });
      panel.innerHTML =
        '<div class="mt5-analytics-grid">' +
        '<div class="mt5-stat"><small>BOT</small><b>' + (inst.botName || inst.botCode) + '</b></div>' +
        '<div class="mt5-stat"><small>PORT</small><b>' + (inst.portSlot || '-') + '</b></div>' +
        '<div class="mt5-stat"><small>กำไร/ขาดทุน</small><b class="' + profitCls + '">' + (data.profit || 0) + '</b></div>' +
        '<div class="mt5-stat"><small>สถานะ</small><b>' + (inst.status || '-') + '</b></div>' +
        '</div>' +
        '<canvas id="mt5EquityCanvas" class="mt5-equity-canvas"></canvas>' +
        '<div class="mt5-intel-box"><h4>วิเคราะห์ตลาด (AI) — ' + (intel.direction || 'WAIT') + '</h4>' +
        '<p>' + (intel.technical_summary || '-') + '</p>' +
        '<p class="muted">' + (intel.risk_summary || '') + '</p></div>' +
        '<div class="mt5-alerts">' + (alertsHtml || '<div class="muted">ไม่มีแจ้งเตือนผิดปกติ</div>') + '</div>';
      drawEquityChart(document.getElementById('mt5EquityCanvas'), data.equitySeries || []);
    } catch (e) {
      panel.innerHTML = '<div class="mt5-empty">Error: ' + e.message + '</div>';
    }
  }

  window.loadMt5BotAnalytics = loadBotAnalytics;

  const runParam = new URLSearchParams(window.location.search).get('run');
  if (runParam) {
    loadBotAnalytics(runParam);
    const card = document.getElementById('mt5BotAnalyticsCard');
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  setInterval(function () {
    const firstRunning = document.querySelector('.mt5-table tbody tr .status.running, .mt5-table tbody tr .status.pending');
    if (firstRunning && !runParam) {
      const row = firstRunning.closest('tr');
      const stopForm = row && row.querySelector('form[action*="/mt5/stop/"]');
      if (stopForm) {
        const m = stopForm.action.match(/\/stop\/(\d+)/);
        if (m) loadBotAnalytics(m[1]);
      }
    }
  }, 8000);
})();
</script>

