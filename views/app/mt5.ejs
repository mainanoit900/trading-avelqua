  function bindMt5RunForm() {
    const form = document.getElementById('mt5RunForm');
    if (!form) return;
    let syncField = 'capital';

    function applyPresetDefaults(changedField) {
      const selected = mt5SelectedRunAccount();
      const hidden = form.querySelector('#mt5RunAccountId');
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const lotInput = form.querySelector('input[name="manual_lot"]');
      const botSelect = form.querySelector('select[name="bot_code"]');
      const levelSelect = form.querySelector('select[name="trade_level"]');
      const timeSelect = form.querySelector('select[name="run_time_mode"]');
      if (!selected || !hidden || !capitalInput || !lotInput || !botSelect) return;

      if (changedField === 'manual_lot') syncField = 'lot';
      if (changedField === 'capital_manual') syncField = 'capital';
      if (changedField === 'bot_code') {
        syncField = 'capital';
        const eqNow = mt5RunAccountCapital(selected);
        const defCap = mt5DefaultCapitalForBot(botSelect.value, eqNow);
        capitalInput.value = defCap > 0 ? mt5Fixed(defCap) : '';
      }

      hidden.value = String(selected.id);
      const actualCapital = mt5RunAccountCapital(selected);
      const botCode = botSelect.value;
      const minCap = mt5MinCapitalForBot(botCode);
      capitalInput.min = String(minCap);
      capitalInput.placeholder = actualCapital > 0 ? ('Equity: ' + actualCapital) : 'กรอกเงินทุน';

      const cfg = window.__mt5RunConfig || {};
      lotInput.min = String(mt5Num(cfg.packageLotMin, 0.01));
      lotInput.max = String(mt5Num(cfg.packageLotMax, 0.05));

      let capital = mt5Num(capitalInput.value, 0);
      if (!capital && actualCapital > 0) capital = actualCapital;
      const manualLot = mt5Num(lotInput.value, 0);
      const preview = mt5ComputeRunPreset(
        botCode,
        capital,
        manualLot,
        levelSelect ? levelSelect.value : 'medium',
        timeSelect ? timeSelect.value : 'auto',
        syncField
      );

      if (syncField === 'lot' && mt5BotKind(botCode) === 'ak') {
        capitalInput.value = preview.capital > 0 ? mt5Fixed(preview.capital) : '';
      } else if (mt5BotKind(botCode) !== 'quantum') {
        lotInput.value = mt5Fixed(preview.lot);
      }

      mt5ApplyRunFormVisibility(form);
      mt5RenderRunPresetSummary(form, preview);
      mt5UpdateRunSubmitState(form);
    }

    ['change', 'input'].forEach(function (eventName) {
      ['select[name="bot_code"]', 'select[name="trade_level"]', 'select[name="run_time_mode"]', 'input[name="capital_manual"]', 'input[name="manual_lot"]'].forEach(function (selector) {
        const field = form.querySelector(selector);
        if (field) {
          field.addEventListener(eventName, function () {
            const name = field.getAttribute('name') || '';
            applyPresetDefaults(name);
          });
        }
      });
    });

    form.addEventListener('submit', function (e) {
      const selected = mt5SelectedRunAccount();
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const botSelect = form.querySelector('select[name="bot_code"]');
      const lotInput = form.querySelector('input[name="manual_lot"]');
      const capital = mt5Num(capitalInput ? capitalInput.value : 0, mt5RunAccountCapital(selected));
      const botCode = botSelect ? botSelect.value : '';
      const preview = mt5ComputeRunPreset(
        botCode,
        capital,
        mt5Num(lotInput ? lotInput.value : 0, 0),
        form.querySelector('select[name="trade_level"]')?.value || 'medium',
        form.querySelector('select[name="run_time_mode"]')?.value || 'auto',
        'capital'
      );
      if (!selected) {
        e.preventDefault();
        alert('กรุณาเลือก PORT ที่เชื่อมต่อแล้วก่อน Run BOT');
        return false;
      }
      if (preview.warning) {
        e.preventDefault();
        alert(preview.warning);
        return false;
      }
      if (capital < mt5Num(preview.minCapital, 100)) {
        e.preventDefault();
        alert('เงินทุนไม่ถึงขั้นต่ำของบอทที่เลือก');
        return false;
      }
      return true;
    });

    applyPresetDefaults('bot_code');
  }
  window.renderMt5RunFormHtml = renderMt5RunFormHtml;
  window.bindMt5RunForm = bindMt5RunForm;

  let mt5RunRenderSignature = '';

  function mt5RunDataSignature(accounts, bots) {
    return JSON.stringify({
      accounts: (accounts || []).map(function (a) {
        return [a.id, a.port_slot, a.assigned_port_no, a.mt5_login, a.last_equity, a.last_balance];
      }),
      activeInstances: (mt5RunState.activeInstances || []).map(function (row) {
        return [row.id, row.mt5_account_id, row.status, row.assigned_port_no];
      }),
      bots: (bots || []).map(function (b) {
        return [b.code || b.bot_code || '', b.label || b.display_name || b.bot_name || ''];
      })
    });
  }

  async function refreshMt5PortCards() {
    try {
      const res = await fetch('/app/mt5/ports-state', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) return;
      const list = document.getElementById('mt5PortList');
      if (list && Array.isArray(data.ports)) {
        list.innerHTML = data.ports.map(renderPortItemHtml).join('');
        if (typeof window.mt5BindPortSlotPicks === 'function') window.mt5BindPortSlotPicks();
      }
      const cntEl = document.getElementById('mt5ConnectedCount');
      if (cntEl) {
        const avail = data.availablePortCount != null ? data.availablePortCount : data.connectedCount;
        cntEl.textContent = String(avail || 0) + ' ช่องว่าง';
      }
      const tempBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="temporary"]');
      if (tempBtn) {
        const btn = tempBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddTemporary === false);
      }
      const permBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="permanent"]');
      if (permBtn) {
        const btn = permBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddPermanent === false);
      }
      const runPanel = document.getElementById('mt5RunPanel');
      if (runPanel) {
        const cfg = window.__mt5RunConfig || {};
        cfg.connectedAccounts = Array.isArray(data.connectedAccounts) ? data.connectedAccounts : [];
        cfg.activeInstances = Array.isArray(data.activeRunInstances) ? data.activeRunInstances : [];
        cfg.bots = Array.isArray(data.bots) && data.bots.length ? data.bots : (cfg.bots || []);
        window.__mt5RunConfig = cfg;
        mt5RunState.activeInstances = Array.isArray(cfg.activeInstances) ? cfg.activeInstances.slice() : [];
        const nextSignature = mt5RunDataSignature(cfg.connectedAccounts, cfg.bots || []);
        if (nextSignature !== mt5RunRenderSignature || !document.getElementById('mt5RunForm')) {
          mt5RunRenderSignature = nextSignature;
          runPanel.innerHTML = renderMt5RunFormHtml(cfg.connectedAccounts, cfg.bots || []);
          bindMt5RunForm();
        } else if (typeof window.mt5UpdateSharedPortSelections === 'function') {
          window.mt5UpdateSharedPortSelections();
        }
      }
    } catch (_) {}
  }
  window.refreshMt5PortCards = refreshMt5PortCards;

  async function finishMt5ConnectSuccess(message) {
    const msg = message || 'เชื่อมต่อสำเร็จ';
    mt5Checking = false;
    if (window.mt5Checker) {
      clearInterval(window.mt5Checker);
      window.mt5Checker = null;
    }
    sessionStorage.removeItem('mt5PollAccountId');
    if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    await refreshMt5PortCards();
    showMt5ConnectModal('success', msg);
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/app/mt5');
    }
  }

  function updateMt5ConnectMeta(data) {
    const metaBox = document.getElementById('mt5ConnectMeta');
    const badge = document.getElementById('mt5ConnectStepBadge');
    const elapsed = document.getElementById('mt5ConnectElapsed');
    const remaining = document.getElementById('mt5ConnectRemaining');
    const detail = document.getElementById('mt5ConnectStepDetail');
    const bar = document.getElementById('mt5ConnectProgressBar');
    if (!metaBox || !badge || !elapsed || !remaining || !detail || !bar) return;

    const step = data && data.step ? data.step : {};
    const stepIndex = Math.max(0, Number(step.index || 0));
    const stepTotal = Math.max(1, Number(step.total || 4));
    const isFailed = String(step.key || '').toLowerCase() === 'failed';
    const isConnected = String(step.key || '').toLowerCase() === 'connected';
    const width = isFailed ? 100 : Math.max(14, Math.min(100, Math.round((stepIndex / stepTotal) * 100)));

    metaBox.style.display = 'block';
    badge.textContent = step.label || 'กำลังตรวจสอบการเชื่อมต่อ';
    detail.textContent = step.detail || data.message || 'กำลังตรวจสอบการเชื่อมต่อ...';
    elapsed.textContent = 'ใช้เวลา ' + String(Number(data.elapsedSec || 0)) + ' วินาที';
    remaining.textContent = data.pending || data.checking
      ? 'เหลือประมาณ ' + String(Number(data.remainingSec || 0)) + ' วินาที'
      : '';
    bar.style.width = width + '%';
    bar.style.background = isFailed
      ? 'linear-gradient(90deg,#ef4444,#f97316)'
      : isConnected
        ? 'linear-gradient(90deg,#22c55e,#14b8a6)'
        : 'linear-gradient(90deg,#2563eb,#38bdf8)';
  }

  function clearLegacyMt5QueryState() {
    if (!window.history || !window.history.replaceState) return;
    if (!urlParams.get('connected') && !urlParams.get('failed') && !urlParams.get('msg')) return;
    window.history.replaceState({}, '', '/app/mt5');
  }
  clearLegacyMt5QueryState();
  const initialRunPanel = document.getElementById('mt5RunPanel');
  if (initialRunPanel) {
    mt5RunRenderSignature = mt5RunDataSignature(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    initialRunPanel.innerHTML = renderMt5RunFormHtml(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    bindMt5RunForm();
  }
  refreshMt5PortCards();
  const mt5PortCardRefreshTimer = window.setInterval(refreshMt5PortCards, 5000);

  window.mt5UnlockConnectBtn = function () {
    var b = document.getElementById('mt5ConnectBtn');
    if (!b) return;
    b.disabled = false;
    b.innerHTML = b.dataset.originalText || 'เชื่อมต่อ';
    b.style.opacity = '';
    b.style.pointerEvents = '';
  };

  async function checkMt5Connected() {
    if (!mt5Checking) return;
    try {
      let statusUrl = '/app/mt5/connect-status';
      if (mt5PollAccountId) {
        statusUrl += '?accountId=' + encodeURIComponent(mt5PollAccountId);
      }
      const res = await fetch(statusUrl, {
        cache: 'no-store',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const text = await res.text();
      let data;
      try {
        data = text ? JSON.parse(text) : {};
      } catch (_) {
        return;
      }
      if (res.status === 401) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', (data && data.message) || 'กรุณาเข้าสู่ระบบใหม่');
        return;
      }
      if (!data.ok) {
        if (data.message && /column.*does not exist/i.test(String(data.message))) {
          const btn = document.getElementById('mt5ConnectBtn');
          if (btn) btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      if (!data.account) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      const stWait = String(data.account.status || '').toLowerCase();
      if (stWait === 'deleted' || stWait === 'expired' || stWait === 'cancelled') {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      if (data.failed || stWait === 'failed') {
        mt5Checking = false;
        const accountId = String(data.account.id || '').trim();
        const modalDedupId = accountId + ':' + String(data.account.updated_at || '');
        const key = 'mt5FailedShownId';
        if (sessionStorage.getItem(key) !== modalDedupId) {
          sessionStorage.setItem(key, modalDedupId);
          if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
          sessionStorage.removeItem('mt5PollAccountId');
          showMt5ConnectModal('error', data.message || 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด');
        }
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        await refreshMt5PortCards();
        return;
      }
      if (stWait === 'connecting' || stWait === 'checking' || stWait === 'starting' || data.pending || data.checking) {
        const btn = document.getElementById('mt5ConnectBtn');
        const previewBox = document.getElementById('mt5LoginPreview');
        const previewImg = document.getElementById('mt5PreviewImg');
        const previewTitle = document.getElementById('mt5PreviewTitle');
        if (previewBox) previewBox.style.display = 'block';
        if (data.previewUrl && previewImg) {
          previewImg.src = data.previewUrl;
          previewImg.style.display = 'block';
        }
        if (previewTitle) {
          previewTitle.textContent = data.windowTitle
            ? 'Title bar: ' + data.windowTitle
            : 'รอหน้าต่าง MT5...';
        }
        updateMt5ConnectMeta(data);
        if (btn) {
          btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      const accountId = String(data.account.id || '').trim();
      const modalDedupId = accountId + ':' + String(data.account.updated_at || '');
      const key = data.connected ? 'mt5ConnectedShownId' : 'mt5FailedShownId';
      if (sessionStorage.getItem(key) === modalDedupId) {
        mt5Checking = false;
        clearInterval(window.mt5Checker);
        return;
      }
      if (
        data.metricsReady
        && (stWait === 'connected' || (data.connected === true && data.status === 'connected'))
      ) {
        sessionStorage.setItem(key, modalDedupId);
        const eqMsg = data.equity != null
          ? `เชื่อมต่อสำเร็จ — Equity: ${data.equity}`
          : (data.message || 'เชื่อมต่อสำเร็จ');
        finishMt5ConnectSuccess(eqMsg);
        return;
      }
    } catch (e) {}
  }

  window.finishMt5ConnectSuccess = finishMt5ConnectSuccess;

  window.startMt5ConnectPolling = function () {
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    mt5Checking = true;
    window.__mt5SuccessShown = false;
    sessionStorage.removeItem('mt5ConnectedShownId');
    window.mt5Checker = setInterval(checkMt5Connected, 800);
    checkMt5Connected();
  };

  if (serverPendingAccountId) {
    mt5PollAccountId = String(serverPendingAccountId);
    sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
    const pendingBtn = document.getElementById('mt5ConnectBtn');
    if (pendingBtn) {
      pendingBtn.disabled = true;
      pendingBtn.innerHTML = 'กำลังเชื่อมต่อ';
    }
  }

  if (mt5PollAccountId) {
    window.startMt5ConnectPolling();
  }

  window.addEventListener('pagehide', function () {
    mt5Checking = false;
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    clearInterval(mt5PortCardRefreshTimer);
  });
})();
</script>

<script>
(function(){
  const packageExpired = <%= packageExpired ? 'true' : 'false' %>;

const mt5ConnectForm = document.getElementById('mt5ConnectForm');
const mt5SelectedPortSlot = document.getElementById('mt5SelectedPortSlot');
const mt5LoginInput = document.getElementById('mt5LoginInput');

function isAllowedMt5LoginUser(login) {
  const value = String(login || '').trim();
  return /^2\d{8}$/.test(value) || /^8\d{7}$/.test(value);
}

function mt5LoginUserValidationMessage() {
  return 'Userไม่ถูกต้อง ';
}

function mt5SelectPortSlot(slot) {
  const n = Number(slot || 0);
  if (!n || !mt5SelectedPortSlot) return;
  mt5SelectedPortSlot.value = String(n);
  const runState = window.mt5RunState;
  const connected = runState && Array.isArray(runState.connectedAccounts) ? runState.connectedAccounts : [];
  const acc = connected.find(function (a) { return Number(a.port_slot) === n; });
  if (acc && typeof mt5SelectRunAccount === 'function') {
    mt5SelectRunAccount(acc.id);
  }
  if (typeof window.mt5UpdateSharedPortSelections === 'function') window.mt5UpdateSharedPortSelections();
}

/** เลือก PORT ว่างอัตโนมัติเมื่อกดเชื่อมต่อ (login พร้อมกันคนละ PORT) */
function mt5AutoPickEmptyConnectSlot() {
  const current = Number(mt5SelectedPortSlot?.value || 0);
  if (current) {
    const curCard = document.querySelector(
      '.port-card-pick[data-port-slot="' + current + '"]:not([data-account-id])'
    );
    if (curCard) return current;
  }
  const empty = document.querySelector('.port-card-pick[data-port-slot]:not([data-account-id])');
  if (empty) {
    const slot = Number(empty.getAttribute('data-port-slot') || 0);
    if (slot) {
      mt5SelectPortSlot(slot);
      return slot;
    }
  }
  return current;
}
window.mt5AutoPickEmptyConnectSlot = mt5AutoPickEmptyConnectSlot;

function mt5SelectRunAccount(accountId) {
  const id = Number(accountId || 0);
  if (!id) return;
  const runState = window.mt5RunState;
  if (!runState) return;
  runState.selectedAccountId = id;
  sessionStorage.setItem('mt5RunAccountId', String(id));
  if (typeof window.mt5UpdateSharedPortSelections === 'function') window.mt5UpdateSharedPortSelections();
  const panel = document.getElementById('mt5RunPanel');
  if (panel && typeof window.renderMt5RunFormHtml === 'function' && typeof window.bindMt5RunForm === 'function') {
    panel.innerHTML = window.renderMt5RunFormHtml(runState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    window.bindMt5RunForm();
  }
}

function mt5UpdateSharedPortSelections() {
  const connectSlot = Number(mt5SelectedPortSlot?.value || 0);
  const runState = window.mt5RunState;
  const runAccountId = Number(runState?.selectedAccountId || 0);
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    const slot = Number(el.getAttribute('data-port-slot') || 0);
    const accountId = Number(el.getAttribute('data-account-id') || 0);
    el.classList.toggle('selected-run', !!accountId && accountId === runAccountId);
    el.classList.toggle('selected-connect', !accountId && !!connectSlot && slot === connectSlot);
  });
}

function mt5BindPortSlotPicks() {
  document.querySelectorAll('.port-delete-form, .port-actions').forEach(function (el) {
    if (el.dataset.delBound === '1') return;
    el.dataset.delBound = '1';
    el.addEventListener('click', function (e) { e.stopPropagation(); });
    el.addEventListener('mousedown', function (e) { e.stopPropagation(); });
  });
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    if (el.dataset.pickBound === '1') return;
    el.dataset.pickBound = '1';
    function pick() {
      const accountId = Number(el.getAttribute('data-account-id') || 0);
      if (accountId) {
        mt5SelectRunAccount(accountId);
      } else {
        mt5SelectPortSlot(el.getAttribute('data-port-slot'));
      }
    }
    el.addEventListener('click', pick);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); }
    });
  });
  mt5UpdateSharedPortSelections();
}
window.mt5BindPortSlotPicks = mt5BindPortSlotPicks;
window.mt5UpdateSharedPortSelections = mt5UpdateSharedPortSelections;
mt5BindPortSlotPicks();

if (mt5ConnectForm) {
  mt5ConnectForm.addEventListener('submit', async function(e){
    e.preventDefault();

    if (packageExpired) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', 'แพ็คเกจหมดอายุ กรุณาต่ออายุแพ็กเกจก่อนเชื่อมต่อ MT5');
      return false;
    }

    const mt5LoginValue = String(mt5LoginInput?.value || '').trim();
    if (!isAllowedMt5LoginUser(mt5LoginValue)) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', mt5LoginUserValidationMessage());
      return false;
    }

    const connectSlot = mt5AutoPickEmptyConnectSlot();
  const connectCard = connectSlot
    ? document.querySelector('.port-card-pick[data-port-slot="' + connectSlot + '"]:not([data-account-id])')
    : null;
  const reconnectCard = connectSlot
    ? document.querySelector('.port-card-pick[data-port-slot="' + connectSlot + '"][data-account-id]')
    : null;
  if (!connectSlot) {
    (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
      'error',
      'ไม่มี PORT ว่าง — ลบ PORT เก่าหรือซื้อพอร์ตเพิ่มก่อน login พร้อมกัน'
    );
    return false;
  }
  if (reconnectCard && !connectCard) {
    const sameLogin = reconnectCard.querySelector('small');
    const titleText = sameLogin ? String(sameLogin.textContent || '') : '';
  const loginOnCard = titleText.includes(mt5LoginValue);
    if (loginOnCard) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'info',
        'บัญชีนี้เชื่อมต่อที่ PORT ' + connectSlot + ' อยู่แล้ว — ใช้ Run BOT หรือลบ PORT ก่อน login ใหม่'
      );
    } else {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'error',
        'PORT ' + connectSlot + ' มีบัญชีอื่นอยู่แล้ว — เลือก PORT ว่าง หรือลบ PORT นี้ก่อน'
      );
    }
    return false;
  }

    const mt5ConnectBtn = document.getElementById('mt5ConnectBtn');
    if (mt5ConnectBtn) {
      mt5ConnectBtn.disabled = true;
      mt5ConnectBtn.dataset.originalText = mt5ConnectBtn.innerHTML;
      mt5ConnectBtn.innerHTML = 'กำลังเชื่อมต่อ';
      mt5ConnectBtn.style.opacity = '0.6';
      mt5ConnectBtn.style.pointerEvents = 'none';
    }

    try {
      const formData = new FormData(mt5ConnectForm);
      const data = Object.fromEntries(formData.entries());

      const res = await fetch('/app/mt5/connect', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(data)
      });

      const raw = await res.text();
      let json;
      try {
        json = raw ? JSON.parse(raw) : {};
      } catch (_) {
        throw new Error(
          res.status === 401
            ? 'กรุณาเข้าสู่ระบบใหม่'
            : 'เซิร์ฟเวอร์ตอบกลับไม่ถูกต้อง กรุณารีเฟรชหน้าแล้วลองอีกครั้ง'
        );
      }
      const pop = typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert;

      if (json.ok === true && json.status === 'connected') {
        if (typeof window.finishMt5ConnectSuccess === 'function') {
          window.finishMt5ConnectSuccess(json.message || 'เชื่อมต่อสำเร็จ');
        } else {
          pop('success', json.message || 'เชื่อมต่อสำเร็จ');
        }
        return false;
      }

      if (json.ok === true && (json.status === 'queued' || json.status === 'pending' || json.status === 'upgrading' || json.accountId)) {
        if (json.accountId) {
          mt5PollAccountId = String(json.accountId);
          sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
        }
        if (typeof window.startMt5ConnectPolling === 'function') {
          window.startMt5ConnectPolling();
        }
        return false;
      }

      pop('error', json.message || 'Login ไม่สำเร็จ');
      await refreshMt5PortCards();
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    } catch (err) {
      await refreshMt5PortCards();
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', err.message || 'Login ไม่สำเร็จ');
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    }

    return false;
  });
}
})();
</script>

<script>
function mt5ManageEscape(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function mt5TradeLevelText(level) {
  const v = String(level || '').toLowerCase();
  if (v === 'high') return 'เสี่ยงสูง';
  if (v === 'medium') return 'เสี่ยงกลาง';
  if (v === 'low' || v === 'safe') return 'เสี่ยงต่ำ';
  return level || '-';
}

function mt5ManageData(el) {
  return el && el.dataset ? el.dataset : {};
}

function closeMt5ManageMenus(exceptMenu) {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(function (menu) {
    if (menu !== exceptMenu) menu.open = false;
  });
}

function positionMt5ManageMenu(menu) {
  if (!menu || !menu.open) return;
  const summary = menu.querySelector('summary');
  const dropdown = menu.querySelector('.mt5-manage-dropdown');
  if (!summary || !dropdown) return;
  const gap = 8;
  const rect = summary.getBoundingClientRect();
  const menuWidth = Math.max(dropdown.offsetWidth || 160, 160);
  const menuHeight = Math.max(dropdown.offsetHeight || 132, 132);
  const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 1280;
  const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 720;
  let left = rect.right - menuWidth;
  left = Math.max(12, Math.min(left, viewportWidth - menuWidth - 12));
  const shouldOpenUp = (viewportHeight - rect.bottom) < (menuHeight + 16) && rect.top > menuHeight;
  const top = shouldOpenUp
    ? Math.max(12, rect.top - menuHeight - gap)
    : Math.max(12, rect.bottom + gap);
  menu.style.setProperty('--mt5-manage-left', left + 'px');
  menu.style.setProperty('--mt5-manage-top', top + 'px');
  menu.classList.toggle('drop-up', shouldOpenUp);
}

function bindMt5ManageMenus(scope) {
  (scope || document).querySelectorAll('.mt5-manage-menu').forEach(function (menu) {
    if (menu.dataset.bound === '1') return;
    menu.dataset.bound = '1';
    menu.addEventListener('toggle', function () {
      if (menu.open) {
        closeMt5ManageMenus(menu);
        requestAnimationFrame(function () {
          positionMt5ManageMenu(menu);
        });
      } else {
        menu.classList.remove('drop-up');
      }
    });
  });
}

document.addEventListener('click', function (e) {
  const activeMenu = e.target.closest('.mt5-manage-menu');
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(function (menu) {
    if (menu !== activeMenu && !menu.contains(e.target)) menu.open = false;
  });
});

window.addEventListener('resize', function () {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(positionMt5ManageMenu);
});

document.addEventListener('scroll', function () {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(positionMt5ManageMenu);
}, true);

function mt5ShowManageModal(title, bodyHtml) {
  const old = document.getElementById('mt5ManageModal');
  if (old) old.remove();
  const modal = document.createElement('div');
  modal.id = 'mt5ManageModal';
  modal.className = 'mt5-manage-modal';
  modal.innerHTML = `
    <div class="mt5-manage-backdrop" onclick="closeMt5ManageModal()"></div>
    <div class="mt5-manage-card">
      <div class="mt5-manage-head">
        <div>
          <small>Manage</small>
          <h3>${mt5ManageEscape(title)}</h3>
        </div>
        <button type="button" class="mt5-manage-close" onclick="closeMt5ManageModal()">ปิด</button>
      </div>
      <div class="mt5-manage-body">${bodyHtml}</div>
    </div>
  `;
  document.body.appendChild(modal);
}

function closeMt5ManageModal() {
  document.getElementById('mt5ManageModal')?.remove();
}

function mt5ManageDetailGrid(rows) {
  return '<div class="mt5-manage-grid">' + rows.map((row) => `
    <div class="mt5-manage-box">
      <small>${mt5ManageEscape(row.label)}</small>
      <b>${mt5ManageEscape(row.value)}</b>
    </div>
  `).join('') + '</div>';
}

function openMt5InstanceDetail(el) {
  const d = mt5ManageData(el);
  mt5ShowManageModal(
    `รายละเอียด BOT #${d.instanceId || '-'}`,
    mt5ManageDetailGrid([
      { label: 'BOT', value: d.bot || '-' },
      { label: 'Login', value: d.login || '-' },
      { label: 'Funding', value: d.funding || '-' },
      { label: 'Lot', value: d.lot || '-' },
      { label: 'Level', value: mt5TradeLevelText(d.level) },
      { label: 'Status', value: d.status || '-' },
      { label: 'PORT', value: d.port || '-' },
      { label: 'VPS', value: d.node || '-' },
      { label: 'อัปเดตล่าสุด', value: d.updated || '-' }
    ])
  );
}

function openMt5InstanceAnalysis(el) {
  const d = mt5ManageData(el);
  const status = String(d.status || '').toLowerCase();
  let summary = 'รายการนี้พร้อมใช้งาน';
  let action = 'ยังไม่ต้องทำอะไรเพิ่มเติม';
  if (status === 'running') {
    summary = 'BOT กำลังทำงานอยู่บน VPS';
    action = 'ติดตาม Equity และใช้เมนู Dashboard หากต้อง Restart หรือดูกราฟ';
  } else if (status === 'pending' || status === 'restarting') {
    summary = 'ระบบกำลังรอ Agent รับคำสั่ง';
    action = 'รอสถานะอัปเดตอีกเล็กน้อย หากค้างนานค่อยสั่ง Restart';
  } else if (status === 'failed') {
    summary = 'BOT มีสถานะผิดพลาด';
    action = 'ควรตรวจ Login, Funding, และสถานะ VPS ก่อนสั่งรันใหม่';
  } else if (status === 'stopped') {
    summary = 'BOT ถูกหยุดแล้ว';
    action = 'สามารถลบประวัติหรือสั่ง Run ใหม่จาก PORT เดิมได้';
  }

  mt5ShowManageModal(
    `วิเคราะห์ ${d.bot || 'BOT'}`,
    `
      <div class="mt5-manage-analysis">
        <div class="mt5-manage-box">
          <small>สรุป</small>
          <b>${mt5ManageEscape(summary)}</b>
        </div>
        <div class="mt5-manage-box">
          <small>คำแนะนำ</small>
          <b>${mt5ManageEscape(action)}</b>
        </div>
      </div>
      ${mt5ManageDetailGrid([
        { label: 'Login', value: d.login || '-' },
        { label: 'Funding', value: d.funding || '-' },
        { label: 'Lot', value: d.lot || '-' },
        { label: 'Level', value: mt5TradeLevelText(d.level) },
        { label: 'Status', value: d.status || '-' }
      ])}
    `
  );
}

function mt5Sparkline(values) {
  const list = Array.isArray(values) ? values.map((v) => Number(v || 0)) : [];
  if (!list.length) {
    return '<div class="mt5-empty">ยังไม่มีข้อมูล Equity เพียงพอสำหรับกราฟ</div>';
  }
  const min = Math.min(...list);
  const max = Math.max(...list);
  const spread = Math.max(1, max - min);
  const points = list.map((v, idx) => {
    const x = (idx / Math.max(1, list.length - 1)) * 100;
    const y = 100 - (((v - min) / spread) * 76 + 12);
    return `${x},${y}`;
  }).join(' ');
  return `
    <div class="mt5-chart-meta">
      <span>ต่ำสุด ${mt5ManageEscape(min.toFixed(2))}</span>
      <span>สูงสุด ${mt5ManageEscape(max.toFixed(2))}</span>
      <span>จุดข้อมูล ${mt5ManageEscape(String(list.length))}</span>
    </div>
    <svg class="mt5-equity-chart" viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Equity chart">
      <defs>
        <linearGradient id="mt5EquityLine" x1="0" x2="1">
          <stop offset="0%" stop-color="#38bdf8"></stop>
          <stop offset="100%" stop-color="#22c55e"></stop>
        </linearGradient>
      </defs>
      <polyline fill="none" stroke="url(#mt5EquityLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="${points}"></polyline>
    </svg>
  `;
}

function mt5Money(value, digits = 2) {
  const n = Number(value);
  return Number.isFinite(n) ? n.toFixed(digits) : '-';
}

async function openMt5EquityGraph(el) {
  const d = mt5ManageData(el);
  mt5ShowManageModal(`กราฟ ${d.bot || 'BOT'}`, '<div class="mt5-empty">กำลังโหลดกราฟ...</div>');
  try {
    const res = await fetch(`/app/mt5/equity-chart/${encodeURIComponent(d.instanceId || '')}`, {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });
    const json = await res.json();
    if (!json.ok) throw new Error('โหลดกราฟไม่สำเร็จ');
    const body = `
      ${mt5ManageDetailGrid([
        { label: 'BOT', value: d.bot || '-' },
        { label: 'Login', value: d.login || '-' },
        { label: 'PORT', value: d.port || '-' },
        { label: 'Status', value: d.status || '-' }
      ])}
      <div class="mt5-manage-chart-wrap">${mt5Sparkline(json.data || [])}</div>
    `;
    document.querySelector('#mt5ManageModal .mt5-manage-body').innerHTML = body;
  } catch (err) {
    document.querySelector('#mt5ManageModal .mt5-manage-body').innerHTML = `<div class="mt5-empty">กราฟโหลดไม่สำเร็จ: ${mt5ManageEscape(err.message || 'unknown error')}</div>`;
  }
}

window.closeMt5ManageModal = closeMt5ManageModal;
window.openMt5InstanceDetail = openMt5InstanceDetail;
window.openMt5InstanceAnalysis = openMt5InstanceAnalysis;
window.openMt5EquityGraph = openMt5EquityGraph;
</script>

<script>
let mt5LiveDashboardPage = 1;
let mt5HistoryDashboardPage = 1;
const MT5_DASHBOARD_REFRESH_MS = 60000;

function mt5DisplayStatus(row) {
  const s = String(row?.display_status || row?.status || '').trim().toLowerCase();
  if (s === 'running' || s === 'connecting' || s === 'stopped' || s === 'fail') return s;
  if (s === 'failed' || s === 'error') return 'fail';
  if (s === 'pending' || s === 'restarting' || s === 'starting') return 'connecting';
  return s || 'connecting';
}

function mt5DashboardUpdatedAt(row) {
  const raw = row?.last_agent_ping || row?.updated_at || row?.started_at;
  return raw ? new Date(raw).toLocaleString('th-TH') : '-';
}

function renderMt5DashboardTable(data, opts) {
  const mode = opts?.mode || 'live';
  const instances = data?.instances || [];
  if (!instances.length) {
    return '<div class="mt5-empty">ยังไม่มีรายการ BOT</div>';
  }

  const headLive = mode === 'live';
  let html = `
    <table class="mt5-table">
      <thead>
        <tr>
          <th>BOT</th>
          <th>Login</th>
          ${headLive ? '<th>PORT</th><th>Balance</th><th>Equity</th><th>Profit</th>' : '<th>Funding</th><th>Lot</th><th>Level</th>'}
          <th>Status</th>
          <th>ล่าสุด</th>
          <th>Manage</th>
        </tr>
      </thead>
      <tbody>
  `;

  instances.forEach(function (i) {
    const st = mt5DisplayStatus(i);
    const balanceNum = Number(i.mt5_balance || 0);
    const equityNum = Number(i.mt5_equity || 0);
    const profitNum = Number.isFinite(balanceNum) && Number.isFinite(equityNum) ? (equityNum - balanceNum) : null;
    const detailAttrs = `
      data-instance-id="${i.id || ''}"
      data-bot="${mt5ManageEscape(i.display_name || i.bot_name || i.bot_code || '-')}"
      data-login="${mt5ManageEscape(i.mt5_login || '-')}"
      data-funding="${i.capital_used != null ? i.capital_used : '-'}"
      data-lot="${i.lot_used != null ? i.lot_used : '-'}"
      data-level="${mt5ManageEscape(mt5TradeLevelText(i.trade_level || '-'))}"
      data-status="${mt5ManageEscape(st)}"
      data-port="${i.assigned_port_no || '-'}"
      data-node="${mt5ManageEscape(i.node_name || i.node_code || '-')}"
      data-updated="${mt5ManageEscape(mt5DashboardUpdatedAt(i))}"
    `;
    html += '<tr>';
    html += '<td>' + (i.display_name || i.bot_name || i.bot_code || '-') + '</td>';
    html += '<td>' + (i.mt5_login || '-') + '</td>';
    if (headLive) {
      html += '<td>' + (i.assigned_port_no || '-') + '</td>';
      html += '<td>' + mt5Money(i.mt5_balance || 0) + '</td>';
      html += '<td>' + mt5Money(i.mt5_equity || 0) + '</td>';
      html += '<td>' + (profitNum == null ? '-' : mt5Money(profitNum)) + '</td>';
    } else {
      html += '<td>' + (i.capital_used != null ? Number(i.capital_used).toFixed(2) : '-') + '</td>';
      html += '<td>' + (i.lot_used || '-') + '</td>';
      html += '<td>' + mt5ManageEscape(mt5TradeLevelText(i.trade_level || '-')) + '</td>';
    }
    html += '<td><span class="status ' + st + '">' + st + '</span></td>';
    html += '<td>' + mt5DashboardUpdatedAt(i) + '</td>';
    html += '<td><details class="mt5-manage-menu"><summary>Manage</summary><div class="mt5-manage-dropdown">';
    html += '<button type="button" class="mt5-manage-item" onclick="openMt5InstanceDetail(this)" ' + detailAttrs + '>รายละเอียด</button>';
    if (headLive) {
      html += '<button type="button" class="mt5-manage-item" onclick="openMt5EquityGraph(this)" ' + detailAttrs + '>กราฟ</button>';
      html += '<form method="POST" action="/app/mt5/request-restart/' + i.id + '" onsubmit="return confirm(\'ยืนยัน Restart BOT รายการนี้ใช่ไหม?\')"><button class="mt5-manage-item" type="submit">Restart</button></form>';
    } else {
      html += '<button type="button" class="mt5-manage-item" onclick="openMt5InstanceAnalysis(this)" ' + detailAttrs + '>วิเคราะห์</button>';
    }
    html += '<form method="POST" action="/app/mt5/instance/' + i.id + '/delete" onsubmit="return confirm(\'ยืนยันลบรายการนี้ใช่ไหม?\')"><button class="mt5-manage-item danger" type="submit">ลบ</button></form>';
    html += '</div></details></td></tr>';
  });

  html += '</tbody></table>';
  const page = Number(data.page || 1);
  const pageCount = Number(data.pageCount || 1);
  if (pageCount > 1) {
    const prevFn = mode === 'live' ? 'changeMt5LiveDashboardPage' : 'changeMt5HistoryDashboardPage';
    const nextFn = prevFn;
    html += '<div class="mt5-pager">';
    html += '<button type="button" class="mt5-pager-btn' + (data.hasPrev ? '' : ' disabled') + '" ' + (data.hasPrev ? ('onclick="' + prevFn + '(' + (page - 1) + ')"') : 'disabled') + '>ก่อนหน้า</button>';
    html += '<span class="mt5-pager-meta">หน้า <b>' + page + '</b> / ' + pageCount + '</span>';
    html += '<button type="button" class="mt5-pager-btn primary' + (data.hasNext ? '' : ' disabled') + '" ' + (data.hasNext ? ('onclick="' + nextFn + '(' + (page + 1) + ')"') : 'disabled') + '>ถัดไป</button>';
    html += '</div>';
  }
  return html;
}

function changeMt5LiveDashboardPage(nextPage) {
  mt5LiveDashboardPage = Math.max(1, Number(nextPage || 1));
  loadMt5LiveDashboard(mt5LiveDashboardPage);
}

function changeMt5HistoryDashboardPage(nextPage) {
  mt5HistoryDashboardPage = Math.max(1, Number(nextPage || 1));
  loadMt5HistoryDashboard(mt5HistoryDashboardPage);
}

window.changeMt5LiveDashboardPage = changeMt5LiveDashboardPage;
window.changeMt5HistoryDashboardPage = changeMt5HistoryDashboardPage;
bindMt5ManageMenus(document);

async function loadMt5LiveDashboard(page) {
  const box = document.getElementById('mt5LiveDashboard');
  if (!box) return;
  if (page != null) mt5LiveDashboardPage = Math.max(1, Number(page || 1));
  try {
    const res = await fetch('/app/mt5/live-dashboard?page=' + encodeURIComponent(mt5LiveDashboardPage), {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();
    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลด Live Dashboard ไม่สำเร็จ</div>';
      return;
    }
    box.innerHTML = renderMt5DashboardTable(data, { mode: 'live' });
    bindMt5ManageMenus(box);
  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">Live Dashboard Error: ' + e.message + '</div>';
  }
}

async function loadMt5HistoryDashboard(page) {
  const box = document.getElementById('mt5HistoryDashboard');
  if (!box) return;
  if (page != null) mt5HistoryDashboardPage = Math.max(1, Number(page || 1));
  try {
    const res = await fetch('/app/mt5/live-dashboard?page=' + encodeURIComponent(mt5HistoryDashboardPage), {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();
    const meta = document.getElementById('mt5HistoryMeta');
    if (meta && data.ok) {
      meta.textContent = '1 การรันต่อ 1 แถว · ทั้งหมด ' + (data.total || 0) + ' PORT · อัปเดตทุก 60 วินาที';
    }
    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลดประวัติไม่สำเร็จ</div>';
      return;
    }
    box.innerHTML = renderMt5DashboardTable(data, { mode: 'history' });
    bindMt5ManageMenus(box);
  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">ประวัติ Error: ' + e.message + '</div>';
  }
}

async function refreshMt5Dashboards() {
  await Promise.all([
    loadMt5LiveDashboard(mt5LiveDashboardPage),
    loadMt5HistoryDashboard(mt5HistoryDashboardPage)
  ]);
  if (typeof window.refreshMt5PortCards === 'function') {
    await window.refreshMt5PortCards();
  }
}

loadMt5LiveDashboard();
loadMt5HistoryDashboard();
setInterval(refreshMt5Dashboards, MT5_DASHBOARD_REFRESH_MS);
</script>

