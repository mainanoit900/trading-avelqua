          <% const canUsePort = acc && accStatus === 'connected'; %>
          <% const slotBusy = acc && ['connecting','checking','connected','ready','starting'].includes(accStatus); %>
          <% const cardPick = canUsePort || !slotBusy; %>
          <div class="port-item <%= canUsePort ? 'connected' : (accStatus === 'connecting' || accStatus === 'starting' ? 'checking' : (acc ? 'cancelled' : '')) %><%= cardPick ? ' port-card-pick' : '' %>" data-port-slot="<%= i %>"<%= acc ? (' data-account-id="' + acc.id + '"') : '' %><%= cardPick ? ' role="button" tabindex="0"' : '' %>>
