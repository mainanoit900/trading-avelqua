<%- include('../partials/app-shell') %>

<div class="mt5-page">
  <% /* if (error) { %><div class="mt5-alert danger"><%- error %></div><% } */ %>
  <% if (success && !error) { %>
  <div class="mt5-alert success" id="mt5SuccessAlert"><%- success %></div>
<% } %>
<% if (error) { %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof window.showMt5ConnectModal === 'function') {
    window.showMt5ConnectModal('error', <%- JSON.stringify(error) %>);
  }
});
</script>
<% } %>

<style>
.mt5-error-modal{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center}
.mt5-error-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(10px)}
.mt5-error-card{position:relative;width:min(460px,92vw);border-radius:28px;padding:32px;background:linear-gradient(145deg,#111827,#020617);border:1px solid rgba(248,113,113,.45);box-shadow:0 30px 100px rgba(0,0,0,.65),0 0 48px rgba(248,113,113,.18);color:#fff;text-align:center;animation:mt5ErrPop .22s ease-out}
.mt5-error-icon{width:68px;height:68px;margin:0 auto 16px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(248,113,113,.14);font-size:36px}
.mt5-error-card h3{margin:0 0 10px;font-size:24px;font-weight:900}
.mt5-error-card p{margin:0 0 24px;color:#fecaca;font-size:16px;line-height:1.6}
.mt5-error-card button{border:0;border-radius:16px;padding:13px 34px;font-weight:900;color:#fff;cursor:pointer;background:linear-gradient(135deg,#ef4444,#f97316);box-shadow:0 12px 28px rgba(239,68,68,.35)}
@keyframes mt5ErrPop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.port-item.port-slot-pick{cursor:pointer}
.port-item.port-slot-pick .port-main.port-slot-pick-hit{flex:1;cursor:pointer}
.port-item.port-slot-pick:hover{border-color:rgba(125,211,252,.45)}
.port-item.port-slot-pick.selected{border-color:#38bdf8;box-shadow:0 0 0 2px rgba(56,189,248,.25)}
.port-actions{position:relative;z-index:2}
.mt5-btn.mini.delete:disabled{opacity:.45;cursor:not-allowed}
.mt5-port-lock-equity{font-weight:800;margin-left:4px;white-space:nowrap}
.mt5-port-lock-equity.live{color:#86efac}
.mt5-port-lock-equity.syncing{color:#fde68a;font-size:.92em;animation:mt5EqPulse 1.4s ease-in-out infinite}
.mt5-port-lock-equity.flash{animation:mt5EqFlash .45s ease}
.mt5-port-lock-equity-ts{display:block;margin-top:4px;font-size:11px;color:#64748b;font-weight:600}
@keyframes mt5EqPulse{50%{opacity:.5}}
@keyframes mt5EqFlash{0%{color:#fef08a}100%{color:#86efac}}
.mt5-connect-steps{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.mt5-connect-step{font-size:11px;font-weight:700;padding:5px 10px;border-radius:999px;border:1px solid #334155;color:#64748b;background:#0f172a}
.mt5-connect-step.active{border-color:#38bdf8;color:#e0f2fe;background:rgba(56,189,248,.12)}
.mt5-connect-step.done{border-color:#22c55e;color:#bbf7d0;background:rgba(34,197,94,.1)}
.mt5-connect-diag b{color:#e2e8f0}
.mt5-connect-diag .warn{color:#fbbf24}
.mt5-connect-diag .err{color:#f87171}
</style>


  <section class="mt5-hero">
    <div>
      <div class="mt5-kicker">MH Markets / MT5 Connector</div>
      <h1>เชื่อมต่อ MT5 และรัน BOT ทองคำ</h1>
    </div>
  </section>

  <section class="mt5-package-panel mt5-package-panel-right">
    <div class="mt5-package-detail-card mt5-package-mini-card <%= packageExpired ? 'expired' : '' %>">
      <div class="mt5-card-head mt5-mini-head">
        <div>
          <h2>รายละเอียดแพ็กเกจที่ซื้อ</h2>
          <span><%= packageExpired ? 'หมดอายุแล้ว ระบบปิดการใช้งาน MT5' : 'ข้อมูลจริงจากระบบสมาชิก' %></span>
        </div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
      </div>

      <div class="mt5-mini-package-name"><%= displayPackageName || pkg.package_name %></div>

      <div class="mt5-detail-grid mt5-detail-grid-mini">
        <div><small>ประเภท</small><b><%= packageTypeText %></b></div>
        <div><small>รองรับ Lot</small><b><%= packageExpired ? '0' : (packageLotMin + ' - ' + packageLotMax) %></b></div>
        <div><small>รองรับ Port</small><b><%= packageExpired ? '0' : (packagePortRange || ('1 - ' + packageMaxPorts)) %> PORT</b><% if (!packageExpired && ((temporaryExtra || 0) + (permanentExtra || 0) > 0)) { %> <small>+ เพิ่ม <%= (temporaryExtra || 0) + (permanentExtra || 0) %> (รวม <%= totalPorts %>)</small><% } %></div>
        <div><small>ใช้งานระบบได้</small><b><%= displayPackageDaysText || '-' %></b></div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
        <div>
  <small>จะหมดอีก</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : (packageDaysLeft + ' วัน') 
    %>
  </b>
</div>
        <div><small>พอร์ตว่าง</small><b id="mt5ConnectedCount"><%= packageExpired ? '0' : (typeof availablePortCount !== 'undefined' ? availablePortCount : connectedCount) %> PORT</b> <small>/ <%= packageExpired ? '0' : totalPorts %> ช่อง</small></div>
      </div>
    </div>
  </section>

  <% if (packageExpired) { %>
    <div class="mt5-expired-banner">
      <b>แพ็คเกจหมดอายุ</b> ระบบตั้ง PORT เป็น 0, ปิดปุ่มเชื่อมต่อ MT5 และส่งคำสั่งให้ Agent ออก terminal64 แล้ว
    </div>
  <% } %>

  <section class="mt5-grid mt5-grid-2">
    <div class="mt5-card">
      <div class="mt5-card-head">
        <h2>1) เลือก PORT ตามแพ็กเกจ</h2>
        <span>แพ็กเกจให้ <%= includedPorts || 1 %> PORT (สูงสุด <%= packagePortRange || ('1 - ' + packageMaxPorts) %>) · ใช้ได้ <%= totalPorts %> PORT / Lot <%= packageLotMin %>-<%= packageLotMax %></span>
      </div>
      <div class="port-list" id="mt5PortList">
        <% if (totalPorts <= 0) { %>
          <div class="port-item cancelled"><div class="port-main"><div><b>PORT 0</b><small>แพ็คเกจหมดอายุ</small></div><span>ใช้งานไม่ได้</span></div></div>
        <% } %>
        <% for (let i = 1; i <= totalPorts; i++) { %>
          <% const acc = typeof pickAccountForPortSlot === 'function' ? pickAccountForPortSlot(portSlotAccounts || accounts, i) : (accounts || []).find(a => Number(a.port_slot) === i); %>
          <% const accStatus = acc ? String(acc.status || '').toLowerCase() : ''; %>
          <% const canUsePort = acc && accStatus === 'connected'; %>
          <div class="port-item port-slot-pick <%= canUsePort ? 'connected' : (accStatus === 'connecting' || accStatus === 'starting' ? 'checking' : (acc ? 'cancelled' : '')) %>" data-port-slot="<%= i %>">
            <div class="port-main port-slot-pick-hit" role="button" tabindex="0" data-port-slot="<%= i %>">
              <div>
                <b>PORT <%= i %></b>
                <small><%= acc ? ('Login: ' + acc.mt5_login + mt5EquitySuffix(acc)) : 'ยังไม่เชื่อมต่อ' %></small>
              </div>
              <span><%= canUsePort ? 'พร้อมรัน' : (accStatus === 'connecting' || accStatus === 'starting' ? 'กำลังเปิด MT5...' : (accStatus === 'checking' ? 'กำลังตรวจ Login' : (accStatus === 'failed' ? 'Login ไม่ผ่าน' : (accStatus === 'ready' ? 'ต้องเชื่อมต่อใหม่' : (acc ? 'ยกเลิกแล้ว' : 'ว่าง'))))) %></span>
            </div>
            <% if (acc) {
              const portBotRunning = (instances || []).some(function (i) {
                return Number(i.mt5_account_id) === Number(acc.id) &&
                  ['running','pending','starting','restarting'].indexOf(String(i.status || '').toLowerCase()) >= 0;
              });
            %>
              <div class="port-actions">
                <form method="POST" action="/app/mt5/account/<%= acc.id %>/delete" data-bot-running="<%= portBotRunning ? '1' : '0' %>" onsubmit="return deletePortCountdown(event, this)">
                  <button class="mt5-btn mini delete" type="submit" <%= portBotRunning ? 'disabled title="กรุณากด หยุด BOT ในขั้นตอน 3 ก่อนลบ"' : '' %>>ลบ</button>
                </form>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
      <div class="mt5-buy-row mt5-buy-single">
        <div class="mt5-add-port-menu" id="mt5AddPortMenu">
          <button type="button" class="mt5-btn warning mt5-add-port-main" onclick="toggleAddPortMenu()" <%= packageExpired ? 'disabled' : '' %>>+ เพิ่มพอร์ต</button>
          <div class="mt5-add-port-dropdown" id="mt5AddPortDropdown">
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ต', '1 Scoin', 'พอร์ตชั่วคราว เพิ่มได้ไม่เกินสิทธิ์แพ็กเกจ และหมดอายุพร้อมแพ็กเกจ')">
              <input type="hidden" name="port_type" value="temporary">
              <button type="submit" class="mt5-port-choice" <%= (packageExpired || canAddTemporary === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ต</b>
                <small>1 Scoin · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> ช่อง</small>
              </button>
            </form>
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ตถาวร', '10 Scoin', 'พอร์ตถาวรผูกกับระดับแพ็กเกจปัจจุบัน BASIC / PRO / ADVANCED')">
              <input type="hidden" name="port_type" value="permanent">
              <button type="submit" class="mt5-port-choice permanent" <%= (packageExpired || canAddPermanent === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ตถาวร</b>
                <small>10 Scoin · ผูกกับระดับ <%= (pkg.package_group || 'BASIC') %> (เพิ่มช่องถาวร)</small>
              </button>
            </form>
          </div>
        </div>
        <div class="mt5-buy-note">
          ซื้อแพ็กเกจได้ <%= includedPorts || 1 %> PORT · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> · ถาวรผูกระดับ <b><%= (pkg.package_group || 'BASIC') %></b>
        </div>
      </div>
    </div>

    <div class="mt5-card">
      <div class="mt5-card-head">
        <h2>2) Login MT5</h2>
        <span><%= fixedServer %> — ตรวจบัญชีจริง · ไม่เปิด BOT</span>
      </div>

      <div class="mt5-login-port-pill" id="mt5LoginPortPill">
        ดู/จัดการ: <b id="mt5LoginPortLabel">คลิก PORT ด้านบน</b>
        <small id="mt5LoginPortHint" style="display:block;margin-top:6px;color:#94a3b8">เลือก PORT ว่างด้านบน หรือระบบจะเลือก PORT ว่างให้อัตโนมัติ · โฟลเดอร์ VPS ตามเลข PORT</small>
      </div>

      <form method="POST" action="/app/mt5/connect" class="mt5-form" id="mt5ConnectForm">
        <input type="hidden" name="port_slot" id="mt5SelectedPortSlot" value="">

  <div id="mt5LoginPreview" class="mt5-login-preview" style="display:none;margin:12px 0;padding:12px;background:#0b1220;border:1px solid #1e3a5f;border-radius:12px">
    <div style="font-size:13px;color:#93c5fd;margin-bottom:8px">
      <b>สถานะ Login MT5</b> — ไล่ 4 ขั้น (มักจบ 15–35 วิ) แล้วไป <b>ขั้นตอน 3</b> เลือกบอทจากรายการเว็บ → เปิด BOT (EA)
    </div>
    <div id="mt5ConnectSteps" class="mt5-connect-steps"></div>
    <div id="mt5ConnectDiag" class="mt5-connect-diag" style="font-size:12px;color:#94a3b8;margin:8px 0;line-height:1.5"></div>
    <div id="mt5PreviewPlaceholder" class="mt5-preview-placeholder" style="display:none;padding:20px;text-align:center;color:#64748b;font-size:13px;border:1px dashed #334155;border-radius:8px">
      รอภาพหน้าจอ MT5 จาก VPS Agent...
    </div>
    <img id="mt5PreviewImg" alt="MT5 Preview" style="max-width:100%;border-radius:8px;border:1px solid #334155;display:none">
    <div id="mt5PreviewTitle" style="font-size:12px;color:#cbd5e1;margin-top:8px;word-break:break-all"></div>
    <div style="font-size:11px;color:#64748b;margin-top:6px">ถ้าใช้ RDP เข้า VPS จะเห็นหน้าต่าง MT5 บนเดสก์ท็อป Windows โดยตรง</div>
  </div>

        <label>MT5 Login</label>
        <input name="mt5_login" id="mt5LoginInput" placeholder="เช่น 12345678" inputmode="numeric" autocomplete="username" required>

        <label>Password</label>
        <input name="mt5_password" id="mt5PasswordInput" type="password" placeholder="รหัสผ่าน MT5" autocomplete="current-password" required>

        <label class="mt5-remember-login" style="display:flex;align-items:center;gap:8px;margin-top:8px;font-weight:normal;color:#94a3b8">
          <input type="checkbox" id="mt5RememberLogin" checked style="width:auto">
          จำเลข Login (ไม่เก็บรหัสผ่าน)
        </label>

        <label>Server (ล็อค)</label>
        <input value="<%= fixedServer %>" disabled readonly>
        <input type="hidden" name="server_name" value="<%= fixedServer %>">
        <small style="color:#94a3b8;display:block;margin-top:4px">ใช้ได้เฉพาะ <b><%= fixedServer %></b> เท่านั้น</small>

        <button type="submit" id="mt5ConnectBtn" class="mt5-btn primary" <%= packageExpired ? 'disabled' : '' %>>
  <%= packageExpired ? 'แพ็คเกจหมดอายุ' : 'เชื่อมต่อ' %>
</button>
      </form>
    </div>
  </section>

  <section class="mt5-card" id="mt5BotSection">
    <div class="mt5-card-head">
      <h2>3) เปิด / หยุด BOT</h2>
      <span id="mt5BotSectionSubtitle"><% if (typeof activePortSlot !== 'undefined' && activePortSlot) { %>PORT <%= activePortSlot %> — ตั้งค่าเปิด/หยุด BOT<% } else { %>เลือก PORT จากขั้นตอน 1<% } %></span>
    </div>

    <div id="mt5RunPanel">
    <% const ac = typeof activeAccount !== 'undefined' ? activeAccount : null; const bi = typeof activeBotInstance !== 'undefined' ? activeBotInstance : null; const _activeSt = ['running','pending','starting','restarting']; const _stopInst = bi && bi.id && _activeSt.indexOf(String(bi.status||'').toLowerCase()) >= 0 ? bi : ((instances || []).find(function(i) { var st = String(i.status||'').toLowerCase(); if (_activeSt.indexOf(st) < 0) return false; if (ac && Number(i.mt5_account_id) === Number(ac.id)) return true; if (ac && Number(i.assigned_port_no) === Number(ac.port_slot)) return true; return false; }) || null); const stopInstId = _stopInst ? Number(_stopInst.id) : 0; const botOn = !!_stopInst; const _prefLvl = (typeof preferredTradeLevel !== 'undefined' && preferredTradeLevel) ? String(preferredTradeLevel).toLowerCase() : (_stopInst && _stopInst.trade_level ? String(_stopInst.trade_level).toLowerCase() : ''); %>
    <% if (!ac || String(ac.status||'').toLowerCase() !== 'connected') { %>
      <div class="mt5-empty">Login PORT <%= typeof activePortSlot !== 'undefined' && activePortSlot ? activePortSlot : 'ที่เลือก' %> ก่อน (ขั้นตอน 2) — ระบบยังไม่เปิด BOT ให้เอง</div>
    <% } else { %>
      <div class="mt5-port-lock-card" id="mt5PortLockCard">
        <div class="mt5-port-lock-main">
          <div><small>PORT / บัญชี (ล็อกจาก Login)</small><b id="mt5PortLockLabel">PORT <%= ac.port_slot %> · Login <%= ac.mt5_login %><span id="mt5PortLockEquity" class="mt5-port-lock-equity <%= mt5EquitySuffix(ac) ? 'live' : 'syncing' %>" data-account-id="<%= ac.id %>" data-initial-equity="<%= ac.last_equity || '' %>" data-initial-balance="<%= ac.last_balance || '' %>"><%= mt5EquitySuffix(ac) ? mt5EquitySuffix(ac).replace(' / Equity: ', ' · Equity $') : ' · กำลังดึง Equity...' %></span></b><small id="mt5PortLockEquityTs" class="mt5-port-lock-equity-ts">Live</small></div>
          <span class="mt5-bot-state-pill <%= botOn ? 'on' : 'off' %>" id="mt5BotStatePill"><%= botOn ? 'BOT กำลังรัน' : 'BOT หยุดแล้ว' %></span>
        </div>
        <p class="mt5-port-lock-note">ใช้ PORT เดิมที่ Login — เปิด/หยุดด้วยปุ่มด้านล่าง · เปิด BOT ไม่ปิดโปรแกรม MT5 · หยุด BOT = หยุดเทรดเท่านั้น</p>
      </div>
      <form method="POST" action="/app/mt5/run" class="mt5-run-form" id="mt5RunForm">
        <input type="hidden" name="mt5_account_id" id="mt5AccountId" value="<%= ac.id %>">
        <input type="hidden" name="port_slot" id="mt5RunPortSlot" value="<%= ac.port_slot %>">
        <div class="mt5-form-row">
          <div>
            <label>1) BOT</label>
            <select name="bot_id" id="mt5BotSelect" required<%= botOn ? ' disabled' : '' %>>
              <% bots.forEach(function(b){ %>
                <option value="<%= b.id %>" data-code="<%= b.bot_code %>"<%= (typeof preferredBotId !== 'undefined' && preferredBotId && Number(preferredBotId) === Number(b.id)) ? ' selected' : '' %>><%= b.display_name || b.bot_name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label>2) ระดับความเสี่ยง</label>
            <select name="trade_level" id="mt5TradeLevel"<%= botOn ? ' disabled' : '' %>>
              <option value="high"<%= _prefLvl === 'high' ? ' selected' : '' %>>🔴 เสี่ยงสูง</option>
              <option value="medium"<%= (!_prefLvl || _prefLvl === 'medium') ? ' selected' : '' %>>🟡 เสี่ยงกลาง</option>
              <option value="low"<%= _prefLvl === 'low' ? ' selected' : '' %>>🟢 เสี่ยงต่ำ</option>
            </select>
            <small class="mt5-hint" id="mt5PresetHint">อิงตาราง admin ตาม LOT</small>
          </div>
        </div>

        <div class="mt5-form-row mt5-bot-config-row">
          <div>
            <label>3) เงินทุน (ขั้นต่ำ $100)</label>
            <input
  type="number"
  step="0.01"
  min="100"
  name="capital_manual"
  id="capital_manual"
  class="mt5-capital-input"
  placeholder="ดึงจาก MT5"
  value="<% const _capEq = ac.last_equity != null && Number(ac.last_equity) > 0 ? Number(ac.last_equity) : (ac.last_balance != null && Number(ac.last_balance) >= 100 ? Number(ac.last_balance) : ''); %><%= _capEq && _capEq >= 100 ? _capEq : '' %>"
  <%= botOn ? 'readonly' : '' %>
>
            <small class="mt5-hint" id="mt5CapitalHint">ทุนจริงจาก MT5 บน PORT นี้ (อัปเดตอัตโนมัติ)</small>
          </div>
          <div>
            <label>4) LOT</label>
            <input name="manual_lot" id="mt5ManualLot" type="number" step="0.01" min="<%= packageLotMin %>" max="<%= packageLotMax %>" value="<%= packageDefaultLot %>"<%= botOn ? ' readonly' : '' %>>
            <small class="mt5-hint" id="mt5LotHint">แพ็กเกจ <%= packageGroup %></small>
          </div>
        </div>
        <small class="mt5-hint" id="mt5EaSetHint">หลังเปิด BOT: MT5 ยังเปิดอยู่ — แนบ EA บน XAUUSD → Load preset → เปิด Algo Trading</small>
        <div class="mt5-license-warn" id="mt5LicenseWarn" hidden></div>
      </form>
        <div class="mt5-bot-command-bar" id="mt5BotCommandBar">
          <button type="submit" form="mt5RunForm" class="mt5-btn run" id="mt5BtnOpenBot" <%= (packageExpired || botOn) ? 'disabled' : '' %>>▶ เปิด BOT</button>
          <button type="button" class="mt5-btn stop" id="mt5BtnStopBot" data-instance-id="<%= stopInstId || '' %>" data-port-slot="<%= ac.port_slot %>" data-account-id="<%= ac.id %>" <%= botOn && stopInstId ? '' : 'disabled' %> onclick="return mt5StopBot()">■ หยุด BOT</button>
          <button type="button" class="mt5-btn ghost" id="mt5BtnTradingReset" data-port-slot="<%= ac.port_slot %>" data-account-id="<%= ac.id %>">↺ รีเซ็ตตั้งค่า</button>
          <% if (stopInstId) { %>
          <form method="POST" action="/app/mt5/request-restart/<%= stopInstId %>" style="display:inline" onsubmit="return confirm('Restart BOT #<%= stopInstId %> ใช่ไหม?')">
            <button type="submit" class="mt5-btn ghost" id="mt5BtnRestartBot" <%= botOn ? '' : 'disabled' %>>↻ Restart</button>
          </form>
          <% } else { %>
          <button type="button" class="mt5-btn ghost" id="mt5BtnRestartBot" disabled>↻ Restart</button>
          <% } %>
        </div>
    <% } %>
    </div>
  </section>

  <section class="mt5-card" id="mt5LiveDashboardSection">
    <div class="mt5-card-head">
      <h2>📡 Live MT5 Dashboard</h2>
      <span>WebSocket/Live Refresh</span>
    </div>
    <div id="mt5DiagBanner" class="mt5-alert danger" style="display:none;margin-bottom:12px"></div>
    <div id="mt5LiveDashboard" class="mt5-table-wrap">
      กำลังโหลดข้อมูล...
    </div>
  </section>

  <section class="mt5-card">
    <div class="mt5-card-head">
      <h2>BOT ที่กำลังทำงาน / ประวัติล่าสุด</h2>
      <span>5 รายการต่อหน้า</span>
    </div>
    <div class="mt5-table-wrap" id="mt5HistoryTableWrap">
      <table class="mt5-table" id="mt5HistoryTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>BOT</th>
            <th>VPS</th>
            <th>PORT</th>
            <th>Fund</th>
            <th>Lot</th>
            <th>Level</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!instances || instances.length === 0) { %>
            <tr><td colspan="9" class="mt5-empty-cell">ยังไม่มีรายการรัน BOT</td></tr>
          <% } %>
          <% (instances || []).forEach(function(i){
            const histDate = i.started_at || i.created_at;
            const histDateStr = histDate && typeof fmtDateView === 'function'
              ? fmtDateView(histDate)
              : (histDate ? String(histDate).slice(0, 16).replace('T', ' ') : '-');
            const fundVal = Number(i.capital_used || i.mt5_equity || i.account_equity || i.mt5_balance || i.account_balance || 0);
            const fundStr = fundVal > 0
              ? fundVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
              : '-';
            const histActive = ['running','pending','starting','restarting'].includes(String(i.status||'').toLowerCase());
          %>
            <tr data-mt5-history-row="1">
              <td><%= histDateStr %></td>
              <td><%= i.display_name || i.bot_name || i.bot_code %></td>
              <td><%= i.node_name || i.node_code || '-' %></td>
              <td><%= i.assigned_port_no || '-' %></td>
              <td><%= fundStr %></td>
              <td><%= i.lot_used || i.lot || '-' %></td>
              <td><%= typeof tradeLevelLabel === 'function' ? tradeLevelLabel(i.trade_level) : (i.trade_level || '-') %></td>
              <td><span class="status <%= i.status %>"><%= i.status %></span></td>
              <td class="mt5-row-actions">
                <div class="mt5-action-dd">
                  <button type="button" class="mt5-action-dd-btn" aria-label="เมนูจัดการ" aria-haspopup="true" aria-expanded="false" onclick="mt5ToggleActionDd(event, this)">
                    <svg class="mt5-action-dd-kebab" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="5" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="12" cy="19" r="1.75"/></svg>
                  </button>
                  <div class="mt5-action-dd-menu" hidden>
                    <div class="mt5-action-dd-menu-head">จัดการรายการ</div>
                    <button type="button" class="mt5-action-dd-item" onclick="mt5FocusInstance(<%= i.id %>, <%= Number(i.assigned_port_no) || 0 %>)">
                      <span class="mt5-dd-ico analyze" aria-hidden="true"></span>
                      <span class="mt5-dd-label">วิเคราะห์</span>
                    </button>
                    <% if (histActive) { %>
                      <form method="POST" action="/app/mt5/stop/<%= i.id %>" class="mt5-action-dd-form" onsubmit="return confirm('หยุดการเทรด BOT ใช่ไหม? (MT5 ยังเปิดอยู่)')">
                        <button type="submit" class="mt5-action-dd-item danger">
                          <span class="mt5-dd-ico stop" aria-hidden="true"></span>
                          <span class="mt5-dd-label">หยุด</span>
                        </button>
                      </form>
                    <% } %>
                    <form method="POST" action="/app/mt5/instance/<%= i.id %>/remove<%= i.assigned_port_no ? '?port_slot=' + i.assigned_port_no : '' %>" class="mt5-action-dd-form" onsubmit="return confirm('เอารายการนี้ออกจากประวัติใช่ไหม?')">
                      <button type="submit" class="mt5-action-dd-item muted" <%= histActive ? 'disabled title="หยุด BOT ก่อน"' : '' %>>
                        <span class="mt5-dd-ico remove" aria-hidden="true"></span>
                        <span class="mt5-dd-label">เอาออก</span>
                      </button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="mt5-pager" id="mt5HistoryPager" aria-label="หน้าประวัติ BOT"></div>
    </div>
  </section>
</div>

<script>
(function () {
  let mt5Checking = false;
  const serverPendingAccountId = '<%= typeof pendingConnectAccountId !== "undefined" && pendingConnectAccountId ? pendingConnectAccountId : "" %>';
  let mt5PollAccountId = sessionStorage.getItem('mt5PollAccountId') || serverPendingAccountId || '';
  const urlParams = new URLSearchParams(window.location.search);
  let mt5StatusPollInFlight = false;

  function syncMt5PollAccountId() {
    const fromStore = sessionStorage.getItem('mt5PollAccountId') || '';
    if (fromStore) mt5PollAccountId = String(fromStore);
    return mt5PollAccountId;
  }

  window.setMt5PollAccountId = function (id) {
    mt5PollAccountId = id != null && id !== '' ? String(id) : '';
    if (mt5PollAccountId) sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
    else sessionStorage.removeItem('mt5PollAccountId');
    return mt5PollAccountId;
  };

  function mt5OutcomeStorageKey(kind, accountId, updatedAt) {
    return String(kind || '') + ':' + String(accountId || '') + ':' + String(updatedAt || '');
  }

  function mt5OutcomeWasShown(key) {
    if (!key) return false;
    return sessionStorage.getItem('mt5OutcomeShown') === key;
  }

  function mt5MarkOutcomeShown(key) {
    if (!key) return;
    sessionStorage.setItem('mt5OutcomeShown', key);
  }

  function showMt5ConnectModal(type, message, opts) {
    opts = opts || {};
    const dedupeKey =
      opts.dedupeKey ||
      String(type) + ':' + String((opts.accountId != null ? opts.accountId : '')) + ':' + String(message || '').slice(0, 120);
    const now = Date.now();
    if (window.__mt5LastModalKey === dedupeKey && now - (window.__mt5LastModalAt || 0) < 15000) {
      return false;
    }
    if (document.getElementById(type === 'success' ? 'mt5SuccessModal' : 'mt5ErrorModal')) {
      return false;
    }
    window.__mt5LastModalKey = dedupeKey;
    window.__mt5LastModalAt = now;
    if (type === 'error') {
      document.querySelectorAll('.mt5-alert.success, #mt5SuccessAlert').forEach(el => el.remove());
    }
    const modalId = type === 'success' ? 'mt5SuccessModal' : 'mt5ErrorModal';
    const existing = document.getElementById(modalId);
    if (existing) existing.remove();
    const isSuccess = type === 'success';
    const msg = String(message || '');
    const runBotErr = opts.runBot || /run bot|bot|เลือก bot|lot|ระดับเทรด|port นี้กำลังรัน/i.test(msg);
    const title = opts.title || (isSuccess ? 'เชื่อมต่อสำเร็จ' : (runBotErr ? 'ไม่สามารถรัน BOT ได้' : 'เชื่อมต่อไม่สำเร็จ'));
    const modal = document.createElement('div');
    modal.id = modalId;
    modal.className = 'mt5-lux-modal';
    modal.innerHTML = `
      <div class="mt5-lux-backdrop"></div>
      <div class="mt5-lux-card ${isSuccess ? 'success' : 'error'}">
        <div class="mt5-lux-icon">${isSuccess ? '✅' : '⚠️'}</div>
        <h3>${title}</h3>
        <p>${msg || (isSuccess ? 'เชื่อมต่อสำเร็จ' : 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด')}</p>
        <button type="button" onclick="document.getElementById('${modalId}')?.remove()">ตกลง</button>
      </div>
    `;
    document.body.appendChild(modal);
    return true;
  }

  window.showMt5ConnectModal = showMt5ConnectModal;

  window.__mt5PageMeta = {
    packageExpired: <%= packageExpired ? 'true' : 'false' %>,
    packageLotMin: <%= packageLotMin %>,
    packageLotMax: <%= packageLotMax %>,
    packageDefaultLot: <%= packageDefaultLot %>,
    packageGroup: '<%= packageGroup %>',
    preferredTradeLevel: '<%= typeof preferredTradeLevel !== "undefined" ? preferredTradeLevel : "" %>'
  };

  function mt5Esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderPortItemHtml(p) {
    const botRun = !!(p.botRunning || p.bot_running);
    const delBtn = botRun
      ? '<button class="mt5-btn mini delete" type="submit" disabled title="กรุณากด หยุด BOT ในขั้นตอน 3 ก่อนลบ">ลบ</button>'
      : '<button class="mt5-btn mini delete" type="submit">ลบ</button>';
    const del = p.accountId
      ? '<form method="POST" action="/app/mt5/account/' + p.accountId + '/delete" data-bot-running="' + (botRun ? '1' : '0') + '" onsubmit="return deletePortCountdown(event, this)">' +
        delBtn + '</form>'
      : '';
    const actions = p.accountId ? '<div class="port-actions">' + del + '</div>' : '';
    return (
      '<div class="port-item port-slot-pick ' + mt5Esc(p.cssClass) + '" data-port-slot="' + p.slot + '">' +
      '<div class="port-main port-slot-pick-hit" role="button" tabindex="0" data-port-slot="' + p.slot + '">' +
      '<div><b>PORT ' + p.slot + '</b><small>' + mt5Esc(p.sublabel) + '</small></div>' +
      '<span>' + mt5Esc(p.statusLabel) + '</span></div>' +
      actions +
      '</div>'
    );
  }

  function renderMt5RunFormHtml(connected, bots) {
    const meta = window.__mt5PageMeta || {};
    const expired = !!meta.packageExpired;
    const lotMin = meta.packageLotMin != null ? meta.packageLotMin : 0.01;
    const lotMax = meta.packageLotMax != null ? meta.packageLotMax : 0.5;
    const defaultLot = meta.packageDefaultLot != null ? meta.packageDefaultLot : lotMax;
    const opts = (connected || []).map(function (a) {
      const bal = Number(a.last_balance);
      const eq = Number(a.last_equity);
      const balOk = Number.isFinite(bal) && bal > 0;
      const eqOk = Number.isFinite(eq) && eq > 0;
      const eqTxt = eqOk ? (' / Equity: ' + eq.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '';
      return '<option value="' + a.id + '" data-balance="' + (balOk ? bal : '') + '" data-equity="' + (eqOk ? eq : '') + '" data-login="' + mt5Esc(a.mt5_login) + '">PORT ' + a.port_slot + ' / Login ' + mt5Esc(a.mt5_login) + eqTxt + '</option>';
    }).join('');
    const botOpts = (bots || []).map(function (b) {
      return '<option value="' + b.id + '" data-code="' + mt5Esc(b.bot_code || '') + '">' + mt5Esc(b.label) + '</option>';
    }).join('');
    let capitalVal = '';
    const firstConn = (connected || []).find(function (a) {
      const eq = Number(a.last_equity);
      return Number.isFinite(eq) && eq > 0;
    });
    if (firstConn) capitalVal = String(Number(firstConn.last_equity));
    const firstAcc = (connected || [])[0];
    const accId = firstAcc ? firstAcc.id : '';
    const portSlot = firstAcc ? firstAcc.port_slot : '';
    let savedLvl = meta.preferredTradeLevel || '';
    try {
      if (!savedLvl) savedLvl = localStorage.getItem('mt5TradeLevel') || '';
    } catch (_) {}
    function tradeOpt(v, label) {
      const sel =
        savedLvl === v || (!savedLvl && v === 'medium') ? ' selected' : '';
      return '<option value="' + v + '"' + sel + '>' + label + '</option>';
    }
    const tradeOpts =
      tradeOpt('high', '🔴 เสี่ยงสูง') +
      tradeOpt('medium', '🟡 เสี่ยงกลาง') +
      tradeOpt('low', '🟢 เสี่ยงต่ำ');
    return (
      '<form method="POST" action="/app/mt5/run" class="mt5-run-form" id="mt5RunForm">' +
      '<input type="hidden" name="mt5_account_id" id="mt5AccountId" value="' + accId + '">' +
      '<input type="hidden" name="port_slot" id="mt5RunPortSlot" value="' + portSlot + '">' +
      '<div class="mt5-form-row">' +
      '<div><label>1) BOT</label><select name="bot_id" id="mt5BotSelect" required>' + botOpts + '</select></div>' +
      '<div><label>2) ระดับความเสี่ยง</label><select name="trade_level" id="mt5TradeLevel">' + tradeOpts + '</select><small class="mt5-hint" id="mt5PresetHint"></small></div></div>' +
      '<div class="mt5-form-row mt5-bot-config-row">' +
      '<div><label>3) เงินทุน (ขั้นต่ำ $100)</label><input type="number" step="0.01" min="100" name="capital_manual" id="capital_manual" value="' + capitalVal + '"><small class="mt5-hint" id="mt5CapitalHint"></small></div>' +
      '<div><label>4) LOT</label><input name="manual_lot" id="mt5ManualLot" type="number" step="0.01" min="' + lotMin + '" max="' + lotMax + '" value="' + defaultLot + '"><small class="mt5-hint" id="mt5LotHint"></small></div></div>' +
      '<small class="mt5-hint" id="mt5EaSetHint">แนบ EA → Load preset</small>' +
      '<div class="mt5-bot-command-bar"><button type="submit" class="mt5-btn run"' + (expired ? ' disabled' : '') + '>▶ เปิด BOT</button></div></form>'
    );
  }

  async function refreshMt5PortCards() {
    try {
      const res = await fetch('/app/mt5/ports-state', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) return;
      const list = document.getElementById('mt5PortList');
      if (list && Array.isArray(data.ports)) {
        list.innerHTML = data.ports.map(renderPortItemHtml).join('');
        if (typeof window.mt5BindPortSlotPicks === 'function') window.mt5BindPortSlotPicks();
        const cur = String((document.getElementById('mt5SelectedPortSlot') || {}).value || '');
        const emptyApi = data.firstEmptySlot != null ? String(data.firstEmptySlot) : '';
        if (!cur || !document.querySelector('.port-item.selected')) {
          mt5EnsureEmptyPortSelected({ fromApi: emptyApi });
        }
      }
      const cntEl = document.getElementById('mt5ConnectedCount');
      if (cntEl) {
        const avail = data.availablePortCount != null ? data.availablePortCount : data.connectedCount;
        const total = data.totalPorts || data.createdPortCount || '';
        cntEl.innerHTML = String(avail || 0) + ' PORT' + (total ? ' <small>/ ' + total + ' ช่อง</small>' : '');
      }
      const tempBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="temporary"]');
      if (tempBtn) {
        const btn = tempBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddTemporary === false);
      }
      const permBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="permanent"]');
      if (permBtn) {
        const btn = permBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddPermanent === false);
      }
      const runPanel = document.getElementById('mt5RunPanel');
      if (runPanel && document.getElementById('mt5AccountId')) {
        /* ขั้นตอน 3 เรนเดอร์จากเซิร์ฟเวอร์ — ไม่แทนที่ด้วยฟอร์มเก่า */
      } else if (runPanel && (data.connectedAccounts || []).length > 0) {
        runPanel.innerHTML = renderMt5RunFormHtml(data.connectedAccounts, data.bots || []);
        if (typeof window.mt5BindRunForm === 'function') window.mt5BindRunForm();
      }
    } catch (_) {}
  }
  window.refreshMt5PortCards = refreshMt5PortCards;

  const MT5_SAVED_LOGIN_KEY = 'mt5SavedLogin';

  function mt5LoadSavedLogin() {
    try {
      const el = document.getElementById('mt5LoginInput');
      if (!el) return;
      const saved = localStorage.getItem(MT5_SAVED_LOGIN_KEY);
      if (saved && /^\d{5,12}$/.test(saved)) el.value = saved;
    } catch (_) {}
  }

  function mt5SaveLoginIfRemembered() {
    try {
      const el = document.getElementById('mt5LoginInput');
      const remember = document.getElementById('mt5RememberLogin');
      if (!el || !remember || !remember.checked) {
        localStorage.removeItem(MT5_SAVED_LOGIN_KEY);
        return;
      }
      const login = String(el.value || '').trim();
      if (/^\d{5,12}$/.test(login)) localStorage.setItem(MT5_SAVED_LOGIN_KEY, login);
    } catch (_) {}
  }

  function mt5ValidateLoginForm() {
    const login = String((document.getElementById('mt5LoginInput') || {}).value || '').trim();
    const pw = String((document.getElementById('mt5PasswordInput') || {}).value || '').trim();
    if (!/^\d{5,12}$/.test(login)) {
      return 'กรุณากรอก MT5 Login เป็นตัวเลข 5–12 หลัก';
    }
    if (!pw || pw.length < 4) {
      return 'กรุณากรอกรหัสผ่าน MT5';
    }
    return '';
  }

  /** PORT ว่าง = ไม่มีบัญชี connected/checking บนการ์ด */
  function mt5FirstEmptyPortSlotFromDom() {
    const cards = document.querySelectorAll('.port-item[data-port-slot]');
    for (let i = 0; i < cards.length; i++) {
      const card = cards[i];
      if (card.classList.contains('connected') || card.classList.contains('checking')) continue;
      const slot = card.getAttribute('data-port-slot');
      if (slot) return String(slot);
    }
    return '';
  }

  function mt5EnsureEmptyPortSelected(opts) {
    const o = opts || {};
    let slot =
      String((document.getElementById('mt5SelectedPortSlot') || {}).value || '').trim() ||
      mt5FirstEmptyPortSlotFromDom();
    if (!slot && o.fromApi) slot = String(o.fromApi);
    if (!slot) return '';
    const card = document.querySelector('.port-item[data-port-slot="' + slot + '"]');
    if (card && (card.classList.contains('connected') || card.classList.contains('checking'))) {
      slot = mt5FirstEmptyPortSlotFromDom();
    }
    if (slot && typeof window.mt5SelectPortSlot === 'function') {
      window.mt5SelectPortSlot(slot, { navigate: false });
    }
    const hint = document.getElementById('mt5LoginPortHint');
    if (hint && slot) {
      hint.textContent =
        'ใช้ PORT ' + slot + ' (ว่าง) · โฟลเดอร์ VPS ตามเลข PORT — ระบบตรวจ Login จริงจาก Journal';
    }
    return slot;
  }

  mt5LoadSavedLogin();

  function mt5ConnectTargetSlot() {
    return (
      sessionStorage.getItem('mt5ConnectTargetSlot') ||
      (document.getElementById('mt5SelectedPortSlot') || {}).value ||
      urlParams.get('port_slot') ||
      ''
    );
  }

  function tryFinishFromPortsState(portsData, statusMsg) {
    if (!portsData || !portsData.ok || !Array.isArray(portsData.ports)) return false;
    const slot = mt5ConnectTargetSlot();
    if (!slot) return false;
    const port = portsData.ports.find(function (p) {
      return String(p.slot) === String(slot);
    });
    if (!port || !(port.canUse || port.cssClass === 'connected')) return false;
    const acc =
      (portsData.connectedAccounts || []).find(function (a) {
        return String(a.port_slot) === String(slot);
      }) || null;
    const accountInfo = acc || {
      id: port.accountId,
      port_slot: Number(slot) || slot,
      mt5_login: port.mt5_login
    };
    finishMt5ConnectSuccess(statusMsg || 'เชื่อมต่อสำเร็จ', accountInfo);
    return true;
  }

  async function finishMt5ConnectSuccess(message, accountInfo) {
    if (window.__mt5FinishSuccessRunning) return;
    window.__mt5FinishSuccessRunning = true;
    const base = message || 'เชื่อมต่อสำเร็จ';
    const msg = base + ' — ยังไม่เปิด BOT กรุณาไปขั้นตอน 3) ตั้งค่า BOT แล้วกด ▶ เปิด BOT (ปิด Algo Trading จนกว่าจะเปิด BOT)';
    const accId = accountInfo && accountInfo.id;
    const outcomeKey = mt5OutcomeStorageKey(
      'ok',
      accId || 'port',
      (accountInfo && accountInfo.updated_at) || String(Date.now())
    );
    if (mt5OutcomeWasShown(outcomeKey)) {
      window.__mt5FinishSuccessRunning = false;
      return;
    }
    mt5MarkOutcomeShown(outcomeKey);
    mt5Checking = false;
    if (window.mt5Checker) {
      clearInterval(window.mt5Checker);
      window.mt5Checker = null;
    }
    sessionStorage.removeItem('mt5PollAccountId');
    sessionStorage.removeItem('mt5ConnectInFlight');
    sessionStorage.removeItem('mt5ConnectTargetSlot');
    if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    const slot =
      (accountInfo && accountInfo.port_slot) ||
      mt5ConnectTargetSlot() ||
      '';
    if (slot) {
      try { localStorage.setItem('mt5ActivePortSlot', String(slot)); } catch (_) {}
      const lbl = document.getElementById('mt5LoginPortLabel');
      if (lbl) lbl.textContent = 'PORT ' + slot + ' — เชื่อมต่อแล้ว';
    }
    mt5SaveLoginIfRemembered();
    showMt5ConnectModal('success', msg, {
      accountId: accId,
      dedupeKey: outcomeKey
    });
    if (accId) {
      const eq = accountInfo.last_equity != null ? Number(accountInfo.last_equity) : null;
      const bal = accountInfo.last_balance != null ? Number(accountInfo.last_balance) : null;
      if (eq > 0 && typeof applyEquityUiState === 'function') {
        applyEquityUiState(eq, bal > 0 ? bal : null);
      }
    }
    refreshMt5PortCards()
      .then(function () {
        if (slot && typeof window.refreshMt5BotPanel === 'function') {
          setTimeout(function () {
            window.refreshMt5BotPanel(slot);
          }, 600);
        }
      })
      .catch(function () {});
    if (slot && window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/app/mt5?port_slot=' + encodeURIComponent(slot));
    }
    window.__mt5FinishSuccessRunning = false;
  }

  async function verifyConnectedFromUrl() {
    if (urlParams.has('connected') || urlParams.has('ts')) {
      const urlOkKey = 'mt5UrlConnectedModal';
      if (!sessionStorage.getItem(urlOkKey)) {
        sessionStorage.setItem(urlOkKey, '1');
        finishMt5ConnectSuccess('เชื่อมต่อสำเร็จ');
      }
      return;
    }
  }
  verifyConnectedFromUrl();

  if (urlParams.get('failed') === '1') {
    mt5Checking = false;
    sessionStorage.removeItem('mt5PollAccountId');
    const failMsg = decodeURIComponent(urlParams.get('msg') || 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด');
    const failOutcomeKey = 'url-fail:' + failMsg.slice(0, 120);
    if (!mt5OutcomeWasShown(failOutcomeKey)) {
      mt5MarkOutcomeShown(failOutcomeKey);
      showMt5ConnectModal('error', failMsg, { dedupeKey: failOutcomeKey });
    }
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/app/mt5');
    }
  }

  window.mt5UpdateConnectProgress = function (data) {
    const box = document.getElementById('mt5LoginPreview');
    const stepsEl = document.getElementById('mt5ConnectSteps');
    const diagEl = document.getElementById('mt5ConnectDiag');
    const ph = document.getElementById('mt5PreviewPlaceholder');
    const img = document.getElementById('mt5PreviewImg');
    const titleEl = document.getElementById('mt5PreviewTitle');
    if (!box) return;
    box.style.display = 'block';
    const d = data || {};
    const sec = d.elapsedSec != null ? d.elapsedSec : '';
    const st = String((d.account && d.account.status) || d.status || '').toLowerCase();
    const cmd = String(d.commandStatus || '').toLowerCase();
    const agentOk = d.agentOnline === true;
    const agentBad = d.agentOnline === false;
    const stepLabels = [
      { key: 'queue', label: 'ส่งคำสั่ง' },
      { key: 'agent', label: 'Agent รับงาน' },
      { key: 'mt5', label: 'เปิด MT5' },
      { key: 'verify', label: 'ตรวจ Login' }
    ];
    // ไล่ทีละสเตป: 0=ส่งคำสั่ง → 1=Agent → 2=เปิด MT5 → 3=ตรวจ Login
    let activeIdx = 0;
    if (st === 'connected' || d.connected === true) {
      activeIdx = stepLabels.length;
    } else if (st === 'checking') {
      activeIdx = 3;
    } else if (st === 'starting' || !!d.previewUrl) {
      activeIdx = 2;
    } else if (['processing', 'picked', 'running'].includes(cmd)) {
      activeIdx = 1;
    } else if (cmd === 'pending' || !cmd) {
      activeIdx = 0;
    }
    if (stepsEl) {
      stepsEl.innerHTML = stepLabels
        .map(function (s, i) {
          const cls =
            i < activeIdx ? 'done' : i === activeIdx ? 'active' : '';
          return '<span class="mt5-connect-step ' + cls + '">' + s.label + '</span>';
        })
        .join('');
    }
    if (diagEl) {
      const lines = [];
      if (d.connectStep) lines.push('<b>ขั้นตอน:</b> ' + mt5Esc(d.connectStep));
      if (d.agentMessage) {
        lines.push(
          '<b>Agent:</b> <span class="' +
            (agentBad ? 'err' : agentOk ? '' : 'warn') +
            '">' +
            mt5Esc(d.agentMessage) +
            '</span>'
        );
      }
      if (cmd) {
        let cmdLine = '<b>คำสั่ง login:</b> ' + mt5Esc(cmd);
        if (d.commandAgeSec != null) cmdLine += ' (' + d.commandAgeSec + ' วินาที)';
        if (d.commandMessage) cmdLine += ' — ' + mt5Esc(d.commandMessage);
        lines.push(cmdLine);
      }
      if (sec !== '') {
        const maxW = d.maxWaitSec != null ? Number(d.maxWaitSec) : 120;
        const waitLine =
          sec >= 60 && maxW > 0
            ? '<b>รอมาแล้ว:</b> ' + sec + ' / ~' + maxW + ' วินาที'
            : '<b>รอมาแล้ว:</b> ' + sec + ' วินาที';
        lines.push(waitLine);
      }
      if (d.waitHint) lines.push('<span class="warn">' + mt5Esc(d.waitHint) + '</span>');
      diagEl.innerHTML = lines.join('<br>') || 'กำลังเชื่อมต่อ...';
    }
    if (d.previewUrl && img) {
      img.src = d.previewUrl;
      img.style.display = 'block';
      if (ph) ph.style.display = 'none';
    } else if (ph && (!img || img.style.display === 'none')) {
      ph.style.display = 'block';
      const phMsgs = [
        'รอ VPS Agent รับคำสั่ง...',
        agentBad
          ? 'VPS Agent ไม่ตอบสนอง — ตรวจ service AvelquaPythonAgent'
          : 'Agent รับงานแล้ว — รอเปิด MT5...',
        'กำลังเปิด MT5 — รอภาพหน้าจอจาก VPS...',
        'กำลังตรวจ Login — รอภาพหน้าจอ MT5...'
      ];
      ph.textContent = phMsgs[Math.min(activeIdx, phMsgs.length - 1)] || phMsgs[0];
    }
    if (titleEl) {
      titleEl.textContent = d.windowTitle
        ? 'Title bar: ' + d.windowTitle
        : d.message
          ? mt5Esc(String(d.message).replace(/ — .*$/, ''))
          : sec !== ''
            ? 'รอหน้าต่าง MT5... (' + sec + ' วินาที)'
            : '';
    }
  };

  window.mt5ClearConnectSession = function () {
    sessionStorage.removeItem('mt5PollAccountId');
    sessionStorage.removeItem('mt5ConnectInFlight');
    sessionStorage.removeItem('mt5ConnectTargetSlot');
    mt5PollAccountId = '';
    mt5Checking = false;
    if (window.mt5Checker) {
      clearInterval(window.mt5Checker);
      window.mt5Checker = null;
    }
  };

  window.mt5UnlockConnectBtn = function () {
    if (typeof window.mt5ClearConnectSession === 'function') {
      window.mt5ClearConnectSession();
    }
    var b = document.getElementById('mt5ConnectBtn');
    if (!b) return;
    b.disabled = false;
    b.innerHTML = b.dataset.originalText || 'เชื่อมต่อ';
    b.style.opacity = '';
    b.style.pointerEvents = '';
  };

  async function checkMt5Connected() {
    if (!mt5Checking || mt5StatusPollInFlight) return;
    mt5StatusPollInFlight = true;
    try {
      syncMt5PollAccountId();
      const inFlight = sessionStorage.getItem('mt5ConnectInFlight') === '1';
      let statusUrl = '/app/mt5/connect-status';
      if (mt5PollAccountId) {
        statusUrl += '?accountId=' + encodeURIComponent(mt5PollAccountId);
      }
      const fetches = [
        fetch(statusUrl, {
          cache: 'no-store',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        })
      ];
      if (inFlight) {
        fetches.push(
          fetch('/app/mt5/ports-state', {
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
          })
        );
      }
      const results = await Promise.all(fetches);
      const res = results[0];
      if (inFlight && results[1] && results[1].ok) {
        try {
          const portsData = await results[1].json();
          if (tryFinishFromPortsState(portsData, 'เชื่อมต่อสำเร็จ')) return;
        } catch (_) {}
      }
      const text = await res.text();
      let data;
      try {
        data = text ? JSON.parse(text) : {};
      } catch (_) {
        return;
      }
      if (res.status === 401) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', (data && data.message) || 'กรุณาเข้าสู่ระบบใหม่');
        return;
      }
      if (!data.ok) {
        if (data.message && /column.*does not exist/i.test(String(data.message))) {
          const btn = document.getElementById('mt5ConnectBtn');
          if (btn) btn.innerHTML = 'กำลังตรวจสอบ Login MT5 (รอสักครู่)...';
        }
        return;
      }
      if (!data.account || data.staleAccount === true) {
        if (data.status === 'none' || data.staleAccount) {
          if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
          const btn = document.getElementById('mt5ConnectBtn');
          if (btn && btn.disabled) {
            showMt5ConnectModal(
              'error',
              data.message ||
                'ยังไม่มีคำสั่ง Login บน VPS — กรุณากดเชื่อมต่ออีกครั้ง (Ctrl+F5 ก่อนถ้าค้าง)'
            );
          }
        }
        return;
      }
      const stWait = String(data.account.status || data.status || '').toLowerCase();
      if (stWait === 'deleted' || stWait === 'expired') {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        sessionStorage.removeItem('mt5ConnectInFlight');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', 'บัญชีนี้ถูกยกเลิกแล้ว — กรุณากดเชื่อมต่อใหม่');
        return;
      }
      const outcomeUpdatedAt = data.account.updated_at || '';
      if (stWait === 'failed' || data.failed === true) {
        const failKey = mt5OutcomeStorageKey('fail', data.account.id, outcomeUpdatedAt);
        if (mt5OutcomeWasShown(failKey)) {
          mt5Checking = false;
          if (window.mt5Checker) clearInterval(window.mt5Checker);
          window.mt5Checker = null;
          return;
        }
        mt5MarkOutcomeShown(failKey);
        mt5Checking = false;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        sessionStorage.removeItem('mt5PollAccountId');
        sessionStorage.removeItem('mt5ConnectInFlight');
        const failMsg =
          data.message || data.account.last_error || data.account.last_login_message || 'Login หรือ Password ไม่ถูกต้อง';
        showMt5ConnectModal('error', failMsg, { accountId: data.account.id, dedupeKey: failKey });
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        return;
      }
      if (stWait === 'connecting' || stWait === 'checking' || stWait === 'starting' || data.pending || data.checking) {
        const btn = document.getElementById('mt5ConnectBtn');
        const sec = data.elapsedSec != null ? Number(data.elapsedSec) : 0;
        const cmdSt = String(data.commandStatus || '').toLowerCase();
        if (
          sec >= 45 &&
          cmdSt === 'pending' &&
          data.agentOnline === false
        ) {
          if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
          showMt5ConnectModal(
            'error',
            data.connectStep ||
              'VPS Agent ไม่ตอบสนอง — restart AvelquaPythonAgent แล้วกดเชื่อมต่อใหม่'
          );
          return;
        }
        const step = data.connectStep || 'กำลังเชื่อมต่อ MT5';
        let waitMsg = data.message || step;
        if (sec > 0) {
          const maxW = data.maxWaitSec != null ? Number(data.maxWaitSec) : 120;
          waitMsg =
            step +
            (sec >= 60 && maxW > 0 ? ' (' + sec + '/' + maxW + ' วิ)' : ' (' + sec + ' วิ)');
        }
        if (typeof window.mt5UpdateConnectProgress === 'function') {
          window.mt5UpdateConnectProgress(data);
        }
        if (btn) btn.innerHTML = waitMsg;
        return;
      }
      if (data.mt5Offline || stWait === 'ready') {
        const offlineMsg = String(
          data.message || 'MT5 บน VPS ไม่ทำงาน — กรุณากรอก Login/Password แล้วกดเชื่อมต่อใหม่'
        );
        const graceKey = 'mt5OfflineGrace_' + String(data.account?.id || '');
        if (/ไม่ทำงาน/.test(offlineMsg) && !sessionStorage.getItem(graceKey)) {
          sessionStorage.setItem(graceKey, '1');
          setTimeout(function () {
            sessionStorage.removeItem(graceKey);
            if (mt5Checking) checkMt5Connected();
          }, 2500);
          return;
        }
        sessionStorage.removeItem(graceKey);
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', offlineMsg);
        return;
      }
      if (stWait === 'connected' && (data.connected === true || data.loginVerified === true)) {
        finishMt5ConnectSuccess(data.message || 'เชื่อมต่อสำเร็จ', data.account || null);
        return;
      }
    } catch (e) {} finally {
      mt5StatusPollInFlight = false;
    }
  }

  window.finishMt5ConnectSuccess = finishMt5ConnectSuccess;
  window.checkMt5Connected = checkMt5Connected;

  window.startMt5ConnectPolling = function () {
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    syncMt5PollAccountId();
    mt5Checking = true;
    window.__mt5SuccessShown = false;
    window.__mt5FinishSuccessRunning = false;
    sessionStorage.removeItem('mt5ConnectedShownId');
    sessionStorage.removeItem('mt5OutcomeShown');
    window.mt5Checker = setInterval(checkMt5Connected, 100);
    checkMt5Connected();
  };

  if (serverPendingAccountId) {
    mt5PollAccountId = String(serverPendingAccountId);
    sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
    const pendingBtn = document.getElementById('mt5ConnectBtn');
    if (pendingBtn) {
      pendingBtn.disabled = true;
      pendingBtn.innerHTML = 'กำลังตรวจสอบ Login MT5 (รอสักครู่)...';
    }
    if (typeof window.mt5UpdateConnectProgress === 'function') {
      window.mt5UpdateConnectProgress({ message: 'กำลังตรวจสอบ Login ที่ค้างอยู่...', elapsedSec: 0 });
    }
  }

  if (sessionStorage.getItem('mt5ConnectInFlight') === '1' && !mt5PollAccountId && !serverPendingAccountId) {
    sessionStorage.removeItem('mt5ConnectInFlight');
    if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
  }

  if (mt5PollAccountId && !urlParams.has('connected') && urlParams.get('failed') !== '1') {
    fetch('/app/mt5/connect-status?accountId=' + encodeURIComponent(mt5PollAccountId), {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (data && (data.status === 'none' || data.staleAccount)) {
          sessionStorage.removeItem('mt5PollAccountId');
          sessionStorage.removeItem('mt5ConnectInFlight');
          mt5PollAccountId = '';
          if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
          return;
        }
        window.startMt5ConnectPolling();
      })
      .catch(function () {
        sessionStorage.removeItem('mt5PollAccountId');
        sessionStorage.removeItem('mt5ConnectInFlight');
      });
  }

  async function mt5BootstrapConnectedState() {
    try {
      syncMt5PollAccountId();
      const slot = urlParams.get('port_slot') || '';
      let url = '/app/mt5/connect-status';
      if (mt5PollAccountId) url += '?accountId=' + encodeURIComponent(mt5PollAccountId);
      const res = await fetch(url, { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!data.ok || !data.account) return;
      const st = String(data.account.status || '').toLowerCase();
      if (st === 'connected' || data.connected === true) {
        const inFlight = sessionStorage.getItem('mt5ConnectInFlight') === '1' || mt5Checking;
        if (inFlight && typeof finishMt5ConnectSuccess === 'function') {
          finishMt5ConnectSuccess(data.message || 'เชื่อมต่อสำเร็จ', data.account);
          return;
        }
        const slotNum = data.account.port_slot || slot;
        if (slotNum) {
          try { localStorage.setItem('mt5ActivePortSlot', String(slotNum)); } catch (_) {}
          if (!urlParams.get('port_slot') && window.location.pathname.indexOf('/app/mt5') >= 0) {
            window.location.replace('/app/mt5?port_slot=' + encodeURIComponent(slotNum));
            return;
          }
        }
        if (typeof window.refreshMt5PortCards === 'function') await window.refreshMt5PortCards();
      } else if (['connecting', 'starting', 'checking'].includes(st) && !window.mt5Checker) {
        if (typeof window.setMt5PollAccountId === 'function') {
          window.setMt5PollAccountId(data.account.id);
        }
        sessionStorage.setItem('mt5ConnectInFlight', '1');
        window.startMt5ConnectPolling();
      }
    } catch (_) {}
  }
  mt5BootstrapConnectedState();

  window.addEventListener('pagehide', function () {
    mt5Checking = false;
    if (window.mt5Checker) clearInterval(window.mt5Checker);
  });
})();
</script>

<script>
(function(){
  const packageExpired = <%= packageExpired ? 'true' : 'false' %>;

const mt5ConnectForm = document.getElementById('mt5ConnectForm');
const mt5SelectedPortSlot = document.getElementById('mt5SelectedPortSlot');

function mt5ScrollToBotSection() {
  const el = document.getElementById('mt5BotSection');
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function mt5SelectPortSlot(slot, opts) {
  const o = opts || {};
  const n = Number(slot || 0);
  if (!n || !mt5SelectedPortSlot) return;
  mt5SelectedPortSlot.value = String(n);
  try { localStorage.setItem('mt5ActivePortSlot', String(n)); } catch (_) {}
  const lbl = document.getElementById('mt5LoginPortLabel');
  if (lbl) lbl.textContent = 'PORT ' + n;
  const sub = document.getElementById('mt5BotSectionSubtitle');
  if (sub) sub.textContent = 'PORT ' + n + ' — ตั้งค่าเปิด/หยุด BOT';
  document.querySelectorAll('.port-item[data-port-slot]').forEach(function (el) {
    el.classList.toggle('selected', Number(el.getAttribute('data-port-slot')) === n);
  });
  if (o.navigate === true) {
    const urlSlot = new URLSearchParams(window.location.search).get('port_slot');
    if (String(urlSlot || '') !== String(n)) {
      window.location.href = '/app/mt5?port_slot=' + encodeURIComponent(n);
      return;
    }
  }
  mt5ScrollToBotSection();
}
window.mt5SelectPortSlot = mt5SelectPortSlot;

window.mt5StopBot = async function (instanceId) {
  const btn = document.getElementById('mt5BtnStopBot');
  const id =
    instanceId ||
    (btn && btn.getAttribute('data-instance-id')) ||
    '';
  if (!id) {
    alert('ไม่พบ BOT ที่กำลังรัน — กด Ctrl+F5 แล้วลองใหม่');
    return false;
  }
  if (
    !confirm(
      'หยุดการเทรด BOT บน PORT นี้ใช่ไหม?\n(โปรแกรม MT5 ยังเปิดอยู่ — ปิด Algo Trading)'
    )
  ) {
    return false;
  }
  const portSlot = (btn && btn.getAttribute('data-port-slot')) || '';
  const prevText = btn ? btn.textContent : '';
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'กำลังหยุด...';
  }
  try {
    const res = await fetch('/app/mt5/stop/' + encodeURIComponent(id), {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        Accept: 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: portSlot ? 'port_slot=' + encodeURIComponent(portSlot) : ''
    });
    const data = await res.json().catch(function () {
      return { ok: res.ok };
    });
    if (res.ok && data.ok !== false) {
      window.location.href =
        data.redirect ||
        '/app/mt5' +
          (portSlot ? '?port_slot=' + encodeURIComponent(portSlot) : '');
      return false;
    }
    alert(data.message || 'หยุด BOT ไม่สำเร็จ — ลองอีกครั้ง');
  } catch (e) {
    alert('หยุด BOT ไม่สำเร็จ: ' + (e.message || e));
  }
  if (btn) {
    btn.disabled = false;
    btn.textContent = prevText || '■ หยุด BOT';
  }
  return false;
};

function mt5SetRunFormLocked(locked) {
  ['mt5BotSelect', 'mt5TradeLevel', 'capital_manual', 'mt5ManualLot'].forEach(function (id) {
    const el = document.getElementById(id);
    if (!el) return;
    if (id === 'capital_manual' || id === 'mt5ManualLot') {
      el.readOnly = !!locked;
    } else {
      el.disabled = !!locked;
    }
  });
}

window.mt5TradingReset = async function () {
  const btn = document.getElementById('mt5BtnTradingReset');
  const accountId =
    (btn && btn.getAttribute('data-account-id')) ||
    (document.getElementById('mt5AccountId') || {}).value ||
    '';
  const portSlot =
    (btn && btn.getAttribute('data-port-slot')) ||
    (document.getElementById('mt5RunPortSlot') || {}).value ||
    '';
  if (!accountId) {
    alert('ยังไม่มีบัญชี PORT — Login ก่อน');
    return false;
  }
  if (!confirm('รีเซ็ตการตั้งค่าเทรดบน PORT นี้?\n(หยุด BOT ถ้ากำลังรัน · MT5 ยังเชื่อมต่ออยู่)')) return false;
  const prev = btn ? btn.textContent : '';
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'กำลังรีเซ็ต...';
  }
  try {
    const body = new URLSearchParams();
    body.set('mt5_account_id', accountId);
    if (portSlot) body.set('port_slot', portSlot);
    const res = await fetch('/app/mt5/trading-reset', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: body.toString()
    });
    const data = await res.json().catch(function () {
      return { ok: false };
    });
    if (!res.ok || data.ok === false) {
      alert(data.message || 'รีเซ็ตไม่สำเร็จ');
      return false;
    }
    const lotInput = document.getElementById('mt5ManualLot');
    if (lotInput) lotInput.dataset.userEdited = '0';
    const capInput = document.getElementById('capital_manual');
    if (capInput) capInput.dataset.userCapitalEdited = '0';
    mt5SetRunFormLocked(false);
    const warn = document.getElementById('mt5LicenseWarn');
    if (warn) warn.hidden = true;
    syncMt5BotControlUi();
    if (typeof refreshPresetCalc === 'function') refreshPresetCalc();
    if (typeof showMt5Modal === 'function') {
      showMt5Modal('รีเซ็ตแล้ว', data.message || 'เลือก BOT / ระดับเสี่ยง / ทุน / LOT ใหม่ได้', { success: true });
    } else {
      alert(data.message || 'รีเซ็ตแล้ว');
    }
  } catch (e) {
    alert('รีเซ็ตไม่สำเร็จ: ' + (e.message || e));
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.textContent = prev || '↺ รีเซ็ตตั้งค่า';
    }
  }
  return false;
};

async function mt5SubmitRunForm(ev) {
  if (ev) ev.preventDefault();
  const form = document.getElementById('mt5RunForm');
  if (!form) return false;
  const openBtn = document.getElementById('mt5BtnOpenBot');
  const portSlot = (document.getElementById('mt5RunPortSlot') || {}).value || '';
  if (!confirm('เปิด BOT บน PORT ' + (portSlot || '?') + ' ใช่ไหม?')) return false;
  const prev = openBtn ? openBtn.textContent : '';
  if (openBtn) {
    openBtn.disabled = true;
    openBtn.textContent = 'กำลังส่งคำสั่ง...';
  }
  try {
    const body = new URLSearchParams(new FormData(form));
    const res = await fetch('/app/mt5/run', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: body.toString()
    });
    const data = await res.json().catch(function () {
      return { ok: false, message: 'ไม่สามารถอ่านผลจากเซิร์ฟเวอร์' };
    });
    if (!res.ok || data.ok === false) {
      if (typeof showMt5Modal === 'function') {
        showMt5Modal('ไม่สามารถรัน BOT ได้', data.message || 'ลองใหม่', { runBot: true });
      } else {
        alert(data.message || 'เปิด BOT ไม่สำเร็จ');
      }
      return false;
    }
    if (typeof showMt5Modal === 'function') {
      showMt5Modal('ส่งคำสั่งเปิด BOT แล้ว', data.message || 'รอ Agent 30–60 วินาที', { success: true });
    }
    let polls = 0;
    const pollRun = setInterval(function () {
      polls += 1;
      syncMt5BotControlUi();
      if (polls >= 24) clearInterval(pollRun);
    }, 500);
    syncMt5BotControlUi();
  } catch (e) {
    alert('เปิด BOT ไม่สำเร็จ: ' + (e.message || e));
  } finally {
    if (openBtn) {
      openBtn.textContent = prev || '▶ เปิด BOT';
      syncMt5BotControlUi();
    }
  }
  return false;
}

function syncMt5BotControlUi() {
  const slot =
    (document.getElementById('mt5RunPortSlot') || {}).value ||
    new URLSearchParams(window.location.search).get('port_slot') ||
    '';
  if (!slot) return;
  fetch('/app/mt5/bot-control-state?port_slot=' + encodeURIComponent(slot), {
    credentials: 'same-origin',
    headers: { Accept: 'application/json' }
  })
    .then(function (r) {
      return r.json();
    })
    .then(function (data) {
      if (!data.ok) return;
      const running = !!data.botRunning;
      const instId = data.instance && data.instance.id ? String(data.instance.id) : '';
      const pill = document.getElementById('mt5BotStatePill');
      const stopBtn = document.getElementById('mt5BtnStopBot');
      const openBtn = document.getElementById('mt5BtnOpenBot');
      const restartBtn = document.getElementById('mt5BtnRestartBot');
      if (pill) {
        pill.textContent = running ? 'BOT กำลังรัน' : 'BOT หยุดแล้ว';
        pill.className = 'mt5-bot-state-pill ' + (running ? 'on' : 'off');
      }
      if (stopBtn) {
        stopBtn.setAttribute('data-instance-id', instId);
        stopBtn.disabled = !running || !instId;
      }
      if (openBtn) openBtn.disabled = running || packageExpired;
      if (restartBtn) restartBtn.disabled = !running;
      mt5SetRunFormLocked(running);
      const levelSel = document.getElementById('mt5TradeLevel');
      if (levelSel && data.instance && data.instance.trade_level) {
        const lv = String(data.instance.trade_level).toLowerCase();
        if (lv === 'high' || lv === 'medium' || lv === 'low') levelSel.value = lv;
      }
    })
    .catch(function () {});
}

function mt5RestoreTradeLevelSelect() {
  const levelSel = document.getElementById('mt5TradeLevel');
  if (!levelSel || levelSel.disabled) return;
  const meta = window.__mt5PageMeta || {};
  let lv = meta.preferredTradeLevel || '';
  try {
    if (!lv) lv = localStorage.getItem('mt5TradeLevel') || '';
  } catch (_) {}
  if (lv === 'high' || lv === 'medium' || lv === 'low') levelSel.value = lv;
  if (!levelSel.dataset.levelStoreBound) {
    levelSel.dataset.levelStoreBound = '1';
    levelSel.addEventListener('change', function () {
      try {
        localStorage.setItem('mt5TradeLevel', levelSel.value || 'medium');
      } catch (_) {}
    });
  }
}
mt5RestoreTradeLevelSelect();

setInterval(syncMt5BotControlUi, 4000);
syncMt5BotControlUi();

window.refreshMt5BotPanel = function (portSlot) {
  const slot = portSlot || (document.getElementById('mt5SelectedPortSlot') || {}).value || '';
  const q = slot ? ('?port_slot=' + encodeURIComponent(slot)) : '';
  window.location.href = '/app/mt5' + q;
};

function mt5BindPortSlotPicks() {
  const list = document.getElementById('mt5PortList');
  if (!list || list.dataset.pickDelegBound === '1') return;
  list.dataset.pickDelegBound = '1';
  list.addEventListener('click', function (e) {
    if (e.target.closest('.port-actions')) return;
    const card = e.target.closest('.port-item[data-port-slot]');
    if (!card) return;
    mt5SelectPortSlot(card.getAttribute('data-port-slot'), { navigate: true });
  });
  list.addEventListener('keydown', function (e) {
    const hit = e.target.closest('.port-slot-pick-hit[data-port-slot]');
    if (!hit || (e.key !== 'Enter' && e.key !== ' ')) return;
    e.preventDefault();
    mt5SelectPortSlot(hit.getAttribute('data-port-slot'), { navigate: true });
  });
}
window.mt5BindPortSlotPicks = mt5BindPortSlotPicks;
mt5BindPortSlotPicks();
try {
  const urlSlot = new URLSearchParams(window.location.search).get('port_slot');
  const savedSlot = urlSlot || localStorage.getItem('mt5ActivePortSlot');
  if (savedSlot) {
    const card = document.querySelector('.port-item[data-port-slot="' + savedSlot + '"]');
    if (card && !card.classList.contains('connected') && !card.classList.contains('checking')) {
      mt5SelectPortSlot(savedSlot, { navigate: false });
    } else {
      mt5EnsureEmptyPortSelected({});
    }
    setTimeout(mt5ScrollToBotSection, 400);
  } else {
    mt5EnsureEmptyPortSelected({});
  }
} catch (_) {}

if (mt5ConnectForm) {
  mt5ConnectForm.addEventListener('submit', async function(e){
    e.preventDefault();

    if (packageExpired) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', 'แพ็คเกจหมดอายุ กรุณาต่ออายุแพ็กเกจก่อนเชื่อมต่อ MT5');
      return false;
    }
    sessionStorage.removeItem('mt5ConnectedShownId');
    sessionStorage.removeItem('mt5FailedShownId');
    sessionStorage.removeItem('mt5OutcomeShown');
    if (typeof window.mt5ClearConnectSession === 'function') window.mt5ClearConnectSession();
    sessionStorage.setItem('mt5ConnectInFlight', '1');
    window.__mt5LastModalKey = '';
    window.__mt5FinishSuccessRunning = false;

    const mt5ConnectBtn = document.getElementById('mt5ConnectBtn');
    if (mt5ConnectBtn) {
      mt5ConnectBtn.disabled = true;
      mt5ConnectBtn.dataset.originalText = mt5ConnectBtn.innerHTML;
      mt5ConnectBtn.innerHTML = 'กำลังตรวจสอบ Login MT5 (รอสักครู่)...';
      mt5ConnectBtn.style.opacity = '0.6';
      mt5ConnectBtn.style.pointerEvents = 'none';
    }
    if (typeof window.mt5UpdateConnectProgress === 'function') {
      window.mt5UpdateConnectProgress({
        message: 'ส่งคำสั่ง Login ไป VPS...',
        connectStep: 'ส่งคำสั่งไป VPS',
        commandStatus: '',
        elapsedSec: 0
      });
    }

    const formErr = mt5ValidateLoginForm();
    if (formErr) {
      sessionStorage.removeItem('mt5ConnectInFlight');
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'error',
        formErr
      );
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
      return false;
    }

    mt5SaveLoginIfRemembered();

    try {
      const formData = new FormData(mt5ConnectForm);
      const data = Object.fromEntries(formData.entries());
      const connectSlot = mt5EnsureEmptyPortSelected({});
      if (!connectSlot) {
        throw new Error('ไม่มี PORT ว่างในแพ็กเกจ — ลบพอร์ตที่ไม่ใช้หรือเพิ่มพอร์ตก่อน');
      }
      data.port_slot = connectSlot;
      sessionStorage.setItem('mt5ConnectTargetSlot', String(connectSlot));

      const connectCtrl = new AbortController();
      const connectTimer = setTimeout(function () {
        connectCtrl.abort();
      }, 20000);
      const res = await fetch('/app/mt5/connect', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(data),
        signal: connectCtrl.signal
      });
      clearTimeout(connectTimer);

      const raw = await res.text();
      let json;
      try {
        json = raw ? JSON.parse(raw) : {};
      } catch (_) {
        throw new Error(
          res.status === 401
            ? 'กรุณาเข้าสู่ระบบใหม่'
            : 'เซิร์ฟเวอร์ตอบกลับไม่ถูกต้อง กรุณารีเฟรชหน้าแล้วลองอีกครั้ง'
        );
      }
      const pop = typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert;

      if (json.ok === true && json.status === 'connected') {
        if (typeof window.finishMt5ConnectSuccess === 'function') {
          window.finishMt5ConnectSuccess(json.message || 'เชื่อมต่อสำเร็จ', json.account || null);
        } else {
          pop('success', json.message || 'เชื่อมต่อสำเร็จ');
        }
        return false;
      }

      if (json.ok === true && (json.status === 'queued' || json.status === 'pending' || json.status === 'upgrading' || json.accountId)) {
        if (json.accountId && typeof window.setMt5PollAccountId === 'function') {
          window.setMt5PollAccountId(json.accountId);
        } else if (json.accountId) {
          sessionStorage.setItem('mt5PollAccountId', String(json.accountId));
        }
        if (json.portSlot) {
          try { localStorage.setItem('mt5ActivePortSlot', String(json.portSlot)); } catch (_) {}
          sessionStorage.setItem('mt5ConnectTargetSlot', String(json.portSlot));
          const lbl = document.getElementById('mt5LoginPortLabel');
          if (lbl) lbl.textContent = 'กำลัง Login → PORT ' + json.portSlot;
        }
        if (typeof window.startMt5ConnectPolling === 'function') {
          window.startMt5ConnectPolling();
        }
        if (typeof window.mt5UpdateConnectProgress === 'function') {
          window.mt5UpdateConnectProgress({
            message: json.message || 'กำลังเปิด MT5...',
            connectStep: 'ส่งคำสั่งแล้ว — รอ Agent รับงาน',
            commandStatus: 'pending',
            waitHint: 'โดยปกติ 15–35 วินาที — สำเร็จแล้วเลือกบอทขั้นตอน 3',
            expectedMaxSec: 35,
            maxWaitSec: 60,
            elapsedSec: 0
          });
        }
        return false;
      }

      sessionStorage.removeItem('mt5ConnectInFlight');
      pop('error', json.message || 'Login ไม่สำเร็จ');
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    } catch (err) {
      sessionStorage.removeItem('mt5ConnectInFlight');
      const msg =
        err && err.name === 'AbortError'
          ? 'ส่งคำสั่งช้าเกินไป — กรุณากดเชื่อมต่ออีกครั้ง'
          : err.message || 'Login ไม่สำเร็จ';
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'error',
        msg
      );
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    }

    return false;
  });
}
})();
</script>

<script>
function fmtMt5Money(v) {
  if (typeof window.fmtMt5Money === 'function' && window.fmtMt5Money !== fmtMt5Money) {
    return window.fmtMt5Money(v);
  }
  if (v == null || v === '' || Number.isNaN(Number(v))) return '—';
  const n = Number(v);
  if (!Number.isFinite(n) || n < 0) return '—';
  return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtLiveProfit(i) {
  let p = null;
  if (i.display_profit != null && Number.isFinite(Number(i.display_profit))) {
    p = Number(i.display_profit);
  } else if (i.profit != null && Number.isFinite(Number(i.profit))) {
    p = Number(i.profit);
  } else {
    const b = Number(i.mt5_balance);
    const e = Number(i.mt5_equity);
    if (Number.isFinite(b) && b > 0 && Number.isFinite(e) && e > 0) {
      p = e - b;
    }
  }
  if (p == null || !Number.isFinite(p)) return '—';
  const cls = p >= 0 ? 'profit-pos' : 'profit-neg';
  const sign = p > 0 ? '+' : '';
  return '<span class="' + cls + '">' + sign + p.toFixed(2) + '</span>';
}

function drawLiveEquityChart(canvas, series) {
  if (!canvas || !series || !series.length) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width = canvas.offsetWidth || 600;
  const h = canvas.height = 200;
  ctx.clearRect(0, 0, w, h);
  const vals = series.map(Number).filter(function (n) { return Number.isFinite(n) && n > 0; });
  if (vals.length < 1) return;
  const min = Math.min.apply(null, vals);
  const max = Math.max.apply(null, vals);
  const pad = (max - min) * 0.08 || 1;
  const yMin = min - pad;
  const yMax = max + pad;
  const step = vals.length > 1 ? w / (vals.length - 1) : w;
  ctx.beginPath();
  vals.forEach(function (v, i) {
    const x = i * step;
    const y = h - ((v - yMin) / (yMax - yMin || 1)) * (h - 16) - 8;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.strokeStyle = '#22c55e';
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.lineTo((vals.length - 1) * step, h);
  ctx.lineTo(0, h);
  ctx.closePath();
  ctx.fillStyle = 'rgba(34,197,94,0.12)';
  ctx.fill();
}

function fmtEaStatus(i) {
  const s = String(i.ea_status || '').trim().toLowerCase();
  if (s === 'ready') return '✓ พร้อมเทรด';
  if (s === 'algo_off') return '⚠ Algo ปิด';
  if (s === 'wrong_chart') return '⚠ ไม่ใช่ XAUUSD';
  if (s === 'attach_required') return '⚠ แนบ EA';
  if (s === 'stopped') return 'หยุด';
  if (!s || s === 'unknown') {
    const st = String(i.status || '').toLowerCase();
    if (st === 'running') return 'กำลังตรวจ…';
    if (st === 'starting' || st === 'restarting') return 'pending';
    if (st === 'failed' || st === 'error') return 'error';
    return '—';
  }
  return s;
}

function escAttr(s) {
  return String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

const MT5_TABLE_PAGE_SIZE = 5;
let mt5LiveDashPage = 1;
let mt5HistoryPage = 1;

function mt5Paginate(items, page, pageSize) {
  const total = items.length;
  const pages = Math.max(1, Math.ceil(total / pageSize) || 1);
  const p = Math.min(Math.max(1, page), pages);
  return {
    items: items.slice((p - 1) * pageSize, p * pageSize),
    page: p,
    pages: pages,
    total: total
  };
}

function mt5PagerHtml(page, pages, total, goFnName) {
  if (total <= MT5_TABLE_PAGE_SIZE) {
    return '<p class="mt5-pager-meta">ทั้งหมด ' + total + ' รายการ</p>';
  }
  let h = '<div class="mt5-pager-bar">';
  h += '<span class="mt5-pager-meta">หน้า ' + page + ' / ' + pages + ' · ' + total + ' รายการ</span>';
  h += '<span class="mt5-pager-btns">';
  if (page > 1) {
    h += '<button type="button" class="mt5-btn mini ghost" onclick="' + goFnName + '(' + (page - 1) + ')">‹ ก่อนหน้า</button>';
  }
  for (let i = 1; i <= pages; i++) {
    if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - page) > 1) {
      if (i === 3 || i === pages - 2) h += '<span class="mt5-pager-dots">…</span>';
      continue;
    }
    h += '<button type="button" class="mt5-btn mini' + (i === page ? ' active' : ' ghost') + '" onclick="' + goFnName + '(' + i + ')">' + i + '</button>';
  }
  if (page < pages) {
    h += '<button type="button" class="mt5-btn mini ghost" onclick="' + goFnName + '(' + (page + 1) + ')">ถัดไป ›</button>';
  }
  h += '</span></div>';
  return h;
}

window.mt5LiveDashGo = function (p) {
  mt5LiveDashPage = p;
  loadMt5LiveDashboard();
};

window.mt5HistoryGo = function (p) {
  mt5HistoryPage = p;
  initMt5HistoryPager();
};

window.mt5PositionActionDdMenu = function (wrap, btn) {
  const menu = wrap && wrap.querySelector ? wrap.querySelector('.mt5-action-dd-menu') : null;
  if (!menu || !btn) return;
  menu.style.position = 'fixed';
  menu.style.zIndex = '10050';
  const r = btn.getBoundingClientRect();
  const mw = menu.offsetWidth || 168;
  const mh = menu.offsetHeight || 140;
  let left = r.right - mw;
  let top = r.bottom + 8;
  if (left < 10) left = 10;
  if (left + mw > window.innerWidth - 10) left = window.innerWidth - mw - 10;
  if (top + mh > window.innerHeight - 10) top = Math.max(10, r.top - mh - 8);
  menu.style.left = left + 'px';
  menu.style.top = top + 'px';
};

window.mt5CloseAllActionDd = function () {
  document.querySelectorAll('.mt5-action-dd').forEach(function (wrap) {
    wrap.classList.remove('is-open');
    const menu = wrap.querySelector('.mt5-action-dd-menu');
    if (menu) {
      menu.hidden = true;
      menu.style.left = '';
      menu.style.top = '';
      menu.style.position = '';
    }
    const btn = wrap.querySelector('.mt5-action-dd-btn');
    if (btn) btn.setAttribute('aria-expanded', 'false');
  });
};

window.mt5ToggleActionDd = function (ev, btn) {
  if (ev) ev.stopPropagation();
  const wrap = btn && btn.closest ? btn.closest('.mt5-action-dd') : null;
  if (!wrap) return;
  const menu = wrap.querySelector('.mt5-action-dd-menu');
  const wasOpen = wrap.classList.contains('is-open');
  mt5CloseAllActionDd();
  if (menu && !wasOpen) {
    menu.hidden = false;
    wrap.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    mt5PositionActionDdMenu(wrap, btn);
    requestAnimationFrame(function () { mt5PositionActionDdMenu(wrap, btn); });
  }
};

window.addEventListener('resize', function () {
  document.querySelectorAll('.mt5-action-dd.is-open').forEach(function (wrap) {
    const btn = wrap.querySelector('.mt5-action-dd-btn');
    if (btn) mt5PositionActionDdMenu(wrap, btn);
  });
});

document.addEventListener('click', function (ev) {
  if (ev.target && ev.target.closest && ev.target.closest('.mt5-action-dd')) return;
  mt5CloseAllActionDd();
});

window.mt5FocusInstance = function (instId, portSlot) {
  mt5CloseAllActionDd();
  const url = new URL(window.location.href);
  if (portSlot) url.searchParams.set('port_slot', String(portSlot));
  if (instId) url.searchParams.set('run', String(instId));
  const dash = document.getElementById('mt5LiveDashboard');
  if (dash) {
    const sec = document.getElementById('mt5LiveDashboardSection') || dash.closest('section');
    if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (typeof loadMt5LiveDashboard === 'function') loadMt5LiveDashboard();
    return;
  }
  window.location.href = url.pathname + '?' + url.searchParams.toString();
};

function initMt5HistoryPager() {
  const wrap = document.getElementById('mt5HistoryTableWrap');
  const pager = document.getElementById('mt5HistoryPager');
  if (!wrap || !pager) return;
  const rows = Array.from(wrap.querySelectorAll('tbody tr[data-mt5-history-row]'));
  if (!rows.length) {
    pager.innerHTML = '';
    return;
  }
  const pg = mt5Paginate(rows, mt5HistoryPage, MT5_TABLE_PAGE_SIZE);
  mt5HistoryPage = pg.page;
  rows.forEach(function (r, idx) {
    const show = idx >= (pg.page - 1) * MT5_TABLE_PAGE_SIZE && idx < pg.page * MT5_TABLE_PAGE_SIZE;
    r.style.display = show ? '' : 'none';
  });
  pager.innerHTML = mt5PagerHtml(pg.page, pg.pages, pg.total, 'mt5HistoryGo');
  if (typeof mt5CloseAllActionDd === 'function') mt5CloseAllActionDd();
}

document.addEventListener('DOMContentLoaded', function () {
  initMt5HistoryPager();
});

let mt5LiveDashBusy = false;
async function loadMt5LiveDashboard() {
  const box = document.getElementById('mt5LiveDashboard');
  if (!box || mt5LiveDashBusy) return;
  mt5LiveDashBusy = true;

  try {
    window.mt5LiveDashPollN = (window.mt5LiveDashPollN || 0) + 1;
    const syncQ = window.mt5LiveDashPollN <= 1 || window.mt5LiveDashPollN % 4 === 0 ? 'sync=1' : 'sync=0';
    const res = await fetch('/app/mt5/live-dashboard?' + syncQ + '&_=' + Date.now(), {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();

    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลด Live Dashboard ไม่สำเร็จ</div>';
      return;
    }

    if (!data.instances || data.instances.length === 0) {
      box.innerHTML = '<div class="mt5-empty">ยังไม่มี BOT</div>';
      mt5LiveDashPage = 1;
      return;
    }

    const dashPage = mt5Paginate(data.instances, mt5LiveDashPage, MT5_TABLE_PAGE_SIZE);
    mt5LiveDashPage = dashPage.page;
    const dashRows = dashPage.items;

    let html = '';
    const dashTs = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    html += '<p class="mt5-live-dash-ts" style="margin:0 0 10px;font-size:12px;color:#94a3b8">อัปเดต ' + dashTs + ' · รีเฟรชทุก 2 วินาที</p>';
    if (data.agentNotice) {
      html += '<div class="mt5-alert danger" style="margin-bottom:12px">' + escAttr(data.agentNotice) + '</div>';
    }
    html += `
      <table class="mt5-table">
        <thead>
          <tr>
            <th>BOT</th>
            <th>VPS</th>
            <th>PORT</th>
            <th>Status</th>
            <th>EA</th>
            <th>Balance</th>
            <th>Equity</th>
            <th>Profit</th>
            <th>Lot</th>
            <th>ครั้ง</th>
            <th>ล่าสุด</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
    `;

    dashRows.forEach(i => {
      const errHint = i.last_error ? escAttr(i.last_error) : '';
      const st = String(i.status || '').toLowerCase();
      const histActive = ['running', 'pending', 'starting', 'restarting'].includes(st);
      const portSlot = Number(i.assigned_port_no) || 0;
      const removeUrl =
        '/app/mt5/instance/' + i.id + '/remove' + (portSlot ? '?port_slot=' + portSlot : '');
      const missHint = i.metrics_missing ? ' title="กำลังดึงข้อมูลจาก MT5..."' : '';
      const instLabel = i.display_name || i.bot_code || 'BOT';
      html += `
        <tr>
          <td>${i.display_name || i.bot_name || i.bot_code || '-'}</td>
          <td>${i.node_name || i.node_code || '-'}</td>
          <td>${i.assigned_port_no || '-'}</td>
          <td title="${errHint}"><span class="status ${st || ''}">${i.status || '-'}</span></td>
          <td title="${errHint}">
            ${fmtEaStatus(i)}
            ${st === 'failed' && i.last_error ? '<div class="mt5-live-err">' + escAttr(i.last_error).slice(0, 80) + (i.last_error.length > 80 ? '…' : '') + '</div>' : ''}
          </td>
          <td${missHint}>${fmtMt5Money(i.mt5_balance)}</td>
          <td${missHint}>${fmtMt5Money(i.mt5_equity)}</td>
          <td>${fmtLiveProfit(i)}</td>
          <td>${i.lot_used || i.lot || '—'}</td>
          <td>${i.restart_count || 0}</td>
          <td>${i.last_agent_ping ? new Date(i.last_agent_ping).toLocaleString('th-TH') : '-'}</td>
          <td class="mt5-row-actions">
            <div class="mt5-action-dd">
              <button type="button" class="mt5-action-dd-btn" aria-label="เมนูจัดการ" aria-haspopup="true" aria-expanded="false" onclick="mt5ToggleActionDd(event, this)">
                <svg class="mt5-action-dd-kebab" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="5" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="12" cy="19" r="1.75"/></svg>
              </button>
              <div class="mt5-action-dd-menu" hidden>
                <div class="mt5-action-dd-menu-head">จัดการ</div>
                <button type="button" class="mt5-action-dd-item" onclick="loadMt5BotAnalytics(${i.id})">
                  <span class="mt5-dd-ico chart" aria-hidden="true"></span>
                  <span class="mt5-dd-label">กราฟ</span>
                </button>
                <form method="POST" action="/app/mt5/request-restart/${i.id}" class="mt5-action-dd-form" onsubmit="return confirm('Restart เฉพาะรายการ ${escAttr(instLabel)} (ID ${i.id}) ใช่ไหม?\\n\\nไม่กระทบแถวอื่นบน PORT เดียวกัน')">
                  <button type="submit" class="mt5-action-dd-item warn" ${histActive ? '' : 'disabled title="เปิด BOT ก่อน จึงจะ Restart ได้"'}>
                    <span class="mt5-dd-ico restart" aria-hidden="true"></span>
                    <span class="mt5-dd-label">Restart</span>
                  </button>
                </form>
                <form method="POST" action="${removeUrl}" class="mt5-action-dd-form" onsubmit="return confirm('ลบแถว ${escAttr(instLabel)} (PORT ${portSlot || '-'}) ออกจาก Live Dashboard ใช่ไหม?')">
                  <button type="submit" class="mt5-action-dd-item danger" ${histActive ? 'disabled title="หยุด BOT ก่อน จึงจะลบแถวได้"' : ''}>
                    <span class="mt5-dd-ico remove" aria-hidden="true"></span>
                    <span class="mt5-dd-label">ลบ</span>
                  </button>
                </form>
              </div>
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    html += mt5PagerHtml(dashPage.page, dashPage.pages, dashPage.total, 'mt5LiveDashGo');
    box.innerHTML = html;

    const chartWrap = document.getElementById('mt5LiveChartWrap');
    const chartCanvas = document.getElementById('mt5LiveEquityCanvas');
    const chartLabel = document.getElementById('mt5LiveChartLabel');
    const series = data.chartSeries || [];
    if (chartWrap && chartCanvas && series.length >= 2) {
      chartWrap.style.display = 'block';
      const inst = data.instances.find(function (x) { return Number(x.id) === Number(data.chartInstanceId); });
      if (chartLabel && inst) {
        chartLabel.textContent = (inst.display_name || inst.bot_code || 'BOT') + ' · PORT ' + (inst.assigned_port_no || '-');
      }
      drawLiveEquityChart(chartCanvas, series);
    } else if (chartWrap) {
      chartWrap.style.display = 'none';
    }

    if (typeof window.syncPortLockFromLiveDashboard === 'function' && data && data.instances) {
      window.syncPortLockFromLiveDashboard(data.instances);
    }
  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">Live Dashboard Error: ' + e.message + '</div>';
  } finally {
    mt5LiveDashBusy = false;
  }
}

async function loadMt5Diagnostics() {
  const banner = document.getElementById('mt5DiagBanner');
  if (!banner) return;
  try {
    const portSlot = new URLSearchParams(window.location.search).get('port_slot') || '';
    const q = portSlot ? '?port_slot=' + encodeURIComponent(portSlot) : '';
    const res = await fetch('/app/mt5/diagnostics' + q, {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();
    if (!data.ok || !data.blockers || !data.blockers.length) {
      banner.style.display = 'none';
      banner.textContent = '';
      return;
    }
    banner.style.display = 'block';
    banner.className =
      'mt5-alert ' +
      (data.upgradeState === 'stuck'
        ? 'danger'
        : data.upgradeState === 'deploying'
          ? 'warn'
          : 'danger') +
      ' mt5-diag-banner';
    banner.innerHTML =
      '<b>ตรวจระบบ:</b> ' +
      data.blockers.map(function (b) { return escAttr(b); }).join(' · ') +
      (data.upgradeMessage && data.upgradeState !== 'deploying'
        ? '<br><small>' + escAttr(data.upgradeMessage) + '</small>'
        : '');
  } catch (_) {
    banner.style.display = 'none';
  }
}

loadMt5Diagnostics();
setInterval(loadMt5Diagnostics, 15000);
loadMt5LiveDashboard();
setInterval(loadMt5LiveDashboard, 8000);
</script>

