      '<span id="mt5RunPortSummaryText">' +
      'Login <b style="color:#fff">' + mt5Esc(selected.mt5_login || '-') + '</b>' +
      (actualCapital > 0 ? (' · Equity <b style="color:#fff">' + mt5Esc(actualCapital) + '</b>') : '') +
      '</span></div>' +
      '<div id="mt5RunSelectedMeta" style="display:none"></div>' +
      '<div id="mt5RunPresetSummary" class="mt5-run-preset-summary" style="margin-bottom:14px;padding:12px 14px;border-radius:14px;background:rgba(15,23,42,.75);border:1px solid rgba(148,163,184,.2)"></div>' +
      '<div class="mt5-form-row">' +
      '<div><label>เลือกบอทเทรด</label><select name="bot_code" required>' + botOpts + '</select></div>' +
      '<div class="mt5-run-trade-level-wrap"><label>ระดับการเทรด</label><select name="trade_level">' +
      '<option value="low">เสี่ยงต่ำ</option><option value="medium" selected>เสี่ยงกลาง</option><option value="high">เสี่ยงสูง</option>' +
      '</select></div>' +
      '<div class="mt5-run-time-mode-wrap"><label>เวลาเปิดออเดอร์</label><select name="run_time_mode"><option value="auto" selected>Auto trading</option><option value="24h">Open 24H.</option></select></div>' +
      '</div>' +
      '<div class="mt5-form-row">' +
      '<div><label class="mt5-capital-label">' + mt5Esc(initialCapitalLabel) + '</label><input type="number" step="0.01" min="' + mt5Esc(initialMinCap) + '" name="capital_manual" class="form-control" placeholder="' + (actualCapital > 0 ? ('Equity: ' + mt5Esc(actualCapital)) : 'กรอกเงินทุน') + '" value="' + (actualCapital > 0 ? mt5Esc(actualCapital) : '') + '"><small class="mt5-capital-hint" style="color:#94a3b8;display:block;margin-top:4px">' + mt5Esc(mt5CapitalHintForBot(initialBotCode)) + '</small></div>' +
      '<div class="mt5-run-lot-wrap"><label>Lot Size</label><input name="manual_lot" type="number" step="0.01" min="' + mt5Esc(lotMin) + '" max="' + mt5Esc(lotMax) + '" value="' + mt5Esc(mt5Fixed(defaultLot)) + '"><small class="mt5-lot-hint" style="color:#94a3b8;display:block;margin-top:4px">สูงสุดตามแพ็กเกจ ' + mt5Esc(mt5Fixed(lotMax)) + '</small></div>' +
      '<div class="mt5-run-action-box">' +
      '<label>คำสั่ง BOT</label>' +
      '<div class="mt5-run-action-buttons">' +
      '<button type="submit" class="mt5-btn run mt5-run-primary mt5-run-submit-btn"' + ((expired || hasActiveInstance) ? ' disabled' : '') + '>' + (expired ? 'แพ็คเกจหมดอายุ' : (hasActiveInstance ? (String(activeInstance.status || '') === 'running' ? 'BOT กำลังรันอยู่' : 'BOT กำลังเชื่อมต่อ...') : 'Run BOT')) + '</button>' +
      (hasActiveInstance
        ? '<button type="button" class="mt5-btn mt5-run-secondary mt5-stop-btn" data-stop-id="' + mt5Esc(activeInstance.id) + '">Stop BOT</button>'
        : '<button type="button" class="mt5-btn mt5-run-secondary mt5-run-secondary-disabled" disabled>Stop BOT</button>') +
      '</div>' +
      '<small class="mt5-run-action-note">' + (hasActiveInstance ? 'BOT กำลังทำงานอยู่ สามารถสั่ง Stop ได้ทันที' : 'พร้อมส่งคำสั่ง Run ไปยัง PORT ที่เลือก') + '</small>' +
      (hasActiveInstance && activeInstance && String(activeInstance.status || '') === 'connecting'
        ? ('<div class="mt5-run-connecting-meta" id="mt5RunConnectingMeta" data-since="' + mt5Esc(activeInstance.connecting_since || activeInstance.started_at || '') + '" data-hint="' + mt5Esc(activeInstance.connecting_hint || mt5ConnectingHint(activeInstance)) + '">' +
          '<b>กำลังเปิดบอท</b> — ใช้เวลา <b>' + mt5ConnectingElapsedSec(activeInstance.connecting_since || activeInstance.started_at) + '</b> วินาที · ' + mt5Esc(activeInstance.connecting_hint || mt5ConnectingHint(activeInstance)) +
          ' · โดยทั่วไป 30–90 วิ</div>')
        : '') +
      '</div>' +
      '</div>' +
      '</form>'
    );
  }

  function bindMt5RunForm() {
    const form = document.getElementById('mt5RunForm');
    if (!form) return;
    let syncField = 'capital';

    const portSelect = form.querySelector('#mt5RunPortSelect');
    if (portSelect) {
      portSelect.addEventListener('change', function () {
        const id = Number(portSelect.value || 0);
        if (!id) return;
        mt5RunState.selectedAccountId = id;
        sessionStorage.setItem('mt5RunAccountId', String(id));
        const connected = Array.isArray(mt5RunState.connectedAccounts) ? mt5RunState.connectedAccounts : [];
        const acc = connected.find(function (a) { return Number(a.id) === id; });
        const hidden = form.querySelector('#mt5RunAccountId');
        if (hidden) hidden.value = String(id);
        const summary = form.querySelector('#mt5RunPortSummaryText');
        if (acc && summary) {
          const eq = mt5RunAccountCapital(acc);
          summary.innerHTML =
            'Login <b style="color:#fff">' + mt5Esc(acc.mt5_login || '-') + '</b>' +
            (eq > 0 ? (' · Equity <b style="color:#fff">' + mt5Esc(eq) + '</b>') : '');
        }
        applyPresetDefaults('bot_code');
      });
    }

    function applyPresetDefaults(changedField) {
      const selected = mt5SelectedRunAccount();
      const hidden = form.querySelector('#mt5RunAccountId');
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const lotInput = form.querySelector('input[name="manual_lot"]');
      const botSelect = form.querySelector('select[name="bot_code"]');
      const levelSelect = form.querySelector('select[name="trade_level"]');
      const timeSelect = form.querySelector('select[name="run_time_mode"]');
      if (!selected || !hidden || !capitalInput || !lotInput || !botSelect) return;

      if (changedField === 'manual_lot') syncField = 'lot';
      if (changedField === 'capital_manual') syncField = 'capital';
      const syncHidden = form.querySelector('#mt5RunSyncField');
      if (syncHidden) syncHidden.value = syncField;
      if (changedField === 'bot_code') {
        syncField = 'capital';
        const eqNow = mt5RunAccountCapital(selected);
        const defCap = mt5DefaultCapitalForBot(botSelect.value, eqNow);
        capitalInput.value = defCap > 0 ? mt5Fixed(defCap) : '';
      }

      hidden.value = String(selected.id);
      const actualCapital = mt5RunAccountCapital(selected);
      const botCode = botSelect.value;
      const minCap = mt5MinCapitalForBot(botCode);
      capitalInput.min = String(minCap);
      capitalInput.placeholder = actualCapital > 0 ? ('Equity: ' + actualCapital) : 'กรอกเงินทุน';

      const cfg = window.__mt5RunConfig || {};
      lotInput.min = String(mt5Num(cfg.packageLotMin, 0.01));
      lotInput.max = String(mt5Num(cfg.packageLotMax, 0.05));

      let capital = mt5Num(capitalInput.value, 0);
      if (!capital && actualCapital > 0 && changedField !== 'capital_manual') {
        capital = actualCapital;
      }
      const manualLot = mt5Num(lotInput.value, 0);
      const preview = mt5ComputeRunPreset(
        botCode,
        capital,
        manualLot,
        levelSelect ? levelSelect.value : 'medium',
        timeSelect ? timeSelect.value : 'auto',
        syncField
      );

      if (syncField === 'lot' && mt5BotKind(botCode) === 'ak') {
        capitalInput.value = preview.capital > 0 ? mt5Fixed(preview.capital) : '';
      } else if (syncField === 'capital' && mt5BotKind(botCode) === 'ak' && preview.packageCapped && preview.capital > 0) {
        capitalInput.value = mt5Fixed(preview.capital);
      }
      if (mt5BotKind(botCode) !== 'quantum') {
        lotInput.value = mt5Fixed(preview.lot);
      }

      mt5ApplyRunFormVisibility(form);
      mt5RenderRunPresetSummary(form, preview);
      mt5UpdateRunSubmitState(form);
    }

    ['change', 'input'].forEach(function (eventName) {
      ['select[name="bot_code"]', 'select[name="trade_level"]', 'select[name="run_time_mode"]', 'input[name="capital_manual"]', 'input[name="manual_lot"]'].forEach(function (selector) {
        const field = form.querySelector(selector);
        if (field) {
          field.addEventListener(eventName, function () {
            const name = field.getAttribute('name') || '';
            applyPresetDefaults(name);
          });
        }
      });
    });

    form.addEventListener('click', function (ev) {
      const stopBtn = ev.target && ev.target.closest ? ev.target.closest('.mt5-stop-btn') : null;
      if (!stopBtn || stopBtn.disabled) return;
      ev.preventDefault();
      ev.stopPropagation();
      mt5StopBot(stopBtn.getAttribute('data-stop-id'), stopBtn);
    });

    let mt5RunSubmitBypass = false;
    form.addEventListener('submit', function (e) {
      if (mt5RunSubmitBypass) {
        mt5RunSubmitBypass = false;
        return;
      }
      e.preventDefault();
      const selected = mt5SelectedRunAccount();
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const botSelect = form.querySelector('select[name="bot_code"]');
      const lotInput = form.querySelector('input[name="manual_lot"]');
      const syncHidden = form.querySelector('#mt5RunSyncField');
      const syncField = syncHidden && syncHidden.value === 'lot' ? 'lot' : 'capital';
      const capital = mt5Num(capitalInput ? capitalInput.value : 0, mt5RunAccountCapital(selected));
      const botCode = botSelect ? botSelect.value : '';
      const preview = mt5ComputeRunPreset(
        botCode,
        capital,
        mt5Num(lotInput ? lotInput.value : 0, 0),
        form.querySelector('select[name="trade_level"]')?.value || 'medium',
        form.querySelector('select[name="run_time_mode"]')?.value || 'auto',
        syncField
      );
      if (capitalInput && preview.capital > 0) {
        capitalInput.value = mt5Fixed(preview.capital);
      }
      if (lotInput && preview.botKind !== 'quantum') {
        lotInput.value = mt5Fixed(preview.lot);
      }
      if (syncHidden) syncHidden.value = syncField;
      mt5RenderRunPresetSummary(form, preview);

      (async function () {
        if (!selected) {
          await mt5UiAlert({ variant: 'warning', title: 'เลือก PORT', message: 'กรุณาเลือก PORT ที่เชื่อมต่อแล้วก่อน Run BOT' });
          return;
        }
        if (preview.warning) {
          await mt5UiAlert({ variant: 'warning', title: 'แจ้งเตือน', message: preview.warning });
          return;
        }
        if (capital < mt5Num(preview.minCapital, 100)) {
          await mt5UiAlert({ variant: 'warning', title: 'เงินทุนไม่พอ', message: 'เงินทุนไม่ถึงขั้นต่ำของบอทที่เลือก' });
          return;
        }
        const ok = await mt5UiConfirm({
          variant: 'success',
          title: 'Run BOT',
          message: 'ยืนยัน Run BOT ใช่ไหม?',
          okText: 'Run BOT',
          cancelText: 'ยกเลิก'
        });
        if (!ok) return;
        const runBtn = form.querySelector('.mt5-run-submit-btn');
        if (runBtn) {
          runBtn.disabled = true;
          runBtn.textContent = 'กำลังส่งคำสั่ง...';
        }
        mt5RunSubmitBypass = true;
        form.submit();
      })();
    });

    applyPresetDefaults('bot_code');
  }
  window.renderMt5RunFormHtml = renderMt5RunFormHtml;
  window.bindMt5RunForm = bindMt5RunForm;

  let mt5RunRenderSignature = '';
  let mt5RunPrepareStartedAt = Date.now();
  let mt5RunPrepareTimer = null;

  function mt5CaptureRunFormDraft(form) {
    if (!form) return null;
    const accountId = form.querySelector('#mt5RunAccountId')?.value || '';
    if (!accountId) return null;
    return {
      account_id: String(accountId),
      bot_code: form.querySelector('select[name="bot_code"]')?.value || '',
      capital_manual: form.querySelector('input[name="capital_manual"]')?.value || '',
      manual_lot: form.querySelector('input[name="manual_lot"]')?.value || '',
      trade_level: form.querySelector('select[name="trade_level"]')?.value || 'medium',
      run_time_mode: form.querySelector('select[name="run_time_mode"]')?.value || 'auto',
      sync_field: form.querySelector('#mt5RunSyncField')?.value || 'capital'
    };
  }

  function mt5RestoreRunFormDraft(form, draft) {
    if (!form || !draft) return;
    const accountId = form.querySelector('#mt5RunAccountId')?.value || '';
    if (!accountId || String(draft.account_id) !== String(accountId)) return;
    const botSelect = form.querySelector('select[name="bot_code"]');
    const capitalInput = form.querySelector('input[name="capital_manual"]');
    const lotInput = form.querySelector('input[name="manual_lot"]');
    const levelSelect = form.querySelector('select[name="trade_level"]');
    const timeSelect = form.querySelector('select[name="run_time_mode"]');
    const syncHidden = form.querySelector('#mt5RunSyncField');
    if (botSelect && draft.bot_code) botSelect.value = draft.bot_code;
    if (capitalInput && draft.capital_manual !== '') capitalInput.value = draft.capital_manual;
    if (lotInput && draft.manual_lot !== '') lotInput.value = draft.manual_lot;
    if (levelSelect && draft.trade_level) levelSelect.value = draft.trade_level;
    if (timeSelect && draft.run_time_mode) timeSelect.value = draft.run_time_mode;
    if (syncHidden && draft.sync_field) syncHidden.value = draft.sync_field;
  }

  function mt5StartRunPrepareTimer() {
    const box = document.getElementById('mt5RunPrepareBox');
    const secEl = document.getElementById('mt5RunPrepareSec');
    if (!box || !secEl) return;
    if (mt5RunPrepareTimer) clearInterval(mt5RunPrepareTimer);
    mt5RunPrepareStartedAt = Date.now();
    mt5RunPrepareTimer = setInterval(function () {
      const sec = Math.max(0, Math.floor((Date.now() - mt5RunPrepareStartedAt) / 1000));
      secEl.textContent = String(sec);
    }, 1000);
    secEl.textContent = '0';
  }

  function mt5StopRunPrepareTimer() {
    if (mt5RunPrepareTimer) {
      clearInterval(mt5RunPrepareTimer);
      mt5RunPrepareTimer = null;
    }
  }

  function mt5RunDataSignature(accounts, bots) {
    return JSON.stringify({
      accounts: (accounts || []).map(function (a) {
        return [a.id, a.port_slot, a.assigned_port_no, a.mt5_login, a.last_equity, a.last_balance];
      }),
      activeInstances: (mt5RunState.activeInstances || []).map(function (row) {
        return [row.id, row.mt5_account_id, row.status, row.assigned_port_no];
      }),
      bots: (bots || []).map(function (b) {
        return [b.code || b.bot_code || '', b.label || b.display_name || b.bot_name || ''];
      })
    });
  }

  async function refreshMt5PortCards() {
    try {
      const res = await fetch('/app/mt5/ports-state', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) return;
      const list = document.getElementById('mt5PortList');
      if (list && Array.isArray(data.ports)) {
        list.innerHTML = data.ports.map(renderPortItemHtml).join('');
        if (typeof window.mt5BindPortSlotPicks === 'function') window.mt5BindPortSlotPicks();
      }
      const cntEl = document.getElementById('mt5ConnectedCount');
      if (cntEl) {
        const avail = data.availablePortCount != null ? data.availablePortCount : data.connectedCount;
        cntEl.textContent = String(avail || 0) + ' ช่องว่าง';
      }
      const tempBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="temporary"]');
      if (tempBtn) {
        const btn = tempBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddTemporary === false);
      }
      const permBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="permanent"]');
      if (permBtn) {
        const btn = permBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddPermanent === false);
      }
      const runPanel = document.getElementById('mt5RunPanel');
      if (runPanel) {
        const cfg = window.__mt5RunConfig || {};
        cfg.connectedAccounts = Array.isArray(data.connectedAccounts) ? data.connectedAccounts : [];
        cfg.activeInstances = Array.isArray(data.activeRunInstances) ? data.activeRunInstances : [];
        cfg.bots = Array.isArray(data.bots) && data.bots.length ? data.bots : (cfg.bots || []);
        window.__mt5RunConfig = cfg;
        mt5RunState.activeInstances = Array.isArray(cfg.activeInstances) ? cfg.activeInstances.slice() : [];
        const nextSignature = mt5RunDataSignature(cfg.connectedAccounts, cfg.bots || []);
        if (nextSignature !== mt5RunRenderSignature || !document.getElementById('mt5RunForm')) {
          const runDraft = mt5CaptureRunFormDraft(document.getElementById('mt5RunForm'));
          mt5RunRenderSignature = nextSignature;
          mt5StopRunPrepareTimer();
          mt5RunState.connectedAccounts = Array.isArray(cfg.connectedAccounts) ? cfg.connectedAccounts.slice() : [];
          runPanel.innerHTML = renderMt5RunFormHtml(cfg.connectedAccounts, cfg.bots || []);
          bindMt5RunForm();
          const restoredForm = document.getElementById('mt5RunForm');
          mt5RestoreRunFormDraft(restoredForm, runDraft);
          if (restoredForm && runDraft) {
            const capField = restoredForm.querySelector('input[name="capital_manual"]');
            if (capField) capField.dispatchEvent(new Event('input', { bubbles: true }));
          }
        } else if (typeof window.mt5UpdateSharedPortSelections === 'function') {
          window.mt5UpdateSharedPortSelections();
        }
        const hasConnectingRun = (cfg.activeInstances || []).some(function (row) {
          return String(row.status || '') === 'connecting';
        });
        if (hasConnectingRun) {
          const sel = mt5SelectedRunInstance();
          if (sel && String(sel.status || '') === 'connecting' && !document.getElementById('mt5RunConnectingMeta')) {
            const runDraft = mt5CaptureRunFormDraft(document.getElementById('mt5RunForm'));
            mt5RunRenderSignature = '';
            mt5StopRunPrepareTimer();
            runPanel.innerHTML = renderMt5RunFormHtml(cfg.connectedAccounts, cfg.bots || []);
            bindMt5RunForm();
            const restoredForm = document.getElementById('mt5RunForm');
            mt5RestoreRunFormDraft(restoredForm, runDraft);
            if (restoredForm && runDraft) {
              const capField = restoredForm.querySelector('input[name="capital_manual"]');
              if (capField) capField.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
        }
        if (typeof mt5SyncLiveFastPoll === 'function') {
          mt5SyncLiveFastPoll(hasConnectingRun, 5);
        }
        if (typeof mt5TickConnectingTimers === 'function') mt5TickConnectingTimers();
      }
    } catch (_) {}
  }
  window.refreshMt5PortCards = refreshMt5PortCards;

  async function finishMt5ConnectSuccess(message) {
    const msg = message || 'เชื่อมต่อสำเร็จ';
    mt5Checking = false;
    if (window.mt5Checker) {
      clearInterval(window.mt5Checker);
      window.mt5Checker = null;
    }
    sessionStorage.removeItem('mt5PollAccountId');
    if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    await refreshMt5PortCards();
    const connectSlot = Number(document.getElementById('mt5SelectedPortSlot')?.value || 0);
    const cfg = window.__mt5RunConfig || {};
    const connected = Array.isArray(cfg.connectedAccounts) ? cfg.connectedAccounts : [];
    const fresh = connectSlot
      ? connected.find(function (a) { return Number(a.port_slot) === connectSlot; })
      : null;
    if (fresh && typeof window.mt5SelectRunAccount === 'function') {
      window.mt5SelectRunAccount(fresh.id);
    }
    showMt5ConnectModal('success', msg);
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/app/mt5');
    }
  }

  function updateMt5ConnectMeta(data) {
    const metaBox = document.getElementById('mt5ConnectMeta');
    const badge = document.getElementById('mt5ConnectStepBadge');
    const elapsed = document.getElementById('mt5ConnectElapsed');
    const remaining = document.getElementById('mt5ConnectRemaining');
    const detail = document.getElementById('mt5ConnectStepDetail');
    const bar = document.getElementById('mt5ConnectProgressBar');
    if (!metaBox || !badge || !elapsed || !remaining || !detail || !bar) return;

    const step = data && data.step ? data.step : {};
    const stepIndex = Math.max(0, Number(step.index || 0));
    const stepTotal = Math.max(1, Number(step.total || 4));
    const isFailed = String(step.key || '').toLowerCase() === 'failed';
    const isConnected = String(step.key || '').toLowerCase() === 'connected';
    const phase = String(data.phase || data.purposeType || '').toLowerCase();
    const width = isFailed ? 100 : Math.max(14, Math.min(100, Math.round((stepIndex / stepTotal) * 100)));

    metaBox.style.display = 'block';
    badge.textContent = phase === 'bot_run'
      ? ((step.label || 'กำลังตรวจสอบการเชื่อมต่อ') + ' · Phase 2')
      : (step.label || 'กำลังตรวจสอบการเชื่อมต่อ');
    detail.textContent = step.detail || data.message || 'กำลังตรวจสอบการเชื่อมต่อ...';
    elapsed.textContent = 'ใช้เวลา ' + String(Number(data.elapsedSec || 0)) + ' วินาที';
    remaining.textContent = data.pending || data.checking
      ? 'เหลือประมาณ ' + String(Number(data.remainingSec || 0)) + ' วินาที'
      : '';
    bar.style.width = width + '%';
    bar.style.background = isFailed
      ? 'linear-gradient(90deg,#ef4444,#f97316)'
      : isConnected
        ? 'linear-gradient(90deg,#22c55e,#14b8a6)'
        : 'linear-gradient(90deg,#2563eb,#38bdf8)';
  }

  function clearLegacyMt5QueryState() {
    if (!window.history || !window.history.replaceState) return;
    if (!urlParams.get('connected') && !urlParams.get('failed') && !urlParams.get('msg')) return;
    window.history.replaceState({}, '', '/app/mt5');
  }
  clearLegacyMt5QueryState();
  mt5StartRunPrepareTimer();
  const initialRunPanel = document.getElementById('mt5RunPanel');
  if (initialRunPanel && mt5RunState.connectedAccounts && mt5RunState.connectedAccounts.length) {
    mt5RunRenderSignature = mt5RunDataSignature(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    mt5StopRunPrepareTimer();
    initialRunPanel.innerHTML = renderMt5RunFormHtml(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    bindMt5RunForm();
  }
  refreshMt5PortCards();
  const mt5PortCardRefreshTimer = window.setInterval(refreshMt5PortCards, 5000);

  window.mt5UnlockConnectBtn = function () {
    var b = document.getElementById('mt5ConnectBtn');
    if (!b) return;
    b.disabled = false;
    b.innerHTML = b.dataset.originalText || 'เชื่อมต่อ';
    b.style.opacity = '';
    b.style.pointerEvents = '';
  };

  async function checkMt5Connected() {
    if (!mt5Checking) return;
    try {
      let statusUrl = '/app/mt5/connect-status';
      if (mt5PollAccountId) {
        statusUrl += '?accountId=' + encodeURIComponent(mt5PollAccountId);
      }
      const res = await fetch(statusUrl, {
        cache: 'no-store',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const text = await res.text();
      let data;
      try {
        data = text ? JSON.parse(text) : {};
      } catch (_) {
        return;
      }
      if (res.status === 401) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', (data && data.message) || 'กรุณาเข้าสู่ระบบใหม่');
        return;
      }
      if (!data.ok) {
        if (data.message && /column.*does not exist/i.test(String(data.message))) {
          const btn = document.getElementById('mt5ConnectBtn');
          if (btn) btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      if (!data.account) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      const stWait = String(data.account.status || '').toLowerCase();
      if (stWait === 'deleted' || stWait === 'expired' || stWait === 'cancelled') {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      if (data.failed || stWait === 'failed') {
        mt5Checking = false;
        const accountId = String(data.account.id || '').trim();
        const modalDedupId = accountId + ':' + String(data.account.updated_at || '');
        const key = 'mt5FailedShownId';
        if (sessionStorage.getItem(key) !== modalDedupId) {
          sessionStorage.setItem(key, modalDedupId);
          if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
          sessionStorage.removeItem('mt5PollAccountId');
          showMt5ConnectModal('error', data.message || 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด');
        }
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        await refreshMt5PortCards();
        return;
      }
      if (stWait === 'connecting' || stWait === 'checking' || stWait === 'starting' || data.pending || data.checking) {
        const btn = document.getElementById('mt5ConnectBtn');
        const previewBox = document.getElementById('mt5LoginPreview');
        const previewImg = document.getElementById('mt5PreviewImg');
        const previewTitle = document.getElementById('mt5PreviewTitle');
        if (previewBox) previewBox.style.display = 'block';
        if (data.previewUrl && previewImg) {
          previewImg.src = data.previewUrl;
          previewImg.style.display = 'block';
        }
        if (previewTitle) {
          previewTitle.textContent = data.windowTitle
            ? 'Title bar: ' + data.windowTitle
            : 'รอหน้าต่าง MT5...';
        }
        updateMt5ConnectMeta(data);
        if (btn) {
          btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      const accountId = String(data.account.id || '').trim();
      const modalDedupId = accountId + ':' + String(data.account.updated_at || '');
      const key = data.connected ? 'mt5ConnectedShownId' : 'mt5FailedShownId';
      if (sessionStorage.getItem(key) === modalDedupId) {
        mt5Checking = false;
        clearInterval(window.mt5Checker);
        return;
      }
      if (
        data.metricsReady
        && (stWait === 'connected' || (data.connected === true && data.status === 'connected'))
      ) {
        sessionStorage.setItem(key, modalDedupId);
        const eqMsg = data.equity != null
          ? (String(data.phase || data.purposeType || '').toLowerCase() === 'bot_run'
            ? `Phase 2 สำเร็จ — Equity: ${data.equity} — กำลังรัน BOT`
            : `Phase 1 สำเร็จ — Equity: ${data.equity} — พร้อม Run BOT`)
          : (data.balance != null
            ? (String(data.phase || data.purposeType || '').toLowerCase() === 'bot_run'
              ? `Phase 2 สำเร็จ — Balance: ${data.balance} — กำลังรัน BOT`
              : `Phase 1 สำเร็จ — Balance: ${data.balance} — พร้อม Run BOT`)
            : (data.message || 'เชื่อมต่อสำเร็จ'));
        finishMt5ConnectSuccess(eqMsg);
        return;
      }
    } catch (e) {}
  }

  window.finishMt5ConnectSuccess = finishMt5ConnectSuccess;

  window.startMt5ConnectPolling = function () {
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    mt5Checking = true;
    window.__mt5SuccessShown = false;
    sessionStorage.removeItem('mt5ConnectedShownId');
    window.mt5Checker = setInterval(checkMt5Connected, 800);
    checkMt5Connected();
  };

  if (serverPendingAccountId) {
    mt5PollAccountId = String(serverPendingAccountId);
    sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
    const pendingBtn = document.getElementById('mt5ConnectBtn');
    if (pendingBtn) {
      pendingBtn.disabled = true;
      pendingBtn.innerHTML = 'กำลังเชื่อมต่อ';
    }
  }

  if (mt5PollAccountId) {
    window.startMt5ConnectPolling();
  }

  window.addEventListener('pagehide', function () {
    mt5Checking = false;
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    clearInterval(mt5PortCardRefreshTimer);
  });
})();
</script>

<script>
(function(){
  const packageExpired = <%= packageExpired ? 'true' : 'false' %>;

const mt5ConnectForm = document.getElementById('mt5ConnectForm');
const mt5SelectedPortSlot = document.getElementById('mt5SelectedPortSlot');
const mt5LoginInput = document.getElementById('mt5LoginInput');

function isAllowedMt5LoginUser(login) {
  const value = String(login || '').trim();
  return /^2\d{8}$/.test(value) || /^8\d{7}$/.test(value);
}

function mt5LoginUserValidationMessage() {
  return 'Userไม่ถูกต้อง ';
}

function mt5SelectPortSlot(slot) {
  const n = Number(slot || 0);
  if (!n || !mt5SelectedPortSlot) return;
  mt5SelectedPortSlot.value = String(n);
  if (typeof window.mt5UpdateSharedPortSelections === 'function') window.mt5UpdateSharedPortSelections();
}

/** เลือก PORT ว่างอัตโนมัติเมื่อกดเชื่อมต่อ (login พร้อมกันคนละ PORT) */
function mt5AutoPickEmptyConnectSlot() {
  const current = Number(mt5SelectedPortSlot?.value || 0);
  if (current) {
    const curCard = document.querySelector(
      '.port-card-pick[data-port-slot="' + current + '"]:not([data-account-id])'
    );
    if (curCard) return current;
  }
  const empty = document.querySelector('.port-card-pick[data-port-slot]:not([data-account-id])');
  if (empty) {
    const slot = Number(empty.getAttribute('data-port-slot') || 0);
    if (slot) {
      mt5SelectPortSlot(slot);
      return slot;
    }
  }
  return current;
}
window.mt5AutoPickEmptyConnectSlot = mt5AutoPickEmptyConnectSlot;

function mt5SelectRunAccount(accountId) {
  const id = Number(accountId || 0);
  if (!id) return;
  const runState = window.mt5RunState;
  if (!runState) return;
  runState.selectedAccountId = id;
  sessionStorage.setItem('mt5RunAccountId', String(id));
  const panel = document.getElementById('mt5RunPanel');
  if (panel && typeof window.renderMt5RunFormHtml === 'function' && typeof window.bindMt5RunForm === 'function') {
    panel.innerHTML = window.renderMt5RunFormHtml(runState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    window.bindMt5RunForm();
  }
}
window.mt5SelectRunAccount = mt5SelectRunAccount;

function mt5UpdateSharedPortSelections() {
  const connectSlot = Number(mt5SelectedPortSlot?.value || 0);
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    const slot = Number(el.getAttribute('data-port-slot') || 0);
    const accountId = Number(el.getAttribute('data-account-id') || 0);
    el.classList.toggle('selected-connect', !accountId && !!connectSlot && slot === connectSlot);
    el.classList.remove('selected-run');
  });
}

function mt5BindPortSlotPicks() {
  document.querySelectorAll('.port-delete-form, .port-actions').forEach(function (el) {
    if (el.dataset.delBound === '1') return;
    el.dataset.delBound = '1';
    el.addEventListener('click', function (e) { e.stopPropagation(); });
    el.addEventListener('mousedown', function (e) { e.stopPropagation(); });
    if (el.classList.contains('port-delete-form')) {
      el.addEventListener('submit', function () {
        try {
          const m = String(el.getAttribute('action') || '').match(/\/account\/(\d+)\/delete/);
          const deletedId = m ? String(m[1]) : '';
          if (deletedId && sessionStorage.getItem('mt5PollAccountId') === deletedId) {
            sessionStorage.removeItem('mt5PollAccountId');
          }
          if (window.mt5Checker) {
            clearInterval(window.mt5Checker);
            window.mt5Checker = null;
          }
          mt5Checking = false;
        } catch (e) {}
      });
    }
  });
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    if (el.dataset.pickBound === '1') return;
    el.dataset.pickBound = '1';
    function pick() {
      const accountId = Number(el.getAttribute('data-account-id') || 0);
      if (accountId) return;
      mt5SelectPortSlot(el.getAttribute('data-port-slot'));
    }
    el.addEventListener('click', pick);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); }
    });
  });
  mt5UpdateSharedPortSelections();
}
window.mt5BindPortSlotPicks = mt5BindPortSlotPicks;
window.mt5UpdateSharedPortSelections = mt5UpdateSharedPortSelections;
mt5BindPortSlotPicks();

if (mt5ConnectForm) {
  mt5ConnectForm.addEventListener('submit', async function(e){
    e.preventDefault();

    if (packageExpired) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', 'แพ็คเกจหมดอายุ กรุณาต่ออายุแพ็กเกจก่อนเชื่อมต่อ MT5');
      return false;
    }

    const mt5LoginValue = String(mt5LoginInput?.value || '').trim();
    if (!isAllowedMt5LoginUser(mt5LoginValue)) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', mt5LoginUserValidationMessage());
      return false;
    }

    const connectSlot = mt5AutoPickEmptyConnectSlot();
  const connectCard = connectSlot
    ? document.querySelector('.port-card-pick[data-port-slot="' + connectSlot + '"]:not([data-account-id])')
    : null;
  const reconnectCard = connectSlot
    ? document.querySelector('.port-card-pick[data-port-slot="' + connectSlot + '"][data-account-id]')
    : null;
  if (!connectSlot) {
    (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
      'error',
      'ไม่มี PORT ว่าง — ลบ PORT เก่าหรือซื้อพอร์ตเพิ่มก่อน login พร้อมกัน'
    );
    return false;
  }
  if (reconnectCard && !connectCard) {
    const sameLogin = reconnectCard.querySelector('small');
    const titleText = sameLogin ? String(sameLogin.textContent || '') : '';
  const loginOnCard = titleText.includes(mt5LoginValue);
    if (loginOnCard) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'info',
        'บัญชีนี้เชื่อมต่อที่ PORT ' + connectSlot + ' อยู่แล้ว — ใช้ Run BOT หรือลบ PORT ก่อน login ใหม่'
      );
    } else {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)(
        'error',
        'PORT ' + connectSlot + ' มีบัญชีอื่นอยู่แล้ว — เลือก PORT ว่าง หรือลบ PORT นี้ก่อน'
      );
    }
    return false;
  }

    const mt5ConnectBtn = document.getElementById('mt5ConnectBtn');
    if (mt5ConnectBtn) {
      mt5ConnectBtn.disabled = true;
      mt5ConnectBtn.dataset.originalText = mt5ConnectBtn.innerHTML;
      mt5ConnectBtn.innerHTML = 'กำลังเชื่อมต่อ';
      mt5ConnectBtn.style.opacity = '0.6';
      mt5ConnectBtn.style.pointerEvents = 'none';
    }

    try {
      const formData = new FormData(mt5ConnectForm);
      const data = Object.fromEntries(formData.entries());

      const res = await fetch('/app/mt5/connect', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(data)
      });

      const raw = await res.text();
      let json;
      try {
        json = raw ? JSON.parse(raw) : {};
      } catch (_) {
        throw new Error(
          res.status === 401
            ? 'กรุณาเข้าสู่ระบบใหม่'
            : 'เซิร์ฟเวอร์ตอบกลับไม่ถูกต้อง กรุณารีเฟรชหน้าแล้วลองอีกครั้ง'
        );
      }
      const pop = typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert;

      if (json.ok === true && json.status === 'connected' && (json.metricsReady || json.fastPath)) {
        if (typeof window.finishMt5ConnectSuccess === 'function') {
          window.finishMt5ConnectSuccess(json.message || 'เชื่อมต่อสำเร็จ');
        } else {
          pop('success', json.message || 'เชื่อมต่อสำเร็จ');
        }
        return false;
      }

      if (json.ok === true && (json.status === 'queued' || json.status === 'pending' || json.status === 'upgrading' || (json.accountId && json.status !== 'connected'))) {
        if (json.accountId) {
          mt5PollAccountId = String(json.accountId);
          sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
        }
        if (typeof window.startMt5ConnectPolling === 'function') {
          window.startMt5ConnectPolling();
        }
        return false;
      }

      pop('error', json.message || 'Login ไม่สำเร็จ');
      await refreshMt5PortCards();
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    } catch (err) {
      await refreshMt5PortCards();
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', err.message || 'Login ไม่สำเร็จ');
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    }

    return false;
  });
}
})();
</script>

<script>
function mt5ManageEscape(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function mt5TradeLevelText(level) {
  const v = String(level || '').toLowerCase();
  if (v === 'high') return 'เสี่ยงสูง';
  if (v === 'medium') return 'เสี่ยงกลาง';
  if (v === 'low' || v === 'safe') return 'เสี่ยงต่ำ';
  return level || '-';
}

function mt5OrderTimeText(modeOrLabel) {
  const v = String(modeOrLabel || '').trim().toLowerCase();
  if (v === '24h' || v === 'open 24h.' || v.includes('24')) return 'Open 24H.';
  if (v === 'auto' || v.includes('auto')) return 'Auto trading';
  return modeOrLabel || 'Auto trading';
}

function mt5ManageData(el) {
  return el && el.dataset ? el.dataset : {};
}

function closeMt5ManageMenus(exceptMenu) {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(function (menu) {
    if (menu !== exceptMenu) menu.open = false;
  });
}

function positionMt5ManageMenu(menu) {
  if (!menu || !menu.open) return;
  const summary = menu.querySelector('summary');
  const dropdown = menu.querySelector('.mt5-manage-dropdown');
  if (!summary || !dropdown) return;
  const gap = 8;
  const rect = summary.getBoundingClientRect();
  const menuWidth = Math.max(dropdown.offsetWidth || 160, 160);
  const menuHeight = Math.max(dropdown.offsetHeight || 132, 132);
  const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 1280;
  const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 720;
  let left = rect.right - menuWidth;
  left = Math.max(12, Math.min(left, viewportWidth - menuWidth - 12));
  const shouldOpenUp = (viewportHeight - rect.bottom) < (menuHeight + 16) && rect.top > menuHeight;
  const top = shouldOpenUp
    ? Math.max(12, rect.top - menuHeight - gap)
    : Math.max(12, rect.bottom + gap);
  menu.style.setProperty('--mt5-manage-left', left + 'px');
  menu.style.setProperty('--mt5-manage-top', top + 'px');
  menu.classList.toggle('drop-up', shouldOpenUp);
}

function bindMt5ManageMenus(scope) {
  (scope || document).querySelectorAll('.mt5-manage-menu').forEach(function (menu) {
    if (menu.dataset.bound === '1') return;
    menu.dataset.bound = '1';
    menu.addEventListener('toggle', function () {
      if (menu.open) {
        closeMt5ManageMenus(menu);
        requestAnimationFrame(function () {
          positionMt5ManageMenu(menu);
        });
      } else {
        menu.classList.remove('drop-up');
      }
    });
  });
}

document.addEventListener('click', function (e) {
  const activeMenu = e.target.closest('.mt5-manage-menu');
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(function (menu) {
    if (menu !== activeMenu && !menu.contains(e.target)) menu.open = false;
  });
});

window.addEventListener('resize', function () {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(positionMt5ManageMenu);
});

document.addEventListener('scroll', function () {
  document.querySelectorAll('.mt5-manage-menu[open]').forEach(positionMt5ManageMenu);
}, true);

function mt5ShowManageModal(title, bodyHtml, mode) {
  const old = document.getElementById('mt5ManageModal');
  if (old) old.remove();
  const isGraph = mode === 'graph';
  const modal = document.createElement('div');
  modal.id = 'mt5ManageModal';
  modal.className = 'mt5-manage-modal' + (isGraph ? ' mt5-manage-modal--fit' : '');
  modal.innerHTML = `
    <div class="mt5-manage-backdrop" onclick="closeMt5ManageModal()"></div>
    <div class="mt5-manage-card${isGraph ? ' mt5-manage-card--graph' : ''}">
      <div class="mt5-manage-head">
        <div>
          <small>Manage</small>
          <h3>${mt5ManageEscape(title)}</h3>
        </div>
        <button type="button" class="mt5-manage-close" onclick="closeMt5ManageModal()">ปิด</button>
      </div>
      <div class="mt5-manage-body">${bodyHtml}</div>
    </div>
  `;
  document.body.appendChild(modal);
}

function mt5GraphMetaStrip(d) {
  const items = [
    ['BOT', d.bot || '-'],
    ['Login', d.login || '-'],
    ['PORT', d.port || '-'],
    ['เวลาเปิดออเดอร์', mt5OrderTimeText(d.orderTime || 'auto')],
    ['Status', d.status || '-']
  ];
  return '<div class="mt5-graph-meta">' + items.map(function (pair) {
    return '<span>' + mt5ManageEscape(pair[0]) + ' <b>' + mt5ManageEscape(pair[1]) + '</b></span>';
  }).join('') + '</div>';
}

function closeMt5ManageModal() {
  document.getElementById('mt5ManageModal')?.remove();
}

function mt5ManageDetailGrid(rows) {
  return '<div class="mt5-manage-grid">' + rows.map((row) => `
    <div class="mt5-manage-box">
      <small>${mt5ManageEscape(row.label)}</small>
      <b>${mt5ManageEscape(row.value)}</b>
    </div>
  `).join('') + '</div>';
}

function openMt5InstanceDetail(el) {
  const d = mt5ManageData(el);
  mt5ShowManageModal(
    `รายละเอียด BOT #${d.instanceId || '-'}`,
    mt5ManageDetailGrid([
      { label: 'BOT', value: d.bot || '-' },
      { label: 'Login', value: d.login || '-' },
      { label: 'เงินทุน', value: d.funding || '-' },
      { label: 'Lot', value: d.lotText || d.lot || '-' },
      { label: 'เวลาเปิดออเดอร์', value: mt5OrderTimeText(d.orderTime || 'auto') },
      { label: 'Level', value: mt5TradeLevelText(d.level) },
      { label: 'Status', value: d.status || '-' },
      { label: 'PORT', value: d.port || '-' },
      { label: 'VPS', value: d.node || '-' },
      { label: 'อัปเดตล่าสุด', value: d.updated || '-' }
    ])
  );
}

function openMt5InstanceAnalysis(el) {
  const d = mt5ManageData(el);
  const status = String(d.status || '').toLowerCase();
  let summary = 'รายการนี้พร้อมใช้งาน';
  let action = 'ยังไม่ต้องทำอะไรเพิ่มเติม';
  if (status === 'running') {
    summary = 'BOT กำลังทำงานอยู่บน VPS';
    action = 'ติดตาม Equity และใช้เมนู Dashboard หากต้อง Restart หรือดูกราฟ';
  } else if (status === 'pending' || status === 'restarting') {
    summary = 'ระบบกำลังรอ Agent รับคำสั่ง';
    action = 'รอสถานะอัปเดตอีกเล็กน้อย หากค้างนานค่อยสั่ง Restart';
  } else if (status === 'failed') {
    summary = 'BOT มีสถานะผิดพลาด';
    action = 'ควรตรวจ Login, Funding, และสถานะ VPS ก่อนสั่งรันใหม่';
  } else if (status === 'stopped') {
    summary = 'BOT ถูกหยุดแล้ว';
    action = 'สามารถลบประวัติหรือสั่ง Run ใหม่จาก PORT เดิมได้';
  }

  mt5ShowManageModal(
    `วิเคราะห์ ${d.bot || 'BOT'}`,
    `
      <div class="mt5-manage-analysis">
        <div class="mt5-manage-box">
          <small>สรุป</small>
          <b>${mt5ManageEscape(summary)}</b>
        </div>
        <div class="mt5-manage-box">
          <small>คำแนะนำ</small>
          <b>${mt5ManageEscape(action)}</b>
        </div>
      </div>
      ${mt5ManageDetailGrid([
        { label: 'Login', value: d.login || '-' },
        { label: 'เงินทุน', value: d.funding || '-' },
        { label: 'Lot', value: d.lotText || d.lot || '-' },
        { label: 'เวลาเปิดออเดอร์', value: mt5OrderTimeText(d.orderTime || 'auto') },
        { label: 'Level', value: mt5TradeLevelText(d.level) },
        { label: 'Status', value: d.status || '-' }
      ])}
    `
  );
}

function mt5GroupPointsByDay(points) {
  const map = Object.create(null);
  (points || []).forEach(function (p) {
    const dt = new Date(p.at || 0);
    if (Number.isNaN(dt.getTime())) return;
    const key = mt5DayKeyBangkok(dt);
    if (!key) return;
    if (!map[key]) {
      map[key] = {
        dayKey: key,
        label: mt5FormatThaiDayLabel(key),
        rows: []
      };
    }
    map[key].rows.push({
      at: p.at,
      time: mt5FormatThaiTime(dt),
      equity: Number(p.equity || 0),
      profit: Number(p.profit || 0),
      loss: Number(p.loss || 0),
      pnl: Number(p.pnl || 0),
      live: !!p.live
    });
  });
  return Object.keys(map).sort().map(function (k) {
    const day = map[k];
    const last = day.rows[day.rows.length - 1];
    let maxProfit = 0;
    let maxLoss = 0;
    day.rows.forEach(function (r) {
      if (r.profit > maxProfit) maxProfit = r.profit;
      if (r.loss > maxLoss) maxLoss = r.loss;
    });
    return {
      dayKey: day.dayKey,
      label: day.label,
      rows: day.rows,
      rowCount: day.rows.length,
      endPnl: last ? last.pnl : 0,
      maxProfit: maxProfit,
      maxLoss: maxLoss
    };
  });
}

function mt5PnlChartsPanel(json, instanceId) {
  const uid = String(instanceId || '0').replace(/\W/g, '');
  const days = Array.isArray(json?.days) && json.days.length ? json.days : mt5GroupPointsByDay(json?.points || []);
  if (!days.length) {
    return '<div class="mt5-empty">ยังไม่มีจุดกราฟ — ระบบบันทึกทุก 90 วินาทีหลังเปิดบอท</div>';
  }
  const startEq = Number(json.startEquity || 0);
  const curEq = Number(json.currentEquity || 0);
  const pnl = Number(json.currentPnl || 0);
  const pnlCls = pnl >= 0 ? 'pos' : 'neg';
  const intervalSec = Number(json.intervalSeconds || (json.intervalMinutes ? json.intervalMinutes * 60 : 90) || 90);
  const intervalLabel = intervalSec >= 60 && intervalSec % 60 === 0
    ? (intervalSec / 60) + ' น.'
    : intervalSec + ' วิ';
  return `
    <div class="mt5-pnl-widget" id="mt5PnlWidget${uid}" data-instance-id="${mt5ManageEscape(instanceId)}">
      <div class="mt5-pnl-summary">
        <div class="mt5-pnl-summary-box"><small>Eq ตั้งต้น</small><b>${mt5Money(startEq)}</b></div>
        <div class="mt5-pnl-summary-box"><small>Eq ปัจจุบัน</small><b>${mt5Money(curEq)}</b></div>
        <div class="mt5-pnl-summary-box ${pnlCls}"><small>P/L รวม</small><b>${pnl >= 0 ? '+' : ''}${mt5Money(pnl)}</b></div>
        <div class="mt5-pnl-summary-box muted"><small>บันทึก</small><b>${intervalLabel}</b></div>
      </div>
      <div class="mt5-pnl-day-head">
        <b id="mt5PnlDayTitle${uid}">—</b>
        <small>คลิกเลือกวัน</small>
      </div>
      <div class="mt5-pnl-dual-chart-wrap">
        <div class="mt5-pnl-legend">
          <span class="leg profit">— กำไร</span>
          <span class="leg loss">— ขาดทุน</span>
        </div>
        <svg class="mt5-pnl-dual-chart" id="mt5PnlSvg${uid}" viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="กราฟกำไรและขาดทุน"></svg>
        <div class="mt5-pnl-xlabels" id="mt5PnlX${uid}"></div>
      </div>
      <div class="mt5-pnl-day-rail" id="mt5PnlRail${uid}">
        <div class="mt5-pnl-day-track" id="mt5PnlTrack${uid}"></div>
      </div>
      <div class="mt5-pnl-table-wrap">
        <table class="mt5-table mt5-pnl-table">
          <thead>
            <tr>
              <th>เวลา</th>
              <th>Equity</th>
              <th>กำไร</th>
              <th>ขาดทุน</th>
              <th>P/L</th>
            </tr>
          </thead>
          <tbody id="mt5PnlTable${uid}"></tbody>
        </table>
      </div>
    </div>
  `;
}

function mt5RenderDualLineChart(svgEl, rows, uid) {
  if (!svgEl) return;
  const profit = rows.map(function (r) { return Math.max(0, Number(r.profit || 0)); });
  const loss = rows.map(function (r) { return Math.max(0, Number(r.loss || 0)); });
  const maxVal = Math.max(0.01, ...profit, ...loss, 1);
  function linePts(vals) {
    if (!vals.length) return '';
    return vals.map(function (v, idx) {
      const x = (idx / Math.max(1, vals.length - 1)) * 100;
      const y = 100 - ((v / maxVal) * 74 + 12);
      return x + ',' + y;
    }).join(' ');
  }
  const gid = 'mt5Dual' + uid;
  svgEl.innerHTML =
    '<defs>' +
    '<linearGradient id="' + gid + 'P" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(34,197,94,.25)"/><stop offset="100%" stop-color="rgba(34,197,94,0)"/></linearGradient>' +
    '<linearGradient id="' + gid + 'L" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(239,68,68,.22)"/><stop offset="100%" stop-color="rgba(239,68,68,0)"/></linearGradient>' +
    '</defs>' +
    '<line x1="0" y1="88" x2="100" y2="88" stroke="rgba(148,163,184,.2)" stroke-width="0.5"/>' +
    '<polyline fill="none" stroke="#4ade80" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" points="' + linePts(profit) + '"/>' +
    '<polyline fill="none" stroke="#f87171" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" points="' + linePts(loss) + '"/>';
}

function mt5InitPnlChartWidget(instanceId, json) {
  const uid = String(instanceId || '0').replace(/\W/g, '');
  const days = Array.isArray(json?.days) && json.days.length ? json.days : mt5GroupPointsByDay(json?.points || []);
  const rail = document.getElementById('mt5PnlRail' + uid);
  const track = document.getElementById('mt5PnlTrack' + uid);
  const tbody = document.getElementById('mt5PnlTable' + uid);
  const svg = document.getElementById('mt5PnlSvg' + uid);
  const xlabels = document.getElementById('mt5PnlX' + uid);
  const dayTitle = document.getElementById('mt5PnlDayTitle' + uid);
  if (!rail || !track || !days.length) return;

  let selectedKey = days[days.length - 1].dayKey;

  function renderDay(dayKey) {
    const day = days.find(function (d) { return d.dayKey === dayKey; }) || days[days.length - 1];
    if (!day) return;
    selectedKey = day.dayKey;
    if (dayTitle) dayTitle.textContent = day.label + ' · ' + day.rowCount + ' จุด';
    track.querySelectorAll('.mt5-pnl-day-chip').forEach(function (chip) {
      chip.classList.toggle('active', chip.getAttribute('data-day') === day.dayKey);
    });
    mt5RenderDualLineChart(svg, day.rows, uid);
    if (xlabels) {
      const labels = day.rows.map(function (r) { return r.time; });
      const show = labels.length <= 8 ? labels : [labels[0], labels[Math.floor(labels.length / 2)], labels[labels.length - 1]];
      xlabels.innerHTML = show.map(function (t) { return '<span>' + mt5ManageEscape(t) + '</span>'; }).join('');
    }
    if (tbody) {
      const maxRows = 6;
      const rows = day.rows.length > maxRows ? day.rows.slice(-maxRows) : day.rows;
      tbody.innerHTML = rows.map(function (r) {
        const pnlCls = r.pnl >= 0 ? 'pos' : 'neg';
        return '<tr>' +
          '<td>' + mt5ManageEscape(r.time) + (r.live ? ' <small class="live">L</small>' : '') + '</td>' +
          '<td>' + mt5Money(r.equity) + '</td>' +
          '<td class="pos">' + (r.profit > 0 ? '+' + mt5Money(r.profit) : '—') + '</td>' +
          '<td class="neg">' + (r.loss > 0 ? '-' + mt5Money(r.loss) : '—') + '</td>' +
          '<td class="' + pnlCls + '">' + (r.pnl >= 0 ? '+' : '') + mt5Money(r.pnl) + '</td>' +
          '</tr>';
      }).join('');
    }
  }

  track.innerHTML = days.map(function (d) {
    const cls = d.endPnl >= 0 ? 'pos' : 'neg';
    const shortLabel = String(d.label || '').replace(/\s+\d{4}$/, '');
    return '<button type="button" class="mt5-pnl-day-chip ' + cls + '" data-day="' + mt5ManageEscape(d.dayKey) + '">' +
      '<span class="d">' + mt5ManageEscape(shortLabel) + '</span>' +
      '<span class="s">' + d.rowCount + '·' + (d.endPnl >= 0 ? '+' : '') + mt5Money(d.endPnl) + '</span>' +
      '</button>';
  }).join('');

  track.querySelectorAll('.mt5-pnl-day-chip').forEach(function (chip) {
    chip.addEventListener('mousedown', function (e) { e.stopPropagation(); });
    chip.addEventListener('click', function () {
      renderDay(chip.getAttribute('data-day'));
    });
  });

  renderDay(selectedKey);
}

function mt5Money(value, digits = 2) {
  const n = Number(value);
  return Number.isFinite(n) ? n.toFixed(digits) : '-';
}

async function openMt5EquityGraph(el) {
  const d = mt5ManageData(el);
  mt5ShowManageModal(`กราฟ ${d.bot || 'BOT'}`, '<div class="mt5-empty">กำลังโหลดกราฟ...</div>', 'graph');
  try {
    const res = await fetch(`/app/mt5/equity-chart/${encodeURIComponent(d.instanceId || '')}`, {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });
    const json = await res.json();
    if (!json.ok) throw new Error('โหลดกราฟไม่สำเร็จ');
    const body = `
      ${mt5GraphMetaStrip(d)}
      <div class="mt5-manage-chart-wrap">${mt5PnlChartsPanel(json, d.instanceId)}</div>
    `;
    document.querySelector('#mt5ManageModal .mt5-manage-body').innerHTML = body;
    mt5InitPnlChartWidget(d.instanceId, json);
  } catch (err) {
    document.querySelector('#mt5ManageModal .mt5-manage-body').innerHTML = `<div class="mt5-empty">กราฟโหลดไม่สำเร็จ: ${mt5ManageEscape(err.message || 'unknown error')}</div>`;
  }
}

window.closeMt5ManageModal = closeMt5ManageModal;
window.openMt5InstanceDetail = openMt5InstanceDetail;
window.openMt5InstanceAnalysis = openMt5InstanceAnalysis;
window.openMt5EquityGraph = openMt5EquityGraph;
</script>

<script>
let mt5LiveDashboardPage = 1;
let mt5HistoryDashboardPage = 1;
const MT5_DASHBOARD_REFRESH_MS = 90 * 1000;
const MT5_CONNECTING_TICK_MS = 1000;
const MT5_CONNECTING_TYPICAL_SEC = 60;
const MT5_CONNECTING_MAX_SEC = 180;
let mt5LiveFastPollTimer = null;
let mt5ConnectingTickTimer = null;
const MT5_TH_TZ = 'Asia/Bangkok';

function mt5FormatThaiDateTime(value) {
  if (!value) return '-';
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return '-';
  return new Intl.DateTimeFormat('th-TH', {
    timeZone: MT5_TH_TZ,
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false
  }).format(d);
}

function mt5DayKeyBangkok(value) {
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return '';
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: MT5_TH_TZ,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).format(d);
}

function mt5FormatThaiDayLabel(dayKey) {
  if (!dayKey) return '-';
  const parts = String(dayKey).split('-').map(Number);
  if (parts.length < 3 || parts.some(function (n) { return !Number.isFinite(n); })) return dayKey;
  const noonBangkokUtc = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2], 5, 0, 0));
  return new Intl.DateTimeFormat('th-TH', {
    timeZone: MT5_TH_TZ,
    weekday: 'short',
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(noonBangkokUtc);
}

function mt5FormatThaiTime(value) {
  if (!value) return '-';
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return '-';
  return new Intl.DateTimeFormat('th-TH', {
    timeZone: MT5_TH_TZ,
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  }).format(d);
}

function mt5DisplayStatus(row) {
  const s = String(row?.display_status || row?.status || '').trim().toLowerCase();
  if (s === 'running' || s === 'connecting' || s === 'stopped' || s === 'fail' || s === 'failed') {
    return s === 'failed' ? 'fail' : s;
  }
  if (s === 'failed' || s === 'error') return 'fail';
  if (s === 'pending' || s === 'restarting' || s === 'starting') return 'connecting';
  return s || 'connecting';
}

function mt5ConnectingElapsedSec(since) {
  if (!since) return 0;
  const d = new Date(since);
  if (Number.isNaN(d.getTime())) return 0;
  return Math.max(0, Math.floor((Date.now() - d.getTime()) / 1000));
}

function mt5ConnectingHint(row) {
  if (row && row.connecting_hint) return String(row.connecting_hint);
  const ea = String(row?.ea_status || '').trim().toLowerCase();
  if (ea === 'attach_required') return 'รอ EA ติดกับชาร์ต';
  if (ea === 'ready' || ea === 'starting') return 'รอเปิด Auto Trading / EA';
  const cmd = String(row?.agent_command_status || '').trim().toLowerCase();
  if (!cmd || cmd === 'pending') return 'รอ VPS รับคำสั่ง';
  if (['processing', 'picked', 'running', 'in_progress'].includes(cmd)) return 'VPS กำลังเปิดบอท';
  if (cmd === 'success' || cmd === 'done') return 'รอข้อมูล Balance/Equity';
  return 'กำลังเชื่อมต่อบอท';
}

function mt5RenderStatusCell(row) {
  const st = mt5DisplayStatus(row);
  if (st !== 'connecting') {
    return '<span class="status ' + st + '">' + st + '</span>';
  }
  const since = row.connecting_since || row.started_at || '';
  const sec = mt5ConnectingElapsedSec(since);
  const hint = mt5ConnectingHint(row);
  const remain = Math.max(0, MT5_CONNECTING_MAX_SEC - sec);
  return (
    '<span class="status connecting" data-mt5-connecting="1">connecting</span>' +
    '<span class="mt5-connecting-timer" data-since="' + mt5ManageEscape(since) + '" data-hint="' + mt5ManageEscape(hint) + '">' +
    sec + ' วิ · ' + mt5ManageEscape(hint) + (remain > 0 ? ' · เหลือ ~' + remain + ' วิ' : '') +
    '</span>'
  );
}

function mt5TickConnectingTimers() {
  document.querySelectorAll('.mt5-connecting-timer').forEach(function (el) {
    const since = el.getAttribute('data-since') || '';
    const hint = el.getAttribute('data-hint') || 'กำลังเชื่อมต่อบอท';
    const sec = mt5ConnectingElapsedSec(since);
    const remain = Math.max(0, MT5_CONNECTING_MAX_SEC - sec);
    el.textContent = sec + ' วิ · ' + hint + (remain > 0 ? ' · เหลือ ~' + remain + ' วิ' : '');
  });
  const runMeta = document.getElementById('mt5RunConnectingMeta');
  if (runMeta && runMeta.dataset.since) {
    const sec = mt5ConnectingElapsedSec(runMeta.dataset.since);
    const hint = runMeta.dataset.hint || 'กำลังเปิดบอท';
    const remain = Math.max(0, MT5_CONNECTING_MAX_SEC - sec);
    runMeta.innerHTML = '<b>กำลังเปิดบอท</b> — ใช้เวลา <b>' + sec + '</b> วินาที · ' + hint +
      (remain > 0 ? ' · โดยทั่วไป 30–90 วิ (สูงสุด ~' + MT5_CONNECTING_MAX_SEC + ' วิ)' : '');
  }
}

function mt5EnsureConnectingTick() {
  if (mt5ConnectingTickTimer) return;
  mt5ConnectingTickTimer = setInterval(mt5TickConnectingTimers, MT5_CONNECTING_TICK_MS);
  mt5TickConnectingTimers();
}

function mt5SyncLiveFastPoll(hasConnecting, pollFastSec) {
  const sec = hasConnecting ? Math.min(5, Number(pollFastSec || 5) || 5) : Number(pollFastSec || 90) || 90;
  const want = !!hasConnecting || sec > 0;
  const ms = Math.max(3000, (hasConnecting ? 5 : sec) * 1000);
  if (want) {
    if (mt5LiveFastPollTimer) clearInterval(mt5LiveFastPollTimer);
    mt5LiveFastPollTimer = setInterval(function () {
      loadMt5LiveDashboard(mt5LiveDashboardPage);
    }, ms);
    mt5EnsureConnectingTick();
  } else if (mt5LiveFastPollTimer) {
    clearInterval(mt5LiveFastPollTimer);
    mt5LiveFastPollTimer = null;
  }
}

function mt5DashboardUpdatedAt(row, preferSnapshot) {
  const raw = preferSnapshot
    ? (row?.live_metrics_at || row?.last_equity_snapshot_at || row?.last_agent_ping || row?.updated_at)
    : (row?.last_agent_ping || row?.last_equity_snapshot_at || row?.updated_at || row?.started_at);
  return mt5FormatThaiDateTime(raw);
}

function mt5DashboardProfit(i, preferLive) {
  if (preferLive && i && i.live_profit != null && Number.isFinite(Number(i.live_profit))) {
    return Number(i.live_profit);
  }
  if (i && i.profit != null && Number.isFinite(Number(i.profit))) return Number(i.profit);
  const balance = Number((preferLive && i?.live_balance != null) ? i.live_balance : (i?.mt5_balance || 0));
  const equity = Number((preferLive && i?.live_equity != null) ? i.live_equity : (i?.mt5_equity || 0));
  const startEq = Number(i?.start_equity || 0);
  if (startEq > 0 && Number.isFinite(equity)) return equity - startEq;
  if (Number.isFinite(balance) && Number.isFinite(equity)) return equity - balance;
  return null;
}

function mt5LiveMoney(i, field) {
  if (field === 'live_equity') {
    return i?.live_equity != null ? Number(i.live_equity) : Number(i?.mt5_equity || 0);
  }
  if (field === 'live_balance') {
    return i?.live_balance != null ? Number(i.live_balance) : Number(i?.mt5_balance || 0);
  }
  return 0;
}

function renderMt5DashboardTable(data, opts) {
  const mode = opts?.mode || 'live';
  const instances = data?.instances || [];
  if (!instances.length) {
    return '<div class="mt5-empty">ยังไม่มีรายการ BOT</div>';
  }

  const headLive = mode === 'live';
  let html = `
    <table class="mt5-table">
      <thead>
        <tr>
          <th>BOT</th>
          <th>Login</th>
          ${headLive ? '<th>PORT</th><th>Balance</th><th>Equity</th><th>Profit</th>' : '<th>เงินทุน</th><th>Lot</th><th>Level</th>'}
          <th>Status</th>
          <th>${headLive ? 'อัปเดตล่าสุด' : 'ล่าสุด'}</th>
          <th>Manage</th>
        </tr>
      </thead>
      <tbody>
  `;

  instances.forEach(function (i) {
    const st = mt5DisplayStatus(i);
    const balanceNum = headLive ? Number(mt5LiveMoney(i, 'live_balance')) : Number(i.mt5_balance || 0);
    const equityNum = headLive ? Number(mt5LiveMoney(i, 'live_equity')) : Number(i.mt5_equity || 0);
    const profitNum = mt5DashboardProfit(i, headLive);
    const profitCls = profitNum == null ? '' : (profitNum >= 0 ? 'pos' : 'neg');
    const detailAttrs = `
      data-instance-id="${i.id || ''}"
      data-bot="${mt5ManageEscape(i.display_name || i.bot_name || i.bot_code || '-')}"
      data-login="${mt5ManageEscape(i.mt5_login || '-')}"
      data-funding="${i.display_funding != null ? i.display_funding : (i.capital_used != null ? i.capital_used : '-')}"
      data-lot="${mt5ManageEscape(i.display_lot_text != null ? i.display_lot_text : (i.display_lot != null ? i.display_lot : (i.lot_used != null ? i.lot_used : '-')))}"
      data-lot-text="${mt5ManageEscape(i.display_lot_text || '')}"
      data-order-time="${mt5ManageEscape(i.order_time_label || i.run_time_mode || 'auto')}"
      data-level="${mt5ManageEscape(mt5TradeLevelText(i.trade_level || '-'))}"
      data-status="${mt5ManageEscape(st)}"
      data-port="${i.assigned_port_no || '-'}"
      data-node="${mt5ManageEscape(i.node_name || i.node_code || '-')}"
      data-updated="${mt5ManageEscape(mt5DashboardUpdatedAt(i))}"
    `;
    html += '<tr>';
    html += '<td>' + (i.display_name || i.bot_name || i.bot_code || '-') + '</td>';
    html += '<td>' + (i.mt5_login || '-') + '</td>';
    if (headLive) {
      html += '<td>' + (i.assigned_port_no || '-') + '</td>';
      html += '<td class="mt5-metric">' + mt5Money(balanceNum) + '</td>';
      html += '<td class="mt5-metric">' + mt5Money(equityNum) + '</td>';
      html += '<td class="mt5-metric ' + profitCls + '">' + (profitNum == null ? '-' : ((profitNum >= 0 ? '+' : '') + mt5Money(profitNum))) + '</td>';
    } else {
      const funding = i.display_funding != null ? i.display_funding : i.capital_used;
      const lotText = i.display_lot_text != null
        ? i.display_lot_text
        : (i.display_lot != null ? Number(i.display_lot).toFixed(2) : (i.lot_used != null ? i.lot_used : '-'));
      html += '<td>' + (funding != null ? Number(funding).toFixed(2) : '-') + '</td>';
      html += '<td>' + mt5ManageEscape(lotText) + '</td>';
      html += '<td>' + mt5ManageEscape(mt5TradeLevelText(i.trade_level || '-')) + '</td>';
    }
    html += '<td>' + mt5RenderStatusCell(i) + '</td>';
    html += '<td class="mt5-metric-time">' + mt5DashboardUpdatedAt(i, headLive) + '</td>';
    html += '<td><details class="mt5-manage-menu"><summary>Manage</summary><div class="mt5-manage-dropdown">';
    html += '<button type="button" class="mt5-manage-item" onclick="openMt5InstanceDetail(this)" ' + detailAttrs + '>รายละเอียด</button>';
    if (headLive) {
      html += '<button type="button" class="mt5-manage-item" onclick="openMt5EquityGraph(this)" ' + detailAttrs + '>กราฟ</button>';
      html += '<form method="POST" action="/app/mt5/request-restart/' + i.id + '" onsubmit="return confirm(\'ยืนยัน Restart BOT รายการนี้ใช่ไหม?\')"><button class="mt5-manage-item" type="submit">Restart</button></form>';
    } else {
      html += '<button type="button" class="mt5-manage-item" onclick="openMt5InstanceAnalysis(this)" ' + detailAttrs + '>วิเคราะห์</button>';
    }
    html += '<form method="POST" action="/app/mt5/instance/' + i.id + '/delete" onsubmit="return confirm(\'ยืนยันลบรายการนี้ใช่ไหม?\')"><button class="mt5-manage-item danger" type="submit">ลบ</button></form>';
    html += '</div></details></td></tr>';
  });

  html += '</tbody></table>';
  const page = Number(data.page || 1);
  const pageCount = Number(data.pageCount || 1);
  if (pageCount > 1) {
    const prevFn = mode === 'live' ? 'changeMt5LiveDashboardPage' : 'changeMt5HistoryDashboardPage';
    const nextFn = prevFn;
    html += '<div class="mt5-pager">';
    html += '<button type="button" class="mt5-pager-btn' + (data.hasPrev ? '' : ' disabled') + '" ' + (data.hasPrev ? ('onclick="' + prevFn + '(' + (page - 1) + ')"') : 'disabled') + '>ก่อนหน้า</button>';
    html += '<span class="mt5-pager-meta">หน้า <b>' + page + '</b> / ' + pageCount + '</span>';
    html += '<button type="button" class="mt5-pager-btn primary' + (data.hasNext ? '' : ' disabled') + '" ' + (data.hasNext ? ('onclick="' + nextFn + '(' + (page + 1) + ')"') : 'disabled') + '>ถัดไป</button>';
    html += '</div>';
  }
  return html;
}

function changeMt5LiveDashboardPage(nextPage) {
  mt5LiveDashboardPage = Math.max(1, Number(nextPage || 1));
  loadMt5LiveDashboard(mt5LiveDashboardPage);
}

function changeMt5HistoryDashboardPage(nextPage) {
  mt5HistoryDashboardPage = Math.max(1, Number(nextPage || 1));
  loadMt5HistoryDashboard(mt5HistoryDashboardPage);
}

window.changeMt5LiveDashboardPage = changeMt5LiveDashboardPage;
window.changeMt5HistoryDashboardPage = changeMt5HistoryDashboardPage;
bindMt5ManageMenus(document);

async function loadMt5LiveDashboard(page) {
  const box = document.getElementById('mt5LiveDashboard');
  if (!box) return;
  if (page != null) mt5LiveDashboardPage = Math.max(1, Number(page || 1));
  try {
    const res = await fetch('/app/mt5/live-dashboard?page=' + encodeURIComponent(mt5LiveDashboardPage), {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();
    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลด Live Dashboard ไม่สำเร็จ</div>';
      return;
    }
    const liveHead = document.getElementById('mt5LiveDashboardMeta');
    if (liveHead) {
      const metricsSec = Number(data.metricsRefreshSec || data.refreshSec || 90);
      liveHead.textContent =
        'Status อัปเดตทุก 5 วินาทีขณะเชื่อมต่อ · Balance · Equity · Profit และกราฟ Equity ทุก ' + metricsSec + ' วินาที';
    }
    box.innerHTML = renderMt5DashboardTable(data, { mode: 'live' });
    bindMt5ManageMenus(box);
    mt5SyncLiveFastPoll(data.hasConnecting, data.pollFastSec);
    mt5TickConnectingTimers();
  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">Live Dashboard Error: ' + e.message + '</div>';
    mt5SyncLiveFastPoll(false);
  }
}

async function loadMt5HistoryDashboard(page) {
  const box = document.getElementById('mt5HistoryDashboard');
  if (!box) return;
  if (page != null) mt5HistoryDashboardPage = Math.max(1, Number(page || 1));
  try {
    const res = await fetch('/app/mt5/history?page=' + encodeURIComponent(mt5HistoryDashboardPage), {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();
    const meta = document.getElementById('mt5HistoryMeta');
    if (meta && data.ok) {
      meta.textContent = 'ทุกครั้งที่ Run = แถวใหม่ · รวม ' + (data.total || 0) + ' รายการ · หยุด/Error บันทึกในรายการ';
    }
    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลดประวัติไม่สำเร็จ</div>';
      return;
    }
    box.innerHTML = renderMt5DashboardTable(data, { mode: 'history' });
    bindMt5ManageMenus(box);
    mt5TickConnectingTimers();
  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">ประวัติ Error: ' + e.message + '</div>';
  }
}

async function refreshMt5Dashboards() {
  await Promise.all([
    loadMt5LiveDashboard(mt5LiveDashboardPage),
    loadMt5HistoryDashboard(mt5HistoryDashboardPage)
  ]);
  if (typeof window.refreshMt5PortCards === 'function') {
    await window.refreshMt5PortCards();
  }
}

loadMt5LiveDashboard();
loadMt5HistoryDashboard();
mt5EnsureConnectingTick();
setInterval(function () {
  loadMt5LiveDashboard(mt5LiveDashboardPage);
}, MT5_DASHBOARD_REFRESH_MS);
</script>

