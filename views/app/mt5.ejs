<%- include('../partials/app-shell') %>

<div class="mt5-page">
  <% /* if (error) { %><div class="mt5-alert danger"><%- error %></div><% } */ %>
  <% if (success && !error) { %>
  <div class="mt5-alert success" id="mt5SuccessAlert"><%- success %></div>
<% } %>

<style>
.mt5-error-modal{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center}
.mt5-error-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(10px)}
.mt5-error-card{position:relative;width:min(460px,92vw);border-radius:28px;padding:32px;background:linear-gradient(145deg,#111827,#020617);border:1px solid rgba(248,113,113,.45);box-shadow:0 30px 100px rgba(0,0,0,.65),0 0 48px rgba(248,113,113,.18);color:#fff;text-align:center;animation:mt5ErrPop .22s ease-out}
.mt5-error-icon{width:68px;height:68px;margin:0 auto 16px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(248,113,113,.14);font-size:36px}
.mt5-error-card h3{margin:0 0 10px;font-size:24px;font-weight:900}
.mt5-error-card p{margin:0 0 24px;color:#fecaca;font-size:16px;line-height:1.6}
.mt5-error-card button{border:0;border-radius:16px;padding:13px 34px;font-weight:900;color:#fff;cursor:pointer;background:linear-gradient(135deg,#ef4444,#f97316);box-shadow:0 12px 28px rgba(239,68,68,.35)}
@keyframes mt5ErrPop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.port-card-pick{cursor:pointer}
.port-card-pick:hover{border-color:rgba(125,211,252,.45)}
.port-item.selected-run{border-color:#38bdf8;box-shadow:0 0 0 2px rgba(56,189,248,.25)}
.port-item.selected-connect{border-color:#facc15;box-shadow:0 0 0 2px rgba(250,204,21,.20)}
.status{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800;text-transform:lowercase}
.status.running{background:rgba(34,197,94,.18);color:#86efac;border:1px solid rgba(34,197,94,.35)}
.status.connecting{background:rgba(56,189,248,.16);color:#7dd3fc;border:1px solid rgba(56,189,248,.32)}
.mt5-connecting-timer{display:block;margin-top:4px;font-size:11px;color:#7dd3fc;line-height:1.35;font-weight:700;font-variant-numeric:tabular-nums}
.mt5-run-connecting-meta{margin-top:6px;padding:8px 10px;border-radius:12px;background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.22);color:#bae6fd;font-size:12px;line-height:1.45}
.mt5-run-connecting-meta b{color:#e0f2fe}
.mt5-run-prepare-box{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:140px;padding:28px 20px;border-radius:20px;background:linear-gradient(145deg,rgba(15,23,42,.92),rgba(2,6,23,.88));border:1px solid rgba(56,189,248,.22);text-align:center}
.mt5-run-prepare-ring{width:44px;height:44px;border-radius:50%;border:3px solid rgba(56,189,248,.2);border-top-color:#38bdf8;animation:mt5PrepareSpin .85s linear infinite}
.mt5-run-prepare-title{margin:0;font-size:16px;font-weight:900;color:#e2e8f0}
.mt5-run-prepare-timer{margin:0;font-size:14px;color:#7dd3fc}
.mt5-run-prepare-timer b{font-size:20px;color:#fff;font-variant-numeric:tabular-nums}
.mt5-run-prepare-hint{margin:0;font-size:12px;color:#94a3b8}
@keyframes mt5PrepareSpin{to{transform:rotate(360deg)}}
.status.stopped{background:rgba(148,163,184,.14);color:#cbd5e1;border:1px solid rgba(148,163,184,.28)}
.status.fail{background:rgba(239,68,68,.16);color:#fca5a5;border:1px solid rgba(239,68,68,.35)}
</style>


  <section class="mt5-hero">
    <div>
      <div class="mt5-kicker">MH Markets / MT5 Connector</div>
      <h1>เชื่อมต่อ MT5 และรัน BOT ทองคำ</h1>
    </div>
  </section>

  <section class="mt5-package-panel mt5-package-panel-right">
    <div class="mt5-package-detail-card mt5-package-mini-card <%= packageExpired ? 'expired' : '' %>">
      <div class="mt5-card-head mt5-mini-head">
        <div>
          <h2>รายละเอียดแพ็กเกจที่ซื้อ</h2>
          <span><%= packageExpired ? 'หมดอายุแล้ว ระบบปิดการใช้งาน MT5' : 'ข้อมูลจริงจากระบบสมาชิก' %></span>
        </div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
      </div>

      <div class="mt5-mini-package-name"><%= displayPackageName || pkg.package_name %></div>

      <div class="mt5-detail-grid mt5-detail-grid-mini">
        <div><small>ประเภท</small><b><%= packageTypeText %></b></div>
        <div><small>รองรับ Lot</small><b><%= packageExpired ? '0' : (packageLotMin + ' - ' + packageLotMax) %></b></div>
        <div><small>รองรับ Port</small><b><%= packageExpired ? '0' : (packagePortRange || ('1 - ' + packageMaxPorts)) %> PORT</b><% if (!packageExpired && ((temporaryExtra || 0) + (permanentExtra || 0) > 0)) { %> <small>+ เพิ่ม <%= (temporaryExtra || 0) + (permanentExtra || 0) %> (รวม <%= totalPorts %>)</small><% } %></div>
        <div><small>ใช้งานระบบได้</small><b><%= displayPackageDaysText || '-' %></b></div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
        <div>
  <small>จะหมดอีก</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : (packageDaysLeft + ' วัน') 
    %>
  </b>
</div>
        <div><small>พอร์ตว่าง</small><b id="mt5ConnectedCount"><%= packageExpired ? '0' : (typeof availablePortCount !== 'undefined' ? availablePortCount : connectedCount) %> ช่องว่าง</b></div>
      </div>
    </div>
  </section>

  <% if (packageExpired) { %>
    <div class="mt5-expired-banner">
      <b>แพ็คเกจหมดอายุ</b> กรุณาเติมแพ็กเกจค่ะ
    </div>
  <% } %>

  <section class="mt5-grid mt5-grid-2">
    <div class="mt5-card">
      <div class="mt5-card-head">
        <h2>1) เลือก PORT ตามแพ็กเกจ</h2>
        <span>แพ็กเกจให้ <%= includedPorts || 1 %> PORT (สูงสุด <%= packagePortRange || ('1 - ' + packageMaxPorts) %>) · ใช้ได้ <%= totalPorts %> PORT / Lot <%= packageLotMin %>-<%= packageLotMax %></span>
      </div>
      <div class="port-list" id="mt5PortList">
        <% if (totalPorts <= 0) { %>
          <div class="port-item cancelled"><div class="port-main"><div><b>PORT 0</b><small>แพ็คเกจหมดอายุ</small></div><span>ใช้งานไม่ได้</span></div></div>
        <% } %>
        <% for (let i = 1; i <= totalPorts; i++) { %>
          <% const acc = typeof pickAccountForPortSlot === 'function' ? pickAccountForPortSlot(portSlotAccounts || accounts, i) : (accounts || []).find(a => Number(a.port_slot) === i); %>
          <% const accStatus = acc ? String(acc.status || '').toLowerCase() : ''; %>
          <% const canUsePort = acc && accStatus === 'connected'; %>
          <% const slotBusy = acc && ['connecting','checking','connected','ready','starting'].includes(accStatus); %>
          <% const cardPick = canUsePort || !slotBusy; %>
          <div class="port-item <%= canUsePort ? 'connected' : (accStatus === 'connecting' || accStatus === 'starting' ? 'checking' : (acc ? 'cancelled' : '')) %><%= cardPick ? ' port-card-pick' : '' %>" data-port-slot="<%= i %>"<%= acc ? (' data-account-id="' + acc.id + '"') : '' %><%= cardPick ? ' role="button" tabindex="0"' : '' %>>
            <div class="port-main">
              <div>
                <b>PORT <%= i %></b>
                <small><%= acc ? ('Login: ' + acc.mt5_login + ((acc.last_equity || acc.last_balance) ? ' / Equity: ' + (acc.last_equity || acc.last_balance) : '')) : 'ยังไม่เชื่อมต่อ' %></small>
              </div>
              <span><%= canUsePort ? 'พร้อมรัน' : (accStatus === 'connecting' || accStatus === 'starting' ? 'กำลังเปิด MT5...' : (accStatus === 'checking' ? 'กำลังตรวจ Login' : (accStatus === 'failed' ? 'Login ไม่ผ่าน' : (accStatus === 'ready' ? 'ต้องเชื่อมต่อใหม่' : (acc ? 'ยกเลิกแล้ว' : 'ว่าง'))))) %></span>
            </div>
            <% if (acc) { %>
              <div class="port-actions" onclick="event.stopPropagation()">
                <form method="POST" action="/app/mt5/account/<%= acc.id %>/delete" class="port-delete-form" onclick="event.stopPropagation()">
                  <button class="mt5-btn mini delete" type="submit" onclick="event.stopPropagation()">ลบ</button>
                </form>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
      <div class="mt5-buy-row mt5-buy-single">
        <div class="mt5-add-port-menu" id="mt5AddPortMenu">
          <button type="button" class="mt5-btn warning mt5-add-port-main" onclick="toggleAddPortMenu()" <%= packageExpired ? 'disabled' : '' %>>+ เพิ่มพอร์ต</button>
          <div class="mt5-add-port-dropdown" id="mt5AddPortDropdown">
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ต', '1 Scoin', 'พอร์ตชั่วคราว เพิ่มได้ไม่เกินสิทธิ์แพ็กเกจ และหมดอายุพร้อมแพ็กเกจ')">
              <input type="hidden" name="port_type" value="temporary">
              <button type="submit" class="mt5-port-choice" <%= (packageExpired || canAddTemporary === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ต</b>
                <small>1 Scoin · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> ช่อง</small>
              </button>
            </form>
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ตถาวร', '10 Scoin', 'พอร์ตถาวรผูกกับระดับแพ็กเกจปัจจุบัน BASIC / PRO / ADVANCED')">
              <input type="hidden" name="port_type" value="permanent">
              <button type="submit" class="mt5-port-choice permanent" <%= (packageExpired || canAddPermanent === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ตถาวร</b>
                <small>10 Scoin · ผูกกับระดับ <%= (pkg.package_group || 'BASIC') %> (เพิ่มช่องถาวร)</small>
              </button>
            </form>
          </div>
        </div>
        <div class="mt5-buy-note">
          ซื้อแพ็กเกจได้ <%= includedPorts || 1 %> PORT · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> · ถาวรผูกระดับ <b><%= (pkg.package_group || 'BASIC') %></b>
        </div>
      </div>
    </div>

