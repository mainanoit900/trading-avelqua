<script>
(function () {
  let mt5Checking = true;
  const serverPendingAccountId = '<%= typeof pendingConnectAccountId !== "undefined" && pendingConnectAccountId ? pendingConnectAccountId : "" %>';
  let mt5PollAccountId = sessionStorage.getItem('mt5PollAccountId') || serverPendingAccountId || '';
  const urlParams = new URLSearchParams(window.location.search);
  function showMt5ConnectModal(type, message) {
    if (type === 'error') {
      document.querySelectorAll('.mt5-alert.success, #mt5SuccessAlert').forEach(el => el.remove());
    }
    const modalId = type === 'success' ? 'mt5SuccessModal' : 'mt5ErrorModal';
    if (document.getElementById(modalId)) return;
    const isSuccess = type === 'success';
    const modal = document.createElement('div');
    modal.id = modalId;
    modal.className = 'mt5-lux-modal';
    modal.innerHTML = `
      <div class="mt5-lux-backdrop"></div>
      <div class="mt5-lux-card ${isSuccess ? 'success' : 'error'}">
        <div class="mt5-lux-icon">${isSuccess ? '✅' : '⚠️'}</div>
        <h3>${isSuccess ? 'เชื่อมต่อสำเร็จ' : 'เชื่อมต่อไม่สำเร็จ'}</h3>
        <p>${message || (isSuccess ? 'เชื่อมต่อสำเร็จ' : 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด')}</p>
        <button type="button" onclick="document.getElementById('${modalId}')?.remove()">ตกลง</button>
      </div>
    `;
    document.body.appendChild(modal);
  }

  window.showMt5ConnectModal = showMt5ConnectModal;

  let mt5UiModalResolve = null;
  let mt5UiModalMode = 'confirm';

  function mt5EnsureUiModal() {
    if (document.getElementById('mt5UiModal')) return;
    const el = document.createElement('div');
    el.id = 'mt5UiModal';
    el.className = 'mt5-ui-modal';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML =
      '<div class="mt5-ui-backdrop" data-mt5-ui-close="0"></div>' +
      '<div class="mt5-ui-card" role="dialog" aria-modal="true">' +
      '<div class="mt5-ui-icon" id="mt5UiIcon">✨</div>' +
      '<h3 id="mt5UiTitle">ยืนยัน</h3>' +
      '<p id="mt5UiMessage"></p>' +
      '<div class="mt5-ui-actions" id="mt5UiActions">' +
      '<button type="button" class="mt5-ui-btn ghost" id="mt5UiCancelBtn">ยกเลิก</button>' +
      '<button type="button" class="mt5-ui-btn primary" id="mt5UiOkBtn">ตกลง</button>' +
      '</div></div>';
    document.body.appendChild(el);
    const close = function (value) {
      el.classList.remove('show');
      el.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('mt5-ui-open');
      const fn = mt5UiModalResolve;
      mt5UiModalResolve = null;
      if (fn) fn(value);
    };
    el.querySelector('[data-mt5-ui-close]').addEventListener('click', function () {
      close(mt5UiModalMode === 'confirm' ? false : undefined);
    });
    document.getElementById('mt5UiCancelBtn').addEventListener('click', function () {
      close(false);
    });
    document.getElementById('mt5UiOkBtn').addEventListener('click', function () {
      close(mt5UiModalMode === 'confirm' ? true : undefined);
    });
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && el.classList.contains('show')) {
        close(mt5UiModalMode === 'confirm' ? false : undefined);
      }
    });
  }

  function mt5OpenUiModal(opts) {
    mt5EnsureUiModal();
    const modal = document.getElementById('mt5UiModal');
    const card = modal.querySelector('.mt5-ui-card');
    const variant = String(opts.variant || 'default');
    card.className = 'mt5-ui-card ' + variant;
    const icons = { danger: '⏹', warning: '⚠️', success: '▶', default: '✨' };
    document.getElementById('mt5UiIcon').textContent = opts.icon || icons[variant] || icons.default;
    document.getElementById('mt5UiTitle').textContent = opts.title || 'ยืนยัน';
    document.getElementById('mt5UiMessage').textContent = opts.message || '';
    const cancelBtn = document.getElementById('mt5UiCancelBtn');
    const okBtn = document.getElementById('mt5UiOkBtn');
    const isAlert = opts.mode === 'alert';
    cancelBtn.style.display = isAlert ? 'none' : '';
    okBtn.textContent = opts.okText || (isAlert ? 'ตกลง' : 'ยืนยัน');
    cancelBtn.textContent = opts.cancelText || 'ยกเลิก';
    okBtn.className = 'mt5-ui-btn primary ' + (variant === 'danger' ? 'danger' : (variant === 'warning' ? 'warning' : 'success'));
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('mt5-ui-open');
    setTimeout(function () { okBtn.focus(); }, 80);
  }

  window.mt5UiConfirm = function (opts) {
    return new Promise(function (resolve) {
      mt5UiModalMode = 'confirm';
      mt5UiModalResolve = resolve;
      mt5OpenUiModal(Object.assign({ mode: 'confirm' }, opts || {}));
    });
  };

  window.mt5UiAlert = function (opts) {
    return new Promise(function (resolve) {
      mt5UiModalMode = 'alert';
      mt5UiModalResolve = resolve;
      mt5OpenUiModal(Object.assign({ mode: 'alert', variant: 'warning' }, opts || {}));
    });
  };

  window.mt5StopBot = async function (instanceId, btn) {
    const id = Number(instanceId);
    if (!Number.isFinite(id) || id <= 0) return;
    if (btn && btn.dataset.stopping === '1') return;
    const ok = await mt5UiConfirm({
      variant: 'danger',
      title: 'หยุด BOT',
      message: 'ยืนยันหยุด BOT และปิด MT5? หลังจากนั้นสามารถเลือกบอทหรือ Run ใหม่ได้',
      okText: 'หยุด BOT',
      cancelText: 'ยกเลิก'
    });
    if (!ok) return;
    if (btn) {
      btn.dataset.stopping = '1';
      btn.disabled = true;
      btn.textContent = 'กำลังหยุด...';
    }
    try {
      const body = new URLSearchParams();
      body.set('close_mt5', '1');
      await fetch('/app/mt5/stop/' + encodeURIComponent(String(id)), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'text/html' },
        body: body.toString()
      });
      window.location.assign('/app/mt5');
    } catch (err) {
      if (btn) {
        btn.dataset.stopping = '0';
        btn.disabled = false;
        btn.textContent = 'Stop BOT';
      }
      await mt5UiAlert({ variant: 'danger', title: 'ส่งคำสั่งไม่สำเร็จ', message: String(err && err.message ? err.message : err) });
    }
  };

  window.__mt5PageMeta = {
    packageExpired: <%= packageExpired ? 'true' : 'false' %>,
    packageLotMin: <%= packageLotMin %>,
    packageLotMax: <%= packageLotMax %>,
    packageDefaultLot: <%= typeof packageDefaultLot !== 'undefined' ? packageDefaultLot : packageLotMax %>
  };
  window.__mt5RunConfig = {
    packageExpired: <%= packageExpired ? 'true' : 'false' %>,
    packageGroup: <%- JSON.stringify(runPackageGroup || 'BASIC') %>,
    packageLotMin: <%= packageLotMin %>,
    packageLotMax: <%= packageLotMax %>,
    packageDefaultLot: <%= typeof packageDefaultLot !== 'undefined' ? packageDefaultLot : packageLotMax %>,
    bots: <%- JSON.stringify((bots || []).map(function (b) { return { code: String(b.bot_code || b.bot_name || '').trim(), label: b.display_name || b.bot_name || b.bot_code || '' }; })) %>,
    botUi: <%- JSON.stringify(runBotUi || {}) %>,
    capitalPer001Lot: 10000,
    connectedAccounts: <%- JSON.stringify(connectedRunAccounts || []) %>,
    activeInstances: <%- JSON.stringify(activeRunInstances || []) %>
  };
  const mt5RunState = {
    connectedAccounts: Array.isArray(window.__mt5RunConfig.connectedAccounts) ? window.__mt5RunConfig.connectedAccounts.slice() : [],
    activeInstances: Array.isArray(window.__mt5RunConfig.activeInstances) ? window.__mt5RunConfig.activeInstances.slice() : [],
    selectedAccountId: Number(sessionStorage.getItem('mt5RunAccountId') || 0)
  };
  window.mt5RunState = mt5RunState;

  function mt5Esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function mt5Num(v, d) {
    const n = Number(v);
    return Number.isFinite(n) ? n : (d == null ? 0 : d);
  }

  function mt5Fixed(v) {
    return mt5Num(v, 0).toFixed(2);
  }

  function mt5Clamp(v, min, max) {
    const lo = mt5Num(min, 0.01);
    const hi = Math.max(lo, mt5Num(max, lo));
    let out = mt5Num(v, lo);
    if (out < lo) out = lo;
    if (out > hi) out = hi;
    return Number(out.toFixed(2));
  }

  function mt5RunAccountCapital(account) {
    if (!account) return 0;
    return mt5Num(account.last_equity, mt5Num(account.last_balance, 0));
  }

  function mt5NormalizeTradeLevel(level) {
    const value = String(level || '').trim().toLowerCase();
    if (value === 'high' || value === 'fast') return 'high';
    if (value === 'medium') return 'medium';
    if (value === 'low' || value === 'safe') return 'low';
    return 'medium';
  }

  function mt5TradeLevelLabel(level) {
    const value = mt5NormalizeTradeLevel(level);
    if (value === 'high') return 'เสี่ยงสูง';
    if (value === 'medium') return 'เสี่ยงกลาง';
    return 'เสี่ยงต่ำ';
  }

  function mt5BotKind(code) {
    const c = String(code || '').toUpperCase();
    if (c.indexOf('QUANTUM-QUEEN') >= 0) return 'quantum';
    if (c.indexOf('QUEEN-SNIPER') >= 0) return 'queen';
    if (c.indexOf('AK-SNIPER') >= 0) return 'ak';
    return 'legacy';
  }

  function mt5LotFromCapital(capital) {
    const cap = mt5Num(capital, 0);
    if (cap <= 0) return 0;
    return Number(((cap / 100) * 0.01).toFixed(4));
  }

  function mt5CapitalFromLot(lot) {
    const l = mt5Num(lot, 0);
    if (l <= 0) return 0;
    const per = mt5Num((window.__mt5RunConfig || {}).capitalPer001Lot, 10000);
    return Number((l * per).toFixed(2));
  }

  function mt5RoundTrailLow(v) {
    const x = mt5Num(v, 0);
    const frac = x - Math.floor(x);
    return frac < 0.5 ? Math.floor(x) : Math.ceil(x);
  }

  function mt5RoundTrailMedStop(v) {
    const x = mt5Num(v, 0);
    const frac = x - Math.floor(x);
    return frac > 0.5 ? Math.ceil(x) : Math.floor(x);
  }

  function mt5AkTrailing(lot, level, capital) {
    const l = mt5Num(lot, 0.01);
    const cap = mt5Num(capital, 0);
    const lv = mt5NormalizeTradeLevel(level);
    if (lv === 'high') {
      return { tStart: Number((l * 200).toFixed(2)), tStop: Number((l * 100).toFixed(2)) };
    }
    if (cap >= 300 && lv === 'low') {
      return { tStart: mt5RoundTrailLow(l * 170), tStop: mt5RoundTrailLow(l * 70) };
    }
    if (cap >= 300 && lv === 'medium') {
      return { tStart: mt5RoundTrailLow(l * 170), tStop: mt5RoundTrailMedStop(l * 85) };
    }
    return { tStart: Number((l * 170).toFixed(2)), tStop: Number((l * 85).toFixed(2)) };
  }

  function mt5QueenLot(capital) {
    const cap = mt5Num(capital, 0);
    if (cap < 10000) return 0;
    return Number((Math.floor(cap / 10000) * 0.01).toFixed(2));
  }

  function mt5MinCapitalForBot(code) {
    const ui = ((window.__mt5RunConfig || {}).botUi || {})[code] || {};
    return mt5Num(ui.minCapital, 100);
  }

  function mt5CapitalHintForBot(code) {
    const ui = ((window.__mt5RunConfig || {}).botUi || {})[code] || {};
    return ui.capitalHint || ('ขั้นต่ำ ' + mt5MinCapitalForBot(code));
  }

  function mt5CapitalLabelForBot(code) {
    const minCap = mt5MinCapitalForBot(code);
    return 'เงินทุน (ขั้นต่ำ ' + minCap + ')';
  }

  function mt5DefaultCapitalForBot(code, equity) {
    const eq = mt5Num(equity, 0);
    const kind = mt5BotKind(code);
    if (kind === 'queen' || kind === 'quantum') {
      return eq > 0 ? eq : 0;
    }
    const ui = ((window.__mt5RunConfig || {}).botUi || {})[code] || {};
    return eq > 0 ? eq : mt5Num(ui.minCapital, 100);
  }

  function mt5BotUsesEquityCapital(code) {
    const ui = ((window.__mt5RunConfig || {}).botUi || {})[code] || {};
    if (ui.equityBased) return true;
    const kind = mt5BotKind(code);
    return kind === 'queen' || kind === 'quantum';
  }

  function mt5SelectedRunAccount() {
    const connected = Array.isArray(mt5RunState.connectedAccounts) ? mt5RunState.connectedAccounts : [];
    const explicitId = Number(mt5RunState.selectedAccountId || 0);
    if (explicitId) {
      const byId = connected.find(function (a) { return Number(a.id) === explicitId; });
      if (byId) return byId;
    }
    if (connected.length) {
      const active = Array.isArray(mt5RunState.activeInstances) ? mt5RunState.activeInstances : [];
      const activeIds = new Set(active.map(function (row) { return Number(row.mt5_account_id || 0); }));
      const picked = connected.find(function (a) { return !activeIds.has(Number(a.id)); }) || connected[0];
      mt5RunState.selectedAccountId = Number(picked.id);
      sessionStorage.setItem('mt5RunAccountId', String(picked.id));
      return picked;
    }
    return null;
  }

  function mt5SelectedRunInstance() {
    const account = mt5SelectedRunAccount();
    if (!account) return null;
    const active = Array.isArray(mt5RunState.activeInstances) ? mt5RunState.activeInstances : [];
    return active.find(function (row) {
      return Number(row.mt5_account_id || 0) === Number(account.id);
    }) || null;
  }

  function mt5ComputeRunPreset(botCode, capital, manualLot, tradeLevel, runTimeMode, syncField) {
    const cfg = window.__mt5RunConfig || {};
    const lotMin = mt5Num(cfg.packageLotMin, 0.01);
    const lotMax = mt5Num(cfg.packageLotMax, 0.05);
    const kind = mt5BotKind(botCode);
    const level = mt5NormalizeTradeLevel(tradeLevel);
    const mode = String(runTimeMode || 'auto').toLowerCase();
    const timeLabel = mode === '24h' ? 'Open 24H.' : 'Auto trading';
    const minCap = mt5MinCapitalForBot(botCode);
    let cap = mt5Num(capital, 0);
    let lot = 0;
    let packageCapped = false;
    const sync = String(syncField || 'capital');

    if (kind === 'quantum') {
      return {
        botKind: 'quantum',
        lot: 0,
        lotPlus: 0,
        capital: cap,
        tStart: 0,
        tStop: 0,
        pipStep: 345,
        takeProfitAverage: 100,
        minCapital: 50000,
        packageCapped: false,
        warning: cap < 50000 ? 'เงินทุนไม่พอใช้บอทตัวนี้ (ขั้นต่ำ 50,000 USD)' : '',
        runTimeMode: mode,
        timeLabel: timeLabel + ' · TF M15'
      };
    }

    if (kind === 'queen') {
      lot = mt5Clamp(mt5QueenLot(cap), lotMin, lotMax);
      return {
        botKind: 'queen',
        lot: lot,
        lotPlus: lot,
        capital: cap,
        tStart: 0,
        tStop: 0,
        pipStep: 345,
        takeProfitAverage: 100,
        minCapital: 10000,
        packageCapped: false,
        warning: cap < 10000 ? 'เงินทุนไม่พอใช้บอทตัวนี้ (ขั้นต่ำ 10,000 USD)' : (lot <= 0 ? 'ทุนไม่ถึงขั้นต่ำสำหรับ Lot 0.01' : ''),
        runTimeMode: mode,
        timeLabel: 'บอทตั้ง Lot อัตโนมัติ (ทุน 10,000 USD / +0.01 Lot)'
      };
    }

    if (kind === 'ak') {
      const manual = mt5Num(manualLot, 0);
      if (sync === 'lot' && manual > 0) {
        lot = mt5Clamp(manual, lotMin, lotMax);
        cap = mt5CapitalFromLot(lot);
      } else {
        const ideal = mt5LotFromCapital(cap);
        lot = mt5Clamp(ideal, lotMin, lotMax);
        if (ideal > lotMax + 0.0001) {
          packageCapped = true;
          cap = mt5CapitalFromLot(lot);
        }
      }
      const trail = mt5AkTrailing(lot, level, cap);
      let warning = '';
      if (packageCapped) {
        warning = 'Lot ถูกจำกัดตามแพ็กเกจ (สูงสุด ' + mt5Fixed(lotMax) + ') — ปรับเงินทุนเป็น ' + mt5Fixed(cap);
      }
      if (cap < minCap) warning = 'เงินทุนต้องไม่ต่ำกว่า ' + minCap;
      return {
        botKind: 'ak',
        lot: lot,
        lotPlus: lot,
        capital: cap,
        tStart: trail.tStart,
        tStop: trail.tStop,
        pipStep: 345,
        takeProfitAverage: 100,
        minCapital: minCap,
        packageCapped: packageCapped,
        warning: warning,
        runTimeMode: mode,
        timeLabel: timeLabel
      };
    }

    return {
      botKind: 'legacy',
      lot: mt5Clamp(mt5Num(manualLot, lotMax), lotMin, lotMax),
      lotPlus: mt5Clamp(mt5Num(manualLot, lotMax), lotMin, lotMax),
      capital: cap,
      tStart: 0,
      tStop: 0,
      pipStep: 345,
      takeProfitAverage: 100,
      minCapital: 100,
      packageCapped: false,
      warning: '',
      runTimeMode: mode,
      timeLabel: timeLabel
    };
  }

  function mt5RenderRunPresetSummary(form, preview) {
    const box = form.querySelector('#mt5RunPresetSummary');
    if (!box) return;
    if (!preview) {
      box.innerHTML = '<small style="color:#94a3b8">เลือกบอท / เงินทุน เพื่อดูค่าที่จะส่งเข้า EA</small>';
      return;
    }
    const warn = preview.warning
      ? '<div style="color:#fbbf24;margin-top:6px">⚠ ' + mt5Esc(preview.warning) + '</div>'
      : '';
    let grid = '<span>เงินทุน</span><b>' + mt5Esc(preview.capital) + '</b>';
    if (preview.botKind !== 'quantum') {
      grid += '<span>Lot / Lot+</span><b>' + mt5Esc(preview.lot) + ' / ' + mt5Esc(preview.lotPlus) + '</b>';
    }
    if (preview.botKind === 'ak') {
      grid += '<span>ระดับเสี่ยง</span><b>' + mt5Esc(mt5TradeLevelLabel(form.querySelector('select[name="trade_level"]')?.value || 'medium')) + '</b>';
      grid += '<span>Trailing Start / Stop</span><b>' + mt5Esc(preview.tStart) + ' / ' + mt5Esc(preview.tStop) + '</b>';
      grid += '<span>Lot+</span><b>' + mt5Esc(preview.lotPlus) + '</b>';
    }
    grid += '<span>เวลาเทรด</span><b>' + mt5Esc(preview.timeLabel) + '</b>';
    box.innerHTML =
      '<div style="font-size:13px;line-height:1.55;color:#e2e8f0">' +
      '<b>สรุปก่อน Run</b>' +
      '<div style="margin-top:6px;display:grid;grid-template-columns:1fr 1fr;gap:4px 12px">' +
      grid + '</div>' + warn + '</div>';
  }

  function mt5ApplyRunFormVisibility(form) {
    if (!form) return;
    const botSelect = form.querySelector('select[name="bot_code"]');
    const code = botSelect ? botSelect.value : '';
    const kind = mt5BotKind(code);
    const cap = mt5Num(form.querySelector('input[name="capital_manual"]')?.value, 0);
    const tradeWrap = form.querySelector('.mt5-run-trade-level-wrap');
    const timeWrap = form.querySelector('.mt5-run-time-mode-wrap');
    const lotWrap = form.querySelector('.mt5-run-lot-wrap');
    const lotInput = form.querySelector('input[name="manual_lot"]');
    if (tradeWrap) tradeWrap.style.display = kind === 'ak' ? '' : 'none';
    if (timeWrap) timeWrap.style.display = kind === 'ak' ? '' : 'none';
    if (lotWrap) lotWrap.style.display = kind === 'quantum' ? 'none' : '';
    if (lotInput) {
      lotInput.readOnly = kind === 'queen';
      lotInput.disabled = kind === 'quantum';
    }
    const levelSelect = form.querySelector('select[name="trade_level"]');
    if (levelSelect && kind === 'ak') {
      ['low', 'medium'].forEach(function (lv) {
        const opt = levelSelect.querySelector('option[value="' + lv + '"]');
        if (!opt) return;
        const hide = cap < 300;
        opt.hidden = hide;
        opt.disabled = hide;
        opt.style.display = hide ? 'none' : '';
      });
      if (cap < 300) levelSelect.value = 'high';
    }
    const capHint = form.querySelector('.mt5-capital-hint');
    if (capHint) capHint.textContent = mt5CapitalHintForBot(code);
    const capLabel = form.querySelector('.mt5-capital-label');
    if (capLabel) capLabel.textContent = mt5CapitalLabelForBot(code);
    const lotHint = form.querySelector('.mt5-lot-hint');
    if (lotHint) {
      lotHint.textContent = kind === 'queen'
        ? 'คำนวณจากทุน — แก้ไขไม่ได้'
        : (kind === 'ak'
          ? 'คำนวณจากทุน (สูงสุดแพ็กเกจ ' + mt5Esc(form.querySelector('input[name="manual_lot"]')?.max || '0.05') + ') — ปรับ Lot หรือทุนได้'
          : '');
    }
    mt5UpdateRunSubmitState(form);
  }

  function mt5UpdateRunSubmitState(form) {
    if (!form) return;
    const btn = form.querySelector('.mt5-run-primary');
    if (!btn) return;
    const meta = window.__mt5RunConfig || {};
    const hasActive = !!mt5SelectedRunInstance();
    const botCode = form.querySelector('select[name="bot_code"]')?.value || '';
    const capital = mt5Num(form.querySelector('input[name="capital_manual"]')?.value, 0);
    const preview = mt5ComputeRunPreset(
      botCode,
      capital,
      mt5Num(form.querySelector('input[name="manual_lot"]')?.value, 0),
      form.querySelector('select[name="trade_level"]')?.value || 'medium',
      form.querySelector('select[name="run_time_mode"]')?.value || 'auto',
      'capital'
    );
    const blocked = !!(preview.warning) || capital < mt5Num(preview.minCapital, 100);
    btn.disabled = !!meta.packageExpired || hasActive || blocked;
    if (blocked && !meta.packageExpired && !hasActive) {
      btn.title = preview.warning || 'เงินทุนไม่ถึงขั้นต่ำ';
    } else {
      btn.removeAttribute('title');
    }
  }

  function renderPortItemHtml(p) {
    const del = p.accountId
      ? '<form method="POST" action="/app/mt5/account/' + p.accountId + '/delete" class="port-delete-form" onclick="event.stopPropagation()">' +
        '<button class="mt5-btn mini delete" type="submit" onclick="event.stopPropagation()">ลบ</button></form>'
      : '';
    const actions = p.accountId ? '<div class="port-actions" onclick="event.stopPropagation()">' + del + '</div>' : '';
    const pickable = !p.accountId && !!p.canPick;
    const pickCls = pickable ? ' port-card-pick' : '';
    const pickAttr = pickable
      ? ' data-port-slot="' + p.slot + '"' + (p.accountId ? ' data-account-id="' + p.accountId + '"' : '') + ' role="button" tabindex="0"'
      : ' data-port-slot="' + p.slot + '"' + (p.accountId ? ' data-account-id="' + p.accountId + '"' : '');
    return (
      '<div class="port-item ' + mt5Esc(p.cssClass) + pickCls + '"' + pickAttr + '>' +
      '<div class="port-main"><div><b>PORT ' + p.slot + '</b><small>' + mt5Esc(p.sublabel) + '</small></div>' +
      '<span>' + mt5Esc(p.statusLabel) + '</span></div>' +
      actions +
      '</div>'
    );
  }

