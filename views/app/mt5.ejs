function closeLuxuryConfirm(){
  document.getElementById('luxuryConfirmModal').classList.remove('show');
  luxuryPendingForm = null;
}
function luxuryConfirm(e, form, title, message, okText){
  e.preventDefault();
  luxuryPendingForm = form;
  openLuxuryConfirm(title, message, okText, '');
