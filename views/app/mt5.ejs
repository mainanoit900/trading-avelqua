.mt5-license-warn{display:block;margin-top:8px;padding:10px 12px;border-radius:10px;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.35);color:#fde68a;font-size:13px;line-height:1.45}
.mt5-license-warn[hidden]{display:none}
.mt5-analytics-panel{padding:12px 0}
.mt5-analytics-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}
.mt5-stat{background:rgba(15,23,42,.6);border:1px solid rgba(148,163,184,.15);border-radius:12px;padding:10px}
.mt5-stat small{color:#94a3b8;display:block}
.mt5-stat b{font-size:18px}
.mt5-stat b.pos{color:#4ade80}
.mt5-stat b.neg{color:#f87171}
.mt5-equity-canvas{width:100%;height:220px;border-radius:12px;margin:12px 0;border:1px solid rgba(148,163,184,.2)}
.mt5-intel-box{background:rgba(30,41,59,.5);border-radius:12px;padding:14px;margin-top:10px;border:1px solid rgba(59,130,246,.25)}
.mt5-intel-box h4{margin:0 0 8px;color:#93c5fd}
.mt5-intel-box .muted{color:#94a3b8;font-size:13px}
.mt5-alert-item{padding:10px 12px;border-radius:10px;margin-top:8px;font-size:13px}
.mt5-alert-item.warning{background:rgba(250,204,21,.12);color:#fde68a}
.mt5-alert-item.danger{background:rgba(248,113,113,.15);color:#fecaca}
.mt5-live-chart-wrap{padding:12px 0 4px;border-top:1px solid rgba(148,163,184,.15);margin-top:12px}
