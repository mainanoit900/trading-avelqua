<%- include('../partials/app-shell') %>

<div class="mt5-page">
  <% /* if (error) { %><div class="mt5-alert danger"><%- error %></div><% } */ %>
  <% if (success && !error) { %>
  <div class="mt5-alert success" id="mt5SuccessAlert"><%- success %></div>
<% } %>

<style>
.mt5-error-modal{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center}
.mt5-error-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(10px)}
.mt5-error-card{position:relative;width:min(460px,92vw);border-radius:28px;padding:32px;background:linear-gradient(145deg,#111827,#020617);border:1px solid rgba(248,113,113,.45);box-shadow:0 30px 100px rgba(0,0,0,.65),0 0 48px rgba(248,113,113,.18);color:#fff;text-align:center;animation:mt5ErrPop .22s ease-out}
.mt5-error-icon{width:68px;height:68px;margin:0 auto 16px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(248,113,113,.14);font-size:36px}
.mt5-error-card h3{margin:0 0 10px;font-size:24px;font-weight:900}
.mt5-error-card p{margin:0 0 24px;color:#fecaca;font-size:16px;line-height:1.6}
.mt5-error-card button{border:0;border-radius:16px;padding:13px 34px;font-weight:900;color:#fff;cursor:pointer;background:linear-gradient(135deg,#ef4444,#f97316);box-shadow:0 12px 28px rgba(239,68,68,.35)}
@keyframes mt5ErrPop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.port-card-pick{cursor:pointer}
.port-card-pick:hover{border-color:rgba(125,211,252,.45)}
.port-item.selected-run{border-color:#38bdf8;box-shadow:0 0 0 2px rgba(56,189,248,.25)}
.port-item.selected-connect{border-color:#facc15;box-shadow:0 0 0 2px rgba(250,204,21,.20)}
</style>


  <section class="mt5-hero">
    <div>
      <div class="mt5-kicker">MH Markets / MT5 Connector</div>
      <h1>เชื่อมต่อ MT5 และรัน BOT ทองคำ</h1>
    </div>
  </section>

  <section class="mt5-package-panel mt5-package-panel-right">
    <div class="mt5-package-detail-card mt5-package-mini-card <%= packageExpired ? 'expired' : '' %>">
      <div class="mt5-card-head mt5-mini-head">
        <div>
          <h2>รายละเอียดแพ็กเกจที่ซื้อ</h2>
          <span><%= packageExpired ? 'หมดอายุแล้ว ระบบปิดการใช้งาน MT5' : 'ข้อมูลจริงจากระบบสมาชิก' %></span>
        </div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
      </div>

      <div class="mt5-mini-package-name"><%= displayPackageName || pkg.package_name %></div>

      <div class="mt5-detail-grid mt5-detail-grid-mini">
        <div><small>ประเภท</small><b><%= packageTypeText %></b></div>
        <div><small>รองรับ Lot</small><b><%= packageExpired ? '0' : (packageLotMin + ' - ' + packageLotMax) %></b></div>
        <div><small>รองรับ Port</small><b><%= packageExpired ? '0' : (packagePortRange || ('1 - ' + packageMaxPorts)) %> PORT</b><% if (!packageExpired && ((temporaryExtra || 0) + (permanentExtra || 0) > 0)) { %> <small>+ เพิ่ม <%= (temporaryExtra || 0) + (permanentExtra || 0) %> (รวม <%= totalPorts %>)</small><% } %></div>
        <div><small>ใช้งานระบบได้</small><b><%= displayPackageDaysText || '-' %></b></div>
        <div>
  <small>วันหมดอายุ</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : fmtDateView(pkg.end_at) 
    %>
  </b>
</div>
        <div>
  <small>จะหมดอีก</small>
  <b>
    <%= packageExpired 
      ? '0' 
      : (packageDaysLeft + ' วัน') 
    %>
  </b>
</div>
        <div><small>พอร์ตว่าง</small><b id="mt5ConnectedCount"><%= packageExpired ? '0' : (typeof availablePortCount !== 'undefined' ? availablePortCount : connectedCount) %> ช่องว่าง</b></div>
      </div>
    </div>
  </section>

  <% if (packageExpired) { %>
    <div class="mt5-expired-banner">
      <b>แพ็คเกจหมดอายุ</b> ระบบตั้ง PORT เป็น 0, ปิดปุ่มเชื่อมต่อ MT5 และส่งคำสั่งให้ Agent ออก terminal64 แล้ว
    </div>
  <% } %>

  <section class="mt5-grid mt5-grid-2">
    <div class="mt5-card">
      <div class="mt5-card-head">
        <h2>1) เลือก PORT ตามแพ็กเกจ</h2>
        <span>แพ็กเกจให้ <%= includedPorts || 1 %> PORT (สูงสุด <%= packagePortRange || ('1 - ' + packageMaxPorts) %>) · ใช้ได้ <%= totalPorts %> PORT / Lot <%= packageLotMin %>-<%= packageLotMax %></span>
      </div>
      <div class="port-list" id="mt5PortList">
        <% if (totalPorts <= 0) { %>
          <div class="port-item cancelled"><div class="port-main"><div><b>PORT 0</b><small>แพ็คเกจหมดอายุ</small></div><span>ใช้งานไม่ได้</span></div></div>
        <% } %>
        <% for (let i = 1; i <= totalPorts; i++) { %>
          <% const acc = typeof pickAccountForPortSlot === 'function' ? pickAccountForPortSlot(portSlotAccounts || accounts, i) : (accounts || []).find(a => Number(a.port_slot) === i); %>
          <% const accStatus = acc ? String(acc.status || '').toLowerCase() : ''; %>
          <% const canUsePort = acc && accStatus === 'connected'; %>
          <% const slotBusy = acc && ['connecting','checking','connected','ready','starting'].includes(accStatus); %>
          <% const cardPick = canUsePort || !slotBusy; %>
          <div class="port-item <%= canUsePort ? 'connected' : (accStatus === 'connecting' || accStatus === 'starting' ? 'checking' : (acc ? 'cancelled' : '')) %><%= cardPick ? ' port-card-pick' : '' %>" data-port-slot="<%= i %>"<%= acc ? (' data-account-id="' + acc.id + '"') : '' %><%= cardPick ? ' role="button" tabindex="0"' : '' %>>
            <div class="port-main">
              <div>
                <b>PORT <%= i %></b>
                <small><%= acc ? ('Login: ' + acc.mt5_login + ((acc.last_equity || acc.last_balance) ? ' / Equity: ' + (acc.last_equity || acc.last_balance) : '')) : 'ยังไม่เชื่อมต่อ' %></small>
              </div>
              <span><%= canUsePort ? 'พร้อมรัน' : (accStatus === 'connecting' || accStatus === 'starting' ? 'กำลังเปิด MT5...' : (accStatus === 'checking' ? 'กำลังตรวจ Login' : (accStatus === 'failed' ? 'Login ไม่ผ่าน' : (accStatus === 'ready' ? 'ต้องเชื่อมต่อใหม่' : (acc ? 'ยกเลิกแล้ว' : 'ว่าง'))))) %></span>
            </div>
            <% if (acc) { %>
              <div class="port-actions">
                <form method="POST" action="/app/mt5/account/<%= acc.id %>/delete" onsubmit="return deletePortCountdown(event, this)">
  <button class="mt5-btn mini delete" type="submit">ลบ</button>
</form>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
      <div class="mt5-buy-row mt5-buy-single">
        <div class="mt5-add-port-menu" id="mt5AddPortMenu">
          <button type="button" class="mt5-btn warning mt5-add-port-main" onclick="toggleAddPortMenu()" <%= packageExpired ? 'disabled' : '' %>>+ เพิ่มพอร์ต</button>
          <div class="mt5-add-port-dropdown" id="mt5AddPortDropdown">
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ต', '1 Scoin', 'พอร์ตชั่วคราว เพิ่มได้ไม่เกินสิทธิ์แพ็กเกจ และหมดอายุพร้อมแพ็กเกจ')">
              <input type="hidden" name="port_type" value="temporary">
              <button type="submit" class="mt5-port-choice" <%= (packageExpired || canAddTemporary === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ต</b>
                <small>1 Scoin · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> ช่อง</small>
              </button>
            </form>
            <form method="POST" action="/app/mt5/ports/add" onsubmit="return buyPortConfirm(event, this, 'เพิ่มพอร์ตถาวร', '10 Scoin', 'พอร์ตถาวรผูกกับระดับแพ็กเกจปัจจุบัน BASIC / PRO / ADVANCED')">
              <input type="hidden" name="port_type" value="permanent">
              <button type="submit" class="mt5-port-choice permanent" <%= (packageExpired || canAddPermanent === false) ? 'disabled' : '' %>>
                <b>เพิ่มพอร์ตถาวร</b>
                <small>10 Scoin · ผูกกับระดับ <%= (pkg.package_group || 'BASIC') %> (เพิ่มช่องถาวร)</small>
              </button>
            </form>
          </div>
        </div>
        <div class="mt5-buy-note">
          ซื้อแพ็กเกจได้ <%= includedPorts || 1 %> PORT · ชั่วคราวเพิ่มได้สูงสุด <%= maxExtraPurchases || packageMaxPorts %> · ถาวรผูกระดับ <b><%= (pkg.package_group || 'BASIC') %></b>
        </div>
      </div>
    </div>

    <div class="mt5-card">
      <div class="mt5-card-head">
        <h2>2) Login MT5</h2>
        <span>Server: <%= fixedServer %> — เปิด MT5 + Login อัตโนมัติ</span>
      </div>


      <form method="POST" action="/app/mt5/connect" class="mt5-form" id="mt5ConnectForm">
        <input type="hidden" name="port_slot" id="mt5SelectedPortSlot" value="">

  <div id="mt5LoginPreview" class="mt5-login-preview" style="display:none;margin:12px 0;padding:12px;background:#0b1220;border:1px solid #1e3a5f;border-radius:12px">
    <div style="font-size:13px;color:#93c5fd;margin-bottom:8px">
      <b>หน้าจอ MT5 บน VPS</b> — ตรวจสอบเลขบัญชีบน title bar ว่าตรงกับที่กรอก
    </div>
    <div id="mt5ConnectMeta" style="display:none;margin:0 0 10px 0">
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
        <span id="mt5ConnectStepBadge" style="display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;background:#172554;color:#bfdbfe;font-size:12px;font-weight:700">ขั้นตอน 1/4</span>
        <span id="mt5ConnectElapsed" style="font-size:12px;color:#cbd5e1">ใช้เวลา 0 วินาที</span>
        <span id="mt5ConnectRemaining" style="font-size:12px;color:#94a3b8">เหลือประมาณ 0 วินาที</span>
      </div>
      <div id="mt5ConnectStepDetail" style="font-size:13px;color:#e2e8f0;margin-bottom:8px">กำลังเตรียมการเชื่อมต่อ...</div>
      <div style="width:100%;height:8px;background:#0f172a;border:1px solid #1e293b;border-radius:999px;overflow:hidden">
        <div id="mt5ConnectProgressBar" style="height:100%;width:18%;background:linear-gradient(90deg,#2563eb,#38bdf8);border-radius:999px;transition:width .25s ease"></div>
      </div>
    </div>
    <img id="mt5PreviewImg" alt="MT5 Preview" style="max-width:100%;border-radius:8px;border:1px solid #334155;display:none">
    <div id="mt5PreviewTitle" style="font-size:12px;color:#cbd5e1;margin-top:8px;word-break:break-all"></div>
    <div style="font-size:11px;color:#64748b;margin-top:6px">ถ้าใช้ RDP เข้า VPS จะเห็นหน้าต่าง MT5 บนเดสก์ท็อป Windows โดยตรง</div>
  </div>

        <label>MT5 Login</label>
        <input name="mt5_login" id="mt5LoginInput" placeholder="เช่น 234567890 หรือ 81234567" inputmode="numeric" maxlength="9" required>
        <small style="color:#94a3b8;display:block;margin-top:4px">ใช้ได้เฉพาะเลขขึ้นต้น <b>2</b> จำนวน <b>9</b> หลัก หรือขึ้นต้น <b>8</b> จำนวน <b>8</b> หลัก</small>

        <label>Password</label>
        <input name="mt5_password" type="password" placeholder="รหัสผ่าน MT5" required>

        <label>Server (ล็อค)</label>
        <input value="<%= fixedServer %>" disabled readonly>
        <input type="hidden" name="server_name" value="<%= fixedServer %>">
        <small style="color:#94a3b8;display:block;margin-top:4px">ใช้ได้เฉพาะ <b><%= fixedServer %></b> เท่านั้น</small>

        <button type="submit" id="mt5ConnectBtn" class="mt5-btn primary" <%= packageExpired ? 'disabled' : '' %>>
  <%= packageExpired ? 'แพ็คเกจหมดอายุ' : 'เชื่อมต่อ' %>
</button>
      </form>
    </div>
  </section>

  <section class="mt5-card">
    <div class="mt5-card-head">
      <h2>3) เลือก BOT แล้วกด Run</h2>
      <span>เทรดทองคำ XAUUSD เท่านั้น</span>
    </div>

    <div id="mt5RunPanel">
    <% if (!connectedRunAccounts || connectedRunAccounts.length === 0) { %>
      <div class="mt5-empty">กรุณาเชื่อมต่อ MT5 ก่อน แล้วระบบจะแสดงตัวเลือก Run BOT</div>
    <% } else { %>
      <div class="mt5-empty">กำลังเตรียมฟอร์ม Run BOT...</div>
    <% } %>
    </div>
  </section>

  <section class="mt5-card">
    <div class="mt5-card-head">
      <h2>BOT ที่กำลังทำงาน / ประวัติล่าสุด</h2>
      <span>แสดง 20 รายการล่าสุด</span>
    </div>
    <div class="mt5-table-wrap">
      <table class="mt5-table">
        <thead>
          <tr>
            <th>BOT</th>
            <th>MT5</th>
            <th>VPS</th>
            <th>PORT</th>
            <th>Lot</th>
            <th>Level</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!instances || instances.length === 0) { %>
            <tr><td colspan="8" class="mt5-empty-cell">ยังไม่มีรายการรัน BOT</td></tr>
          <% } %>
          <% (instances || []).forEach(function(i){ %>
            <tr>
              <td><%= i.display_name || i.bot_name || i.bot_code %></td>
              <td>#<%= i.mt5_account_id %></td>
              <td><%= i.node_name || i.node_code || '-' %></td>
              <td><%= i.assigned_port_no || '-' %></td>
              <td><%= i.lot_used || '-' %></td>
              <td><%= i.trade_level === 'high' ? 'เสี่ยงสูง' : (i.trade_level === 'medium' ? 'เสี่ยงกลาง' : (i.trade_level === 'low' || i.trade_level === 'safe' ? 'เสี่ยงต่ำ' : (i.trade_level || '-'))) %></td>
              <td><span class="status <%= i.status %>"><%= i.status %></span></td>
              <td>
                <% if (['running','pending'].includes(i.status)) { %>
                  <form method="POST" action="/app/mt5/stop/<%= i.id %>" onsubmit="return confirm('ยืนยันหยุด BOT ใช่ไหม?')">
                    <button class="mt5-btn mini" type="submit">หยุด</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<section class="mt5-card">
  <div class="mt5-card-head">
    <h2>📡 Live MT5 Dashboard</h2>
    <span>WebSocket/Live Refresh</span>
  </div>

  <div id="mt5LiveDashboard" class="mt5-table-wrap">
    กำลังโหลดข้อมูล...
  </div>
</section>

<script>
(function () {
  let mt5Checking = true;
  const serverPendingAccountId = '<%= typeof pendingConnectAccountId !== "undefined" && pendingConnectAccountId ? pendingConnectAccountId : "" %>';
  let mt5PollAccountId = sessionStorage.getItem('mt5PollAccountId') || serverPendingAccountId || '';
  const urlParams = new URLSearchParams(window.location.search);
  function showMt5ConnectModal(type, message) {
    if (type === 'error') {
      document.querySelectorAll('.mt5-alert.success, #mt5SuccessAlert').forEach(el => el.remove());
    }
    const modalId = type === 'success' ? 'mt5SuccessModal' : 'mt5ErrorModal';
    if (document.getElementById(modalId)) return;
    const isSuccess = type === 'success';
    const modal = document.createElement('div');
    modal.id = modalId;
    modal.className = 'mt5-lux-modal';
    modal.innerHTML = `
      <div class="mt5-lux-backdrop"></div>
      <div class="mt5-lux-card ${isSuccess ? 'success' : 'error'}">
        <div class="mt5-lux-icon">${isSuccess ? '✅' : '⚠️'}</div>
        <h3>${isSuccess ? 'เชื่อมต่อสำเร็จ' : 'เชื่อมต่อไม่สำเร็จ'}</h3>
        <p>${message || (isSuccess ? 'เชื่อมต่อสำเร็จ' : 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด')}</p>
        <button type="button" onclick="document.getElementById('${modalId}')?.remove()">ตกลง</button>
      </div>
    `;
    document.body.appendChild(modal);
  }

  window.showMt5ConnectModal = showMt5ConnectModal;

  window.__mt5PageMeta = {
    packageExpired: <%= packageExpired ? 'true' : 'false' %>,
    packageLotMin: <%= packageLotMin %>,
    packageLotMax: <%= packageLotMax %>,
    packageDefaultLot: <%= typeof packageDefaultLot !== 'undefined' ? packageDefaultLot : packageLotMax %>
  };
  window.__mt5RunConfig = {
    packageExpired: <%= packageExpired ? 'true' : 'false' %>,
    packageGroup: <%- JSON.stringify(runPackageGroup || 'BASIC') %>,
    packageLotMin: <%= packageLotMin %>,
    packageLotMax: <%= packageLotMax %>,
    packageDefaultLot: <%= typeof packageDefaultLot !== 'undefined' ? packageDefaultLot : packageLotMax %>,
    bots: <%- JSON.stringify((bots || []).map(function (b) { return { code: String(b.bot_code || b.bot_name || '').trim(), label: b.display_name || b.bot_name || b.bot_code || '' }; })) %>,
    presetTables: <%- JSON.stringify(runPresetTables || {}) %>,
    connectedAccounts: <%- JSON.stringify(connectedRunAccounts || []) %>
  };
  const mt5RunState = {
    connectedAccounts: Array.isArray(window.__mt5RunConfig.connectedAccounts) ? window.__mt5RunConfig.connectedAccounts.slice() : [],
    selectedAccountId: Number(sessionStorage.getItem('mt5RunAccountId') || 0)
  };
  window.mt5RunState = mt5RunState;

  function mt5Esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function mt5Num(v, d) {
    const n = Number(v);
    return Number.isFinite(n) ? n : (d == null ? 0 : d);
  }

  function mt5Fixed(v) {
    return mt5Num(v, 0).toFixed(2);
  }

  function mt5Clamp(v, min, max) {
    const lo = mt5Num(min, 0.01);
    const hi = Math.max(lo, mt5Num(max, lo));
    let out = mt5Num(v, lo);
    if (out < lo) out = lo;
    if (out > hi) out = hi;
    return Number(out.toFixed(2));
  }

  function mt5RunAccountCapital(account) {
    if (!account) return 0;
    return mt5Num(account.last_equity, mt5Num(account.last_balance, 0));
  }

  function mt5NormalizeTradeLevel(level) {
    const value = String(level || '').trim().toLowerCase();
    if (value === 'high' || value === 'fast') return 'high';
    if (value === 'medium') return 'medium';
    if (value === 'low' || value === 'safe') return 'low';
    return 'medium';
  }

  function mt5TradeLevelLabel(level) {
    const value = mt5NormalizeTradeLevel(level);
    if (value === 'high') return 'เสี่ยงสูง';
    if (value === 'medium') return 'เสี่ยงกลาง';
    return 'เสี่ยงต่ำ';
  }

  function mt5NearestPresetRow(rows, capital) {
    if (!Array.isArray(rows) || !rows.length) return null;
    const target = mt5Num(capital, 0);
    let best = rows[0];
    let bestDiff = Math.abs(mt5Num(best.capital_recommend, 0) - target);
    rows.forEach(function (row) {
      const diff = Math.abs(mt5Num(row.capital_recommend, 0) - target);
      if (diff < bestDiff) {
        best = row;
        bestDiff = diff;
      }
    });
    return best;
  }

  function mt5NearestPresetRowByLot(rows, lot) {
    if (!Array.isArray(rows) || !rows.length) return null;
    const target = mt5Num(lot, 0);
    let best = rows[0];
    let bestDiff = Math.abs(mt5Num(best.lot_size, 0) - target);
    rows.forEach(function (row) {
      const diff = Math.abs(mt5Num(row.lot_size, 0) - target);
      if (diff < bestDiff) {
        best = row;
        bestDiff = diff;
      }
    });
    return best;
  }

  function mt5SelectedRunAccount() {
    const connected = Array.isArray(mt5RunState.connectedAccounts) ? mt5RunState.connectedAccounts : [];
    let picked = connected.find(function (a) { return Number(a.id) === Number(mt5RunState.selectedAccountId); }) || null;
    if (!picked && connected.length) {
      picked = connected[0];
      mt5RunState.selectedAccountId = Number(picked.id);
      sessionStorage.setItem('mt5RunAccountId', String(picked.id));
    }
    return picked;
  }

  function mt5ComputeRunPreset(botCode, capital, manualLot, tradeLevel) {
    const cfg = window.__mt5RunConfig || {};
    const rows = (cfg.presetTables && cfg.presetTables[botCode]) || [];
    const lotMin = mt5Num(cfg.packageLotMin, 0.01);
    const lotMax = mt5Num(cfg.packageLotMax, 0.05);
    const defaultLot = mt5Num(cfg.packageDefaultLot, lotMax);
    const lot = mt5Clamp(manualLot || defaultLot, lotMin, lotMax);
    const preset = mt5NearestPresetRowByLot(rows, lot) || mt5NearestPresetRow(rows, capital) || null;
    const level = mt5NormalizeTradeLevel(tradeLevel);
    let tStart = 0;
    let tStop = 0;
    if (preset) {
      if (level === 'high') {
        tStart = mt5Num(preset.t_start, 0);
        tStop = mt5Num(preset.t_stop, 0);
      } else if (level === 'medium') {
        tStart = mt5Num(preset.medium_t_start || preset.t_start, 0);
        tStop = mt5Num(preset.medium_t_stop || preset.t_stop, 0);
      } else {
        tStart = mt5Num(preset.fast_t_start || preset.medium_t_start || preset.t_start, 0);
        tStop = mt5Num(preset.fast_t_stop || preset.medium_t_stop || preset.t_stop, 0);
      }
    }
    return {
      preset: preset,
      lot: lot,
      lotPlus: mt5Clamp(preset ? mt5Num(preset.lot_plus, lot) : lot, lotMin, lotMax),
      tStart: tStart,
      tStop: tStop
    };
  }

  function renderPortItemHtml(p) {
    const del = p.accountId
      ? '<form method="POST" action="/app/mt5/account/' + p.accountId + '/delete" onsubmit="return deletePortCountdown(event, this)">' +
        '<button class="mt5-btn mini delete" type="submit">ลบ</button></form>'
      : '';
    const actions = p.accountId ? '<div class="port-actions">' + del + '</div>' : '';
    const pickable = !!(p.canUse || p.canPick);
    const pickCls = pickable ? ' port-card-pick' : '';
    const pickAttr = pickable
      ? ' data-port-slot="' + p.slot + '"' + (p.accountId ? ' data-account-id="' + p.accountId + '"' : '') + ' role="button" tabindex="0"'
      : ' data-port-slot="' + p.slot + '"' + (p.accountId ? ' data-account-id="' + p.accountId + '"' : '');
    return (
      '<div class="port-item ' + mt5Esc(p.cssClass) + pickCls + '"' + pickAttr + '>' +
      '<div class="port-main"><div><b>PORT ' + p.slot + '</b><small>' + mt5Esc(p.sublabel) + '</small></div>' +
      '<span>' + mt5Esc(p.statusLabel) + '</span></div>' +
      actions +
      '</div>'
    );
  }

  function renderMt5RunFormHtml(connected, bots) {
    mt5RunState.connectedAccounts = Array.isArray(connected) ? connected.slice() : [];
    const meta = window.__mt5RunConfig || {};
    const expired = !!meta.packageExpired;
    const selected = mt5SelectedRunAccount();
    if (!selected) {
      return '<div class="mt5-empty">กรุณาเชื่อมต่อ MT5 ก่อน แล้วระบบจะแสดงตัวเลือก Run BOT</div>';
    }
    const lotMin = mt5Num(meta.packageLotMin, 0.01);
    const lotMax = mt5Num(meta.packageLotMax, 0.05);
    const defaultLot = mt5Num(meta.packageDefaultLot, lotMax);
    const actualCapital = mt5RunAccountCapital(selected);
    const botOpts = (bots || []).map(function (b) {
      const code = mt5Esc(b.code || b.bot_code || b.bot_name || '');
      const label = mt5Esc(b.label || b.display_name || b.bot_name || b.bot_code || '');
      return '<option value="' + code + '">' + label + '</option>';
    }).join('');
    return (
      '<form method="POST" action="/app/mt5/run" class="mt5-run-form" id="mt5RunForm">' +
      '<input type="hidden" name="mt5_account_id" id="mt5RunAccountId" value="' + mt5Esc(selected.id) + '">' +
      '<div style="margin-bottom:14px;padding:10px 12px;border-radius:14px;background:rgba(15,23,42,.8);border:1px solid rgba(56,189,248,.18);color:#cbd5e1;font-size:13px">' +
      'เลือก PORT จากข้อ 1: <b style="color:#fff">PORT ' + mt5Esc(selected.port_slot) + '</b>' + (selected.mt5_login ? ' / Login ' + mt5Esc(selected.mt5_login) : '') + (actualCapital > 0 ? ' / Equity ' + mt5Esc(actualCapital) : '') +
      '</div>' +
      '<div id="mt5RunSelectedMeta" style="display:none"></div>' +
      '<div class="mt5-form-row">' +
      '<div><label>BOT</label><select name="bot_code" required>' + botOpts + '</select></div>' +
      '<div><label>ระดับการเทรด</label><select name="trade_level">' +
      '<option value="low">เสี่ยงต่ำ</option><option value="medium" selected>เสี่ยงกลาง</option><option value="high">เสี่ยงสูง</option>' +
      '</select></div>' +
      '<div><label>เวลาเปิดออเดอร์</label><select name="run_time_mode"><option value="auto" selected>Auto อิงจากเวลา Bot</option><option value="24h">สามารถเปิด 24ชม.</option></select></div>' +
      '</div>' +
      '<div class="mt5-form-row">' +
      '<div><label>เงินทุน (ขั้นต่ำ 100)</label><input type="number" step="0.01" min="100" name="capital_manual" class="form-control" placeholder="' + (actualCapital > 0 ? ('ทุนจาก MT5 จริง: ' + mt5Esc(actualCapital) + ' / หรือพิมพ์เอง') : 'กรอกเงินทุนขั้นต่ำ 100') + '" value="' + (actualCapital >= 100 ? mt5Esc(actualCapital) : '') + '"><small style="color:#94a3b8;display:block;margin-top:4px">ถ้าแก้เอง ระบบจะใช้ค่าที่กรอกแทน Equity</small></div>' +
      '<div><label>Lot Size</label><input name="manual_lot" type="number" step="0.01" min="' + mt5Esc(lotMin) + '" max="' + mt5Esc(lotMax) + '" value="' + mt5Esc(mt5Fixed(defaultLot)) + '"><small style="color:#94a3b8;display:block;margin-top:4px">ค่าเริ่มต้น ' + mt5Esc(mt5Fixed(defaultLot)) + ' / ปรับได้สูงสุด ' + mt5Esc(mt5Fixed(lotMax)) + '</small></div>' +
      '<div class="run-action"><button type="submit" class="mt5-btn run"' + (expired ? ' disabled' : '') + ' onclick="return confirm(\'ยืนยัน Run BOT ใช่ไหม?\')">' + (expired ? 'แพ็คเกจหมดอายุ' : 'Run BOT') + '</button></div>' +
      '</div>' +
      '</form>'
    );
  }

  function bindMt5RunForm() {
    const form = document.getElementById('mt5RunForm');
    if (!form) return;

    function applyPresetDefaults() {
      const selected = mt5SelectedRunAccount();
      const hidden = form.querySelector('#mt5RunAccountId');
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const lotInput = form.querySelector('input[name="manual_lot"]');
      const botSelect = form.querySelector('select[name="bot_code"]');
      const levelSelect = form.querySelector('select[name="trade_level"]');
      if (!selected || !hidden || !capitalInput || !lotInput || !botSelect || !levelSelect) return;

      hidden.value = String(selected.id);
      const actualCapital = mt5RunAccountCapital(selected);
      capitalInput.min = '100';
      capitalInput.placeholder = actualCapital > 0
        ? 'ทุนจาก MT5 จริง: ' + actualCapital + ' / หรือพิมพ์เอง'
        : 'กรอกเงินทุนขั้นต่ำ 100';

      const cfg = window.__mt5RunConfig || {};
      lotInput.min = String(mt5Num(cfg.packageLotMin, 0.01));
      lotInput.max = String(mt5Num(cfg.packageLotMax, 0.05));
      if (!lotInput.value) lotInput.value = mt5Fixed(cfg.packageDefaultLot || cfg.packageLotMax || 0.05);
      const capital = mt5Num(capitalInput.value, actualCapital);
      const manualLot = mt5Clamp(lotInput.value || cfg.packageDefaultLot || cfg.packageLotMax, cfg.packageLotMin, cfg.packageLotMax);
      lotInput.value = mt5Fixed(manualLot);
      mt5ComputeRunPreset(botSelect.value, capital, manualLot, levelSelect.value);
    }

    ['change', 'input'].forEach(function (eventName) {
      ['select[name="bot_code"]', 'select[name="trade_level"]', 'input[name="capital_manual"]', 'input[name="manual_lot"]'].forEach(function (selector) {
        const field = form.querySelector(selector);
        if (field) field.addEventListener(eventName, applyPresetDefaults);
      });
    });

    form.addEventListener('submit', function (e) {
      const selected = mt5SelectedRunAccount();
      const capitalInput = form.querySelector('input[name="capital_manual"]');
      const capital = mt5Num(capitalInput ? capitalInput.value : 0, mt5RunAccountCapital(selected));
      if (!selected) {
        e.preventDefault();
        alert('กรุณาเลือก PORT ที่เชื่อมต่อแล้วก่อน Run BOT');
        return false;
      }
      if (capital < 100) {
        e.preventDefault();
        alert('เงินทุนต้องไม่ต่ำกว่า 100');
        return false;
      }
      return true;
    });

    applyPresetDefaults();
  }
  window.renderMt5RunFormHtml = renderMt5RunFormHtml;
  window.bindMt5RunForm = bindMt5RunForm;

  let mt5RunRenderSignature = '';

  function mt5RunDataSignature(accounts, bots) {
    return JSON.stringify({
      accounts: (accounts || []).map(function (a) {
        return [a.id, a.port_slot, a.assigned_port_no, a.mt5_login, a.last_equity, a.last_balance];
      }),
      bots: (bots || []).map(function (b) {
        return [b.code || b.bot_code || '', b.label || b.display_name || b.bot_name || ''];
      })
    });
  }

  async function refreshMt5PortCards() {
    try {
      const res = await fetch('/app/mt5/ports-state', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.ok) return;
      const list = document.getElementById('mt5PortList');
      if (list && Array.isArray(data.ports)) {
        list.innerHTML = data.ports.map(renderPortItemHtml).join('');
        if (typeof window.mt5BindPortSlotPicks === 'function') window.mt5BindPortSlotPicks();
      }
      const cntEl = document.getElementById('mt5ConnectedCount');
      if (cntEl) {
        const avail = data.availablePortCount != null ? data.availablePortCount : data.connectedCount;
        cntEl.textContent = String(avail || 0) + ' ช่องว่าง';
      }
      const tempBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="temporary"]');
      if (tempBtn) {
        const btn = tempBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddTemporary === false);
      }
      const permBtn = document.querySelector('#mt5AddPortMenu form input[name="port_type"][value="permanent"]');
      if (permBtn) {
        const btn = permBtn.closest('form')?.querySelector('button');
        if (btn) btn.disabled = !!(data.packageExpired || data.canAddPermanent === false);
      }
      const runPanel = document.getElementById('mt5RunPanel');
      if (runPanel) {
        const cfg = window.__mt5RunConfig || {};
        cfg.connectedAccounts = Array.isArray(data.connectedAccounts) ? data.connectedAccounts : [];
        cfg.bots = Array.isArray(data.bots) && data.bots.length ? data.bots : (cfg.bots || []);
        window.__mt5RunConfig = cfg;
        const nextSignature = mt5RunDataSignature(cfg.connectedAccounts, cfg.bots || []);
        if (nextSignature !== mt5RunRenderSignature || !document.getElementById('mt5RunForm')) {
          mt5RunRenderSignature = nextSignature;
          runPanel.innerHTML = renderMt5RunFormHtml(cfg.connectedAccounts, cfg.bots || []);
          bindMt5RunForm();
        } else if (typeof window.mt5UpdateSharedPortSelections === 'function') {
          window.mt5UpdateSharedPortSelections();
        }
      }
    } catch (_) {}
  }
  window.refreshMt5PortCards = refreshMt5PortCards;

  async function finishMt5ConnectSuccess(message) {
    const msg = message || 'เชื่อมต่อสำเร็จ';
    mt5Checking = false;
    if (window.mt5Checker) {
      clearInterval(window.mt5Checker);
      window.mt5Checker = null;
    }
    sessionStorage.removeItem('mt5PollAccountId');
    if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    await refreshMt5PortCards();
    showMt5ConnectModal('success', msg);
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '/app/mt5');
    }
  }

  function updateMt5ConnectMeta(data) {
    const metaBox = document.getElementById('mt5ConnectMeta');
    const badge = document.getElementById('mt5ConnectStepBadge');
    const elapsed = document.getElementById('mt5ConnectElapsed');
    const remaining = document.getElementById('mt5ConnectRemaining');
    const detail = document.getElementById('mt5ConnectStepDetail');
    const bar = document.getElementById('mt5ConnectProgressBar');
    if (!metaBox || !badge || !elapsed || !remaining || !detail || !bar) return;

    const step = data && data.step ? data.step : {};
    const stepIndex = Math.max(0, Number(step.index || 0));
    const stepTotal = Math.max(1, Number(step.total || 4));
    const isFailed = String(step.key || '').toLowerCase() === 'failed';
    const isConnected = String(step.key || '').toLowerCase() === 'connected';
    const width = isFailed ? 100 : Math.max(14, Math.min(100, Math.round((stepIndex / stepTotal) * 100)));

    metaBox.style.display = 'block';
    badge.textContent = step.label || 'กำลังตรวจสอบการเชื่อมต่อ';
    detail.textContent = step.detail || data.message || 'กำลังตรวจสอบการเชื่อมต่อ...';
    elapsed.textContent = 'ใช้เวลา ' + String(Number(data.elapsedSec || 0)) + ' วินาที';
    remaining.textContent = data.pending || data.checking
      ? 'เหลือประมาณ ' + String(Number(data.remainingSec || 0)) + ' วินาที'
      : '';
    bar.style.width = width + '%';
    bar.style.background = isFailed
      ? 'linear-gradient(90deg,#ef4444,#f97316)'
      : isConnected
        ? 'linear-gradient(90deg,#22c55e,#14b8a6)'
        : 'linear-gradient(90deg,#2563eb,#38bdf8)';
  }

  function clearLegacyMt5QueryState() {
    if (!window.history || !window.history.replaceState) return;
    if (!urlParams.get('connected') && !urlParams.get('failed') && !urlParams.get('msg')) return;
    window.history.replaceState({}, '', '/app/mt5');
  }
  clearLegacyMt5QueryState();
  const initialRunPanel = document.getElementById('mt5RunPanel');
  if (initialRunPanel) {
    mt5RunRenderSignature = mt5RunDataSignature(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    initialRunPanel.innerHTML = renderMt5RunFormHtml(mt5RunState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    bindMt5RunForm();
  }
  refreshMt5PortCards();
  const mt5PortCardRefreshTimer = window.setInterval(refreshMt5PortCards, 5000);

  window.mt5UnlockConnectBtn = function () {
    var b = document.getElementById('mt5ConnectBtn');
    if (!b) return;
    b.disabled = false;
    b.innerHTML = b.dataset.originalText || 'เชื่อมต่อ';
    b.style.opacity = '';
    b.style.pointerEvents = '';
  };

  async function checkMt5Connected() {
    if (!mt5Checking) return;
    try {
      let statusUrl = '/app/mt5/connect-status';
      if (mt5PollAccountId) {
        statusUrl += '?accountId=' + encodeURIComponent(mt5PollAccountId);
      }
      const res = await fetch(statusUrl, {
        cache: 'no-store',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      const text = await res.text();
      let data;
      try {
        data = text ? JSON.parse(text) : {};
      } catch (_) {
        return;
      }
      if (res.status === 401) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        showMt5ConnectModal('error', (data && data.message) || 'กรุณาเข้าสู่ระบบใหม่');
        return;
      }
      if (!data.ok) {
        if (data.message && /column.*does not exist/i.test(String(data.message))) {
          const btn = document.getElementById('mt5ConnectBtn');
          if (btn) btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      if (!data.account) {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      const stWait = String(data.account.status || '').toLowerCase();
      if (stWait === 'deleted' || stWait === 'expired' || stWait === 'cancelled') {
        mt5Checking = false;
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        sessionStorage.removeItem('mt5PollAccountId');
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        await refreshMt5PortCards();
        return;
      }
      if (stWait === 'connecting' || stWait === 'checking' || stWait === 'starting' || data.pending || data.checking) {
        const btn = document.getElementById('mt5ConnectBtn');
        const previewBox = document.getElementById('mt5LoginPreview');
        const previewImg = document.getElementById('mt5PreviewImg');
        const previewTitle = document.getElementById('mt5PreviewTitle');
        if (previewBox) previewBox.style.display = 'block';
        if (data.previewUrl && previewImg) {
          previewImg.src = data.previewUrl;
          previewImg.style.display = 'block';
        }
        if (previewTitle) {
          previewTitle.textContent = data.windowTitle
            ? 'Title bar: ' + data.windowTitle
            : 'รอหน้าต่าง MT5...';
        }
        updateMt5ConnectMeta(data);
        if (btn) {
          btn.innerHTML = 'กำลังเชื่อมต่อ';
        }
        return;
      }
      const accountId = String(data.account.id || '').trim();
      const modalDedupId = accountId + ':' + String(data.account.updated_at || '');
      const key = data.connected ? 'mt5ConnectedShownId' : 'mt5FailedShownId';
      if (sessionStorage.getItem(key) === modalDedupId) {
        mt5Checking = false;
        clearInterval(window.mt5Checker);
        return;
      }
      if (data.failed) {
        mt5Checking = false;
        sessionStorage.setItem(key, modalDedupId);
        if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
        sessionStorage.removeItem('mt5PollAccountId');
        showMt5ConnectModal('error', data.message || 'เชื่อมต่อไม่สำเร็จผู้ใช้งานผิด');
        if (window.mt5Checker) clearInterval(window.mt5Checker);
        window.mt5Checker = null;
        return;
      }
      if (stWait === 'connected' || (data.connected === true && data.status === 'connected')) {
        sessionStorage.setItem(key, modalDedupId);
        finishMt5ConnectSuccess(data.message || 'เชื่อมต่อสำเร็จ');
        return;
      }
    } catch (e) {}
  }

  window.finishMt5ConnectSuccess = finishMt5ConnectSuccess;

  window.startMt5ConnectPolling = function () {
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    mt5Checking = true;
    window.__mt5SuccessShown = false;
    sessionStorage.removeItem('mt5ConnectedShownId');
    window.mt5Checker = setInterval(checkMt5Connected, 800);
    checkMt5Connected();
  };

  if (serverPendingAccountId) {
    mt5PollAccountId = String(serverPendingAccountId);
    sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
    const pendingBtn = document.getElementById('mt5ConnectBtn');
    if (pendingBtn) {
      pendingBtn.disabled = true;
      pendingBtn.innerHTML = 'กำลังเชื่อมต่อ';
    }
  }

  if (mt5PollAccountId) {
    window.startMt5ConnectPolling();
  }

  window.addEventListener('pagehide', function () {
    mt5Checking = false;
    if (window.mt5Checker) clearInterval(window.mt5Checker);
    clearInterval(mt5PortCardRefreshTimer);
  });
})();
</script>

<script>
(function(){
  const packageExpired = <%= packageExpired ? 'true' : 'false' %>;

const mt5ConnectForm = document.getElementById('mt5ConnectForm');
const mt5SelectedPortSlot = document.getElementById('mt5SelectedPortSlot');
const mt5LoginInput = document.getElementById('mt5LoginInput');

function isAllowedMt5LoginUser(login) {
  const value = String(login || '').trim();
  return /^2\d{8}$/.test(value) || /^8\d{7}$/.test(value);
}

function mt5LoginUserValidationMessage() {
  return 'Userไม่ถูกต้อง - ใช้ได้เฉพาะเลขขึ้นต้น 2 จำนวน 9 หลัก หรือขึ้นต้น 8 จำนวน 8 หลัก';
}

function mt5SelectPortSlot(slot) {
  const n = Number(slot || 0);
  if (!n || !mt5SelectedPortSlot) return;
  mt5SelectedPortSlot.value = String(n);
  if (typeof window.mt5UpdateSharedPortSelections === 'function') window.mt5UpdateSharedPortSelections();
}

function mt5SelectRunAccount(accountId) {
  const id = Number(accountId || 0);
  if (!id) return;
  const runState = window.mt5RunState;
  if (!runState) return;
  runState.selectedAccountId = id;
  sessionStorage.setItem('mt5RunAccountId', String(id));
  if (typeof window.mt5UpdateSharedPortSelections === 'function') window.mt5UpdateSharedPortSelections();
  const panel = document.getElementById('mt5RunPanel');
  if (panel && typeof window.renderMt5RunFormHtml === 'function' && typeof window.bindMt5RunForm === 'function') {
    panel.innerHTML = window.renderMt5RunFormHtml(runState.connectedAccounts, (window.__mt5RunConfig || {}).bots || []);
    window.bindMt5RunForm();
  }
}

function mt5UpdateSharedPortSelections() {
  const connectSlot = Number(mt5SelectedPortSlot?.value || 0);
  const runState = window.mt5RunState;
  const runAccountId = Number(runState?.selectedAccountId || 0);
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    const slot = Number(el.getAttribute('data-port-slot') || 0);
    const accountId = Number(el.getAttribute('data-account-id') || 0);
    el.classList.toggle('selected-run', !!accountId && accountId === runAccountId);
    el.classList.toggle('selected-connect', !accountId && !!connectSlot && slot === connectSlot);
  });
}

function mt5BindPortSlotPicks() {
  document.querySelectorAll('.port-card-pick').forEach(function (el) {
    if (el.dataset.pickBound === '1') return;
    el.dataset.pickBound = '1';
    function pick() {
      const accountId = Number(el.getAttribute('data-account-id') || 0);
      if (accountId) {
        mt5SelectRunAccount(accountId);
      } else {
        mt5SelectPortSlot(el.getAttribute('data-port-slot'));
      }
    }
    el.addEventListener('click', pick);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); }
    });
  });
  mt5UpdateSharedPortSelections();
}
window.mt5BindPortSlotPicks = mt5BindPortSlotPicks;
window.mt5UpdateSharedPortSelections = mt5UpdateSharedPortSelections;
mt5BindPortSlotPicks();

if (mt5ConnectForm) {
  mt5ConnectForm.addEventListener('submit', async function(e){
    e.preventDefault();

    if (packageExpired) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', 'แพ็คเกจหมดอายุ กรุณาต่ออายุแพ็กเกจก่อนเชื่อมต่อ MT5');
      return false;
    }

    const mt5LoginValue = String(mt5LoginInput?.value || '').trim();
    if (!isAllowedMt5LoginUser(mt5LoginValue)) {
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', mt5LoginUserValidationMessage());
      return false;
    }

    const mt5ConnectBtn = document.getElementById('mt5ConnectBtn');
    if (mt5ConnectBtn) {
      mt5ConnectBtn.disabled = true;
      mt5ConnectBtn.dataset.originalText = mt5ConnectBtn.innerHTML;
      mt5ConnectBtn.innerHTML = 'กำลังเชื่อมต่อ';
      mt5ConnectBtn.style.opacity = '0.6';
      mt5ConnectBtn.style.pointerEvents = 'none';
    }

    try {
      const formData = new FormData(mt5ConnectForm);
      const data = Object.fromEntries(formData.entries());

      const res = await fetch('/app/mt5/connect', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(data)
      });

      const raw = await res.text();
      let json;
      try {
        json = raw ? JSON.parse(raw) : {};
      } catch (_) {
        throw new Error(
          res.status === 401
            ? 'กรุณาเข้าสู่ระบบใหม่'
            : 'เซิร์ฟเวอร์ตอบกลับไม่ถูกต้อง กรุณารีเฟรชหน้าแล้วลองอีกครั้ง'
        );
      }
      const pop = typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert;

      if (json.ok === true && json.status === 'connected') {
        if (typeof window.finishMt5ConnectSuccess === 'function') {
          window.finishMt5ConnectSuccess(json.message || 'เชื่อมต่อสำเร็จ');
        } else {
          pop('success', json.message || 'เชื่อมต่อสำเร็จ');
        }
        return false;
      }

      if (json.ok === true && (json.status === 'queued' || json.status === 'pending' || json.status === 'upgrading' || json.accountId)) {
        if (json.accountId) {
          mt5PollAccountId = String(json.accountId);
          sessionStorage.setItem('mt5PollAccountId', mt5PollAccountId);
        }
        if (typeof window.startMt5ConnectPolling === 'function') {
          window.startMt5ConnectPolling();
        }
        return false;
      }

      pop('error', json.message || 'Login ไม่สำเร็จ');
      await refreshMt5PortCards();
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    } catch (err) {
      await refreshMt5PortCards();
      (typeof window.showMt5ConnectModal === 'function' ? window.showMt5ConnectModal : alert)('error', err.message || 'Login ไม่สำเร็จ');
      if (typeof window.mt5UnlockConnectBtn === 'function') window.mt5UnlockConnectBtn();
    }

    return false;
  });
}
})();
</script>

<script>
async function loadMt5LiveDashboard() {
  const box = document.getElementById('mt5LiveDashboard');
  if (!box) return;

  try {
    const res = await fetch('/app/mt5/live-dashboard', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });
    const data = await res.json();

    if (!data.ok) {
      box.innerHTML = '<div class="mt5-empty">โหลด Live Dashboard ไม่สำเร็จ</div>';
      return;
    }

    if (!data.instances || data.instances.length === 0) {
      box.innerHTML = '<div class="mt5-empty">ยังไม่มี BOT</div>';
      return;
    }

    let html = `
      <table class="mt5-table">
        <thead>
          <tr>
            <th>BOT</th>
            <th>VPS</th>
            <th>PORT</th>
            <th>Status</th>
            <th>EA</th>
            <th>Balance</th>
            <th>Equity</th>
            <th>Restart</th>
            <th>ล่าสุด</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
    `;

    data.instances.forEach(i => {
      html += `
        <tr>
          <td>${i.display_name || i.bot_name || i.bot_code || '-'}</td>
          <td>${i.node_name || i.node_code || '-'}</td>
          <td>${i.assigned_port_no || '-'}</td>
          <td><span class="status ${i.status || ''}">${i.status || '-'}</span></td>
          <td>${i.ea_status || '-'}</td>
          <td>${i.mt5_balance || 0}</td>
          <td>${i.mt5_equity || 0}</td>
          <td>${i.restart_count || 0}</td>
          <td>${i.last_agent_ping ? new Date(i.last_agent_ping).toLocaleString('th-TH') : '-'}</td>
          <td>
            <form method="POST" action="/app/mt5/request-restart/${i.id}" onsubmit="return confirm('Restart EA/MT5 รายการนี้ใช่ไหม?')">
              <button class="mt5-btn mini" type="submit">Restart</button>
            </form>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    box.innerHTML = html;

  } catch (e) {
    box.innerHTML = '<div class="mt5-empty">Live Dashboard Error: ' + e.message + '</div>';
  }
}

loadMt5LiveDashboard();
setInterval(loadMt5LiveDashboard, 3000);
</script>

