.mt5-error-card button{background:linear-gradient(135deg,#ef4444,#f97316);box-shadow:0 12px 28px rgba(239,68,68,.35)}
@keyframes mt5Pop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
</style>

<script>

function toggleAddPortMenu(){
  const menu = document.getElementById('mt5AddPortMenu');
  if (menu) menu.classList.toggle('open');
}
document.addEventListener('click', function(e){
  const menu = document.getElementById('mt5AddPortMenu');
  if (menu && !menu.contains(e.target)) menu.classList.remove('open');
});

let luxuryPendingForm = null;
function openLuxuryConfirm(title, message, okText, priceText){
  const modal = document.getElementById('luxuryConfirmModal');
  document.getElementById('luxuryTitle').textContent = title || 'ยืนยันรายการ';
  document.getElementById('luxuryMessage').textContent = message || 'กรุณายืนยัน';
  const price = document.getElementById('luxuryPrice');
  if (priceText) { price.style.display='block'; price.textContent = 'ราคา: ' + priceText; } else { price.style.display='none'; price.textContent=''; }
  document.getElementById('luxuryOkBtn').textContent = okText || 'ยืนยัน';
  modal.classList.add('show');
}
function closeLuxuryConfirm(){
  document.getElementById('luxuryConfirmModal').classList.remove('show');
  luxuryPendingForm = null;
}
function luxuryConfirm(e, form, title, message, okText){
  e.preventDefault();
  luxuryPendingForm = form;
  openLuxuryConfirm(title, message, okText, '');
  return false;
}
function buyPortConfirm(e, form, title, price, note){
  e.preventDefault();
  luxuryPendingForm = form;
  openLuxuryConfirm('ยืนยันซื้อ ' + title, note || 'เพิ่ม PORT ตามสิทธิ์แพ็กเกจ', 'ยืนยันซื้อ', price);
  return false;
}
document.addEventListener('DOMContentLoaded', function(){
  const ok = document.getElementById('luxuryOkBtn');
  if (ok) ok.addEventListener('click', function(){
    const f = luxuryPendingForm;
    closeLuxuryConfirm();
    if (f) f.submit();
  });
});
</script>

