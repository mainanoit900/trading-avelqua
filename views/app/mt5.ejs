      return '<div class="mt5-empty">กรุณาเชื่อมต่อ MT5 ก่อน แล้วเลือก PORT จาก dropdown ด้านล่างเพื่อ Run BOT</div>';
    }
    const lotMin = mt5Num(meta.packageLotMin, 0.01);
    const lotMax = mt5Num(meta.packageLotMax, 0.05);
