<%- include('../partials/app-shell') %>

<div class="mt5-page">
  <% /* if (error) { %><div class="mt5-alert danger"><%- error %></div><% } */ %>
  <% if (success && !error) { %>
  <div class="mt5-alert success" id="mt5SuccessAlert"><%- success %></div>
<% } %>

<style>
.mt5-error-modal{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center}
.mt5-error-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.72);backdrop-filter:blur(10px)}
.mt5-error-card{position:relative;width:min(460px,92vw);border-radius:28px;padding:32px;background:linear-gradient(145deg,#111827,#020617);border:1px solid rgba(248,113,113,.45);box-shadow:0 30px 100px rgba(0,0,0,.65),0 0 48px rgba(248,113,113,.18);color:#fff;text-align:center;animation:mt5ErrPop .22s ease-out}
.mt5-error-icon{width:68px;height:68px;margin:0 auto 16px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(248,113,113,.14);font-size:36px}
.mt5-error-card h3{margin:0 0 10px;font-size:24px;font-weight:900}
.mt5-error-card p{margin:0 0 24px;color:#fecaca;font-size:16px;line-height:1.6}
.mt5-error-card button{border:0;border-radius:16px;padding:13px 34px;font-weight:900;color:#fff;cursor:pointer;background:linear-gradient(135deg,#ef4444,#f97316);box-shadow:0 12px 28px rgba(239,68,68,.35)}
@keyframes mt5ErrPop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.port-card-pick{cursor:pointer}
.port-card-pick:hover{border-color:rgba(125,211,252,.45)}
.port-item.selected-run{border-color:#38bdf8;box-shadow:0 0 0 2px rgba(56,189,248,.25)}
.port-item.selected-connect{border-color:#facc15;box-shadow:0 0 0 2px rgba(250,204,21,.20)}
.status{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800;text-transform:lowercase}
.status.running{background:rgba(34,197,94,.18);color:#86efac;border:1px solid rgba(34,197,94,.35)}
.status.connecting{background:rgba(56,189,248,.16);color:#7dd3fc;border:1px solid rgba(56,189,248,.32)}
.status.stopped{background:rgba(148,163,184,.14);color:#cbd5e1;border:1px solid rgba(148,163,184,.28)}
.status.fail{background:rgba(239,68,68,.16);color:#fca5a5;border:1px solid rgba(239,68,68,.35)}
</style>


