        <div><small>รองรับ Port</small><b><%= packageExpired ? '0' : (packagePortRange || ('1 - ' + packageMaxPorts)) %> PORT</b><% if (!packageExpired && ((temporaryExtra || 0) + (permanentExtra || 0) > 0)) { %> <small>+ เพิ่ม <%= (temporaryExtra || 0) + (permanentExtra || 0) %> (รวม <%= totalPorts %>)</small><% } %></div>
        <div><small>ใช้งานระบบได้</small><b><%= displayPackageDaysText || '-' %></b></div>
        <div>
