    <button type="button" onclick="closeMt5ErrorModal()">ตกลง</button>
  </div>
</div>

<script>
function closeMt5ErrorModal(){
  const modal = document.getElementById('mt5ErrorModal');
  if (modal) modal.remove();
}
</script>


<% } %>
