<div class="wallet-page">
  <section class="wallet-coin-card">
    <div class="wallet-coin-top">
      <div class="wallet-coin-brand">
        <div class="wallet-chip"><%= coinName %> Digital Wallet</div>
        <span class="wallet-network-badge">● <%= networkName %></span>
      </div>
      <div class="wallet-muted">ราคา 1 <%= coinSymbol %> = ฿<%= fmtNum((scoinSettings && scoinSettings.current_price_thb) || 0.10, 2, 4) %></div>
    </div>
    <div class="wallet-balance-main"><%= fmtNum(scoinAvailable, 2, 4) %> <span style="font-size:22px;"><%= coinSymbol %></span></div>
    <div class="wallet-balance-sub">ใช้ได้ · มูลค่าโดยประมาณ ฿<%= fmtMoney(scoinValueThb) %></div>
    <div class="wallet-kpis" style="margin-top:18px;grid-template-columns:repeat(3,1fr);">
      <div class="wallet-stat"><span>ยอดรวมในกระเป๋า</span><strong><%= fmtNum(scoinBalance, 2, 4) %></strong></div>
      <div class="wallet-stat"><span>กันวงเงิน (ขายรออนุมัติ)</span><strong><%= fmtNum(scoinLocked, 2, 4) %></strong></div>
      <div class="wallet-stat"><span>ค่าธรรมเนียมโอน</span><strong><%= fmtNum((scoinSettings && scoinSettings.transfer_fee_percent) || 1.2, 2, 2) %>%</strong></div>
    </div>
    <div class="wallet-coin-actions">
      <button type="button" class="wallet-coin-action primary" data-wallet-tab="transfer">โอน</button>
      <button type="button" class="wallet-coin-action" data-wallet-tab="market">ซื้อ / ขาย</button>
      <button type="button" class="wallet-coin-action" data-wallet-tab="activity">ประวัติ</button>
    </div>
  </section>

  <section class="wallet-info-bar">
    <div class="wallet-info-status">
      <div class="wallet-muted">บัญชีรับเงินสำหรับขาย Scoin</div>
      <% if (verifiedBank && verifiedBank.is_verified) { %>
        <div><span class="wallet-badge verified">verified</span> <strong><%= verifiedBank.bank_name %></strong> / <%= verifiedBank.account_name %> / <%= verifiedBank.account_number_masked %></div>
      <% } else { %>
        <div><span class="wallet-badge pending">ยังไม่ verified</span> ต้องยืนยัน OTP ทางอีเมลก่อนจึงจะขาย Scoin ได้</div>
      <% } %>
    </div>
    <div class="wallet-actions">
      <a class="wallet-link-btn" href="/app/bank-accounts">ไปหน้าบัญชีรับเงิน</a>
    </div>
  </section>

  <section class="card wallet-panel active" id="wallet-panel-overview">
    <div class="card-head"><h3>ที่อยู่กระเป๋า (Wallet Address)</h3></div>
    <div class="wallet-code-box">
      <div class="wallet-address-card">
        <% if (walletCode && qrWalletUrl) { %>
          <img class="wallet-qr" src="<%= qrWalletUrl %>" alt="QR Wallet">
        <% } else { %>
          <div class="wallet-qr-placeholder">สร้างรหัสกระเป๋า<br>เพื่อแสดง QR</div>
        <% } %>
        <div>
          <div class="wallet-code-label">ใช้รหัสนี้รับโอน Scoin ภายในระบบ Avelqua (พร้อมขยาย API ภายนอกในอนาคต)</div>
          <div class="wallet-code-row">
            <div class="wallet-code-value" id="walletCodeText"><%= walletCode || 'ยังไม่มีรหัสกระเป๋า' %></div>
            <div class="wallet-actions">
              <% if (!walletCode) { %>
                <form method="post" action="/app/scoin-wallet/create-wallet"><button type="submit" class="wallet-main-btn wallet">สร้างกระเป๋า</button></form>
              <% } %>
              <button type="button" class="wallet-main-btn secondary" onclick="copyWalletCode()">คัดลอก</button>
            </div>
          </div>
          <div class="wallet-note">Network: <strong><%= networkName %></strong> · Format: <strong>SCN-XXXX-XXXX-XXXX-XXXX</strong></div>
          <div class="wallet-note">API สำหรับแอป/บริการภายนอก: <code>/app/api/v1/scoin/balance</code>, <code>/wallet</code>, <code>/transactions</code></div>
        </div>
      </div>
    </div>

    <div class="wallet-grid-3" style="margin-top:16px;grid-template-columns:repeat(4,1fr);">
      <div class="wallet-summary-card"><span>คำสั่งตลาดทั้งหมด</span><strong><%= Number(summary.total_orders || 0) %></strong></div>
      <div class="wallet-summary-card"><span>รออนุมัติ</span><strong><%= Number(summary.pending_orders || 0) %></strong></div>
      <div class="wallet-summary-card"><span>สำเร็จ</span><strong><%= Number(summary.approved_orders || 0) %></strong></div>
      <div class="wallet-summary-card"><span>ยกเลิก/ปฏิเสธ</span><strong><%= Number(summary.cancelled_orders || 0) %></strong></div>
    </div>
  </section>

  <section class="wallet-grid-2 wallet-panel" id="wallet-panel-transfer">
    <section class="card">
      <div class="card-head"><h3>โอน Scoin ให้ผู้ใช้อื่น</h3></div>
      <form method="POST" action="/app/scoin-wallet/transfer-by-wallet" class="wallet-form">
        <div><label>รหัสกระเป๋าปลายทาง</label><input type="text" name="to_wallet_code" required placeholder="SCN-XXXX-XXXX-XXXX-XXXX"></div>
        <div><label>จำนวน Scoin (ใช้ได้ <%= fmtNum(scoinAvailable, 2, 4) %>)</label><input type="number" name="amount" min="0.0001" step="0.0001" max="<%= scoinAvailable %>" required placeholder="0.0000"></div>
        <div class="wallet-btn-row"><button type="submit" class="wallet-main-btn transfer">โอน Scoin</button></div>
      </form>
    </section>

    <section class="card">
      <div class="card-head"><h3>คำแนะนำการโอน</h3></div>
      <div class="wallet-form" style="margin-top:0;">
        <div class="wallet-mini-card"><span>รหัสกระเป๋า</span><strong>ใช้ SCN-XXXX-XXXX-XXXX-XXXX ของผู้รับ</strong></div>
        <div class="wallet-mini-card"><span>ค่าธรรมเนียม</span><strong>หักจากยอดโอน <%= fmtNum((scoinSettings && scoinSettings.transfer_fee_percent) || 1.2, 2, 2) %>%</strong></div>
        <div class="wallet-mini-card"><span>Ledger</span><strong>ทุกรายการมี tx_ref และบันทึกยอดก่อน/หลัง</strong></div>
      </div>
    </section>
  </section>

  <section class="wallet-grid-2 wallet-panel" id="wallet-panel-market">
    <section class="card">
      <div class="card-head"><h3>ซื้อ Scoin</h3></div>
      <form method="POST" action="/app/scoin-market/order" class="wallet-form">
        <input type="hidden" name="order_type" value="buy">
        <div class="wallet-form-grid-2">
          <div><label>จำนวน Scoin</label><input id="buy_scoin_amount" type="number" name="scoin_amount" min="0" step="0.0001" placeholder="0.0000"></div>
          <div><label>จำนวนเงินบาท</label><input id="buy_amount_thb" type="number" name="amount_thb" min="0" step="0.01" placeholder="0.00"></div>
        </div>
        <div>
          <label>ช่องทางชำระเงิน</label>
          <select name="payment_method" required>
            <option value="">เลือกช่องทางชำระเงิน</option>
            <option value="promptpay_qr">PromptPay QR</option>
            <option value="credit_card">บัตรเครดิต / เดบิต</option>
          </select>
        </div>
        <div><label>หมายเหตุ</label><input type="text" name="note" placeholder="เช่น ซื้อเข้ากระเป๋าหลัก"></div>
        <div class="wallet-btn-row"><button type="submit" class="wallet-main-btn buy">ซื้อ Scoin</button></div>
      </form>
    </section>

    <section class="card">
      <div class="card-head"><h3>ขาย Scoin คืนโฮส</h3></div>
      <form method="POST" action="/app/scoin-market/order" class="wallet-form">
        <input type="hidden" name="order_type" value="sell">
        <div class="wallet-form-grid-2">
          <div><label>จำนวน Scoin</label><input id="sell_scoin_amount" type="number" name="scoin_amount" min="0" step="0.0001" placeholder="0.0000"></div>
          <div><label>จำนวนเงินบาท</label><input id="sell_amount_thb" type="number" name="amount_thb" min="0" step="0.01" placeholder="0.00"></div>
        </div>
        <div><label>บัญชีรับเงิน</label><input type="text" readonly value="<%= verifiedBank ? [verifiedBank.bank_name, verifiedBank.account_name, verifiedBank.account_number_masked].filter(Boolean).join(' / ') : 'ยังไม่มีบัญชีรับเงิน verified' %>"></div>
        <div><label>หมายเหตุ</label><input type="text" name="note" placeholder="เช่น ขายคืนโฮส รอ admin อนุมัติ"></div>
        <div class="wallet-note">เมื่อส่งคำสั่งขาย ระบบจะกันวงเงิน Scoin ทันทีจนกว่า admin อนุมัติหรือปฏิเสธ</div>
        <div class="wallet-btn-row">
          <% if (verifiedBank && verifiedBank.is_verified) { %>
            <button type="submit" class="wallet-main-btn sell">ขาย Scoin</button>
          <% } else { %>
            <a class="wallet-link-btn" href="/app/bank-accounts">เพิ่มและยืนยันบัญชีรับเงินก่อน</a>
          <% } %>
        </div>
      </form>
    </section>
  </section>

  <section class="card wallet-panel" id="wallet-panel-activity">
    <div class="card-head"><h3>ประวัติคำสั่งตลาด</h3></div>
    <div class="wallet-table-wrap">
      <table class="wallet-table">
        <thead>
          <tr>
            <th>วันเวลา</th>
            <th>ประเภท</th>
            <th>จำนวน</th>
            <th>ราคา</th>
            <th>สุทธิ</th>
            <th>ช่องทาง</th>
            <th>สถานะ</th>
            <th>หมายเหตุ</th>
            <th>จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr><td colspan="9" class="wallet-empty">ยังไม่มีประวัติคำสั่งตลาด</td></tr>
          <% } %>

          <% orders.forEach(function(order){ %>
            <tr>
              <td><%= fmtDate(order.created_at) %></td>
              <td><span class="wallet-badge <%= String(order.order_type || '').toLowerCase() %>"><%= order.order_type || '-' %></span></td>
              <td><%= fmtNum(order.scoin_amount, 2, 4) %></td>
              <td>฿<%= fmtNum(order.price_thb, 2, 4) %></td>
              <td>฿<%= fmtMoney(order.net_amount_thb) %></td>
              <td><%= order.payment_method || '-' %></td>
              <td><span class="wallet-badge <%= String(order.status || '').toLowerCase() %>"><%= order.status || '-' %></span></td>
              <td><%= order.note || '-' %></td>
              <td>
                <% if (
                  String(order.order_type || '').toLowerCase() === 'buy' &&
                  String(order.status || '').toLowerCase() === 'pending' &&
                  String(order.payment_status || '').toLowerCase() === 'pending'
                ) { %>
                  <div class="wallet-market-actions">
                    <a class="wallet-link-btn" href="/app/scoin-market/payment/<%= order.id %>">ชำระเงินต่อ</a>
                    <form method="POST" action="/app/scoin-market/order/<%= order.id %>/cancel" style="margin:0;">
                      <button class="wallet-cancel-btn" type="submit">ยกเลิก</button>
                    </form>
                  </div>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (ordersPagination && ordersPagination.totalPages > 1) { %>
    <div class="wallet-pagination">
      <% if (ordersPagination.page > 1) { %>
        <a class="wallet-link-btn" href="/app/scoin-wallet?orders_page=<%= ordersPagination.page - 1 %>&txs_page=<%= txsPagination.page %>">ก่อนหน้า</a>
      <% } %>
      <span class="wallet-muted">หน้า <%= ordersPagination.page %> / <%= ordersPagination.totalPages %></span>
      <% if (ordersPagination.page < ordersPagination.totalPages) { %>
        <a class="wallet-link-btn" href="/app/scoin-wallet?orders_page=<%= ordersPagination.page + 1 %>&txs_page=<%= txsPagination.page %>">ถัดไป</a>
      <% } %>
    </div>
    <% } %>
  </section>

  <section class="card wallet-panel" id="wallet-panel-activity-txs">
    <div class="card-head"><h3>ประวัติธุรกรรม (Ledger)</h3></div>
    <div class="wallet-table-wrap">
      <table class="wallet-table">
        <thead>
          <tr>
            <th>วันเวลา</th>
            <th>Tx Ref</th>
            <th>ประเภท</th>
            <th>ทิศทาง</th>
            <th>จำนวน</th>
            <th>ยอดหลัง</th>
            <th>สถานะ</th>
          </tr>
        </thead>
        <tbody>
          <% if (!txs.length) { %><tr><td colspan="7" class="wallet-empty">ยังไม่มีประวัติธุรกรรม</td></tr><% } %>
          <% txs.forEach(function(tx){ %>
            <tr>
              <td><%= fmtDate(tx.created_at) %></td>
              <td>
                <% if (tx.tx_ref) { %>
                  <div class="wallet-tx-ref"><%= tx.tx_ref %></div>
                  <button type="button" class="wallet-copy-mini" onclick="copyText('<%= tx.tx_ref %>')">คัดลอก</button>
                <% } else { %>-<% } %>
              </td>
              <td><strong><%= txLabel(tx) %></strong><br><small class="wallet-muted"><%= tx.tx_type || '-' %></small></td>
              <td><span class="wallet-badge <%= String(tx.direction || '').toLowerCase() %>"><%= tx.direction || '-' %></span></td>
              <td><%= fmtNum(tx.amount,2,4) %></td>
              <td><%= fmtNum(tx.balance_after,2,4) %></td>
              <td><span class="wallet-badge <%= String(tx.status || 'confirmed').toLowerCase() %>"><%= tx.status || 'confirmed' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (txsPagination && txsPagination.totalPages > 1) { %>
    <div class="wallet-pagination">
      <% if (txsPagination.page > 1) { %>
        <a class="wallet-link-btn" href="/app/scoin-wallet?orders_page=<%= ordersPagination.page %>&txs_page=<%= txsPagination.page - 1 %>">ก่อนหน้า</a>
      <% } %>
      <span class="wallet-muted">หน้า <%= txsPagination.page %> / <%= txsPagination.totalPages %></span>
      <% if (txsPagination.page < txsPagination.totalPages) { %>
        <a class="wallet-link-btn" href="/app/scoin-wallet?orders_page=<%= ordersPagination.page %>&txs_page=<%= txsPagination.page + 1 %>">ถัดไป</a>
      <% } %>
    </div>
    <% } %>
  </section>
</div>
<script>
function copyText(text){
  if(!text)return;
  navigator.clipboard.writeText(text).then(()=>alert('คัดลอกแล้ว')).catch(()=>alert('คัดลอกไม่สำเร็จ'));
}
function copyWalletCode(){copyText(document.getElementById('walletCodeText')?.innerText?.trim());}
function setWalletTab(name){
  const panels={
    overview:['wallet-panel-overview'],
    transfer:['wallet-panel-transfer'],
    market:['wallet-panel-market'],
    activity:['wallet-panel-activity','wallet-panel-activity-txs']
  };
  document.querySelectorAll('.wallet-panel').forEach(el=>el.classList.remove('active'));
  (panels[name]||panels.overview).forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.classList.add('active');
  });
  document.querySelectorAll('[data-wallet-tab]').forEach(btn=>{
    btn.classList.toggle('active', btn.getAttribute('data-wallet-tab')===name);
  });
}
document.querySelectorAll('[data-wallet-tab]').forEach(btn=>{
  btn.addEventListener('click',()=>setWalletTab(btn.getAttribute('data-wallet-tab')));
});
const SCOIN_PRICE=<%= Number((scoinSettings && scoinSettings.current_price_thb) || 1) %>;
function bindScoinThbPair(scoinId,thbId){const s=document.getElementById(scoinId),t=document.getElementById(thbId);if(!s||!t)return;let syncing=false;s.addEventListener('input',()=>{if(syncing)return;syncing=true;const v=Number(s.value||0);t.value=v>0?(v*SCOIN_PRICE).toFixed(2):'';syncing=false;});t.addEventListener('input',()=>{if(syncing)return;syncing=true;const v=Number(t.value||0);s.value=v>0?(v/SCOIN_PRICE).toFixed(4):'';syncing=false;});}
bindScoinThbPair('buy_scoin_amount','buy_amount_thb');
bindScoinThbPair('sell_scoin_amount','sell_amount_thb');
(function(){
  const params=new URLSearchParams(window.location.search);
  const ordersPage=Math.max(1,Number(params.get('orders_page')||1));
  const txsPage=Math.max(1,Number(params.get('txs_page')||1));
  if(ordersPage>1||txsPage>1)setWalletTab('activity');
})();
</script>

<%- include('../partials/app-shell-end') %>