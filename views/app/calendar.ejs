<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
const pageCss = 'app-calendar.css';
const calendarRefreshSec = Number(typeof refreshSec !== 'undefined' ? refreshSec : 90) || 90;
const calActiveTab = String(typeof activeTab !== 'undefined' ? activeTab : 'calendar');
%>

<%- include('../partials/app-shell') %>

<div class="cal-page" id="calPage">
  <nav class="cal-tabs" aria-label="เมนูปฏิทิน">
    <a href="/app/calendar" class="cal-tab <%= calActiveTab === 'calendar' ? 'active' : '' %>">📅 ปฏิทิน PnL</a>
    <a href="/app/calendar/ai" class="cal-tab <%= calActiveTab === 'ai' ? 'active' : '' %>">🤖 AI วิเคราะห์ 30 วัน</a>
  </nav>

  <section class="cal-hero">
    <div class="cal-hero-top">
      <div>
        <p class="cal-eyebrow">MT5 Performance</p>
        <% if (calActiveTab === 'ai') { %>
          <h2>AI วิเคราะห์ตลาด · 30 วันข้างหน้า</h2>
          <p>วิเคราะห์จากประวัติ PnL ของแต่ละ Login + มุมมองตลาดทอง (Python AI) — คาดการณ์กำไร/ขาดทุนเฉพาะวันจันทร์–ศุกร์</p>
        <% } else { %>
          <h2>ปฏิทินกำไร / ขาดทุน</h2>
          <p>กำไร/ขาดทุน = Equity ปัจจุบัน − Equity ตอนเชื่อมต่อ Login · อัปเดตทุก <%= calendarRefreshSec %> วิ (จ–ศ) · เสาร์–อาทิตย์ตลาดปิด</p>
        <% } %>
      </div>
      <div class="cal-live-badge" id="calLiveBadge" hidden>
        <span class="cal-live-dot" aria-hidden="true"></span>
        <span>Live · <%= calendarRefreshSec %>s</span>
      </div>
      <div class="cal-closed-badge" id="calClosedBadge" hidden>
        <span>ตลาดปิด · เสาร์–อาทิตย์</span>
      </div>
    </div>

    <div class="cal-toolbar">
      <label>
        MT5 Login
        <select id="calAccountSelect" aria-label="เลือก MT5 Login">
          <option value="">กำลังโหลด...</option>
        </select>
      </label>
      <% if (calActiveTab === 'calendar') { %>
      <div class="cal-month-nav" aria-label="เปลี่ยนเดือน">
        <button type="button" id="calPrevMonth" title="เดือนก่อน">‹</button>
        <strong id="calMonthLabel">-</strong>
        <button type="button" id="calNextMonth" title="เดือนถัดไป">›</button>
      </div>
      <% } else { %>
      <button type="button" class="cal-ai-refresh" id="calAiRefresh">🔄 วิเคราะห์ใหม่</button>
      <% } %>
    </div>
  </section>

  <% if (calActiveTab === 'calendar') { %>
  <section class="cal-stats" aria-label="สรุปเดือน">
    <article class="cal-stat">
      <span>กำไร/ขาดทุนสะสม Live</span>
      <strong id="calLivePnl" class="neu">-</strong>
    </article>
    <article class="cal-stat">
      <span>Equity ตอนเชื่อมต่อ</span>
      <strong id="calBaseline" class="neu">-</strong>
    </article>
    <article class="cal-stat">
      <span>เปลี่ยนแปลงในเดือนนี้</span>
      <strong id="calMonthTotal" class="neu">-</strong>
    </article>
    <article class="cal-stat">
      <span>วันที่ได้กำไร (ในเดือน)</span>
      <strong id="calProfitDays" class="neu">0</strong>
    </article>
    <article class="cal-stat">
      <span>วันที่ขาดทุน (ในเดือน)</span>
      <strong id="calLossDays" class="neu">0</strong>
    </article>
  </section>

  <section class="cal-panel" aria-label="ปฏิทินรายเดือน">
    <div class="cal-panel-head">
      <div>
        <h3>ปฏิทินรายเดือน</h3>
        <p id="calSelectedHint">เลือกวันเพื่อดูประวัติด้านล่าง</p>
      </div>
    </div>
    <div class="cal-grid-wrap">
      <div class="cal-weekdays" aria-hidden="true">
        <span>อา</span><span>จ</span><span>อ</span><span>พ</span><span>พฤ</span><span>ศ</span><span>ส</span>
      </div>
      <div class="cal-grid" id="calGrid"></div>
    </div>
  </section>

  <section class="cal-panel" aria-label="ประวัติผลการเทรด">
    <div class="cal-panel-head">
      <div>
        <h3>ประวัติผลการเทรด</h3>
        <p id="calHistoryHint">อัปเดตทุก <%= calendarRefreshSec %> วินาที · 10 แถวต่อหน้า</p>
      </div>
    </div>
    <div class="cal-table-wrap">
      <table class="cal-table">
        <thead>
          <tr>
            <th>เวลา</th>
            <th>Equity</th>
            <th>กำไร/ขาดทุน (จากเชื่อมต่อ)</th>
            <th>กำไร</th>
            <th>ขาดทุน</th>
            <th>สถานะ</th>
          </tr>
        </thead>
        <tbody id="calHistoryBody">
          <tr><td colspan="6" class="cal-empty">กำลังโหลด...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="cal-pager">
      <span id="calPagerInfo">-</span>
      <div class="cal-pager-btns">
        <button type="button" id="calHistPrev">ก่อนหน้า</button>
        <button type="button" id="calHistNext">ถัดไป</button>
      </div>
    </div>
  </section>
  <% } else { %>
  <section class="cal-ai-stats" id="calAiStats" aria-label="สรุป AI">
    <article class="cal-stat">
      <span>แนวโน้ม</span>
      <strong id="calAiOutlook" class="neu">-</strong>
    </article>
    <article class="cal-stat">
      <span>ความมั่นใจ AI</span>
      <strong id="calAiConfidence" class="neu">-</strong>
    </article>
    <article class="cal-stat">
      <span>คาดการณ์ 30 วัน (ฐาน)</span>
      <strong id="calAiBase" class="neu">-</strong>
    </article>
  </section>

  <section class="cal-panel cal-ai-panel" aria-label="สรุป AI">
    <div class="cal-panel-head">
      <div>
        <h3>สรุปการวิเคราะห์</h3>
        <p id="calAiMeta">กำลังโหลด...</p>
      </div>
    </div>
    <div class="cal-ai-summary" id="calAiSummary">กำลังวิเคราะห์...</div>
    <div class="cal-ai-scenarios" id="calAiScenarios"></div>
    <div class="cal-ai-lists">
      <div><h4>ความเสี่ยง</h4><ul id="calAiRisks"></ul></div>
      <div><h4>คำแนะนำ</h4><ul id="calAiTips"></ul></div>
    </div>
    <p class="cal-ai-disclaimer" id="calAiDisclaimer"></p>
  </section>

  <section class="cal-panel" aria-label="คาดการณ์รายวัน 30 วัน">
    <div class="cal-panel-head">
      <div>
        <h3>คาดการณ์รายวัน (เฉพาะวันตลาดเปิด)</h3>
        <p>30 วันทำการข้างหน้า · ข้ามเสาร์–อาทิตย์ · 10 แถวต่อหน้า</p>
      </div>
    </div>
    <div class="cal-table-wrap">
      <table class="cal-table">
        <thead>
          <tr>
            <th>วันที่</th>
            <th>คาด PnL/วัน</th>
            <th>ดีสุด</th>
            <th>แย่สุด</th>
            <th>สะสม 30 วัน</th>
          </tr>
        </thead>
        <tbody id="calAiForecastBody">
          <tr><td colspan="5" class="cal-empty">กำลังโหลด...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="cal-pager">
      <span id="calAiForecastPagerInfo">-</span>
      <div class="cal-pager-btns">
        <button type="button" id="calAiForecastPrev">ก่อนหน้า</button>
        <button type="button" id="calAiForecastNext">ถัดไป</button>
      </div>
    </div>
  </section>
  <% } %>
</div>

<script>
(function () {
  var ACTIVE_TAB = '<%= calActiveTab %>';
  var REFRESH_MS = <%= calendarRefreshSec %> * 1000;
  var FORECAST_PAGE_SIZE = 10;
  var state = {
    accountId: 0,
    month: '',
    selectedDay: '',
    historyPage: 1,
    forecastPage: 1,
    forecastDays: [],
    loading: false,
    timer: null
  };

  var el = {
    page: document.getElementById('calPage'),
    account: document.getElementById('calAccountSelect')
  };

  if (ACTIVE_TAB === 'calendar') {
    Object.assign(el, {
      monthLabel: document.getElementById('calMonthLabel'),
      grid: document.getElementById('calGrid'),
      monthTotal: document.getElementById('calMonthTotal'),
      livePnl: document.getElementById('calLivePnl'),
      baseline: document.getElementById('calBaseline'),
      profitDays: document.getElementById('calProfitDays'),
      lossDays: document.getElementById('calLossDays'),
      selectedHint: document.getElementById('calSelectedHint'),
      historyHint: document.getElementById('calHistoryHint'),
      historyBody: document.getElementById('calHistoryBody'),
      pagerInfo: document.getElementById('calPagerInfo'),
      histPrev: document.getElementById('calHistPrev'),
      histNext: document.getElementById('calHistNext'),
      liveBadge: document.getElementById('calLiveBadge'),
      closedBadge: document.getElementById('calClosedBadge'),
      prevMonth: document.getElementById('calPrevMonth'),
      nextMonth: document.getElementById('calNextMonth')
    });
  } else {
    Object.assign(el, {
      aiRefresh: document.getElementById('calAiRefresh'),
      aiOutlook: document.getElementById('calAiOutlook'),
      aiConfidence: document.getElementById('calAiConfidence'),
      aiBase: document.getElementById('calAiBase'),
      aiMeta: document.getElementById('calAiMeta'),
      aiSummary: document.getElementById('calAiSummary'),
      aiScenarios: document.getElementById('calAiScenarios'),
      aiRisks: document.getElementById('calAiRisks'),
      aiTips: document.getElementById('calAiTips'),
      aiDisclaimer: document.getElementById('calAiDisclaimer'),
      aiForecastBody: document.getElementById('calAiForecastBody'),
      aiForecastPagerInfo: document.getElementById('calAiForecastPagerInfo'),
      aiForecastPrev: document.getElementById('calAiForecastPrev'),
      aiForecastNext: document.getElementById('calAiForecastNext')
    });
  }

  function fmtMoney(v) {
    var n = Number(v);
    if (!Number.isFinite(n)) return '-';
    var sign = n > 0 ? '+' : '';
    return sign + n.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function pnlClass(v) {
    var n = Number(v);
    if (!Number.isFinite(n) || n === 0) return 'neu';
    return n > 0 ? 'pos' : 'neg';
  }

  function outlookLabel(v) {
    var s = String(v || '').toLowerCase();
    if (s === 'bullish') return 'ขาขึ้น';
    if (s === 'bearish') return 'ขาลง';
    return 'ทรงตัว';
  }

  function renderAccounts(accounts, selectedId) {
    if (!accounts || !accounts.length) {
      el.account.innerHTML = '<option value="">ยังไม่มี MT5 Login</option>';
      return;
    }
    el.account.innerHTML = accounts.map(function (a) {
      var label = 'Login ' + a.mt5_login;
      if (a.port_slot) label += ' · PORT ' + a.port_slot;
      var sel = Number(a.id) === Number(selectedId) ? ' selected' : '';
      return '<option value="' + a.id + '"' + sel + '>' + label + '</option>';
    }).join('');
    el.account.value = String(selectedId || accounts[0].id);
  }

  if (ACTIVE_TAB === 'calendar') {
    function shiftMonth(monthKey, delta) {
      var parts = String(monthKey || '').split('-').map(Number);
      if (parts.length < 2) return monthKey;
      var d = new Date(Date.UTC(parts[0], parts[1] - 1 + delta, 1));
      return d.getUTCFullYear() + '-' + String(d.getUTCMonth() + 1).padStart(2, '0');
    }

    function buildQuery() {
      var q = new URLSearchParams();
      if (state.accountId) q.set('accountId', String(state.accountId));
      if (state.month) q.set('month', state.month);
      if (state.selectedDay) q.set('day', state.selectedDay);
      q.set('historyPage', String(state.historyPage));
      return q.toString();
    }

    function renderGrid(data) {
      var cells = (data.calendar && data.calendar.cells) || [];
      if (!cells.length) {
        el.grid.innerHTML = '<div class="cal-empty">ยังไม่มีข้อมูล</div>';
        return;
      }
      el.grid.innerHTML = cells.map(function (c) {
        if (c.empty) return '<div class="cal-cell empty"></div>';
        var cls = ['cal-cell'];
        if (!c.isFuture && (c.hasData || c.isToday)) cls.push('clickable');
        if (c.isToday) cls.push('today');
        if (c.live) cls.push('live');
        if (c.dayKey === data.selectedDay) cls.push('selected');
        if (c.isFuture) cls.push('future');
        if (c.isWeekend || c.marketClosed) cls.push('weekend');
        var pnlText = (c.marketClosed || c.isWeekend) ? 'ปิด' : (c.pnl == null ? '—' : fmtMoney(c.pnl));
        var tag = '';
        if (c.marketClosed || c.isWeekend) tag = '<span class="cal-cell-tag cal-market-closed">ตลาดปิด</span>';
        else if (c.live) tag = '<span class="cal-cell-tag">Live</span>';
        else if (c.finalized) tag = '<span class="cal-cell-tag" style="color:#94a3b8">สรุปแล้ว</span>';
        return '<button type="button" class="' + cls.join(' ') + '" data-day="' + c.dayKey + '" ' + (c.isFuture ? 'disabled' : '') + '>' +
          '<span class="cal-day-num">' + c.day + '</span>' +
          '<span class="cal-pnl ' + pnlClass(c.pnl) + '">' + pnlText + '</span>' + tag + '</button>';
      }).join('');
      el.grid.querySelectorAll('.cal-cell.clickable').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.selectedDay = btn.getAttribute('data-day') || '';
          state.historyPage = 1;
          loadCalendar(false);
        });
      });
    }

    function renderHistory(data) {
      var hist = data.history || {};
      var rows = hist.rows || [];
      if (!rows.length) {
        var emptyMsg = (hist.marketClosed || data.selectedMarketClosed)
          ? 'ตลาดทองปิด · ไม่มีการอัปเดตวันเสาร์–อาทิตย์'
          : 'ยังไม่มีประวัติในวันนี้';
        el.historyBody.innerHTML = '<tr><td colspan="6" class="cal-empty">' + emptyMsg + '</td></tr>';
      } else {
        el.historyBody.innerHTML = rows.map(function (r) {
          return '<tr class="' + (r.live ? 'live-row' : '') + '">' +
            '<td>' + (r.datetime || r.time || '-') + '</td>' +
            '<td class="num">' + fmtMoney(r.equity) + '</td>' +
            '<td class="num ' + pnlClass(r.pnl) + '">' + fmtMoney(r.pnl) + '</td>' +
            '<td class="num pos">' + (r.profit ? fmtMoney(r.profit) : '-') + '</td>' +
            '<td class="num neg">' + (r.loss ? fmtMoney(r.loss) : '-') + '</td>' +
            '<td>' + (r.live ? '<span class="pos">Live</span>' : 'บันทึก') + '</td></tr>';
        }).join('');
      }
      el.pagerInfo.textContent = 'หน้า ' + (hist.page || 1) + ' / ' + (hist.pageCount || 1) + ' · ทั้งหมด ' + (hist.total || 0) + ' รายการ';
      el.histPrev.disabled = (hist.page || 1) <= 1;
      el.histNext.disabled = (hist.page || 1) >= (hist.pageCount || 1);
    }

    function renderSummary(data) {
      var hist = data.history || {};
      var total = Number((data.calendar && data.calendar.monthTotal) || 0);
      el.monthTotal.textContent = fmtMoney(total);
      el.monthTotal.className = pnlClass(total);
      if (el.livePnl) {
        el.livePnl.textContent = data.livePnl != null ? fmtMoney(data.livePnl) : '-';
        el.livePnl.className = pnlClass(data.livePnl);
      }
      if (el.baseline) {
        el.baseline.textContent = data.connectBaseline != null ? fmtMoney(data.connectBaseline) : '-';
      }
      el.profitDays.textContent = String((data.calendar && data.calendar.profitDays) || 0);
      el.lossDays.textContent = String((data.calendar && data.calendar.lossDays) || 0);
      el.monthLabel.textContent = data.monthLabel || data.month || '-';
      el.selectedHint.textContent = 'วันที่เลือก: ' + (data.selectedDayLabel || data.selectedDay || '-')
        + (data.selectedDayPnl != null ? ' · ' + fmtMoney(data.selectedDayPnl) : '');
      el.historyHint.textContent = (data.selectedMarketClosed || (hist.marketClosed && data.selectedDay === data.todayKey))
        ? 'วันเสาร์–อาทิตย์ ตลาดทองปิด · ไม่อัปเดต'
        : ('ประวัติวันที่ ' + (data.selectedDayLabel || data.selectedDay || '-')
          + ' · อัปเดตทุก ' + (data.refreshSec || <%= calendarRefreshSec %>) + ' วินาที (จ–ศ)');
      el.liveBadge.hidden = !(data.selectedDay === data.todayKey && data.refreshEnabled);
      el.closedBadge.hidden = !(!data.refreshEnabled && data.selectedDay === data.todayKey);
    }

    function scheduleRefresh(enabled) {
      if (state.timer) clearInterval(state.timer);
      state.timer = null;
      if (enabled) state.timer = setInterval(function () { loadCalendar(false); }, REFRESH_MS);
    }

    async function loadCalendar(showLoading) {
      if (state.loading) return;
      state.loading = true;
      if (showLoading !== false) el.page.classList.add('cal-loading');
      try {
        var res = await fetch('/app/calendar/data?' + buildQuery(), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        var data = await res.json();
        if (!data.ok) throw new Error(data.message || 'load_failed');
        state.accountId = data.accountId || 0;
        state.month = data.month || state.month;
        state.selectedDay = data.selectedDay || state.selectedDay;
        state.historyPage = (data.history && data.history.page) || state.historyPage;
        renderAccounts(data.accounts || [], data.accountId);
        renderSummary(data);
        renderGrid(data);
        renderHistory(data);
        scheduleRefresh(!!data.refreshEnabled);
      } catch (e) {
        el.grid.innerHTML = '<div class="cal-empty">โหลดไม่สำเร็จ: ' + (e.message || e) + '</div>';
      } finally {
        state.loading = false;
        el.page.classList.remove('cal-loading');
      }
    }

    el.account.addEventListener('change', function () {
      state.accountId = Number(el.account.value || 0);
      state.historyPage = 1;
      loadCalendar(true);
    });
    el.prevMonth.addEventListener('click', function () { state.month = shiftMonth(state.month, -1); loadCalendar(true); });
    el.nextMonth.addEventListener('click', function () { state.month = shiftMonth(state.month, 1); loadCalendar(true); });
    el.histPrev.addEventListener('click', function () { if (state.historyPage > 1) { state.historyPage -= 1; loadCalendar(false); } });
    el.histNext.addEventListener('click', function () { state.historyPage += 1; loadCalendar(false); });
    loadCalendar(true);
  } else {
    function renderForecastTable() {
      var days = state.forecastDays || [];
      var total = days.length;
      var pageCount = Math.max(1, Math.ceil(total / FORECAST_PAGE_SIZE));
      if (state.forecastPage > pageCount) state.forecastPage = pageCount;
      if (state.forecastPage < 1) state.forecastPage = 1;

      if (!total) {
        el.aiForecastBody.innerHTML = '<tr><td colspan="5" class="cal-empty">ยังไม่มีข้อมูลคาดการณ์ (ต้องมีประวัติ PnL อย่างน้อยบางวัน)</td></tr>';
        if (el.aiForecastPagerInfo) el.aiForecastPagerInfo.textContent = '-';
        if (el.aiForecastPrev) el.aiForecastPrev.disabled = true;
        if (el.aiForecastNext) el.aiForecastNext.disabled = true;
        return;
      }

      var start = (state.forecastPage - 1) * FORECAST_PAGE_SIZE;
      var pageRows = days.slice(start, start + FORECAST_PAGE_SIZE);
      el.aiForecastBody.innerHTML = pageRows.map(function (d) {
        return '<tr><td>' + d.day_key + '</td><td class="num ' + pnlClass(d.expected_pnl) + '">' + fmtMoney(d.expected_pnl) + '</td>' +
          '<td class="num pos">' + fmtMoney(d.optimistic_pnl) + '</td><td class="num neg">' + fmtMoney(d.pessimistic_pnl) + '</td>' +
          '<td class="num ' + pnlClass(d.cumulative_pnl) + '">' + fmtMoney(d.cumulative_pnl) + '</td></tr>';
      }).join('');

      if (el.aiForecastPagerInfo) {
        el.aiForecastPagerInfo.textContent = 'หน้า ' + state.forecastPage + ' / ' + pageCount + ' · ทั้งหมด ' + total + ' วัน · 10 แถวต่อหน้า';
      }
      if (el.aiForecastPrev) el.aiForecastPrev.disabled = state.forecastPage <= 1;
      if (el.aiForecastNext) el.aiForecastNext.disabled = state.forecastPage >= pageCount;
    }

    function renderForecast(data) {
      var f = data.forecast || {};
      var analysis = f.analysis || {};
      var stats = f.stats || {};
      var proj = f.projected_pnl_30d || {};
      el.aiOutlook.textContent = outlookLabel(analysis.outlook);
      el.aiOutlook.className = pnlClass(analysis.outlook === 'bullish' ? 1 : analysis.outlook === 'bearish' ? -1 : 0);
      el.aiConfidence.textContent = String(analysis.confidence != null ? analysis.confidence : '-') + '%';
      el.aiBase.textContent = fmtMoney(proj.base);
      el.aiBase.className = pnlClass(proj.base);
      var meta = 'Login ' + (data.mt5Login || '-') + ' · วิเคราะห์เมื่อ ' + (data.generatedAt ? new Date(data.generatedAt).toLocaleString('th-TH') : '-');
      if (data.cached) meta += ' · จากแคช';
      if (data.refreshBlocked) meta += ' · รอ ' + (data.refreshCooldownSec || 0) + ' วิ ก่อนวิเคราะห์ใหม่';
      el.aiMeta.textContent = meta;
      el.aiSummary.innerHTML = '<p><strong>สรุป:</strong> ' + (analysis.summary_th || '-') + '</p><p><strong>มุมมองตลาด:</strong> ' + (analysis.market_view_th || '-') + '</p>';
      el.aiScenarios.innerHTML =
        '<div class="cal-ai-scenario pos"><span>ดีสุด</span><strong>' + fmtMoney(proj.optimistic) + '</strong></div>' +
        '<div class="cal-ai-scenario neu"><span>ฐาน</span><strong>' + fmtMoney(proj.base) + '</strong></div>' +
        '<div class="cal-ai-scenario neg"><span>แย่สุด</span><strong>' + fmtMoney(proj.pessimistic) + '</strong></div>';
      el.aiRisks.innerHTML = (analysis.risks || []).map(function (x) { return '<li>' + x + '</li>'; }).join('') || '<li>-</li>';
      el.aiTips.innerHTML = (analysis.recommendations || []).map(function (x) { return '<li>' + x + '</li>'; }).join('') || '<li>-</li>';
      el.aiDisclaimer.textContent = analysis.disclaimer || 'เป็นการคาดการณ์ ไม่ใช่คำแนะนำการลงทุน';
      state.forecastDays = f.daily_forecast || [];
      renderForecastTable();
    }

    async function loadForecast(refresh) {
      if (state.loading) return;
      state.loading = true;
      el.page.classList.add('cal-loading');
      try {
        var q = new URLSearchParams();
        if (state.accountId) q.set('accountId', String(state.accountId));
        if (refresh) q.set('refresh', '1');
        var res = await fetch('/app/calendar/forecast?' + q.toString(), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        var data = await res.json();
        if (!data.ok) throw new Error(data.message || 'forecast_failed');
        state.accountId = data.accountId || state.accountId;
        if (refresh) state.forecastPage = 1;
        renderAccounts(data.accounts || [], data.accountId);
        if (data.message === 'no_account') {
          el.aiSummary.textContent = 'ยังไม่มี MT5 Login — เชื่อมต่อที่หน้า MT5 ก่อน';
          return;
        }
        renderForecast(data);
      } catch (e) {
        el.aiSummary.textContent = 'โหลดไม่สำเร็จ: ' + (e.message || e);
      } finally {
        state.loading = false;
        el.page.classList.remove('cal-loading');
      }
    }

    el.account.addEventListener('change', function () {
      state.accountId = Number(el.account.value || 0);
      state.forecastPage = 1;
      loadForecast(false);
    });
    el.aiRefresh.addEventListener('click', function () { loadForecast(true); });
    if (el.aiForecastPrev) {
      el.aiForecastPrev.addEventListener('click', function () {
        if (state.forecastPage > 1) {
          state.forecastPage -= 1;
          renderForecastTable();
        }
      });
    }
    if (el.aiForecastNext) {
      el.aiForecastNext.addEventListener('click', function () {
        var pageCount = Math.max(1, Math.ceil((state.forecastDays || []).length / FORECAST_PAGE_SIZE));
        if (state.forecastPage < pageCount) {
          state.forecastPage += 1;
          renderForecastTable();
        }
      });
    }
    loadForecast(false);
  }
})();
</script>

<%- include('../partials/app-shell-end') %>
