<%- include('../partials/app-shell') %>
<div class="grid-2"><section class="card"><div class="card-head"><h3>ตัวช่วยคำนวณกำไร</h3></div><form method="GET" class="form-grid two"><label>กำไรต่อวัน<input type="number" name="dailyProfit" value="<%= calc.daily %>" /></label><label>จำนวนวัน<input type="number" name="days" value="<%= calc.days %>" /></label><div class="form-actions full"><button class="btn primary">คำนวณ</button></div></form></section><section class="card"><div class="card-head"><h3>ผลลัพธ์</h3></div><div class="stat-card large"><span>ประมาณการ</span><strong>฿<%= Number(calc.estimated || 0).toLocaleString('th-TH') %></strong><div class="muted">คำนวณจาก <%= calc.daily %> x <%= calc.days %> วัน</div></div></section></div>
<%- include('../partials/app-shell-end') %>
