<%- include('../partials/app-shell') %>
<section class="card form-card"><div class="card-head"><h3>เพิ่มบัญชีโบรกเกอร์</h3></div><form method="POST" action="/app/broker-accounts" class="form-grid two"><label>Broker<input type="text" name="broker_name" required /></label><label>Login<input type="text" name="account_login" required /></label><label>Password<input type="text" name="account_password" required /></label><label>Server<input type="text" name="server_name" required /></label><div class="form-actions full"><button class="btn primary">บันทึก</button></div></form></section>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Broker</th><th>Login</th><th>Server</th><th>Created</th><th></th></tr></thead><tbody><% if (!(brokerAccounts || []).length) { %><tr><td colspan="5" class="empty-cell">ยังไม่มีบัญชี</td></tr><% } %><% (brokerAccounts || []).forEach(function(a){ %><tr><td><%= a.broker_name %></td><td><%= a.account_login %></td><td><%= a.server_name %></td><td><%= a.created_at ? new Date(a.created_at).toLocaleString('th-TH') : '-' %><div class="cell-sub">#<%= a.display_id || a.id %></div></td><td><form method="POST" action="/app/broker-accounts/<%= a.id %>/delete" onsubmit="return confirm('ยืนยันลบ?')"><button class="btn danger">ลบ</button></form></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/app-shell-end') %>
