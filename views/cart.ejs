<%
const safeT = typeof t === 'function' ? t : (key, fallback='') => fallback || key;
%>

<%- include('partials/head', { pageCss: 'cart.css' }) %>
<%- include('partials/nav') %>
<main class="container section">
  <div class="page-head">
    <span class="badge"><%= safeT('cart.badge', 'CART') %></span>
    <h1 class="gradient-text"><%= safeT('cart.title', 'Your package cart') %></h1>
    <p class="muted lead"><%= safeT('cart.desc', 'Review your selected package before proceeding to checkout.') %></p>
  </div>
  <div class="card">
    <% const items = cartItems || []; %>
    <% if (!items.length) { %>
      <div class="empty-state">
        <p><%= safeT('cart.empty', 'Your cart is empty') %></p>
        <a class="btn primary" href="/pricing?lang=<%= lang || 'th' %>"><%= safeT('cart.choose_package', 'Choose package') %></a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th><%= safeT('pricing.package_name','Package') %></th>
              <th><%= safeT('payment.duration','Duration') %></th>
              <th><%= safeT('payment.total','Price') %></th>
              <th>Lot</th>
              <th><%= safeT('pricing.ports','Ports') %></th>
              <th><%= safeT('pricing.avg_profit','Average profit') %></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(item){ %>
              <tr>
                <td><strong><%= item.packageName %></strong></td>
                <td><%= item.days %></td>
                <td>฿<%= Number(item.price || 0).toLocaleString('th-TH') %></td>
                <td><%= item.lotMin %> - <%= item.lotMax %></td>
                <td><%= item.portMin %> - <%= item.portMax %></td>
                <td><%= item.profit && item.profit.label ? item.profit.label : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card" style="margin-top:16px">
        <div class="grid grid-2">
          <div>
            <div class="caption"><%= safeT('cart.total_label','Total amount') %></div>
            <div class="price">฿<%= Number(total || 0).toLocaleString('th-TH') %></div>
          </div>
          <div class="cart-actions" style="justify-content:flex-end;align-items:flex-end">
            <a class="btn primary" href="/payment/checkout?lang=<%= lang || 'th' %>"><%= safeT('cart.go_checkout','Go to checkout') %></a>
            <form method="post" action="/cart/remove">
              <button class="btn danger" type="submit"><%= safeT('cart.remove_all','Remove items') %></button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
