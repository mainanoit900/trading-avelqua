//--- [1] SECURITY & LIMITS ---
const datetime InpExpiryDate = D'2027.12.30 23:59:59'; // วันหมดอายุ
long AllowedAccounts[] = {0};                  // ใส่เลขพอร์ตเพื่อล็อค (รองรับหลายพอร์ต) หรือ ใส่ 0 เพื่อให้ใช้ได้ทุกพอร์ต
input int      InpMaxServerReq   = 30000;              // ลิมิตส่งคำสั่งเข้า Server ต่อวัน (กันโบรกแบน)

//--- [2] STRATEGY & MONEY MANAGEMENT ---
input double   InpLotStart       = 0.05;       // Start Lot
input double   InpMultiplier     = 1.5;         // Lot Multiplier
input int      InpMaxOrders      = 1000;        // Max Orders
input double   InpMaxDDPercent   = 15.0;        // Cut Loss (%)

//--- [3] ENTRY & GRID STEP ---
input bool     InpUseATRGrid     = true;        // เปิดใช้ ATR Dynamic Grid (True=ATR, False=Pip Step)
input int      InpPipStep        = 440;         // Pip Step (point) [หากไม่ใช้ ATR]
input double   InpATR_Mult       = 3.0;         // ATR Multiplier [หากใช้ ATR]
input int      InpMinStep        = 440;         // Min Step Points [หากใช้ ATR]
input int      InpMaxStep        = 1000;        // Max Step Points [หากใช้ ATR]

//--- [4] EXIT & PROFIT LOCK ---
input bool     InpSoftClose      = false;       // โหมด Soft Close (รวบกำไรไม้ค้างแล้วหยุด ไม่เปิดไม้ใหม่)
input double   InpTargetUSD      = 0.0;         // Target Profit (USD) [0 = ไม่ใช้งาน]
input int      InpTPAverage      = 100;         // Take Profit Average (point) [0 = ไม่ใช้งาน]
input double   InpTrailingStart  = 0.0;         // Trailing Start ($) [0 = ไม่ใช้งาน]
input double   InpTrailingStop   = 0.0;         // Trailing Stop ($)

//--- [5] DAILY TARGETS ---
input double   InpDailyProfit    = 0.0;         // Daily Profit Target ($) [0 = ไม่ใช้งาน]
input double   InpDailyLoss      = 0.0;         // Daily Loss Limit ($) [0 = ไม่ใช้งาน]

//--- [6] TIME FILTER SESSION ---
input bool     InpUseTimeFilter  = false;       // เปิดใช้งานระบบแบ่งเวลาเทรด
input bool     InpUseSession1    = false;       // เปิดใช้งาน Session 1
input string   InpStart1         = "03:00";     // Start Time 1 (HH:MM)
input string   InpStop1          = "06:00";     // Stop Time 1 (HH:MM)
input bool     InpUseSession2    = false;       // เปิดใช้งาน Session 2
input string   InpStart2         = "11:00";     // Start Time 2 (HH:MM)
input string   InpStop2          = "14:00";     // Stop Time 2 (HH:MM)
input bool     InpUseSession3    = false;       // เปิดใช้งาน Session 3
input string   InpStart3         = "19:00";     // Start Time 3 (HH:MM)
input string   InpStop3          = "23:55";     // Stop Time 3 (HH:MM)

//--- [7] SYSTEM ---
input long     InpMagic          = 20260427;    // Magic Number

//--- Global Variables
int handle_ema;
int handle_atr;
int server_requests_today = 0;
int last_day = -1;
int last_week = -1;
bool daily_limit_hit = false;
datetime last_trade_time = 0; // Cooldown Tracker

double max_buy_profit_usd = 0;
double max_sell_profit_usd = 0;

