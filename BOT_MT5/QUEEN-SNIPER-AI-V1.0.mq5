double max_dd_week_money = 0.0;

// All Time Tracker Variables
double max_dd_all_time_pct = 0.0;
double max_dd_all_time_money = 0.0;
long   max_dd_all_time_date = 0; // เก็บเป็นวินาที (Unix timestamp) เพื่อง่ายต่อ Global Variable

string gv_all_pct = "";
string gv_all_money = "";
string gv_all_date = "";

//--- Daily Min/Max Profit Tracker
double max_profit_day_usd = 0.0;
double min_profit_day_usd = 0.0;
long   max_profit_date = 0;
long   min_profit_date = 0;

string gv_max_prof = "";
string gv_min_prof = "";
string gv_max_prof_date = "";
string gv_min_prof_date = "";

//--- Average Daily Profit Variables (Smart Cache)
datetime first_trade_time = 0;
double total_closed_profit = 0.0;
int last_history_deals = 0;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   // --- ส่วนตรวจสอบวันหมดอายุ ---
   if (TimeCurrent() > InpExpiryDate)
     {
      Alert("Trial period expired! (หมดอายุการใช้งาน)");
      return(INIT_FAILED);
     }

   // --- ส่วนตรวจสอบเลขบัญชี (รองรับหลายบัญชี) ---
   bool isAllowed = false;
   int totalAccounts = ArraySize(AllowedAccounts);
   long currentAccount = AccountInfoInteger(ACCOUNT_LOGIN);

   for(int i=0; i < totalAccounts; i++)
     {
      if(currentAccount == AllowedAccounts[i] || AllowedAccounts[i] == 0)
        {
         isAllowed = true;
         break;
        }
     }

   if(!isAllowed)
     {
      Alert("เลขบัญชีไม่ถูกต้อง! EA นี้ไม่อนุญาตให้ใช้งานกับบัญชี: ", currentAccount);
      return(INIT_FAILED);
     }
   // =========================================================

   trade.SetExpertMagicNumber(InpMagic);
   trade.SetTypeFillingBySymbol(Symbol());

   // --- โหลดค่า All Time Max DD เดิม (ถ้ามี) ---
   gv_all_pct = "MAX_DD_PCT_" + IntegerToString(InpMagic) + "_" + Symbol();
   gv_all_money = "MAX_DD_MONEY_" + IntegerToString(InpMagic) + "_" + Symbol();
   gv_all_date = "MAX_DD_DATE_" + IntegerToString(InpMagic) + "_" + Symbol();

   if(GlobalVariableCheck(gv_all_pct)) max_dd_all_time_pct = GlobalVariableGet(gv_all_pct);
   if(GlobalVariableCheck(gv_all_money)) max_dd_all_time_money = GlobalVariableGet(gv_all_money);
   if(GlobalVariableCheck(gv_all_date)) max_dd_all_time_date = (long)GlobalVariableGet(gv_all_date);

   // --- โหลดค่ากำไรสูงสุด/ต่ำสุดของวัน เดิม (ถ้ามี) ---
   gv_max_prof = "MAX_PROF_USD_" + IntegerToString(InpMagic) + "_" + Symbol();
   gv_min_prof = "MIN_PROF_USD_" + IntegerToString(InpMagic) + "_" + Symbol();
   gv_max_prof_date = "MAX_PROF_DATE_" + IntegerToString(InpMagic) + "_" + Symbol();
   gv_min_prof_date = "MIN_PROF_DATE_" + IntegerToString(InpMagic) + "_" + Symbol();

   if(GlobalVariableCheck(gv_max_prof)) max_profit_day_usd = GlobalVariableGet(gv_max_prof);
   if(GlobalVariableCheck(gv_min_prof)) min_profit_day_usd = GlobalVariableGet(gv_min_prof);
   if(GlobalVariableCheck(gv_max_prof_date)) max_profit_date = (long)GlobalVariableGet(gv_max_prof_date);
   if(GlobalVariableCheck(gv_min_prof_date)) min_profit_date = (long)GlobalVariableGet(gv_min_prof_date);

   handle_ema = iMA(Symbol(), PERIOD_M15, 21, 0, MODE_EMA, PRICE_CLOSE);
   handle_atr = iATR(Symbol(), PERIOD_M30, 14);

   if(handle_ema == INVALID_HANDLE || handle_atr == INVALID_HANDLE)
     {
      Print("Error loading indicators");
      return(INIT_FAILED);
     }

   m_symbol.Name(Symbol());
   m_symbol.RefreshRates();

   //--- Set Auto Chart Candles Colors
   ChartSetInteger(0, CHART_MODE, CHART_CANDLES);
   ChartSetInteger(0, CHART_COLOR_CHART_UP, clrDeepSkyBlue);
   ChartSetInteger(0, CHART_COLOR_CHART_DOWN, clrRed);
   ChartSetInteger(0, CHART_COLOR_CANDLE_BULL, clrDeepSkyBlue);
   ChartSetInteger(0, CHART_COLOR_CANDLE_BEAR, clrRed);

   return(INIT_SUCCEEDED);
  }

