# คัดลอกเป็น deploy.env แล้วใส่ URL repo จริง
# cp deploy.env.example deploy.env

# HTTPS หรือ SSH
GIT_REMOTE_URL=https://github.com/YOUR_USER/trading-avelqua.git
# Personal Access Token (repo scope) — เก็บใน deploy.env เท่านั้น ห้าม commit
# GIT_TOKEN=ghp_xxxxxxxx
GIT_BRANCH=main
GIT_PUSH_ON_DEPLOY=1

# หลัง pull แล้ว restart อัตโนมัติ
PM2_APP_NAME=trading-avelqua
RUN_NPM_INSTALL=1

# เมื่อ public/agent/agent.py เปลี่ยน → คิว deploy + restart ไปทุก VPS
AGENT_DEPLOY_ON_PULL=1
# บังคับ deploy agent ทุกครั้งที่ pull (ไม่ต้องรอไฟล์ agent.py เปลี่ยน)
# FORCE_AGENT_DEPLOY=1
